# Node / pnpm artifacts
node_modules/

# Persistent local acceptance artifacts (kept outside cargo clean).
# The published screenshot corpora live here as well: their pixels are local
# acceptance evidence and never enter git, while each surface's
# `manifest.tsv` — the index that names every published frame — stays tracked
# so CI can still hold a surface to its canonical matrix.
**/.evidence/**
!.evidence/corpora/
!.evidence/corpora/**/
.evidence/corpora/**/*.png
!.evidence/corpora/**/manifest.tsv

# Rust build artifacts
target/
crates/mihomo-dav-sync/target/

# Misc
dist/
*.log
*.tmp
_tmp_*
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Local AI tool state (per-session caches and plans; never product sources)
.mimosa/
.zcode/
.claude/settings.local.json
.claude/worktrees/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Vendored mihomo core binaries (untracked; restore with scripts/fetch-mihomo.sh)
vendor/

# SQLite databases (runtime generated)
*.db
*.db-shm
*.db-wal

# Private local notes (never committed)
.private/

# Historical documents are local reference only; do not track archive contents.
/docs/archive/

# Build outputs
*.msi
*.exe

# Android build outputs and local toolchain configuration
android/.gradle/
android/.idea/
android/.kotlin/
android/.cxx/
android/.externalNativeBuild/
android/*.iml
android/build/
android/app/build/
android/bevy-host/build/
android/core-host-tests/build/
android/buildSrc/build/
android/buildSrc/.gradle/
android/app/.cxx/
android/app/.externalNativeBuild/
android/app/src/main/jniLibs/
android/app/src/slint/jniLibs/
android/local.properties
android/app/src/main/assets/mihomo/mihomo-android-arm64-v8
android/app/src/main/java/infiltrator_android/
android/Medium-Phone-*

# Design font collection binaries and local commercial candidates
crates/infiltrator-shared/assets/fonts/base-local/
crates/infiltrator-shared/assets/fonts/*-local/
crates/infiltrator-shared/assets/fonts/collection/**
!crates/infiltrator-shared/assets/fonts/collection/**/
!crates/infiltrator-shared/assets/fonts/collection/**/*.txt
crates/infiltrator-shared/assets/fonts/*.otf
crates/infiltrator-shared/assets/fonts/LongCang-Regular.ttf
crates/infiltrator-shared/assets/fonts/MaShanZheng-Regular.ttf
crates/infiltrator-shared/assets/fonts/ZCOOLXiaoWei-Regular.ttf

