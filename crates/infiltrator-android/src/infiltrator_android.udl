namespace infiltrator_android {
  // Sync functions
  string ping();
  boolean bridge_ready();
  FfiStatus bridge_shutdown();
  VpnPreparationResult prepare_vpn(u64 vpn_generation);
  FfiStatus start_vpn(i32 fd, u64 vpn_generation, u64 preparation_id, u64 activation_lease_id);
  FfiStatus cancel_vpn_preparation(u64 vpn_generation);
  FfiStatus revoke_vpn();

  // Async functions
  [Async]
  IpResult ip_check();

  [Async]
  FfiStatus connection_close(string id);

  [Async]
  FfiStatus connections_close_all();

  [Async]
  DnsSettingsResult dns_settings();

  [Async]
  DnsSettingsResult dns_settings_save(DnsSettingsPatch patch);

  [Async]
  FakeIpSettingsResult fake_ip_settings();

  [Async]
  FakeIpSettingsResult fake_ip_settings_save(FakeIpSettingsPatch patch);

  [Async]
  FfiBoolResult fake_ip_cache_clear();

};

enum FfiErrorCode {
  "Ok",
  "InvalidState",
  "InvalidInput",
  "NotReady",
  "NotSupported",
  "Io",
  "Network",
  "Unknown",
};

dictionary FfiStatus {
  FfiErrorCode code;
  string? message;
};

dictionary FfiStringResult {
  FfiStatus status;
  string? value;
};

dictionary FfiBoolResult {
  FfiStatus status;
  boolean value;
};

dictionary ProfileSummary {
  string name;
  boolean active;
  string? subscription_url;
  boolean auto_update_enabled;
  u32? update_interval_hours;
  string? last_updated;
  string? next_update;
};

dictionary ProfilesResult {
  FfiStatus status;
  sequence<ProfileSummary> profiles;
};

dictionary ProfileDetail {
  string name;
  boolean active;
  string content;
  string? subscription_url;
  boolean auto_update_enabled;
  u32? update_interval_hours;
  string? last_updated;
  string? next_update;
};

dictionary ProfileDetailResult {
  FfiStatus status;
  ProfileDetail? profile;
};

dictionary IpCheckResult {
  string ip;
  string? country;
  string? region;
  string? city;
};

dictionary IpResult {
  FfiStatus status;
  IpCheckResult? value;
};

dictionary VpnTunSettings {
  u32? mtu;
  boolean? auto_route;
  boolean? strict_route;
  string? stack;
  boolean? auto_detect_interface;
};

dictionary VpnTunSettingsPatch {
  u32? mtu;
  boolean? auto_route;
  boolean? strict_route;
  string? stack;
  boolean? auto_detect_interface;
};

dictionary VpnTunSettingsResult {
  FfiStatus status;
  VpnTunSettings? settings;
};

enum AndroidCoreLifecycle {
  "Stopped",
  "Starting",
  "Ready",
  "Running",
  "Stopping",
  "Failed",
};

dictionary VpnPreparationResult {
  FfiStatus status;
  u64? preparation_id;
};

dictionary DnsSettings {
  boolean? enable;
  boolean? ipv6;
  string? enhanced_mode;
  sequence<string> nameserver;
  sequence<string> default_nameserver;
  sequence<string> fallback;
  DnsFallbackFilterSettings? fallback_filter;
};

dictionary DnsSettingsPatch {
  boolean? enable;
  boolean? ipv6;
  string? enhanced_mode;
  sequence<string>? nameserver;
  sequence<string>? default_nameserver;
  sequence<string>? fallback;
  DnsFallbackFilterSettings? fallback_filter;
};

dictionary DnsFallbackFilterSettings {
  boolean? geoip;
  string? geoip_code;
  sequence<string> ipcidr;
  sequence<string> domain;
  sequence<string> domain_suffix;
};

dictionary DnsSettingsResult {
  FfiStatus status;
  DnsSettings? settings;
};

dictionary FakeIpSettings {
  string? fake_ip_range;
  sequence<string> fake_ip_filter;
  boolean? store_fake_ip;
};

dictionary FakeIpSettingsPatch {
  string? fake_ip_range;
  sequence<string>? fake_ip_filter;
  boolean? store_fake_ip;
};

dictionary FakeIpSettingsResult {
  FfiStatus status;
  FakeIpSettings? settings;
};

dictionary WebDavSettings {
  boolean enabled;
  string url;
  string username;
  string password;
  u32 sync_interval_mins;
  boolean sync_on_startup;
};

dictionary WebDavSettingsResult {
  FfiStatus status;
  WebDavSettings? settings;
};

dictionary WebDavSyncResult {
  FfiStatus status;
  u32 success_count;
  u32 failed_count;
  u32 total_actions;
};
