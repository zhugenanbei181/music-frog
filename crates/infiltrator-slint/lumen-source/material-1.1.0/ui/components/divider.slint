import { LumenUiScale } from "../../../ui/ui-scale.slint";
import { MaterialPalette } from "../styling/material_palette.slint";

component BaseDivider {
    Rectangle {
        background: MaterialPalette.outline_variant;
    }
}

export component VerticalDivider {
    width: 1px * LumenUiScale.factor;

    BaseDivider {
        width: 100%;
        height: 100%;
    }
}

export component HorizontalDivider {
    height: 1px * LumenUiScale.factor;

    BaseDivider {
        width: 100%;
        height: 100%;
    }
}
