#[cfg(any(target_os = "windows", target_os = "linux"))]
use anyhow::Context;
#[cfg(target_os = "android")]
use std::path::PathBuf;

#[cfg(any(target_os = "windows", target_os = "linux"))]
const SERVICE: &str = "org.lumen.proxy";

#[cfg(any(target_os = "windows", target_os = "linux"))]
fn entry(reference: &str) -> anyhow::Result<keyring::Entry> {
    keyring::Entry::new(SERVICE, reference).map_err(|_| anyhow::anyhow!("无法访问系统凭据库"))
}

pub fn store(reference: &str, secret: &str) -> anyhow::Result<()> {
    #[cfg(any(target_os = "windows", target_os = "linux"))]
    entry(reference)?
        .set_password(secret)
        .context("无法将凭据保存到系统凭据库")?;
    #[cfg(target_os = "android")]
    android_store(reference, secret)?;
    #[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "android")))]
    anyhow::bail!("此平台的安全凭据存储尚未接入");
    Ok(())
}

pub fn read(reference: &str) -> anyhow::Result<String> {
    #[cfg(any(target_os = "windows", target_os = "linux"))]
    {
        return entry(reference)?
            .get_password()
            .context("无法从系统凭据库读取订阅凭据");
    }
    #[cfg(target_os = "android")]
    {
        return android_read(reference);
    }
    #[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "android")))]
    {
        let _ = reference;
        anyhow::bail!("此平台的安全凭据存储尚未接入");
    }
}

pub fn delete(reference: &str) {
    #[cfg(any(target_os = "windows", target_os = "linux"))]
    {
        if let Ok(item) = entry(reference) {
            let _ = item.delete_credential();
        }
    }
    #[cfg(target_os = "android")]
    android_delete(reference);
    #[cfg(not(any(target_os = "windows", target_os = "linux", target_os = "android")))]
    {
        let _ = reference;
    }
}

#[cfg(target_os = "android")]
mod android {
    use super::*;
    use anyhow::Context as _;
    use jni::{
        JNIEnv, JavaVM,
        objects::{JByteArray, JObject, JObjectArray, JValue},
        sys::{jbyte, jbyteArray},
    };
    use std::{fs, io::Write, sync::OnceLock};

    struct AndroidContext {
        vm_ptr: usize,
        root: PathBuf,
    }

    static CONTEXT: OnceLock<AndroidContext> = OnceLock::new();

    pub(super) fn configure(vm: *mut std::ffi::c_void, data_path: PathBuf) -> anyhow::Result<()> {
        let vm = unsafe { JavaVM::from_raw(vm.cast()) }
            .map_err(|_| anyhow::anyhow!("Android Java VM 不可用"))?;
        CONTEXT
            .set(AndroidContext {
                vm_ptr: vm.get_java_vm_pointer() as usize,
                root: data_path.join("Lumen").join("credentials"),
            })
            .map_err(|_| anyhow::anyhow!("Android 凭据服务已初始化"))
    }

    fn context() -> anyhow::Result<&'static AndroidContext> {
        CONTEXT
            .get()
            .ok_or_else(|| anyhow::anyhow!("Android Keystore 尚未初始化"))
    }

    fn alias(reference: &str) -> anyhow::Result<String> {
        if reference.is_empty()
            || reference.len() > 64
            || !reference
                .bytes()
                .all(|value| value.is_ascii_hexdigit() || value == b'-')
        {
            anyhow::bail!("凭据引用无效");
        }
        Ok(format!("lumen.profile.{reference}"))
    }

    fn encrypted_file(reference: &str) -> anyhow::Result<PathBuf> {
        Ok(context()?.root.join(format!("{}.bin", reference)))
    }

    pub(super) fn store(reference: &str, secret: &str) -> anyhow::Result<()> {
        let key_alias = alias(reference)?;
        let context = context()?;
        let vm = unsafe { JavaVM::from_raw(context.vm_ptr as *mut _) }
            .map_err(|_| anyhow::anyhow!("Android Java VM 不可用"))?;
        let mut env = vm
            .attach_current_thread()
            .map_err(|_| anyhow::anyhow!("无法连接 Android Keystore"))?;
        let encrypted = encrypt(&mut env, &key_alias, secret.as_bytes())
            .map_err(|_| anyhow::anyhow!("Android Keystore 加密失败"))?;
        let path = encrypted_file(reference)?;
        let parent = path
            .parent()
            .ok_or_else(|| anyhow::anyhow!("Android 凭据目录无效"))?;
        fs::create_dir_all(parent).context("无法创建 Android 私有凭据目录")?;
        let mut temp = tempfile::NamedTempFile::new_in(parent)?;
        temp.write_all(&encrypted)?;
        temp.as_file().sync_all()?;
        temp.persist(path)
            .map_err(|error| error.error)
            .context("无法保存加密后的 Android 凭据")?;
        Ok(())
    }

    pub(super) fn read(reference: &str) -> anyhow::Result<String> {
        let key_alias = alias(reference)?;
        let encrypted =
            fs::read(encrypted_file(reference)?).context("无法读取加密后的 Android 凭据")?;
        let context = context()?;
        let vm = unsafe { JavaVM::from_raw(context.vm_ptr as *mut _) }
            .map_err(|_| anyhow::anyhow!("Android Java VM 不可用"))?;
        let mut env = vm
            .attach_current_thread()
            .map_err(|_| anyhow::anyhow!("无法连接 Android Keystore"))?;
        let plaintext = decrypt(&mut env, &key_alias, &encrypted)
            .map_err(|_| anyhow::anyhow!("Android Keystore 解密失败"))?;
        String::from_utf8(plaintext).context("Android 凭据内容无效")
    }

    pub(super) fn delete(reference: &str) {
        let Ok(key_alias) = alias(reference) else {
            return;
        };
        if let Ok(context) = context() {
            if let Ok(vm) = unsafe { JavaVM::from_raw(context.vm_ptr as *mut _) }
                && let Ok(mut env) = vm.attach_current_thread()
            {
                let _ = delete_key(&mut env, &key_alias);
            }
        }
        if let Ok(path) = encrypted_file(reference) {
            let _ = fs::remove_file(path);
        }
    }

    fn key_store<'local>(env: &mut JNIEnv<'local>) -> anyhow::Result<JObject<'local>> {
        let class = env.find_class("java/security/KeyStore")?;
        let provider = env.new_string("AndroidKeyStore")?;
        let provider: JObject = provider.into();
        let store = env
            .call_static_method(
                class,
                "getInstance",
                "(Ljava/lang/String;)Ljava/security/KeyStore;",
                &[JValue::Object(&provider)],
            )?
            .l()?;
        let null = JObject::null();
        env.call_method(
            &store,
            "load",
            "(Ljava/security/KeyStore$LoadStoreParameter;)V",
            &[JValue::Object(&null)],
        )?;
        Ok(store)
    }

    fn get_or_create_key<'local>(
        env: &mut JNIEnv<'local>,
        store: &JObject<'local>,
        key_alias: &str,
    ) -> anyhow::Result<JObject<'local>> {
        let alias_string = env.new_string(key_alias)?;
        let alias_object: JObject = alias_string.into();
        let key = get_key(env, store, &alias_object)?;
        if !key.is_null() {
            return Ok(key);
        }

        let builder = env.new_object(
            "android/security/keystore/KeyGenParameterSpec$Builder",
            "(Ljava/lang/String;I)V",
            &[
                JValue::Object(&alias_object),
                JValue::Int(3), // PURPOSE_ENCRYPT | PURPOSE_DECRYPT
            ],
        )?;
        let gcm = env.new_string("GCM")?;
        let gcm: JObject = gcm.into();
        let string_class = env.find_class("java/lang/String")?;
        let modes: JObjectArray = env.new_object_array(1, &string_class, JObject::null())?;
        env.set_object_array_element(&modes, 0, &gcm)?;
        env.call_method(
            &builder,
            "setBlockModes",
            "([Ljava/lang/String;)Landroid/security/keystore/KeyGenParameterSpec$Builder;",
            &[JValue::Object(&modes)],
        )?;
        let padding = env.new_string("NoPadding")?;
        let padding: JObject = padding.into();
        let paddings: JObjectArray = env.new_object_array(1, &string_class, JObject::null())?;
        env.set_object_array_element(&paddings, 0, &padding)?;
        env.call_method(
            &builder,
            "setEncryptionPaddings",
            "([Ljava/lang/String;)Landroid/security/keystore/KeyGenParameterSpec$Builder;",
            &[JValue::Object(&paddings)],
        )?;
        let spec = env
            .call_method(
                &builder,
                "build",
                "()Landroid/security/keystore/KeyGenParameterSpec;",
                &[],
            )?
            .l()?;
        let algorithm = env.new_string("AES")?;
        let provider = env.new_string("AndroidKeyStore")?;
        let algorithm: JObject = algorithm.into();
        let provider: JObject = provider.into();
        let generator = env
            .call_static_method(
                "javax/crypto/KeyGenerator",
                "getInstance",
                "(Ljava/lang/String;Ljava/lang/String;)Ljavax/crypto/KeyGenerator;",
                &[JValue::Object(&algorithm), JValue::Object(&provider)],
            )?
            .l()?;
        env.call_method(
            &generator,
            "init",
            "(Ljava/security/spec/AlgorithmParameterSpec;)V",
            &[JValue::Object(&spec)],
        )?;
        Ok(env
            .call_method(&generator, "generateKey", "()Ljava/security/Key;", &[])?
            .l()?)
    }

    fn get_key<'local>(
        env: &mut JNIEnv<'local>,
        store: &JObject<'local>,
        alias: &JObject<'local>,
    ) -> anyhow::Result<JObject<'local>> {
        let null = JObject::null();
        Ok(env
            .call_method(
                store,
                "getKey",
                "(Ljava/lang/String;[C)Ljava/security/Key;",
                &[JValue::Object(alias), JValue::Object(&null)],
            )?
            .l()?)
    }

    fn encrypt<'local>(
        env: &mut JNIEnv<'local>,
        key_alias: &str,
        plaintext: &[u8],
    ) -> anyhow::Result<Vec<u8>> {
        let store = key_store(env)?;
        let key = get_or_create_key(env, &store, key_alias)?;
        let cipher_type = env.new_string("AES/GCM/NoPadding")?;
        let cipher_type: JObject = cipher_type.into();
        let cipher = env
            .call_static_method(
                "javax/crypto/Cipher",
                "getInstance",
                "(Ljava/lang/String;)Ljavax/crypto/Cipher;",
                &[JValue::Object(&cipher_type)],
            )?
            .l()?;
        env.call_method(
            &cipher,
            "init",
            "(ILjava/security/Key;)V",
            &[JValue::Int(1), JValue::Object(&key)],
        )?;
        let iv_obj = env.call_method(&cipher, "getIV", "()[B", &[])?.l()?;
        let iv: JByteArray = unsafe { JByteArray::from_raw(iv_obj.into_raw() as jbyteArray) };
        let iv = env.convert_byte_array(&iv)?;
        let plaintext_array = byte_array(env, plaintext)?;
        let ciphertext_obj = env
            .call_method(
                &cipher,
                "doFinal",
                "([B)[B",
                &[JValue::Object(plaintext_array.as_ref())],
            )?
            .l()?;
        let ciphertext: JByteArray =
            unsafe { JByteArray::from_raw(ciphertext_obj.into_raw() as jbyteArray) };
        let ciphertext = env.convert_byte_array(&ciphertext)?;
        let mut encrypted = Vec::with_capacity(iv.len() + ciphertext.len());
        encrypted.extend_from_slice(&iv);
        encrypted.extend_from_slice(&ciphertext);
        Ok(encrypted)
    }

    fn decrypt<'local>(
        env: &mut JNIEnv<'local>,
        key_alias: &str,
        encrypted: &[u8],
    ) -> anyhow::Result<Vec<u8>> {
        const IV_LENGTH: usize = 12;
        if encrypted.len() <= IV_LENGTH {
            anyhow::bail!("Android 加密凭据格式无效");
        }
        let store = key_store(env)?;
        let alias = env.new_string(key_alias)?;
        let alias: JObject = alias.into();
        let key = get_key(env, &store, &alias)?;
        if key.is_null() {
            anyhow::bail!("Android 凭据密钥不存在");
        }
        let cipher_type = env.new_string("AES/GCM/NoPadding")?;
        let cipher_type: JObject = cipher_type.into();
        let cipher = env
            .call_static_method(
                "javax/crypto/Cipher",
                "getInstance",
                "(Ljava/lang/String;)Ljavax/crypto/Cipher;",
                &[JValue::Object(&cipher_type)],
            )?
            .l()?;
        let iv_array = byte_array(env, &encrypted[..IV_LENGTH])?;
        let params = env.new_object(
            "javax/crypto/spec/GCMParameterSpec",
            "(I[B)V",
            &[JValue::Int(128), JValue::Object(iv_array.as_ref())],
        )?;
        env.call_method(
            &cipher,
            "init",
            "(ILjava/security/Key;Ljava/security/spec/AlgorithmParameterSpec;)V",
            &[
                JValue::Int(2),
                JValue::Object(&key),
                JValue::Object(&params),
            ],
        )?;
        let ciphertext_array = byte_array(env, &encrypted[IV_LENGTH..])?;
        let plaintext_obj = env
            .call_method(
                &cipher,
                "doFinal",
                "([B)[B",
                &[JValue::Object(ciphertext_array.as_ref())],
            )?
            .l()?;
        let plaintext: JByteArray =
            unsafe { JByteArray::from_raw(plaintext_obj.into_raw() as jbyteArray) };
        Ok(env.convert_byte_array(&plaintext)?)
    }

    fn delete_key<'local>(env: &mut JNIEnv<'local>, key_alias: &str) -> anyhow::Result<()> {
        let store = key_store(env)?;
        let alias = env.new_string(key_alias)?;
        let alias: JObject = alias.into();
        env.call_method(
            &store,
            "deleteEntry",
            "(Ljava/lang/String;)V",
            &[JValue::Object(&alias)],
        )?;
        Ok(())
    }

    fn byte_array<'local>(
        env: &mut JNIEnv<'local>,
        bytes: &[u8],
    ) -> anyhow::Result<JByteArray<'local>> {
        let array = env.new_byte_array(bytes.len() as i32)?;
        let signed: Vec<jbyte> = bytes.iter().map(|value| *value as jbyte).collect();
        env.set_byte_array_region(&array, 0, &signed)?;
        Ok(array)
    }
}

#[cfg(target_os = "android")]
pub(crate) fn configure_android(
    vm: *mut std::ffi::c_void,
    data_path: PathBuf,
) -> anyhow::Result<()> {
    android::configure(vm, data_path)
}

#[cfg(target_os = "android")]
fn android_store(reference: &str, secret: &str) -> anyhow::Result<()> {
    android::store(reference, secret)
}

#[cfg(target_os = "android")]
fn android_read(reference: &str) -> anyhow::Result<String> {
    android::read(reference)
}

#[cfg(target_os = "android")]
fn android_delete(reference: &str) {
    android::delete(reference);
}
