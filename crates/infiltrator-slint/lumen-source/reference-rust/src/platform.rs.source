    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeSystemThemeChanged(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        dark_mode: jni::sys::jboolean,
    ) {
        send(UiCommand::SetSystemDarkMode(dark_mode != 0));
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeAndroidActivityVisibility(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        visible: jni::sys::jboolean,
    ) {
        send(UiCommand::AndroidActivityVisibility(visible != 0));
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeAndroidSystemSettingsChanged(
        mut env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        notifications_allowed: jni::sys::jboolean,
        battery_optimization_ignored: jni::sys::jboolean,
        language: JString<'_>,
        api_level: jni::sys::jint,
    ) {
        let language = env.get_string(&language)
            .map(|value| value.to_string_lossy().into_owned())
            .unwrap_or_else(|_| "zh-CN".into());
        send(UiCommand::AndroidSystemSettingsChanged {
            notification_permission_granted: notifications_allowed != 0,
            ignore_battery_optimizations: battery_optimization_ignored != 0,
            system_language: language,
            api_level: api_level.max(0) as u32,
        });
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeNotificationPermissionResult(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        granted: jni::sys::jboolean,
    ) {
        if let Some(slot) = NOTIFICATION_PERMISSION_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(granted != 0);
            }
        }
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeBackGestureProgress(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        progress: jni::sys::jfloat,
    ) {
        send(UiCommand::AndroidBackGestureProgress(progress));
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeBackGestureCancelled(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
    ) {
        send(UiCommand::AndroidBackGestureCancelled);
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeVpnPermissionResult(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        granted: jni::sys::jboolean,
    ) {
        if let Some(slot) = VPN_PERMISSION_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(granted != 0);
            }
        }
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeVpnStartRequestFailed(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
    ) {
        if let Some(slot) = VPN_TUN_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(Err("无法启动 Android VPN 前台服务".into()));
            }
        }
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenVpnService_nativeVpnTunnelEstablished(
        _env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        fd: jni::sys::jint,
    ) {
        if let Some(slot) = VPN_TUN_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(Ok(fd));
            }
        }
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenVpnService_nativeVpnTunnelFailed(
        mut env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        reason: JString<'_>,
    ) {
        let reason = env
            .get_string(&reason)
            .map(|value| value.to_string_lossy().into_owned())
            .unwrap_or_else(|_| "Android VPN 服务启动失败".into());
        if let Some(slot) = VPN_TUN_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(Err(reason));
            }
        }
    }

    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenVpnService_nativeVpnServiceDisconnected(
        mut env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        reason: JString<'_>,
    ) {
        let reason = env
            .get_string(&reason)
            .map(|value| value.to_string_lossy().into_owned())
            .unwrap_or_else(|_| "Android VPN 服务已断开".into());
        if let Some(slot) = VPN_TUN_SENDER.get() {
            if let Some(sender) = slot.lock().ok().and_then(|mut current| current.take()) {
                let _ = sender.send(Err(reason.clone()));
            }
        }
        send(UiCommand::AndroidVpnDisconnected(reason));
    }
}

#[cfg(target_os = "android")]
pub fn configure_android_activity(app: slint::android::AndroidApp) {
    android_profile_picker::configure_activity(app);
}

#[cfg(target_os = "android")]
pub fn set_android_system_bar_appearance(dark_background: bool) {
    android_profile_picker::set_system_bar_appearance(dark_background);
}

#[cfg(target_os = "android")]
pub fn refresh_android_system_theme() {
    android_profile_picker::refresh_system_theme();
}

#[cfg(target_os = "android")]
pub fn register_android_profile_file_sender(
    sender: std::sync::mpsc::Sender<crate::services::UiCommand>,
) {
    android_profile_picker::register_sender(sender);
}

#[cfg(target_os = "android")]
pub fn request_android_profile_file_picker() -> anyhow::Result<()> {
    android_profile_picker::request_profile_picker()
}

#[cfg(target_os = "android")]
pub async fn set_android_hide_background_card(enabled: bool) -> anyhow::Result<()> {
    android_profile_picker::set_hide_background_card(enabled).await
}

