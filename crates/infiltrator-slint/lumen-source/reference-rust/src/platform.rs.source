    #[unsafe(no_mangle)]
    pub extern "system" fn Java_org_lumen_client_LumenActivity_nativeExportDocumentSelected(
        mut env: jni::JNIEnv<'_>,
        _class: JClass<'_>,
        uri: JString<'_>,
    ) {
        let uri = match env.get_string(&uri) {
            Ok(value) => value.to_string_lossy().into_owned(),
            Err(_) => {
                complete_export(UiCommand::AndroidExportDocumentFailed(
                    "无法读取 Android 保存位置".into(),
                ));
                return;
            }
        };
        send(UiCommand::AndroidExportDocumentSelected(uri));
