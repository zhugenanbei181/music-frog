    runtime_transition: String,
    system_dark_mode: bool,
    core_version: String,
    notice: String,
    connections: Vec<ConnectionEntry>,
    closed_connections: VecDeque<ConnectionEntry>,
    connection_search: String,
    connection_sort: String,
    connection_show_closed: bool,
    selected_connection_id: String,
    connection_breaking_id: String,
    log_search: String,
    log_level: String,
    log_stream_status: String,
    rule_search: String,
    rule_pending_index: String,
    rules: Vec<ObservationRow>,
    logs: VecDeque<ObservationRow>,
    providers: Vec<ObservationRow>,
    license_catalog: Option<LicenseCatalog>,
