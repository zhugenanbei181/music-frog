    license_query: String,
    license_rows: Arc<Vec<LicenseRow>>,
    license_rows_revision: i32,
    selected_license_id: String,
    license_detail: Option<Arc<LicenseDetail>>,
    license_detail_revision: i32,
    traffic_samples: VecDeque<ObservationRow>,
    traffic_stream_status: String,
    traffic_stream_id: Option<String>,
    traffic_last_totals: Option<(u64, u64)>,
    traffic_history_dirty: bool,
    traffic_history_last_save: Instant,
    proxy_groups: Vec<ProxyGroup>,
    proxy_nodes: Vec<ObservationRow>,
    cached_proxies: Option<Value>,
    proxy_group_order: Vec<String>,
    proxy_group_members: HashMap<String, Vec<String>>,
    proxy_endpoints: HashMap<String, ProxyEndpoint>,
    proxy_search: String,
    proxy_sort_mode: String,
    proxy_node_types: HashMap<String, String>,
    proxy_delays: HashMap<String, u64>,
    proxy_testing_group: String,
    proxy_testing_node: String,
    home_proxy_group: String,
    home_current_node_id: String,
    home_current_node: String,
    home_current_accessible: String,
    home_current_flag_code: String,
    home_current_flag_index: i32,
    home_current_delay: String,
    home_exit_ip: String,
    home_exit_country_code: String,
    home_exit_flag_index: i32,
    home_exit_status: String,
    home_egress_generation: u64,
    home_egress_pending: bool,
