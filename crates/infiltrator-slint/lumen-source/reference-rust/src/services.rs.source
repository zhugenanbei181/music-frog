        up: f64,
        down: f64,
        up_total: u64,
        down_total: u64,
    },
    HomeEgress {
        generation: u64,
        result: Result<(String, String), String>,
    },
    StreamDisconnected(String),
    LogStreamStatus(bool),
}

#[derive(Clone)]
struct ProxyEndpoint {
    server: String,
    port: u16,
}

fn collect_runtime_group_nodes(
    value: &Value,
    name: &str,
    visited: &mut HashSet<String>,
    nodes: &mut Vec<String>,
) {
    if !visited.insert(name.to_string()) {
        return;
    }
    let Some(proxy_map) = value.get("proxies").and_then(Value::as_object) else {
        return;
    };
    let Some(entry) = proxy_map.get(name) else {
        nodes.push(name.to_string());
        return;
    };
    if let Some(children) = entry.get("all").and_then(Value::as_array) {
        for child in children.iter().filter_map(Value::as_str) {
            collect_runtime_group_nodes(value, child, visited, nodes);
        }
    } else {
        nodes.push(name.to_string());
    }
}

enum ProxyTestResults {
    Mihomo(Vec<(String, Result<u64, String>)>),
    Tcp(Vec<(String, Result<u64, String>)>),
}

struct TrafficHistoryView {
    today_bars: Vec<TrafficBar>,
    week_bars: Vec<TrafficBar>,
    today_download: String,
    today_upload: String,
    week_download: String,
    week_upload: String,
    week_average_download: String,
    week_average_upload: String,
    today_has_data: bool,
    week_has_data: bool,
}

fn traffic_history_view(buckets: &[TrafficUsageBucket], today: NaiveDate) -> TrafficHistoryView {
    let week_start = today - ChronoDuration::days(today.weekday().num_days_from_monday() as i64);
    let elapsed_days = today
        .signed_duration_since(week_start)
        .num_days()
        .saturating_add(1) as usize;
    let mut hourly = vec![(0_u64, 0_u64); 24];
    let mut daily = vec![(0_u64, 0_u64); elapsed_days];

    for bucket in buckets {
        if bucket.hour >= 24 {
            continue;
        }
        let Ok(day) = NaiveDate::parse_from_str(&bucket.day, "%Y-%m-%d") else {
            continue;
        };
        if day == today {
            let hour_entry = &mut hourly[bucket.hour as usize];
            hour_entry.0 = hour_entry.0.saturating_add(bucket.download_bytes);
            hour_entry.1 = hour_entry.1.saturating_add(bucket.upload_bytes);
        }
        if (week_start..=today).contains(&day) {
            let index = day.signed_duration_since(week_start).num_days() as usize;
            if let Some(day_entry) = daily.get_mut(index) {
                day_entry.0 = day_entry.0.saturating_add(bucket.download_bytes);
                day_entry.1 = day_entry.1.saturating_add(bucket.upload_bytes);
            }
        }
    }

    let today_download = hourly
        .iter()
        .fold(0_u64, |total, entry| total.saturating_add(entry.0));
    let today_upload = hourly
        .iter()
        .fold(0_u64, |total, entry| total.saturating_add(entry.1));
    let week_download = daily
        .iter()
        .fold(0_u64, |total, entry| total.saturating_add(entry.0));
    let week_upload = daily
        .iter()
        .fold(0_u64, |total, entry| total.saturating_add(entry.1));
    let max_hour_download = hourly.iter().map(|entry| entry.0).max().unwrap_or(0);
    let max_hour_upload = hourly.iter().map(|entry| entry.1).max().unwrap_or(0);
    let max_day_download = daily.iter().map(|entry| entry.0).max().unwrap_or(0);
    let max_day_upload = daily.iter().map(|entry| entry.1).max().unwrap_or(0);

    let today_bars = hourly
        .iter()
        .enumerate()
        .map(|(hour, (download, upload))| TrafficBar {
            label: format!("{hour:02}").into(),
            detail_label: format!("{hour:02}:00").into(),
            download: mihomo::format_bytes(*download as f64).into(),
            upload: mihomo::format_bytes(*upload as f64).into(),
            download_fraction: traffic_fraction(*download, max_hour_download),
            upload_fraction: traffic_fraction(*upload, max_hour_upload),
        })
        .collect();
    let week_bars = daily
        .iter()
        .enumerate()
        .map(|(index, (download, upload))| {
            let day = week_start + ChronoDuration::days(index as i64);
            let weekday = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
                [day.weekday().num_days_from_monday() as usize];
            TrafficBar {
                label: weekday.into(),
                detail_label: day.format("%Y-%m-%d").to_string().into(),
                download: mihomo::format_bytes(*download as f64).into(),
                upload: mihomo::format_bytes(*upload as f64).into(),
                download_fraction: traffic_fraction(*download, max_day_download),
                upload_fraction: traffic_fraction(*upload, max_day_upload),
            }
        })
        .collect();

    TrafficHistoryView {
        today_bars,
        week_bars,
        today_download: mihomo::format_bytes(today_download as f64),
        today_upload: mihomo::format_bytes(today_upload as f64),
        week_download: mihomo::format_bytes(week_download as f64),
        week_upload: mihomo::format_bytes(week_upload as f64),
        week_average_download: mihomo::format_bytes((week_download / elapsed_days as u64) as f64),
        week_average_upload: mihomo::format_bytes((week_upload / elapsed_days as u64) as f64),
        today_has_data: today_download > 0 || today_upload > 0,
        week_has_data: week_download > 0 || week_upload > 0,
    }
}

fn traffic_fraction(value: u64, maximum: u64) -> f32 {
    if maximum == 0 {
        0.0
    } else {
        (value as f64 / maximum as f64).clamp(0.0, 1.0) as f32
    }
}

fn prune_traffic_buckets(buckets: &mut Vec<TrafficUsageBucket>, today: NaiveDate) -> bool {
    let previous = buckets.clone();
    let cutoff = today - ChronoDuration::days(6);
    buckets.retain(|bucket| {
        bucket.hour < 24
            && NaiveDate::parse_from_str(&bucket.day, "%Y-%m-%d")
                .is_ok_and(|day| (cutoff..=today).contains(&day))
    });
    buckets.sort_by(|left, right| left.day.cmp(&right.day).then(left.hour.cmp(&right.hour)));
    if buckets.len() > MAX_TRAFFIC_BUCKETS {
        let excess = buckets.len() - MAX_TRAFFIC_BUCKETS;
        buckets.drain(..excess);
    }
    *buckets != previous
}

pub fn start_worker(
    command_receiver: mpsc::Receiver<UiCommand>,
    state_sender: mpsc::SyncSender<UiState>,
) -> std::thread::JoinHandle<()> {
    std::thread::Builder::new().name("lumen-application-services".into()).spawn(move || {
        let runtime = match tokio::runtime::Builder::new_multi_thread().worker_threads(2).enable_all().build() {
            Ok(value) => value,
            Err(_) => return,
        };
        runtime.block_on(async move {
            let (command_sender, mut commands) = async_mpsc::unbounded_channel();
            tokio::task::spawn_blocking(move || {
                while let Ok(command) = command_receiver.recv() {
                    if command_sender.send(command).is_err() { break; }
                }
            });
            let (event_sender, mut events) = async_mpsc::channel(256);
            let mut backend = match Backend::open(state_sender.clone(), event_sender) {
                Ok(value) => value,
                Err(error) => {
                    let _ = state_sender.try_send(UiState::failed(error));
                    return;
                }
            };
            cleanup_stale_runtime_files(&backend.paths.root);
            let recovery = backend.paths.root.join("system-proxy-recovery.json");
            let had_recovery = recovery.exists();
            match platform::restore_system_proxy(&recovery).await {
                Ok(true) => {
                    backend.notice = "检测到系统代理被外部修改；已保留当前设置并清理旧恢复记录".into();
                }
                Ok(false) if had_recovery => {
                    backend.notice = "已恢复上次会话前的系统代理设置".into();
                }
                Ok(false) => {}
                Err(error) => {
                    backend.proxy_recovery_blocked = true;
                    backend.notice = format!("上次退出后系统代理状态尚未恢复：{error}。请先恢复系统代理再启动。" );
                }
            }
            #[cfg(target_os = "android")]
            if let Err(error) = backend.resolve_android_core().await {
                backend.core_version = "核心不可用".into();
                backend.notice = format!("Mihomo Android 核心不可用：{error}");
            }
            backend.publish();
            let startup_profile_id = backend
                .store
                .refresh_current_profile_on_start
                .then(|| backend.store.current_profile_id.clone())
                .flatten()
                .filter(|id| {
                    backend.store.profiles.iter().any(|profile| {
                        profile.id == *id && profile.source_kind == SourceKind::Subscription
                    })
                });
            if let Some(id) = startup_profile_id {
                backend.refresh_profile(&id).await;
            }
            let mut ticker = interval(Duration::from_millis(900));
            loop {
                tokio::select! {
                    command = commands.recv() => match command {
                        Some(command) => backend.handle(command).await,
                        None => break,
                    },
                    event = events.recv() => if let Some(event) = event { backend.handle_event(event); },
                    _ = ticker.tick() => backend.tick().await,
                }
            }
            backend.shutdown().await;
        });
    }).expect("application worker thread could not start")
}

