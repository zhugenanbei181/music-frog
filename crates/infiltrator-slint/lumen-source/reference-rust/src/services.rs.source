    android_export_contents: Option<String>,
    #[cfg(target_os = "android")]
    android_export_success_notice: String,
    profile_settings_id: String,
    profile_settings_name: String,
    profile_settings_location: String,
    profile_settings_kind: String,
    profile_settings_age_key: String,
    profile_settings_override_ids: Vec<String>,
    down_rate: String,
    up_rate: String,
    total_down: String,
    total_up: String,
    ticks: u64,
    proxy_recovery_blocked: bool,
    proxy_external_change_seen: bool,
    user_agent_save_revision: i32,
    user_agent_result_revision: i32,
    preview_theme_color: Option<String>,
    android_activity_visible: bool,
    android_notification_permission_granted: bool,
    android_ignore_battery_optimizations: bool,
    android_system_language: String,
    android_api_level: u32,
    android_back_gesture_progress: f32,
    android_back_gesture_active: bool,
    theme_color_save_revision: i32,
    theme_color_result_revision: i32,
    back_request_revision: i32,
}

impl Backend {
    fn open(
        state_sender: mpsc::SyncSender<UiState>,
        event_sender: async_mpsc::Sender<RuntimeEvent>,
    ) -> anyhow::Result<Self> {
        let paths = AppPaths::discover()?;
        use fs2::FileExt;
        let instance_lock = std::fs::OpenOptions::new()
            .create(true)
            .read(true)
            .write(true)
            .open(paths.root.join("lumen.lock"))?;
        instance_lock.try_lock_exclusive().map_err(|_| {
            anyhow::anyhow!("Lumen 已在运行，只允许一个实例管理本机 Mihomo 和系统代理")
        })?;
        let mut store = paths.load()?;
        let traffic_history_dirty =
            prune_traffic_buckets(&mut store.traffic_buckets, Local::now().date_naive());
        let traffic_history_last_save = if traffic_history_dirty {
            Instant::now() - TRAFFIC_HISTORY_SAVE_INTERVAL
        } else {
            Instant::now()
        };
        let (license_catalog, license_catalog_error) = match LicenseCatalog::load_embedded() {
            Ok(catalog) => (Some(catalog), String::new()),
            Err(error) => (None, error.to_string()),
        };
        let license_rows = Arc::new(
            license_catalog
                .as_ref()
                .map(|catalog| catalog.rows(""))
                .unwrap_or_default(),
        );
        let notice = String::new();
        let mut backend = Self {
            paths,
            _instance_lock: instance_lock,
            store,
            state_sender,
            event_sender,
            runtime: None,
            runtime_transition: String::new(),
            system_dark_mode: platform::system_dark_mode(),
            core_version: "未检测".into(),
            notice,
            connections: Vec::new(),
            closed_connections: VecDeque::new(),
            connection_search: String::new(),
            connection_sort: "时间".into(),
            connection_show_closed: false,
            selected_connection_id: String::new(),
            connection_breaking_id: String::new(),
            log_search: String::new(),
            log_level: "全部".into(),
            log_stream_status: "未运行".into(),
            rule_search: String::new(),
            rule_pending_index: String::new(),
            rules: Vec::new(),
            logs: VecDeque::new(),
            providers: Vec::new(),
            license_catalog,
            license_catalog_error,
            license_query: String::new(),
            license_rows,
            license_rows_revision: 1,
            selected_license_id: String::new(),
            license_detail: None,
            license_detail_revision: 1,
            traffic_samples: VecDeque::new(),
            traffic_stream_status: "未运行".into(),
            traffic_stream_id: None,
            traffic_last_totals: None,
            traffic_history_dirty,
            traffic_history_last_save,
            proxy_groups: Vec::new(),
            proxy_nodes: Vec::new(),
            selected_group: String::new(),
            cached_proxies: None,
            proxy_group_order: Vec::new(),
            proxy_group_members: HashMap::new(),
            proxy_endpoints: HashMap::new(),
            proxy_search: String::new(),
            proxy_sort_mode: "默认顺序".into(),
            proxy_node_types: HashMap::new(),
            proxy_delays: HashMap::new(),
            proxy_testing_group: String::new(),
            proxy_testing_node: String::new(),
            home_proxy_group: String::new(),
            home_current_node_id: String::new(),
            home_current_node: "未知".into(),
            home_current_accessible: "未知".into(),
            home_current_flag_code: String::new(),
            home_current_flag_index: -1,
            home_current_delay: "—".into(),
            home_exit_ip: "—".into(),
            home_exit_country_code: String::new(),
            home_exit_flag_index: -1,
            home_exit_status: String::new(),
            home_egress_generation: 0,
            home_egress_pending: false,
            home_egress_last_probe: None,
            home_rate_samples: VecDeque::new(),
            pending_profile_age_key: String::new(),
            pending_profile_name: String::new(),
            content_preview: String::new(),
            content_preview_profile: String::new(),
            edit_id: String::new(),
            edit_name: String::new(),
            edit_body: String::new(),
            override_importing: false,
            override_import_error: String::new(),
            override_import_revision: 0,
            #[cfg(target_os = "android")]
            android_export_contents: None,
            #[cfg(target_os = "android")]
            android_export_success_notice: String::new(),
            profile_settings_id: String::new(),
            profile_settings_name: String::new(),
            profile_settings_location: String::new(),
            profile_settings_kind: String::new(),
            profile_settings_age_key: String::new(),
            profile_settings_override_ids: Vec::new(),
            down_rate: "0 B/s".into(),
            up_rate: "0 B/s".into(),
            total_down: "0 B".into(),
            total_up: "0 B".into(),
            ticks: 0,
            proxy_recovery_blocked: false,
            proxy_external_change_seen: false,
            user_agent_save_revision: 0,
            user_agent_result_revision: 0,
            preview_theme_color: None,
            android_activity_visible: true,
            android_notification_permission_granted: false,
            android_ignore_battery_optimizations: false,
            android_system_language: "zh-CN".into(),
            android_api_level: 0,
            android_back_gesture_progress: 0.0,
            android_back_gesture_active: false,
            theme_color_save_revision: 0,
            theme_color_result_revision: 0,
            back_request_revision: 0,
        };
        backend.refresh_proxy_catalog_from_current_profile();
        Ok(backend)
    }

    fn refresh_license_rows(&mut self) {
        self.license_rows = Arc::new(
            self.license_catalog
                .as_ref()
                .map(|catalog| catalog.rows(&self.license_query))
                .unwrap_or_default(),
        );
        self.license_rows_revision = self.license_rows_revision.wrapping_add(1).max(1);
    }

    fn refresh_license_detail(&mut self) {
        self.license_detail = self
            .license_catalog
            .as_ref()
            .and_then(|catalog| catalog.detail(&self.selected_license_id))
            .map(Arc::new);
        self.license_detail_revision = self.license_detail_revision.wrapping_add(1).max(1);
    }

    fn publish(&self) {
        let english = self.is_english_ui();
        let current_id = self.store.current_profile_id.as_deref();
        let profiles = self
            .store
            .profiles
            .iter()
            .enumerate()
            .map(|(index, profile)| ProfileCard {
                id: profile.id.clone().into(),
                name: profile.name.clone().into(),
                kind: if english {
                    match &profile.source_kind {
                        SourceKind::Subscription => "Subscription",
                        SourceKind::LocalFile => "Local YAML",
                    }.into()
                } else {
                    profile.source_kind.label().into()
                },
                location: profile.location.clone().into(),
                updated: profile.updated_label().into(),
                current: Some(profile.id.as_str()) == current_id,
                can_move_up: index > 0,
                can_move_down: index + 1 < self.store.profiles.len(),
            })
            .collect::<Vec<_>>();
        let active_profile = self
            .store
            .profiles
            .iter()
            .find(|item| Some(item.id.as_str()) == current_id)
            .map(|item| item.name.clone())
            .unwrap_or_else(|| if english { "No profile selected" } else { "未选择配置" }.into());
        let has_current_profile =
            current_id.is_some_and(|id| self.store.profiles.iter().any(|profile| profile.id == id));
        let overrides = self
            .store
            .overrides
            .iter()
            .map(|item| OverrideCard {
                id: item.id.clone().into(),
                name: item.name.clone().into(),
                kind: if current_id
                    .is_some_and(|id| item.profile_ids.iter().any(|bound| bound == id))
                {
                    "当前配置已应用".into()
                } else {
                    "用户覆写".into()
                },
                format: "YAML".into(),
                bound_count: item.profile_ids.len().to_string().into(),
            })
            .collect();
        let selected_count = self.profile_settings_override_ids.len();
        let mut profile_settings_overrides = self
            .profile_settings_override_ids
            .iter()
            .enumerate()
            .filter_map(|(index, id)| {
                self.store
                    .overrides
                    .iter()
                    .find(|item| &item.id == id)
                    .map(|item| ProfileOverrideChoice {
                        id: item.id.clone().into(),
                        name: item.name.clone().into(),
                        format: "YAML".into(),
                        selected: true,
                        can_move_up: index > 0,
                        can_move_down: index + 1 < selected_count,
                    })
            })
            .collect::<Vec<_>>();
        profile_settings_overrides.extend(
            self.store
                .overrides
                .iter()
                .filter(|item| !self.profile_settings_override_ids.contains(&item.id))
                .map(|item| ProfileOverrideChoice {
                    id: item.id.clone().into(),
                    name: item.name.clone().into(),
                    format: "YAML".into(),
                    selected: false,
                    can_move_up: false,
                    can_move_down: false,
                }),
        );
        let runtime_status = if !self.runtime_transition.is_empty() {
            self.runtime_transition.as_str()
        } else if self.runtime.is_some() {
            "Running"
        } else {
            "Stopped"
        };
        let runtime_detail = if !self.notice.is_empty() {
            self.notice.clone()
        } else if self.runtime.is_some() {
            "本地 Mihomo 已就绪".into()
        } else {
            "尚未启动 Mihomo".into()
        };
        let runtime_detail = if english { english_ui_text(&runtime_detail) } else { runtime_detail };
        let connections = self.visible_connections(self.connection_show_closed);
        let selected_connection = self.find_connection(&self.selected_connection_id).cloned();
        let rules = self.visible_rules();
        let logs = self.visible_logs();
        let traffic_history =
            traffic_history_view(&self.store.traffic_buckets, Local::now().date_naive());
        let license_detail_error = if !self.license_catalog_error.is_empty() {
            self.license_catalog_error.clone()
        } else if self.selected_license_id.is_empty() {
            String::new()
        } else {
            self.license_detail
                .as_ref()
                .map(|detail| detail.error.clone())
                .unwrap_or_else(|| "未找到所选依赖的许可证记录，请重试读取。".into())
        };
        let network_mode_status = self.network_mode_status();
        let network_mode_status = if english { english_ui_text(&network_mode_status) } else { network_mode_status };
        let tun_capability_detail = self.tun_capability_detail();
        let tun_capability_detail = if english { english_ui_text(&tun_capability_detail) } else { tun_capability_detail };
        let max_home_download = self
            .home_rate_samples
            .iter()
            .map(|(download, _)| *download)
            .fold(0.0_f64, f64::max);
        let max_home_upload = self
            .home_rate_samples
            .iter()
            .map(|(_, upload)| *upload)
            .fold(0.0_f64, f64::max);
        let home_traffic_points = self
            .home_rate_samples
            .iter()
            .map(|(download, upload)| HomeTrafficPoint {
                download_fraction: if max_home_download > 0.0 {
                    (*download / max_home_download).clamp(0.0, 1.0) as f32
                } else {
                    0.0
                },
                upload_fraction: if max_home_upload > 0.0 {
                    (*upload / max_home_upload).clamp(0.0, 1.0) as f32
                } else {
                    0.0
                },
            })
            .collect();
        let network_mode_status_warning = match self.store.network_mode {
            NetworkMode::SystemProxy => {
                self.proxy_external_change_seen
                    || network_mode_status.contains("仍活动")
                    || network_mode_status.contains("无法确认")
            }
            NetworkMode::Tun => {
                !network_mode_status.contains("网卡和默认路由均已确认")
                    && !network_mode_status.contains("网卡和默认路由均已停止")
            }
            NetworkMode::Vpn => self.runtime.is_none(),
        };
        let effective_theme_color = self
            .preview_theme_color
            .as_deref()
            .unwrap_or(&self.store.theme_color)
            .to_string();
        let theme_color_input_code = format!("##{}", effective_theme_color.strip_prefix('#').unwrap_or(&effective_theme_color));
        let theme_rgb = parse_theme_color(&effective_theme_color).unwrap_or([1, 104, 136]);
        let (theme_hue, theme_saturation, theme_value) = rgb_to_hsv(theme_rgb);
        let system_language = if cfg!(target_os = "android") {
            self.android_system_language.clone()
        } else {
            system_language_from_environment()
        };
        let state = UiState {
            android_platform: cfg!(target_os = "android"),
            back_request_revision: self.back_request_revision,
            back_gesture_progress: self.android_back_gesture_progress,
            back_gesture_active: self.android_back_gesture_active,
            profiles,
            profile_settings_overrides,
            proxy_groups: self.proxy_groups.clone(),
            proxy_nodes: self.proxy_nodes.clone(),
            proxy_current_node_available: self.proxy_nodes.iter().any(|node| node.active),
            proxy_testing_group: self.proxy_testing_group.clone().into(),
            proxy_testing_node: self.proxy_testing_node.clone().into(),
            overrides,
            connections,
            rules,
            logs,
            providers: self.providers.clone(),
            license_rows: self.license_rows.clone(),
            license_rows_revision: self.license_rows_revision,
            license_query: self.license_query.clone().into(),
            license_catalog_error: self.license_catalog_error.clone().into(),
            license_detail: self.license_detail.clone(),
            license_detail_error: license_detail_error.into(),
            license_detail_revision: self.license_detail_revision,
            traffic_samples: self.traffic_samples.iter().cloned().collect(),
            traffic_today_bars: traffic_history.today_bars,
            traffic_week_bars: traffic_history.week_bars,
            traffic_today_down: traffic_history.today_download.into(),
            traffic_today_up: traffic_history.today_upload.into(),
            traffic_week_down: traffic_history.week_download.into(),
            traffic_week_up: traffic_history.week_upload.into(),
            traffic_week_average_down: traffic_history.week_average_download.into(),
            traffic_week_average_up: traffic_history.week_average_upload.into(),
            traffic_today_has_data: traffic_history.today_has_data,
            traffic_week_has_data: traffic_history.week_has_data,
            active_profile: active_profile.into(),
            has_current_profile,
            runtime_status: runtime_status.into(),
            runtime_detail: runtime_detail.into(),
            route_mode: self.store.route_mode.label().into(),
            theme_mode: self.store.theme_mode.label().into(),
            application_dark_mode: match &self.store.theme_mode {
                ThemeMode::System => self.system_dark_mode,
                ThemeMode::Light => false,
                ThemeMode::Dark => true,
            },
            network_mode: self.store.network_mode.label().into(),
            network_mode_status: network_mode_status.into(),
            network_mode_status_warning,
            tun_capable: platform::tun_platform_supported() && platform::tun_permission_available(),
            tun_capability_detail: tun_capability_detail.into(),
            core_version: if english { english_ui_text(&self.core_version).into() } else { self.core_version.clone().into() },
            user_agent: self.store.user_agent.clone().into(),
            user_agent_save_revision: self.user_agent_save_revision,
            user_agent_result_revision: self.user_agent_result_revision,
            refresh_current_profile_on_start: self.store.refresh_current_profile_on_start,
            auto_start: self.store.auto_start,
            application_language: self.store.application_language.clone().into(),
            system_language: system_language.into(),
            theme_color: effective_theme_color.clone().into(),
            theme_color_input_code: theme_color_input_code.into(),
            theme_accent_light_foreground: should_use_light_foreground(theme_rgb),
            theme_hue,
            theme_saturation,
            theme_value,
            theme_color_save_revision: self.theme_color_save_revision,
            theme_color_result_revision: self.theme_color_result_revision,
            page_scale_percent: self.store.page_scale_percent,
            invert_theme_foreground: self.store.invert_theme_foreground,
            hide_bottom_bar_on_scroll: self.store.hide_bottom_bar_on_scroll,
            predictive_back_enabled: self.store.predictive_back_enabled,
            predictive_back_supported: cfg!(target_os = "android") && self.android_api_level >= 34,
            hide_background_card: self.store.hide_background_card,
            recents_screenshot_supported: cfg!(target_os = "android") && self.android_api_level >= 33,
            show_traffic_notification: self.store.show_traffic_notification,
            notification_permission_granted: self.android_notification_permission_granted,
            release_ui_when_background: self.store.release_ui_when_background,
            ignore_battery_optimizations: self.android_ignore_battery_optimizations,
            proxy_recovery_pending: self.proxy_recovery_blocked,
            profile_settings_id: self.profile_settings_id.clone().into(),
            profile_settings_name: self.profile_settings_name.clone().into(),
            profile_settings_location: self.profile_settings_location.clone().into(),
            profile_settings_kind: self.profile_settings_kind.clone().into(),
            profile_settings_url: "".into(),
            profile_settings_age_key: self.profile_settings_age_key.clone().into(),
            stat_down: self.down_rate.clone().into(),
            stat_up: self.up_rate.clone().into(),
            home_current_node: self.home_current_node.clone().into(),
            home_current_accessible: self.home_current_accessible.clone().into(),
            home_current_flag_code: self.home_current_flag_code.clone().into(),
            home_current_flag_index: self.home_current_flag_index,
            home_current_delay: self.home_current_delay.clone().into(),
            home_exit_ip: self.home_exit_ip.clone().into(),
            home_exit_country_code: self.home_exit_country_code.clone().into(),
            home_exit_flag_index: self.home_exit_flag_index,
            home_exit_status: if english { english_ui_text(&self.home_exit_status).into() } else { self.home_exit_status.clone().into() },
            home_traffic_points,
            home_traffic_has_data: self
                .home_rate_samples
                .iter()
                .any(|(download, upload)| *download > 0.0 || *upload > 0.0),
            traffic_stream_status: if english { english_ui_text(&self.traffic_stream_status).into() } else { self.traffic_stream_status.clone().into() },
            stat_connections: self.connections.len().to_string().into(),
            connection_search: self.connection_search.clone().into(),
            connection_sort: self.connection_sort.clone().into(),
            connection_show_closed: self.connection_show_closed,
            connection_detail_id: selected_connection
                .as_ref()
                .map(|entry| entry.id.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_host: selected_connection
                .as_ref()
                .map(|entry| entry.host.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_protocol: selected_connection
                .as_ref()
                .map(|entry| entry.protocol.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_process: selected_connection
                .as_ref()
                .map(|entry| entry.process.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_source: selected_connection
                .as_ref()
                .map(|entry| entry.source.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_destination: selected_connection
                .as_ref()
                .map(|entry| entry.destination.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_rule: selected_connection
                .as_ref()
                .map(|entry| entry.rule.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_chains: selected_connection
                .as_ref()
                .map(|entry| entry.chains.as_str())
                .unwrap_or("核心未提供代理链")
                .into(),
            connection_detail_providers: selected_connection
                .as_ref()
                .map(|entry| entry.providers.as_str())
                .unwrap_or("核心未提供")
                .into(),
            connection_detail_start: selected_connection
                .as_ref()
                .map(|entry| entry.started_at.as_str())
                .unwrap_or_default()
                .into(),
            connection_detail_duration: selected_connection
                .as_ref()
                .map(ConnectionEntry::duration)
                .unwrap_or_default()
                .into(),
            connection_detail_upload: selected_connection
                .as_ref()
                .map(|entry| mihomo::format_bytes(entry.upload_bytes))
                .unwrap_or_default()
                .into(),
            connection_detail_download: selected_connection
                .as_ref()
                .map(|entry| mihomo::format_bytes(entry.download_bytes))
                .unwrap_or_default()
                .into(),
            connection_detail_active: selected_connection
                .as_ref()
                .is_some_and(|entry| entry.active),
            connection_breaking_id: self.connection_breaking_id.clone().into(),
            log_search: self.log_search.clone().into(),
            log_level: self.log_level.clone().into(),
            log_stream_status: self.log_stream_status.clone().into(),
            rule_search: self.rule_search.clone().into(),
            rule_pending_index: self.rule_pending_index.clone().into(),
            stat_total_down: self.total_down.clone().into(),
            stat_total_up: self.total_up.clone().into(),
            selected_group: self.selected_group.clone().into(),
            content_preview: self.content_preview.clone().into(),
            content_preview_profile: self.content_preview_profile.clone().into(),
            override_edit_id: self.edit_id.clone().into(),
            override_name: self.edit_name.clone().into(),
            override_body: self.edit_body.clone().into(),
            override_importing: self.override_importing,
            override_import_error: self.override_import_error.clone().into(),
            override_import_revision: self.override_import_revision,
            notice: if english { english_ui_text(&self.notice).into() } else { self.notice.clone().into() },
        };
        let _ = self.state_sender.try_send(state);
    }

    fn visible_connections(&self, closed: bool) -> Vec<ObservationRow> {
        let query = self.connection_search.trim().to_lowercase();
        let mut entries = if closed {
            self.closed_connections.iter().collect::<Vec<_>>()
        } else {
            self.connections.iter().collect::<Vec<_>>()
        };
        if !query.is_empty() {
            entries.retain(|entry| {
                entry.host.to_lowercase().contains(&query)
                    || entry.process.to_lowercase().contains(&query)
            });
        }
        entries.sort_by(|left, right| match self.connection_sort.as_str() {
            "上传" => right
                .upload_bytes
                .partial_cmp(&left.upload_bytes)
                .unwrap_or(std::cmp::Ordering::Equal),
            "下载" => right
                .download_bytes
                .partial_cmp(&left.download_bytes)
                .unwrap_or(std::cmp::Ordering::Equal),
            "主机" => left.host.to_lowercase().cmp(&right.host.to_lowercase()),
            _ => right.started_at_epoch_ms.cmp(&left.started_at_epoch_ms),
        });
        entries
            .into_iter()
            .take(MAX_CONNECTION_ROWS)
            .map(|entry| entry.row(closed))
            .collect()
    }

    fn find_connection(&self, id: &str) -> Option<&ConnectionEntry> {
        self.connections
            .iter()
            .find(|entry| entry.id == id)
            .or_else(|| self.closed_connections.iter().find(|entry| entry.id == id))
    }

    fn visible_rules(&self) -> Vec<ObservationRow> {
        let query = self.rule_search.trim().to_lowercase();
        self.rules
            .iter()
            .filter(|row| {
                query.is_empty()
                    || row.title.to_string().to_lowercase().contains(&query)
                    || row.subtitle.to_string().to_lowercase().contains(&query)
                    || row.trailing.to_string().to_lowercase().contains(&query)
            })
            .cloned()
            .collect()
    }

    fn visible_logs(&self) -> Vec<ObservationRow> {
        let query = self.log_search.trim().to_lowercase();
        self.logs
            .iter()
            .rev()
            .filter(|row| {
                let level = row.subtitle.to_string().to_ascii_lowercase();
                let matches_level = match self.log_level.as_str() {
                    "Debug" => level == "debug",
                    "Info" => level == "info",
                    "Warning" => level == "warning" || level == "warn",
                    "Error" => level == "error",
                    _ => true,
                };
                let matches_query = query.is_empty()
                    || row.title.to_string().to_lowercase().contains(&query)
                    || level.contains(&query)
                    || row.trailing.to_string().to_lowercase().contains(&query);
                matches_level && matches_query
            })
            .cloned()
            .collect()
    }

    fn tun_capability_detail(&self) -> String {
        if !platform::tun_platform_supported() {
            return if cfg!(target_os = "linux") {
                "Linux TUN 权限与路由恢复适配尚未实现".into()
            } else {
                "当前平台尚未接入 TUN 适配".into()
            };
        }
        if platform::tun_permission_available() {
            "当前 Lumen 已有管理员权限，可尝试启用 Windows TUN".into()
        } else {
            "需以管理员身份重新启动 Lumen；应用不会自动提升权限".into()
        }
    }

    fn network_mode_status(&self) -> String {
        match &self.store.network_mode {
            NetworkMode::SystemProxy => {
                if self.runtime.is_some() {
                    "Runtime 运行中；系统代理状态由平台适配器核对".into()
                } else if platform::tun_platform_supported() {
                    match (
                        platform::tun_interface_is_up("Lumen"),
                        platform::tun_default_routes_present("Lumen"),
                    ) {
                        (Ok(false), Ok(false)) => "Runtime 未运行".into(),
                        (Ok(true), Ok(_)) | (Ok(_), Ok(true)) => "Runtime 未运行，但检测到 Lumen TUN 网卡或默认路由仍活动；请在 Windows 网络设置中恢复".into(),
                        _ => "Runtime 未运行；无法确认是否存在残留 TUN 路由".into(),
                    }
                } else {
                    "Runtime 未运行".into()
                }
            }
            NetworkMode::Tun => {
                if let Some(session) = self.runtime.as_ref() {
                    return match (
                        platform::tun_interface_is_up(&session.tun_device),
                        platform::tun_default_routes_present(&session.tun_device),
                    ) {
                        (Ok(true), Ok(true)) => "Windows Lumen TUN 网卡和默认路由均已确认".into(),
                        (Ok(false), Ok(true)) => {
                            "Lumen TUN 网卡未活动，但默认路由仍存在；请检查恢复状态".into()
                        }
                        (Ok(true), Ok(false)) => "Lumen TUN 网卡活动，但默认路由未确认".into(),
                        (Ok(false), Ok(false)) => "Runtime 运行中，但 TUN 接管未生效".into(),
                        _ => "无法读取 Windows TUN 网卡或路由状态".into(),
                    };
                }
                match (
                    platform::tun_interface_is_up("Lumen"),
                    platform::tun_default_routes_present("Lumen"),
                ) {
                    (Ok(false), Ok(false)) => "Runtime 未运行；TUN 网卡和默认路由均已停止".into(),
                    (Ok(true), Ok(_)) | (Ok(_), Ok(true)) => "Runtime 未运行，但 Lumen TUN 网卡或默认路由仍活动；请在 Windows 网络设置中恢复".into(),
                    _ => "当前平台未验证 TUN 状态".into(),
                }
            }
            NetworkMode::Vpn => {
                if self.runtime.is_some() {
                    "Android VPN 隧道与 Mihomo 控制接口均已确认".into()
                } else if self.core_version.starts_with("核心不可用") {
                    "Mihomo 核心不可用；请重新安装当前 ABI 的 Lumen APK".into()
                } else {
                    "Runtime 未运行；启动时请求 Android VPN 授权".into()
                }
            }
        }
    }

    fn is_english_ui(&self) -> bool {
        self.store.application_language == "en"
            || (self.store.application_language == "system"
                && if cfg!(target_os = "android") {
                    self.android_system_language == "en"
                } else {
                    system_language_from_environment() == "en"
                })
    }

    fn set_notice(&mut self, value: impl Into<String>) {
        let value = value.into();
        self.notice = if self.is_english_ui() { english_ui_text(&value) } else { value };
        self.publish();
    }

    fn save_user_agent(&mut self, value: String) {
        self.user_agent_result_revision = self.user_agent_result_revision.wrapping_add(1);
        let value = value.trim().to_string();
        if value.len() > 512 {
            self.set_notice("User-Agent 最多 512 字节");
            return;
        }
        if !value.is_empty() && reqwest::header::HeaderValue::from_str(&value).is_err() {
            self.set_notice("User-Agent 格式无效；请删除换行或控制字符");
            return;
        }
        let previous = self.store.user_agent.clone();
        self.store.user_agent = value;
        if let Err(error) = self.persist_store() {
            self.store.user_agent = previous;
            self.set_notice(format!("无法保存 User-Agent：{error}"));
            return;
        }
        self.user_agent_save_revision = self.user_agent_save_revision.wrapping_add(1);
        self.set_notice(if self.store.user_agent.is_empty() {
            "已恢复默认 User-Agent：Lumen/0.1.0"
        } else {
            "订阅 User-Agent 已保存；后续请求将使用新值"
        });
    }

    fn set_refresh_profile_on_start(&mut self, enabled: bool) {
        let previous = self.store.refresh_current_profile_on_start;
        self.store.refresh_current_profile_on_start = enabled;
        if let Err(error) = self.persist_store() {
            self.store.refresh_current_profile_on_start = previous;
            self.set_notice(format!("无法保存启动时更新设置：{error}"));
            return;
        }
        self.set_notice(if enabled {
            "已启用启动时更新当前订阅 Profile；本地文件不会联网更新"
        } else {
            "已关闭启动时更新当前 Profile"
        });
    }

    fn set_theme_foreground_inverted(&mut self, enabled: bool) {
        let previous = self.store.invert_theme_foreground;
        self.store.invert_theme_foreground = enabled;
        if let Err(error) = self.persist_store() {
            self.store.invert_theme_foreground = previous;
            self.set_notice(format!("无法保存前景色设置：{error}"));
            return;
        }
        self.set_notice(if enabled { "已反转主题文字层级颜色" } else { "已恢复默认主题文字颜色" });
    }

    fn preview_theme_color(&mut self, hue: f32, saturation: f32, value: f32) {
        let color = hsv_to_theme_color(hue, saturation, value);
        self.preview_theme_color = Some(color);
        self.publish();
    }

    fn cancel_theme_color_preview(&mut self) {
        if self.preview_theme_color.take().is_some() {
            self.publish();
        }
    }

    fn set_theme_color(&mut self, value: &str) {
        self.theme_color_result_revision = self.theme_color_result_revision.wrapping_add(1);
        let Some(rgb) = parse_theme_color(value) else {
            self.preview_theme_color = None;
            self.set_notice("颜色格式无效；请输入 #RRGGBB 或 ##RRGGBB 六位十六进制颜色");
            return;
        };
        let normalized = format!("#{:02X}{:02X}{:02X}", rgb[0], rgb[1], rgb[2]);
        let previous = std::mem::replace(&mut self.store.theme_color, normalized.clone());
        if let Err(error) = self.persist_store() {
            self.store.theme_color = previous;
            self.preview_theme_color = None;
            self.set_notice(format!("无法保存主题色：{error}"));
            return;
        }
        self.preview_theme_color = None;
        self.theme_color_save_revision = self.theme_color_save_revision.wrapping_add(1);
        self.set_notice(format!("主题色已设为 {normalized}"));
    }

    async fn set_application_language(&mut self, language: &str) {
        let normalized = match language {
            "system" => "system",
            "zh-CN" | "zh" => "zh-CN",
            "en" | "en-US" | "en-GB" => "en",
            _ => {
                self.set_notice("不支持的应用语言");
                return;
            }
        };
        let previous = self.store.application_language.clone();
        #[cfg(target_os = "android")]
        if let Err(error) = platform::set_android_application_language_preference(normalized.into()).await {
            self.set_notice(format!("无法保存应用语言：{error}"));
            return;
        }
        self.store.application_language = normalized.into();
        if let Err(error) = self.persist_store() {
            self.store.application_language = previous;
            #[cfg(target_os = "android")]
            let _ = platform::set_android_application_language_preference(self.store.application_language.clone()).await;
            self.set_notice(format!("无法保存应用语言：{error}"));
            return;
        }
        let language = if normalized == "system" {
            self.android_system_language.as_str()
        } else {
            normalized
        };
        if language == "en" {
            self.set_notice("Application language set to English");
        } else {
            self.set_notice("应用语言已设为简体中文");
        }
    }

    fn set_page_scale(&mut self, percent: i32) {
        let percent = (percent.clamp(85, 115) / 5) * 5;
        let previous = self.store.page_scale_percent;
        self.store.page_scale_percent = percent;
        if let Err(error) = self.persist_store() {
            self.store.page_scale_percent = previous;
            self.set_notice(format!("无法保存页面缩放：{error}"));
            return;
        }
        self.set_notice(format!("界面缩放已设为 {percent}%"));
    }

    fn set_hide_bottom_bar_on_scroll(&mut self, enabled: bool) {
        let previous = self.store.hide_bottom_bar_on_scroll;
        self.store.hide_bottom_bar_on_scroll = enabled;
        if let Err(error) = self.persist_store() {
            self.store.hide_bottom_bar_on_scroll = previous;
            self.set_notice(format!("无法保存底栏设置：{error}"));
            return;
        }
        self.set_notice(if enabled { "向下滚动列表时隐藏导航底栏，向上滚动可恢复" } else { "已关闭滑动隐藏导航底栏" });
    }

    fn set_release_ui_when_background(&mut self, enabled: bool) {
        let previous = self.store.release_ui_when_background;
        self.store.release_ui_when_background = enabled;
        if let Err(error) = self.persist_store() {
            self.store.release_ui_when_background = previous;
            self.set_notice(format!("无法保存后台轻量模式：{error}"));
            return;
        }
        self.set_notice(if enabled { "后台时暂停高频界面采样；VPN 和 Mihomo 保持运行" } else { "已关闭后台轻量模式" });
    }

    async fn set_android_hide_background_card(&mut self, enabled: bool) {
        if !cfg!(target_os = "android") {
            self.set_notice("此设置仅适用于 Android");
            return;
        }
        #[cfg(target_os = "android")]
        if let Err(error) = platform::set_android_hide_background_card(enabled).await {
            self.set_notice(format!("无法修改 Android 后台卡片：{error}"));
            return;
        }
        let previous = self.store.hide_background_card;
        self.store.hide_background_card = enabled;
        if let Err(error) = self.persist_store() {
            self.store.hide_background_card = previous;
            #[cfg(target_os = "android")]
            let _ = platform::set_android_hide_background_card(previous).await;
            self.set_notice(format!("无法保存后台卡片设置：{error}"));
            return;
        }
        self.set_notice(if enabled { "已隐藏 Android 最近任务中的应用卡片" } else { "已显示 Android 最近任务中的应用卡片" });
    }

    async fn set_traffic_notification(&mut self, enabled: bool) {
        if !cfg!(target_os = "android") {
            self.set_notice("流量通知仅适用于 Android");
            return;
        }
        #[cfg(target_os = "android")]
        if enabled {
            match platform::request_android_notification_permission().await {
                Ok(true) => self.android_notification_permission_granted = true,
                Ok(false) => {
                    self.set_notice("需要允许 Lumen 通知权限，才能在通知栏显示流量速率");
                    return;
                }
                Err(error) => {
                    self.set_notice(format!("无法请求 Android 通知权限：{error}"));
                    return;
                }
            }
        }
        let previous = self.store.show_traffic_notification;
        self.store.show_traffic_notification = enabled;
        if let Err(error) = self.persist_store() {
            self.store.show_traffic_notification = previous;
            self.set_notice(format!("无法保存流量通知设置：{error}"));
            return;
        }
        self.set_notice(if enabled { "已启用通知中的实时上下行速率" } else { "已关闭流量速率通知" });
    }

    async fn request_ignore_battery_optimizations(&mut self) {
        #[cfg(target_os = "android")]
        match platform::request_android_ignore_battery_optimizations().await {
            Ok(()) => self.set_notice("请在 Android 系统页面确认电池优化策略；返回后会读取实际状态"),
            Err(error) => self.set_notice(format!("无法打开 Android 电池设置：{error}")),
        }
        #[cfg(not(target_os = "android"))]
        self.set_notice("电池优化设置仅适用于 Android");
    }

    async fn set_auto_start(&mut self, enabled: bool) {
        #[cfg(target_os = "android")]
        if enabled && !self.android_notification_permission_granted {
            match platform::request_android_notification_permission().await {
                Ok(true) => self.android_notification_permission_granted = true,
                Ok(false) => {
                    self.set_notice("Android 开机通知需要通知权限；自动启动保持关闭");
                    return;
                }
                Err(error) => {
                    self.set_notice(format!("无法启用 Android 开机通知：{error}"));
                    return;
                }
            }
        }
        let previous = self.store.auto_start;
        if let Err(error) = platform::set_autostart(enabled) {
            self.set_notice(format!("无法修改登录自动启动：{error}"));
            return;
        }
        self.store.auto_start = enabled;
        if let Err(error) = self.persist_store() {
            self.store.auto_start = previous;
            let recovery = platform::set_autostart(previous)
                .err()
                .map(|rollback| format!("系统启动项回滚失败：{rollback}。请手动检查登录启动设置"))
                .unwrap_or_else(|| "系统启动项已回滚".into());
            self.set_notice(format!("无法保存自动启动偏好：{error}；{recovery}"));
            return;
        }
        self.set_notice(if cfg!(target_os = "android") {
            if enabled { "已启用 Android 开机通知；点按通知后打开 Lumen" } else { "已关闭 Android 开机通知" }
        } else if enabled {
            "已启用当前用户登录后启动 Lumen"
        } else {
            "已关闭当前用户登录后启动 Lumen"
        });
    }

    fn set_theme_mode(&mut self, mode: &str) {
        let next = match mode.to_ascii_lowercase().as_str() {
            "system" => ThemeMode::System,
            "light" => ThemeMode::Light,
            "dark" => ThemeMode::Dark,
            _ => {
                self.set_notice("不支持的主题模式");
                return;
            }
        };
        let previous = self.store.theme_mode.clone();
        self.store.theme_mode = next.clone();
        if let Err(error) = self.persist_store() {
            self.store.theme_mode = previous;
            self.set_notice(format!("无法保存主题模式：{error}"));
            return;
        }
        let label = match next {
            ThemeMode::System => "跟随系统",
            ThemeMode::Light => "浅色",
            ThemeMode::Dark => "深色",
        };
        self.set_notice(format!("主题模式已设为{label}"));
    }

    fn record_traffic_totals(&mut self, up_total: u64, down_total: u64) {
        let previous = self.traffic_last_totals.replace((up_total, down_total));
        let Some((previous_up, previous_down)) = previous else {
            return;
        };
        let up_delta = if up_total >= previous_up {
            up_total - previous_up
        } else {
            up_total
        };
        let down_delta = if down_total >= previous_down {
            down_total - previous_down
        } else {
            down_total
        };
        if up_delta == 0 && down_delta == 0 {
            return;
        }

        let now = Local::now();
        let today = now.date_naive();
        let day = today.format("%Y-%m-%d").to_string();
        let hour = now.hour() as u8;
        {
            let buckets = &mut self.store.traffic_buckets;
            if let Some(bucket) = buckets
                .iter_mut()
                .find(|bucket| bucket.day == day && bucket.hour == hour)
            {
                bucket.download_bytes = bucket.download_bytes.saturating_add(down_delta);
                bucket.upload_bytes = bucket.upload_bytes.saturating_add(up_delta);
            } else {
                buckets.push(TrafficUsageBucket {
                    day,
                    hour,
                    download_bytes: down_delta,
                    upload_bytes: up_delta,
                });
            }
            prune_traffic_buckets(buckets, today);
        }
        self.traffic_history_dirty = true;
        self.maybe_persist_traffic_history(false);
    }

    fn maybe_persist_traffic_history(&mut self, force: bool) {
        if !self.traffic_history_dirty
            || (!force && self.traffic_history_last_save.elapsed() < TRAFFIC_HISTORY_SAVE_INTERVAL)
        {
            return;
        }
        self.traffic_history_last_save = Instant::now();
        match self.persist_store() {
            Ok(()) => {
                self.traffic_history_dirty = false;
                if let Some(index) = self
                    .notice
                    .find("流量统计保存失败，仍保留内存数据并将重试：")
                {
                    self.notice = self.notice[..index].trim_end_matches('；').to_string();
                }
            }
            Err(error) => {
                let failure = format!("流量统计保存失败，仍保留内存数据并将重试：{error}");
                if !self
                    .notice
                    .contains("流量统计保存失败，仍保留内存数据并将重试：")
                {
                    self.notice = if self.notice.is_empty() {
                        failure
                    } else {
                        format!("{}；{failure}", self.notice)
                    };
                }
            }
        }
    }

    fn clear_traffic_history(&mut self) {
        if self.store.traffic_buckets.is_empty() {
            self.set_notice("当前没有可清空的流量统计");
            return;
        }
        let previous = std::mem::take(&mut self.store.traffic_buckets);
        let was_dirty = self.traffic_history_dirty;
        self.traffic_history_dirty = false;
        match self.persist_store() {
            Ok(()) => {
                self.traffic_history_last_save = Instant::now();
                self.set_notice("已清空本地流量统计");
            }
            Err(error) => {
                self.store.traffic_buckets = previous;
                self.traffic_history_dirty = was_dirty;
                self.set_notice(format!("无法清空流量统计，原数据已保留：{error}"));
            }
        }
    }

    async fn handle(&mut self, command: UiCommand) {
        match command {
            UiCommand::AddUrlProfile {
                name,
                url,
                age_private_key,
            } => self.add_url_profile(name, url, age_private_key).await,
            UiCommand::ChooseProfileFile { name, age_private_key } => {
                self.choose_profile_file(name, age_private_key).await
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidProfileFilePicked {
                display_name,
                contents,
            } => {
                self.import_android_profile_file(display_name, contents)
                    .await
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidProfileFileReading => self.set_notice("正在读取所选配置文件…"),
            #[cfg(target_os = "android")]
            UiCommand::AndroidProfileFileFailed(reason) => {
                self.pending_profile_name.clear();
                self.pending_profile_age_key.clear();
                self.set_notice(reason);
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidProfileFileCancelled => {
                self.pending_profile_name.clear();
                self.pending_profile_age_key.clear();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidOverrideFilePicked {
                display_name,
                contents,
            } => {
                self.import_android_override_file(display_name, contents)
                    .await;
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidOverrideFileReading => {
                self.override_importing = true;
                self.override_import_error.clear();
                self.set_notice("正在读取 Override YAML 文件…");
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidOverrideFileFailed(reason) => {
                self.override_importing = false;
                self.override_import_error = reason.clone().into();
                self.set_notice(reason);
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidOverrideFileCancelled => {
                self.override_importing = false;
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidExportDocumentSelected(uri) => {
                let Some(contents) = self.android_export_contents.take() else {
                    self.android_export_success_notice.clear();
                    self.set_notice("没有待导出的文件内容");
                    return;
                };
                if let Err(error) = platform::write_android_document(&uri, &contents) {
                    self.android_export_success_notice.clear();
                    self.set_notice(format!("无法写入所选 Android 文档：{error}"));
                } else {
                    self.set_notice("正在导出文件…");
                }
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidExportDocumentCompleted => {
                self.android_export_contents = None;
                let notice = std::mem::take(&mut self.android_export_success_notice);
                self.set_notice(if notice.is_empty() {
                    "文件已导出".into()
                } else {
                    notice
                });
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidExportDocumentFailed(reason) => {
                self.android_export_contents = None;
                self.android_export_success_notice.clear();
                self.set_notice(reason);
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidExportDocumentCancelled => {
                self.android_export_contents = None;
                self.android_export_success_notice.clear();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidBackPressed => {
                self.android_back_gesture_progress = 0.0;
                self.android_back_gesture_active = false;
                self.back_request_revision = self.back_request_revision.wrapping_add(1).max(1);
                self.publish();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidBackGestureProgress(progress) => {
                self.android_back_gesture_progress = progress.clamp(0.0, 1.0);
                self.android_back_gesture_active = self.store.predictive_back_enabled;
                self.publish();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidBackGestureCancelled => {
                self.android_back_gesture_progress = 0.0;
                self.android_back_gesture_active = false;
                self.publish();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidActivityVisibility(visible) => {
                let became_visible = visible && !self.android_activity_visible;
                self.android_activity_visible = visible;
                if became_visible && self.store.release_ui_when_background && self.runtime.is_some() {
                    self.refresh_observations().await;
                } else {
                    self.publish();
                }
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidSystemSettingsChanged {
                notification_permission_granted,
                ignore_battery_optimizations,
                system_language,
                api_level,
            } => {
                self.android_notification_permission_granted = notification_permission_granted;
                self.android_ignore_battery_optimizations = ignore_battery_optimizations;
                self.android_api_level = api_level;
                self.android_system_language = if system_language.to_ascii_lowercase().starts_with("en") { "en" } else { "zh-CN" }.into();
                if let Err(error) = platform::set_android_application_language_preference(self.store.application_language.clone()).await {
                    self.notice = format!("无法同步 Android 通知语言：{error}");
                }
                if self.store.ignore_battery_optimizations != ignore_battery_optimizations {
                    self.store.ignore_battery_optimizations = ignore_battery_optimizations;
                    if let Err(error) = self.persist_store() {
                        self.notice = format!("无法保存 Android 电池优化实际状态：{error}");
                    }
                }
                if api_level >= 26 {
                    let _ = platform::set_android_hide_background_card(self.store.hide_background_card).await;
                }
                if api_level >= 34 {
                    let _ = platform::set_android_predictive_back_enabled(self.store.predictive_back_enabled).await;
                }
                if self.store.show_traffic_notification && !notification_permission_granted {
                    self.store.show_traffic_notification = false;
                    let _ = self.persist_store();
                    self.notice = "通知权限已关闭，流量速率通知已停用".into();
                }
                self.publish();
            }
            #[cfg(target_os = "android")]
            UiCommand::AndroidVpnDisconnected(reason) => {
                if self.runtime.is_some() {
                    if self.stop_runtime_inner().await {
                        self.set_notice(reason);
                    }
                } else {
                    self.set_notice(reason);
                }
            }
            UiCommand::SetCurrentProfile(id) => self.set_current_profile(&id).await,
            UiCommand::MoveProfile { id, up } => self.move_profile(&id, up),
            UiCommand::DeleteProfile(id) => self.delete_profile(&id).await,
            UiCommand::RefreshProfile(id) => self.refresh_profile(&id).await,
            UiCommand::ShowPreview(id) => self.show_preview(&id),
            UiCommand::StartRuntime => self.start_runtime().await,
            UiCommand::StopRuntime => self.stop_runtime().await,
            UiCommand::SetRouteMode(mode) => self.set_route_mode(&mode).await,
            UiCommand::SetNetworkMode(mode) => self.set_network_mode(&mode).await,
            UiCommand::CheckCore => self.check_core().await,
            UiCommand::OpenProfileSettings(id) => self.open_profile_settings(&id),
            UiCommand::SaveProfileSettings {
                id,
                name,
                url,
                age_private_key,
            } => {
                self.save_profile_settings(&id, name, url, age_private_key)
                    .await
            }
            UiCommand::CancelProfileSettings => self.cancel_profile_settings(),
            UiCommand::ToggleProfileOverride { id, selected } => {
                self.toggle_profile_override(&id, selected)
            }
            UiCommand::MoveProfileOverride { id, up } => self.move_profile_override(&id, up),
            UiCommand::AddOverride { name, content } => self.add_override(name, content),
            UiCommand::ImportOverrideUrl(url) => self.import_override_url(&url).await,
            UiCommand::ChooseOverrideFile => self.choose_override_file().await,
            UiCommand::ExportProfile(id) => self.export_profile(&id),
            UiCommand::ExportOverride(id) => self.export_override(&id),
            UiCommand::SaveOverride { id, content } => self.save_override(&id, content).await,
            UiCommand::EditOverride(id) => self.edit_override(&id),
            UiCommand::DeleteOverride(id) => self.delete_override(&id),
            UiCommand::ApplyOverride(id) => self.apply_override(&id).await,
            UiCommand::SelectProxyGroup(name) => self.select_proxy_group(&name),
            UiCommand::SearchProxyNodes(query) => {
                self.proxy_search = query.chars().take(256).collect();
                if let Some(value) = self.cached_proxies.clone() {
                    self.update_proxies(value);
                } else {
                    self.refresh_proxy_catalog_from_current_profile();
                }
                self.publish();
            }
            UiCommand::SetProxySort(sort) => {
                if matches!(sort.as_str(), "默认顺序" | "按名称排序" | "按延迟排序") {
                    self.proxy_sort_mode = sort;
                    if let Some(value) = self.cached_proxies.clone() {
                        self.update_proxies(value);
                    } else {
                        self.refresh_proxy_catalog_from_current_profile();
                    }
                    self.publish();
                }
            }
            UiCommand::SelectProxy { group, node } => self.select_proxy(&group, &node).await,
            UiCommand::TestProxy { group, node } => self.test_proxy(&group, &node).await,
            UiCommand::RefreshHomeEgress => self.request_home_egress(true),
            UiCommand::CloseConnection(id) => self.close_connection(&id).await,
            UiCommand::OpenConnection(id) => {
                if self.find_connection(&id).is_some() {
                    self.selected_connection_id = id;
                } else {
                    self.selected_connection_id.clear();
                }
                self.publish();
            }
            UiCommand::SearchConnections(query) => {
                self.connection_search = query;
                self.publish();
            }
            UiCommand::SetConnectionView(show_closed) => {
                self.connection_show_closed = show_closed;
                self.publish();
            }
            UiCommand::SetConnectionSort(sort) => {
                if matches!(sort.as_str(), "时间" | "上传" | "下载" | "主机") {
                    self.connection_sort = sort;
                }
                self.publish();
            }
            UiCommand::SearchLogs(query) => {
                self.log_search = query;
                self.publish();
            }
            UiCommand::SetLogLevel(level) => {
                if matches!(
                    level.as_str(),
                    "全部" | "Debug" | "Info" | "Warning" | "Error"
                ) {
                    self.log_level = level;
                }
                self.publish();
            }
            UiCommand::SearchRules(query) => {
                self.rule_search = query;
                self.publish();
            }
            UiCommand::SetRuleEnabled { index, enabled } => {
                self.set_rule_enabled(&index, enabled).await
            }
            UiCommand::UpdateProvider(name) => self.update_provider(&name).await,
            UiCommand::RetryProxyRestore => self.retry_proxy_restore().await,
            UiCommand::ExportLogs => self.export_logs(),
            UiCommand::RefreshObservations => self.refresh_observations().await,
            UiCommand::SaveUserAgent(value) => self.save_user_agent(value),
            UiCommand::SetThemeForegroundInverted(enabled) => self.set_theme_foreground_inverted(enabled),
            UiCommand::PreviewThemeColor(hue, saturation, value) => self.preview_theme_color(hue, saturation, value),
            UiCommand::CancelThemeColorPreview => self.cancel_theme_color_preview(),
            UiCommand::SetThemeColor(color) => self.set_theme_color(&color),
            UiCommand::SetApplicationLanguage(language) => self.set_application_language(&language).await,
            UiCommand::SetPageScale(percent) => self.set_page_scale(percent),
            UiCommand::SetHideBottomBarOnScroll(enabled) => self.set_hide_bottom_bar_on_scroll(enabled),
            UiCommand::SetPredictiveBackEnabled(enabled) => {
                #[cfg(target_os = "android")]
                {
                    if self.android_api_level < 34 {
                        self.set_notice("系统手势预览需要 Android 14 或更高版本");
                    } else if let Err(error) = platform::set_android_predictive_back_enabled(enabled).await {
                        self.set_notice(format!("无法设置 Android 预测返回：{error}"));
                    } else {
                        let previous = self.store.predictive_back_enabled;
                        self.store.predictive_back_enabled = enabled;
                        if let Err(error) = self.persist_store() {
                            self.store.predictive_back_enabled = previous;
                            let _ = platform::set_android_predictive_back_enabled(previous).await;
                            self.set_notice(format!("无法保存预测返回设置：{error}"));
                        } else {
                            self.set_notice(if enabled { "已启用 Android 预测返回手势" } else { "已关闭 Android 预测返回手势" });
                        }
                    }
                }
                #[cfg(not(target_os = "android"))]
                {
                    let _ = enabled;
                    self.set_notice("预测返回手势仅适用于 Android");
                }
            }
            UiCommand::SetHideBackgroundCard(enabled) => self.set_android_hide_background_card(enabled).await,
            UiCommand::SetShowTrafficNotification(enabled) => self.set_traffic_notification(enabled).await,
            UiCommand::SetReleaseUiWhenBackground(enabled) => self.set_release_ui_when_background(enabled),
            UiCommand::SetIgnoreBatteryOptimizations => self.request_ignore_battery_optimizations().await,
            UiCommand::SetRefreshProfileOnStart(enabled) => {
                self.set_refresh_profile_on_start(enabled)
            }
            UiCommand::SetAutoStart(enabled) => self.set_auto_start(enabled).await,
            UiCommand::SetThemeMode(mode) => self.set_theme_mode(&mode),
            #[cfg(target_os = "android")]
            UiCommand::SetSystemDarkMode(dark) => {
                if self.system_dark_mode != dark {
                    self.system_dark_mode = dark;
                    self.publish();
                }
            }
            UiCommand::ClearTrafficHistory => self.clear_traffic_history(),
            UiCommand::SearchLicenses(query) => {
                self.license_query = query.chars().take(256).collect();
                self.refresh_license_rows();
                self.publish();
            }
            UiCommand::OpenLicense(id) => {
                self.selected_license_id = id;
                self.refresh_license_detail();
                self.publish();
            }
            UiCommand::RetryLicenseCatalog => {
                match LicenseCatalog::load_embedded() {
                    Ok(catalog) => {
                        self.license_catalog = Some(catalog);
                        self.license_catalog_error.clear();
                        self.refresh_license_rows();
                        self.refresh_license_detail();
                    }
                    Err(error) => {
                        self.license_catalog_error = error.to_string();
                        self.license_detail_revision =
                            self.license_detail_revision.wrapping_add(1).max(1);
                    }
                }
                self.publish();
            }
        }
    }

    fn handle_event(&mut self, event: RuntimeEvent) {
        if self.runtime.is_none() {
            return;
        }
        match event {
            RuntimeEvent::Log {
                time,
                level,
                message,
            } => {
                self.logs.push_back(row("", time, level, message));
                while self.logs.len() > MAX_LOG_ROWS {
                    self.logs.pop_front();
                }
            }
            RuntimeEvent::Traffic {
                stream_id,
                up,
                down,
                up_total,
                down_total,
            } => {
                if self.traffic_stream_id.as_deref() != Some(stream_id.as_str()) {
                    return;
                }
                self.record_traffic_totals(up_total, down_total);
                self.traffic_stream_status = "已连接".into();
                self.up_rate = format!("{}/s", mihomo::format_bytes(up));
                self.down_rate = format!("{}/s", mihomo::format_bytes(down));
                self.home_rate_samples
                    .push_back((down.max(0.0), up.max(0.0)));
                while self.home_rate_samples.len() > 48 {
                    self.home_rate_samples.pop_front();
                }
                self.total_up = mihomo::format_bytes(up_total as f64);
                self.total_down = mihomo::format_bytes(down_total as f64);
                let now = Utc::now().format("%H:%M:%S").to_string();
                self.traffic_samples.push_back(row(
                    "",
                    now,
                    format!("下载 {} / 上传 {}", self.down_rate, self.up_rate),
                    format!("累计 ↓ {} ↑ {}", self.total_down, self.total_up),
                ));
                while self.traffic_samples.len() > MAX_TRAFFIC_ROWS {
                    self.traffic_samples.pop_front();
                }
            }
            RuntimeEvent::StreamDisconnected(stream_id) => {
                if self.traffic_stream_id.as_deref() != Some(stream_id.as_str()) {
                    return;
                }
                self.traffic_stream_status = "正在重连".into();
                self.down_rate = "0 B/s".into();
                self.up_rate = "0 B/s".into();
                self.home_rate_samples.push_back((0.0, 0.0));
                while self.home_rate_samples.len() > 48 {
                    self.home_rate_samples.pop_front();
                }
                self.notice = "Mihomo 实时流已断开，正在重连".into();
            }
            RuntimeEvent::HomeEgress { generation, result } => {
                if generation != self.home_egress_generation {
                    return;
                }
                self.home_egress_pending = false;
                self.home_egress_last_probe = Some(Instant::now());
                match result {
                    Ok((ip, country_code)) => {
                        self.home_exit_ip = ip;
                        self.home_exit_flag_index =
                            crate::flag_assets::index_for_code(&country_code.to_ascii_lowercase())
                                .unwrap_or(-1);
                        self.home_exit_country_code = country_code.to_ascii_uppercase();
                        self.home_exit_status = "已更新".into();
                    }
                    Err(_) => {
                        self.home_exit_ip = "—".into();
                        self.home_exit_country_code.clear();
                        self.home_exit_flag_index = -1;
                        self.home_exit_status = "暂不可用".into();
                    }
                }
                self.publish();
            }
            RuntimeEvent::LogStreamStatus(connected) => {
                self.log_stream_status = if connected {
                    "已连接".into()
                } else {
                    "正在重连".into()
                };
            }
        }
        self.publish();
    }

    async fn tick(&mut self) {
        self.ticks = self.ticks.wrapping_add(1);
        #[cfg(not(target_os = "android"))]
        if matches!(&self.store.theme_mode, ThemeMode::System) && self.ticks % 67 == 0 {
            let system_dark_mode = tokio::task::spawn_blocking(platform::system_dark_mode)
                .await
                .unwrap_or(self.system_dark_mode);
            if self.system_dark_mode != system_dark_mode {
                self.system_dark_mode = system_dark_mode;
                self.publish();
            }
        }
        let previous_notice = self.notice.clone();
        self.maybe_persist_traffic_history(false);
        if self.notice != previous_notice {
            self.publish();
        }
        let Some(session) = self.runtime.as_mut() else {
            return;
        };
        let process_state = session.child.try_wait();
        match process_state {
            Ok(Some(status)) => {
                let network_mode = self
                    .runtime
                    .as_ref()
                    .map(|session| session.network_mode.clone())
                    .unwrap_or(NetworkMode::SystemProxy);
                let recovery = if network_mode == NetworkMode::SystemProxy {
                    platform::restore_system_proxy(
                        &self.paths.root.join("system-proxy-recovery.json"),
                    )
                    .await
                } else {
                    Ok(false)
                };
                let tun_state = if network_mode == NetworkMode::Tun {
                    match (
                        platform::tun_interface_is_up("Lumen"),
                        platform::tun_default_routes_present("Lumen"),
                    ) {
                        (Ok(interface_up), Ok(routes_present)) => {
                            Ok((interface_up, routes_present))
                        }
                        (Err(error), _) | (_, Err(error)) => Err(error),
                    }
                } else {
                    Ok((false, false))
                };
                if let Some(session) = self.runtime.as_mut() {
                    let _ = std::fs::remove_file(&session.candidate_file);
                    for task in session.stream_tasks.drain(..) {
                        task.abort();
                    }
                }
                self.runtime = None;
                self.runtime_transition.clear();
                self.proxy_external_change_seen = false;
                self.reset_home_runtime_data();
                self.notice = match network_mode {
                    NetworkMode::SystemProxy => match recovery {
                        Ok(true) => format!(
                            "Mihomo 已退出（退出码 {:?}）；检测到系统代理外部修改并已保留",
                            status.code()
                        ),
                        Ok(false) => format!(
                            "Mihomo 已退出（退出码 {:?}）；已恢复系统代理",
                            status.code()
                        ),
                        Err(error) => {
                            self.proxy_recovery_blocked = true;
                            format!(
                                "Mihomo 已退出（退出码 {:?}）；系统代理恢复失败：{error}。请先恢复代理再启动。",
                                status.code()
                            )
                        }
                    },
                    NetworkMode::Tun => match tun_state {
                        Ok((false, false)) => format!(
                            "Mihomo 已退出（退出码 {:?}）；Windows TUN 网卡已停止",
                            status.code()
                        ),
                        Ok((true, _)) | Ok((_, true)) => format!(
                            "Mihomo 已退出（退出码 {:?}），但 Lumen TUN 网卡或默认路由仍活动；请在 Windows 网络设置中恢复后再启动",
                            status.code()
                        ),
                        Err(error) => format!(
                            "Mihomo 已退出（退出码 {:?}）；无法确认 TUN 网卡是否已恢复：{error}",
                            status.code()
                        ),
                    },
                    NetworkMode::Vpn => format!("Mihomo 已退出（退出码 {:?}）", status.code()),
                };
                self.clear_observations();
                self.maybe_persist_traffic_history(true);
                self.publish();
                return;
            }
            Err(_) => {
                self.notice = "无法读取 Mihomo 进程状态".into();
                self.publish();
                return;
            }
            _ => {}
        }
        let tun_status = self
            .runtime
            .as_ref()
            .filter(|session| session.network_mode == NetworkMode::Tun)
            .map(|session| (session.tun_device.clone(), session.tun_active));
        if self.ticks % 2 == 0
            && let Some((device, previous_active)) = tun_status
        {
            let state = match (
                platform::tun_interface_is_up(&device),
                platform::tun_default_routes_present(&device),
            ) {
                (Ok(interface_up), Ok(routes_present)) => Ok(interface_up && routes_present),
                (Err(error), _) | (_, Err(error)) => Err(error),
            };
            match state {
                Ok(active) if active != previous_active => {
                    if let Some(session) = self.runtime.as_mut() {
                        session.tun_active = active;
                    }
                    self.notice = if active {
                        "Windows TUN 网卡已恢复活动".into()
                    } else {
                        "Windows TUN 网卡已断开；请检查网络适配器和 Mihomo 日志".into()
                    };
                    self.publish();
                }
                Err(error) => {
                    self.notice = format!("无法确认 Windows TUN 网卡状态：{error}");
                    self.publish();
                }
                _ => {}
            }
        }
        if self.runtime.is_some() && self.ticks % 4 == 0 && !self.proxy_external_change_seen {
            let lease = self
                .runtime
                .as_ref()
                .and_then(|session| session.proxy_lease.clone());
            if let Some(lease) = lease {
                match platform::verify_system_proxy_lease(&lease).await {
                    Ok(true) => {}
                    Ok(false) => {
                        self.proxy_external_change_seen = true;
                        self.notice = "检测到系统代理被外部修改；当前状态已保留，停止 Runtime 时不会覆盖新设置".into();
                        self.publish();
                    }
                    Err(_) => {
                        self.proxy_external_change_seen = true;
                        self.notice =
                            "无法确认系统代理当前状态；请在网络设置核对后再停止 Runtime".into();
                        self.publish();
                    }
                }
            }
        }
        if self.runtime.is_some()
            && self.ticks % 2 == 0
            && (self.android_activity_visible || !self.store.release_ui_when_background)
        {
            self.refresh_observations().await;
        }
        #[cfg(target_os = "android")]
        if self.ticks % 2 == 0 && self.runtime.is_some() {
            platform::update_android_traffic_notification(
                self.store.show_traffic_notification,
                &self.down_rate,
                &self.up_rate,
                self.is_english_ui(),
            );
        }
        if self.runtime.is_some()
            && !self.home_egress_pending
            && self
                .home_egress_last_probe
                .is_none_or(|last| last.elapsed() >= Duration::from_secs(300))
        {
            self.request_home_egress(false);
        }
    }

    async fn add_url_profile(&mut self, name: String, raw_url: String, age_private_key: String) {
        let url = match Url::parse(raw_url.trim()) {
            Ok(value) if value.scheme() == "http" || value.scheme() == "https" => value,
            _ => {
                self.set_notice("订阅链接无效；只接受 HTTP 或 HTTPS URL");
                return;
            }
        };
        let full_url = raw_url.trim().to_string();
        let id = new_id();
        if let Err(error) = credentials::store(&id, &full_url) {
            self.set_notice(format!("无法安全保存订阅链接：{error}"));
            return;
        }
        let age_reference = if age_private_key.trim().is_empty() {
            None
        } else {
            let reference = format!("{id}-age");
            if credentials::store(&reference, age_private_key.trim()).is_err() {
                credentials::delete(&id);
                self.set_notice("无法安全保存 Age 私钥");
                return;
            }
            Some(reference)
        };
        let mut profile = Profile {
            id: id.clone(),
            name: nonempty_name(&name, "新配置"),
            source_kind: SourceKind::Subscription,
            location: safe_url_label(&url),
            source_file: PathBuf::new(),
            origin_directory: None,
            credential_ref: Some(id.clone()),
            age_credential_ref: age_reference.clone(),
            override_ids: Vec::new(),
            updated_at: Utc::now(),
        };
        match self
            .fetch_url(&full_url)
            .await
            .and_then(|content| decrypt_age_profile_content(&content, &age_private_key))
            .and_then(|content| validate_profile_yaml(&content))
        {
            Ok(content) => {
                let path = match self.paths.save_profile_source(&id, content.as_bytes()) {
                    Ok(path) => path,
                    Err(_) => {
                        credentials::delete(&id);
                        if let Some(reference) = age_reference.as_deref() {
                            credentials::delete(reference);
                        }
                        self.set_notice("无法保存订阅配置到应用数据目录");
                        return;
                    }
                };
                profile.source_file = path;
                self.store.profiles.push(profile);
                if let Err(error) = self.persist_store() {
                    self.store.profiles.pop();
                    credentials::delete(&id);
                    if let Some(reference) = age_reference.as_deref() {
                        credentials::delete(reference);
                    }
                    self.set_notice(format!("无法保存配置元数据：{error}"));
                    return;
                }
                self.notice = "订阅导入成功".into();
            }
            Err(error) => {
                credentials::delete(&id);
                if let Some(reference) = age_reference.as_deref() {
                    credentials::delete(reference);
                }
                self.notice = error;
            }
        }
        self.publish();
    }

    async fn choose_profile_file(&mut self, name: String, age_private_key: String) {
        self.pending_profile_name = name;
        self.pending_profile_age_key = age_private_key;
        #[cfg(target_os = "android")]
        {
            match platform::request_android_profile_file_picker() {
                Ok(()) => self.set_notice("请选择 YAML/YML 配置文件"),
                Err(error) => {
                    self.pending_profile_name.clear();
                    self.pending_profile_age_key.clear();
                    self.set_notice(format!("无法打开 Android 文件选择器：{error}"));
                }
            }
            return;
        }
        #[cfg(not(target_os = "android"))]
        {
            let picked = rfd::AsyncFileDialog::new()
                .add_filter("Mihomo YAML", &["yaml", "yml"])
                .pick_file()
                .await;
            let Some(file) = picked else {
                self.pending_profile_name.clear();
                self.pending_profile_age_key.clear();
                return;
            };
            let profile_name = std::mem::take(&mut self.pending_profile_name);
            let age_private_key = std::mem::take(&mut self.pending_profile_age_key);
            self.notice = "正在读取并校验 YAML 配置…".into();
            self.publish();
            let path = file.path().to_path_buf();
            let metadata = match tokio::fs::metadata(&path).await {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("无法读取所选文件");
                    return;
                }
            };
            if metadata.len() as usize > MAX_PROFILE_BYTES {
                self.set_notice("配置文件超过 20 MiB 上限");
                return;
            }
            let content = match tokio::fs::read(&path).await {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("无法读取所选文件");
                    return;
                }
            };
            let content = match String::from_utf8(content) {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("配置文件不是有效 UTF-8 文本");
                    return;
                }
            };
            let content = match decrypt_age_profile_content(&content, &age_private_key)
                .and_then(|content| validate_profile_yaml(&content))
            {
                Ok(value) => value,
                Err(error) => {
                    self.set_notice(error);
                    return;
                }
            };
            let id = new_id();
            let destination = match self.paths.save_profile_source(&id, content.as_bytes()) {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("无法保存来源配置");
                    return;
                }
            };
            let file_name = path
                .file_stem()
                .and_then(|v| v.to_str())
                .filter(|v| !v.trim().is_empty())
                .unwrap_or("本地配置");
            let profile = Profile {
                id,
                name: nonempty_name(&profile_name, file_name),
                source_kind: SourceKind::LocalFile,
                location: path
                    .file_name()
                    .and_then(|v| v.to_str())
                    .unwrap_or("YAML 文件")
                    .to_string(),
                source_file: destination,
                origin_directory: path.parent().map(Path::to_path_buf),
                credential_ref: None,
                age_credential_ref: None,
                override_ids: Vec::new(),
                updated_at: Utc::now(),
            };
            self.store.profiles.push(profile);
            if let Err(error) = self.persist_store() {
                self.store.profiles.pop();
                self.set_notice(format!("无法保存配置元数据：{error}"));
                return;
            }
            self.set_notice("本地 YAML 导入成功；Profile 来源按只读数据保存");
        }
    }

    #[cfg(target_os = "android")]
    async fn import_android_profile_file(&mut self, display_name: String, contents: Vec<u8>) {
        let profile_name = std::mem::take(&mut self.pending_profile_name);
        let age_private_key = std::mem::take(&mut self.pending_profile_age_key);
        if contents.len() > MAX_PROFILE_BYTES {
            self.set_notice("配置文件超过 20 MiB 上限");
            return;
        }
        let display_name = display_name
            .chars()
            .filter(|value| !value.is_control())
            .collect::<String>();
        let display_name = display_name
            .rsplit(['/', '\\'])
            .next()
            .unwrap_or_default()
            .trim();
        if display_name.is_empty() {
            self.set_notice("无法读取所选文件名");
            return;
        }
        let lower_name = display_name.to_ascii_lowercase();
        if !lower_name.ends_with(".yaml") && !lower_name.ends_with(".yml") {
            self.set_notice("仅支持 .yaml 或 .yml 格式的配置文件");
            return;
        }
        let content = match String::from_utf8(contents) {
            Ok(value) => value,
            Err(_) => {
                self.set_notice("配置文件不是有效 UTF-8 文本");
                return;
            }
        };
        self.notice = "正在校验所选 YAML 配置…".into();
        self.publish();
        let content = match decrypt_age_profile_content(&content, &age_private_key)
            .and_then(|content| validate_profile_yaml(&content))
        {
            Ok(value) => value,
            Err(error) => {
                self.set_notice(error);
                return;
            }
        };
        let id = new_id();
        let source_file = match self.paths.save_profile_source(&id, content.as_bytes()) {
            Ok(value) => value,
            Err(error) => {
                self.set_notice(format!("无法保存来源配置：{error}"));
                return;
            }
        };
        let stem = display_name
            .rfind('.')
            .map(|index| &display_name[..index])
            .filter(|value| !value.trim().is_empty())
            .unwrap_or("本地配置");
        let fallback_name = stem.chars().take(128).collect::<String>();
        let name = nonempty_name(&profile_name, &fallback_name);
        let location = display_name.chars().take(255).collect::<String>();
        self.store.profiles.push(Profile {
            id,
            name,
            source_kind: SourceKind::LocalFile,
            location,
            source_file: source_file.clone(),
            origin_directory: None,
            credential_ref: None,
            age_credential_ref: None,
            override_ids: Vec::new(),
            updated_at: Utc::now(),
        });
        if let Err(error) = self.persist_store() {
            self.store.profiles.pop();
            let _ = tokio::fs::remove_file(&source_file).await;
            self.set_notice(format!("无法保存配置元数据：{error}"));
            return;
        }
        self.set_notice("本地 YAML 导入成功；Profile 来源按只读数据保存");
    }

    async fn fetch_url(&self, url: &str) -> Result<String, String> {
        self.fetch_url_with_label(url, "订阅").await
    }

    async fn fetch_url_with_label(&self, url: &str, label: &str) -> Result<String, String> {
        let user_agent = if self.store.user_agent.trim().is_empty() {
            "Lumen/0.1.0"
        } else {
            self.store.user_agent.trim()
        };
        let client = Client::builder()
            .user_agent(user_agent)
            .timeout(Duration::from_secs(45))
            .redirect(reqwest::redirect::Policy::none())
            .build()
            .map_err(|_| format!("无法创建{label}请求"))?;
        let mut response = client
            .get(url)
            .send()
            .await
            .map_err(|_| format!("{label}请求失败；请检查网络和链接"))?;
        let status = response.status();
        if !status.is_success() {
            return Err(format!("{label}服务器返回 HTTP {}", status.as_u16()));
        }
        if response
            .content_length()
            .is_some_and(|length| length > MAX_PROFILE_BYTES as u64)
        {
            return Err(format!("{label}配置超过 20 MiB 上限"));
        }
        let mut bytes = Vec::new();
        while let Some(chunk) = response
            .chunk()
            .await
            .map_err(|_| format!("无法读取{label}响应"))?
        {
            if bytes.len().saturating_add(chunk.len()) > MAX_PROFILE_BYTES {
                return Err(format!("{label}配置超过 20 MiB 上限"));
            }
            bytes.extend_from_slice(&chunk);
        }
        String::from_utf8(bytes).map_err(|_| format!("{label}响应不是有效 UTF-8 文本"))
    }

    async fn set_current_profile(&mut self, id: &str) {
        if id.is_empty() {
            let Some(previous_id) = self.store.current_profile_id.clone() else {
                return;
            };
            let preserved_proxy_change = if self.runtime.is_some() {
                if !self.stop_runtime_inner().await {
                    return;
                }
                self.notice.contains("外部修改")
            } else {
                false
            };
            self.store.current_profile_id = None;
            if let Err(error) = self.persist_store() {
                self.store.current_profile_id = Some(previous_id);
                self.set_notice(format!("无法取消当前配置：{error}"));
                return;
            }
            self.notice = if preserved_proxy_change {
                "当前配置已取消；Runtime 已停止，并保留外部修改后的系统代理设置".into()
            } else {
                "当前配置已取消；Runtime 已停止".into()
            };
            self.refresh_proxy_catalog_from_current_profile();
            self.publish();
            return;
        }
        if !self.store.profiles.iter().any(|profile| profile.id == id) {
            self.set_notice("找不到该 Profile");
            return;
        }
        if self.store.current_profile_id.as_deref() == Some(id) {
            self.set_notice("此配置已经是当前 Profile");
            return;
        }
        let preserved_proxy_change = if self.runtime.is_some() {
            if !self.stop_runtime_inner().await {
                return;
            }
            self.notice.contains("外部修改")
        } else {
            false
        };
        let old = self.store.current_profile_id.clone();
        self.store.current_profile_id = Some(id.to_string());
        if let Err(error) = self.persist_store() {
            self.store.current_profile_id = old;
            self.set_notice(format!("无法保存当前配置：{error}"));
            return;
        }
        self.notice = if preserved_proxy_change {
            "当前 Profile 已切换；Runtime 已停止，并保留外部修改后的系统代理设置".into()
        } else {
            "当前 Profile 已切换；Runtime 已停止，确认后可重新启动".into()
        };
        self.refresh_proxy_catalog_from_current_profile();
        self.publish();
    }

    fn move_profile(&mut self, id: &str, up: bool) {
        let Some(index) = self.store.profiles.iter().position(|item| item.id == id) else {
            self.set_notice("找不到该 Profile");
            return;
        };
        let Some(target) = (if up {
            index.checked_sub(1)
        } else if index + 1 < self.store.profiles.len() {
            Some(index + 1)
        } else {
            None
        }) else {
            return;
        };
        self.store.profiles.swap(index, target);
        if let Err(error) = self.persist_store() {
            self.store.profiles.swap(index, target);
            self.set_notice(format!("无法保存 Profile 顺序：{error}"));
            return;
        }
        self.set_notice("Profile 顺序已保存");
    }

    async fn delete_profile(&mut self, id: &str) {
        let Some(index) = self
            .store
            .profiles
            .iter()
            .position(|profile| profile.id == id)
        else {
            self.set_notice("找不到该 Profile");
            return;
        };
        let preserved_proxy_change =
            if self.store.current_profile_id.as_deref() == Some(id) && self.runtime.is_some() {
                if !self.stop_runtime_inner().await {
                    return;
                }
                self.notice.contains("外部修改")
            } else {
                false
            };
        let previous_store = self.store.clone();
        let profile = self.store.profiles.remove(index);
        if self.store.current_profile_id.as_deref() == Some(id) {
            self.store.current_profile_id = None;
        }
        for item in &mut self.store.overrides {
            item.profile_ids.retain(|bound| bound != id);
        }
        if let Err(error) = self.persist_store() {
            self.store = previous_store;
            self.set_notice(format!("无法删除 Profile：{error}"));
            return;
        }
        if let Some(reference) = profile.credential_ref.as_deref() {
            credentials::delete(reference);
        }
        if let Some(reference) = profile.age_credential_ref.as_deref() {
            credentials::delete(reference);
        }
        let _ = tokio::fs::remove_file(profile.source_file).await;
        self.notice = if preserved_proxy_change {
            "配置已删除；已保留外部修改后的系统代理设置".into()
        } else {
            "配置已删除".into()
        };
        self.refresh_proxy_catalog_from_current_profile();
        self.publish();
    }

    async fn refresh_profile(&mut self, id: &str) {
        let Some(profile) = self
            .store
            .profiles
            .iter()
            .find(|profile| profile.id == id)
            .cloned()
        else {
            self.set_notice("找不到该 Profile");
            return;
        };
        if profile.source_kind != SourceKind::Subscription {
            self.set_notice("本地文件来源无法在线更新");
            return;
        }
        let Some(reference) = profile.credential_ref.as_deref() else {
            self.set_notice("订阅凭据引用不存在，请重新添加此订阅");
            return;
        };
        let url = match credentials::read(reference) {
            Ok(value) => value,
            Err(error) => {
                self.set_notice(format!("无法读取订阅凭据：{error}"));
                return;
            }
        };
        let age_private_key = match profile.age_credential_ref.as_deref() {
            Some(reference) => match credentials::read(reference) {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("无法从系统安全凭据库读取 Age 私钥");
                    return;
                }
            },
            None => String::new(),
        };
        self.notice = format!("正在更新 Profile「{}」…", profile.name);
        self.publish();
        let new_content = match self
            .fetch_url(&url)
            .await
            .and_then(|content| decrypt_age_profile_content(&content, &age_private_key))
            .and_then(|content| validate_profile_yaml(&content))
        {
            Ok(value) => value,
            Err(error) => {
                self.set_notice(error);
                return;
            }
        };
        let old_content = match self.paths.read_profile_source(&profile) {
            Ok(value) => value,
            Err(_) => {
                self.set_notice("无法读取现有来源配置");
                return;
            }
        };
        if let Err(_) = self.paths.atomic_text(&profile.source_file, &new_content) {
            self.set_notice("无法写入更新的来源配置");
            return;
        }
        let updated_at = Utc::now();
        if let Some(item) = self.store.profiles.iter_mut().find(|item| item.id == id) {
            item.updated_at = updated_at;
        }
        if let Err(error) = self.persist_store() {
            let _ = self.paths.atomic_text(&profile.source_file, &old_content);
            if let Some(item) = self.store.profiles.iter_mut().find(|item| item.id == id) {
                item.updated_at = profile.updated_at;
            }
            self.set_notice(format!("无法保存订阅更新：{error}"));
            return;
        }
        if self.runtime.is_some() && self.store.current_profile_id.as_deref() == Some(id) {
            if let Err(error) = self.reload_current_config().await {
                let _ = self.paths.atomic_text(&profile.source_file, &old_content);
                if let Some(item) = self.store.profiles.iter_mut().find(|item| item.id == id) {
                    item.updated_at = profile.updated_at;
                }
                let _ = self.persist_store();
                self.set_notice(format!(
                    "候选配置应用失败，已保留上次成功的来源和运行会话：{error}"
                ));
                return;
            }
        }
        if self.store.current_profile_id.as_deref() == Some(id) && self.runtime.is_none() {
            self.refresh_proxy_catalog_from_current_profile();
        }
        self.set_notice("订阅更新成功");
    }

    fn open_profile_settings(&mut self, id: &str) {
        let Some(profile) = self.store.profiles.iter().find(|item| item.id == id) else {
            self.set_notice("找不到该 Profile");
            return;
        };
        self.profile_settings_id = profile.id.clone();
        self.profile_settings_name = profile.name.clone();
        self.profile_settings_location = profile.location.clone();
        self.profile_settings_kind = profile.source_kind.label().to_string();
        self.profile_settings_age_key.clear();
        self.profile_settings_override_ids = profile.override_ids.clone();
        self.notice.clear();
        self.publish();
    }

    fn toggle_profile_override(&mut self, id: &str, selected: bool) {
        if self.profile_settings_id.is_empty()
            || !self.store.overrides.iter().any(|item| item.id == id)
        {
            self.set_notice("Profile 设置已失效；请重新打开设置页");
            return;
        }
        if selected {
            if !self
                .profile_settings_override_ids
                .iter()
                .any(|item| item == id)
            {
                self.profile_settings_override_ids.push(id.to_string());
            }
        } else {
            self.profile_settings_override_ids.retain(|item| item != id);
        }
        self.publish();
    }

    fn move_profile_override(&mut self, id: &str, up: bool) {
        let Some(index) = self
            .profile_settings_override_ids
            .iter()
            .position(|item| item == id)
        else {
            return;
        };
        let target = if up {
            index.checked_sub(1)
        } else if index + 1 < self.profile_settings_override_ids.len() {
            Some(index + 1)
        } else {
            None
        };
        if let Some(target) = target {
            self.profile_settings_override_ids.swap(index, target);
            self.publish();
        }
    }

    fn cancel_profile_settings(&mut self) {
        self.profile_settings_id.clear();
        self.profile_settings_name.clear();
        self.profile_settings_location.clear();
        self.profile_settings_kind.clear();
        self.profile_settings_age_key.clear();
        self.profile_settings_override_ids.clear();
        self.publish();
    }

    async fn save_profile_settings(
        &mut self,
        id: &str,
        name: String,
        raw_url: String,
        submitted_age_key: String,
    ) {
        if self.profile_settings_id != id {
            self.set_notice("Profile 设置已失效；请重新打开设置页");
            return;
        }
        let name = name.trim().to_string();
        if name.is_empty() {
            self.set_notice("配置名称不能为空");
            return;
        }
        let Some(profile_index) = self.store.profiles.iter().position(|item| item.id == id) else {
            self.set_notice("找不到该 Profile");
            return;
        };
        let profile = self.store.profiles[profile_index].clone();
        let requested_url = raw_url.trim();
        let submitted_age_key = submitted_age_key.trim().to_string();
        let mut replacement: Option<(String, String, String)> = None;
        let mut previous_url: Option<String> = None;
        if !requested_url.is_empty() {
            if profile.source_kind != SourceKind::Subscription {
                self.set_notice("本地文件来源不能转换为订阅链接");
                return;
            }
            let parsed = match Url::parse(requested_url) {
                Ok(url) if url.scheme() == "http" || url.scheme() == "https" => url,
                _ => {
                    self.set_notice("订阅链接无效；只接受 HTTP 或 HTTPS URL");
                    return;
                }
            };
            let Some(reference) = profile.credential_ref.as_deref() else {
                self.set_notice("订阅凭据引用不存在，请重新添加此订阅");
                return;
            };
            let old_url = match credentials::read(reference) {
                Ok(value) => value,
                Err(error) => {
                    self.set_notice(format!("无法读取现有订阅凭据：{error}"));
                    return;
                }
            };
            if requested_url != old_url {
                let effective_age_key = if !submitted_age_key.is_empty() {
                    submitted_age_key.clone()
                } else if let Some(reference) = profile.age_credential_ref.as_deref() {
                    match credentials::read(reference) {
                        Ok(value) => value,
                        Err(_) => {
                            self.set_notice("无法从系统安全凭据库读取 Age 私钥");
                            return;
                        }
                    }
                } else {
                    String::new()
                };
                self.notice = "正在下载并校验新订阅…".into();
                self.publish();
                let content = match self
                    .fetch_url(requested_url)
                    .await
                    .and_then(|value| decrypt_age_profile_content(&value, &effective_age_key))
                    .and_then(|value| validate_profile_yaml(&value))
                {
                    Ok(value) => value,
                    Err(error) => {
                        self.set_notice(format!("订阅地址未更改：{error}"));
                        return;
                    }
                };
                replacement = Some((content, safe_url_label(&parsed), requested_url.to_string()));
                previous_url = Some(old_url);
            }
        }

        let previous_store = self.store.clone();
        let old_content = if replacement.is_some() {
            match self.paths.read_profile_source(&profile) {
                Ok(value) => Some(value),
                Err(error) => {
                    self.set_notice(format!("无法读取现有来源配置：{error}"));
                    return;
                }
            }
        } else {
            None
        };
        let new_age_reference = if submitted_age_key.is_empty() {
            None
        } else {
            let reference = format!("{}-age", new_id());
            if credentials::store(&reference, &submitted_age_key).is_err() {
                self.set_notice("无法安全保存 Age 私钥");
                return;
            }
            Some(reference)
        };
        if let (Some((_, _, new_url)), Some(reference)) =
            (replacement.as_ref(), profile.credential_ref.as_deref())
        {
            if let Err(error) = credentials::store(reference, new_url) {
                if let Some(age_reference) = new_age_reference.as_deref() {
                    credentials::delete(age_reference);
                }
                self.set_notice(format!("无法安全更新订阅凭据：{error}"));
                return;
            }
        }
        if let Some((content, _, _)) = replacement.as_ref() {
            if let Err(error) = self.paths.atomic_text(&profile.source_file, content) {
                let mut rollback_errors = Vec::new();
                if let (Some(old_url), Some(reference)) =
                    (previous_url.as_deref(), profile.credential_ref.as_deref())
                {
                    if let Err(rollback_error) = credentials::store(reference, old_url) {
                        rollback_errors.push(format!("订阅凭据：{rollback_error}"));
                    }
                }
                let recovery = if rollback_errors.is_empty() {
                    "现有订阅已恢复".to_string()
                } else {
                    format!(
                        "凭据恢复失败（{}）；请重新保存原订阅链接",
                        rollback_errors.join("；")
                    )
                };
                if let Some(age_reference) = new_age_reference.as_deref() {
                    credentials::delete(age_reference);
                }
                self.set_notice(format!("无法写入新来源配置：{error}。{recovery}"));
                return;
            }
        }
        self.store.profiles[profile_index].name = name;
        if let Some(reference) = new_age_reference.as_ref() {
            self.store.profiles[profile_index].age_credential_ref = Some(reference.clone());
        }
        if let Some((_, location, _)) = replacement.as_ref() {
            self.store.profiles[profile_index].location = location.clone();
            self.store.profiles[profile_index].updated_at = Utc::now();
        }
        self.store.profiles[profile_index].override_ids = self
            .profile_settings_override_ids
            .iter()
            .filter(|override_id| {
                self.store
                    .overrides
                    .iter()
                    .any(|item| &item.id == *override_id)
            })
            .cloned()
            .collect();
        let selected_ids = self.store.profiles[profile_index].override_ids.clone();
        for item in &mut self.store.overrides {
            item.profile_ids.retain(|profile_id| profile_id != id);
            if selected_ids
                .iter()
                .any(|override_id| override_id == &item.id)
            {
                item.profile_ids.push(id.to_string());
            }
        }
        if let Err(error) = self.persist_store() {
            self.store = previous_store;
            let mut rollback_errors = Vec::new();
            if let Err(rollback_error) = self.persist_store() {
                rollback_errors.push(format!("设置文件：{rollback_error}"));
            }
            if let Some(old_content) = old_content.as_deref() {
                if let Err(rollback_error) =
                    self.paths.atomic_text(&profile.source_file, old_content)
                {
                    rollback_errors.push(format!("Profile 来源：{rollback_error}"));
                }
            }
            if let (Some(old_url), Some(reference)) =
                (previous_url.as_deref(), profile.credential_ref.as_deref())
            {
                if let Err(rollback_error) = credentials::store(reference, old_url) {
                    rollback_errors.push(format!("订阅凭据：{rollback_error}"));
                }
            }
            if let Some(age_reference) = new_age_reference.as_deref() {
                credentials::delete(age_reference);
            }
            let recovery = if rollback_errors.is_empty() {
                "已恢复原来源、凭据和绑定".to_string()
            } else {
                format!(
                    "恢复未完全成功（{}）；请检查 Profile 设置并重试",
                    rollback_errors.join("；")
                )
            };
            self.set_notice(format!("无法保存 Profile 设置：{error}。{recovery}"));
            return;
        }

        if let (Some(new_reference), Some(old_reference)) =
            (new_age_reference.as_deref(), profile.age_credential_ref.as_deref())
            && new_reference != old_reference
        {
            credentials::delete(old_reference);
        }

        if self.runtime.is_some()
            && self.store.current_profile_id.as_deref() == Some(id)
            && (replacement.is_some()
                || previous_store.profiles[profile_index].override_ids != selected_ids)
        {
            if let Err(error) = self.reload_current_config().await {
                self.notice = format!("设置已保存为草稿；当前有效 Runtime 保持不变：{error}");
                self.publish();
                return;
            }
        }
        self.cancel_profile_settings();
        self.set_notice("Profile 设置已保存");
    }

    fn show_preview(&mut self, id: &str) {
        let Some(profile) = self.store.profiles.iter().find(|profile| profile.id == id) else {
            self.set_notice("找不到该 Profile");
            return;
        };
        match mihomo::build_candidate(&self.store, &self.paths, profile, true) {
            Ok(yaml) => {
                self.content_preview = mihomo::sanitize_preview(&yaml);
                self.content_preview_profile = profile.name.clone();
                self.notice = "只读候选配置预览".into();
                self.publish();
            }
            Err(error) => self.set_notice(format!("配置预览失败：{error}")),
        }
    }

    async fn start_runtime(&mut self) {
        if self.proxy_recovery_blocked {
            self.set_notice("上次系统代理状态仍待恢复；请先重试恢复或手动还原系统代理");
            return;
        }
        if self.runtime.is_some() {
            self.set_notice("Mihomo 已在运行");
            return;
        }
        let Some(id) = self.store.current_profile_id.clone() else {
            self.set_notice("请先在配置页面选择当前 Profile");
            return;
        };
        let Some(profile) = self
            .store
            .profiles
            .iter()
            .find(|profile| profile.id == id)
            .cloned()
        else {
            self.set_notice("当前 Profile 不存在，请重新选择配置");
            return;
        };
        self.runtime_transition = "Starting".into();
        self.notice = "正在生成并校验候选配置…".into();
        self.publish();
        let content = match mihomo::build_candidate(&self.store, &self.paths, &profile, true) {
            Ok(value) => value,
            Err(error) => {
                self.runtime_transition.clear();
                self.set_notice(format!("配置生成失败：{error}"));
                return;
            }
        };
        #[cfg(target_os = "android")]
        let core_path = match self.resolve_android_core().await {
            Ok(path) => path,
            Err(error) => {
                self.runtime_transition.clear();
                self.set_notice(format!(
                    "Mihomo Android 核心不可用：{error}；请重新安装当前 ABI 的 Lumen APK"
                ));
                return;
            }
        };
        #[cfg(not(target_os = "android"))]
        let core_path = PathBuf::from("mihomo");
        self.notice = match self.store.network_mode {
            NetworkMode::SystemProxy => "正在启动 Mihomo 并核对系统代理状态…".into(),
            NetworkMode::Tun => "正在启动 Mihomo、Windows TUN 网卡和默认路由…".into(),
            NetworkMode::Vpn => "正在验证 Android VPN 配置并请求系统授权…".into(),
        };
        self.publish();
        match mihomo::start_runtime(&self.store, &self.paths, &profile, &core_path, content).await {
            Ok(mut session) => {
                self.core_version = session.version.clone();
                let network_mode = session.network_mode.clone();
                let controller = session.controller.clone();
                let secret = session.api_secret.clone();
                let traffic_stream_id = new_id();
                spawn_runtime_streams(
                    &controller,
                    secret,
                    traffic_stream_id.clone(),
                    self.event_sender.clone(),
                    &mut session,
                );
                self.runtime = Some(session);
                self.runtime_transition.clear();
                self.proxy_external_change_seen = false;
                self.notice = match network_mode {
                    NetworkMode::SystemProxy => "Mihomo 已就绪，系统代理已回读确认".into(),
                    NetworkMode::Tun => {
                        "Mihomo 已就绪，Windows TUN 配置和网卡状态已回读确认".into()
                    }
                    NetworkMode::Vpn => "Mihomo 核心和 Android VPN 隧道均已就绪".into(),
                };
                self.clear_observations();
                self.traffic_stream_id = Some(traffic_stream_id);
                self.traffic_last_totals = Some((0, 0));
                self.traffic_stream_status = "正在连接".into();
                self.log_stream_status = "正在连接".into();
                self.home_rate_samples.clear();
                self.home_egress_last_probe = None;
                self.home_exit_ip = "—".into();
                self.home_exit_country_code.clear();
                self.home_exit_flag_index = -1;
                self.home_exit_status = "查询中".into();
                self.refresh_observations().await;
                self.request_home_egress(true);
                if !self.home_current_node_id.is_empty() {
                    let home_node = self.home_current_node_id.clone();
                    self.test_proxy_node(&home_node).await;
                }
            }
            Err(error) => {
                self.runtime_transition.clear();
                if self.paths.root.join("system-proxy-recovery.json").exists() {
                    self.proxy_recovery_blocked = true;
                    self.notice = format!("{}。系统代理恢复记录仍保留，需先恢复后再启动。", error);
                } else {
                    self.notice = error.to_string();
                }
            }
        }
        self.publish();
    }

    async fn stop_runtime(&mut self) {
        if self.runtime.is_none() {
            self.set_notice("Runtime 当前未运行");
            return;
        }
        if self.stop_runtime_inner().await {
            self.publish();
        }
    }

    async fn retry_proxy_restore(&mut self) {
        if self.runtime.is_some() {
            self.set_notice("请先停止当前 Runtime，再恢复上次系统代理状态");
            return;
        }
        let journal = self.paths.root.join("system-proxy-recovery.json");
        match platform::restore_system_proxy(&journal).await {
            Ok(true) => {
                self.proxy_recovery_blocked = false;
                self.set_notice("检测到系统代理已被外部修改；已保留当前设置，现在可以启动 Runtime");
            }
            Ok(false) => {
                self.proxy_recovery_blocked = false;
                self.set_notice("已恢复上次系统代理设置，现在可以启动 Runtime");
            }
            Err(error) => self.set_notice(format!(
                "系统代理恢复失败：{error}。请检查系统代理权限后重试。"
            )),
        }
    }

    async fn stop_runtime_inner(&mut self) -> bool {
        let Some(network_mode) = self
            .runtime
            .as_ref()
            .map(|session| session.network_mode.clone())
        else {
            return true;
        };
        self.runtime_transition = "Stopping".into();
        self.notice = if network_mode == NetworkMode::Tun {
            "正在请求关闭 Windows TUN，并确认网卡和默认路由恢复…".into()
        } else {
            "正在停止 Mihomo 并恢复网络接管状态…".into()
        };
        self.publish();
        let Some(session) = self.runtime.as_mut() else {
            self.runtime_transition.clear();
            return true;
        };
        match session.stop(&self.paths).await {
            Ok(external_proxy_change_preserved) => {
                self.runtime = None;
                self.runtime_transition.clear();
                self.proxy_external_change_seen = false;
                self.reset_home_runtime_data();
                self.clear_observations();
                self.maybe_persist_traffic_history(true);
                self.notice = match (network_mode, external_proxy_change_preserved) {
                    (NetworkMode::SystemProxy, true) => {
                        "检测到系统代理外部修改；已保留当前设置".into()
                    }
                    (NetworkMode::SystemProxy, false) => "Runtime 已停止，系统代理已恢复".into(),
                    (NetworkMode::Tun, _) => "Runtime 已停止，Windows TUN 已关闭并回读确认".into(),
                    (NetworkMode::Vpn, _) => "Runtime 已停止".into(),
                };
                self.publish();
                true
            }
            Err(error) => {
                self.runtime_transition.clear();
                self.set_notice(format!("Runtime 停止失败：{error}。保留状态并可重试恢复。"));
                false
            }
        }
    }

    async fn set_route_mode(&mut self, mode: &str) {
        let next = match mode.to_ascii_lowercase().as_str() {
            "rule" => RouteMode::Rule,
            "global" => RouteMode::Global,
            "direct" => RouteMode::Direct,
            _ => {
                self.set_notice("不支持的核心模式");
                return;
            }
        };
        let old_mode = self.store.route_mode.clone();
        if let Some(session) = self.runtime.as_ref() {
            let response = session
                .controller
                .send_json(
                    Method::PATCH,
                    "configs",
                    json!({ "mode": next.label().to_ascii_lowercase() }),
                )
                .await;
            if let Err(error) = response {
                self.set_notice(format!("核心模式切换失败：{error}"));
                return;
            }
            match session.controller.get_json("configs").await {
                Ok(value)
                    if value
                        .get("mode")
                        .and_then(Value::as_str)
                        .is_some_and(|actual| actual.eq_ignore_ascii_case(next.label())) => {}
                _ => {
                    self.set_notice("核心未确认新的代理模式；仍显示上次实际值");
                    return;
                }
            }
        }
        self.store.route_mode = next;
        if let Err(error) = self.persist_store() {
            self.store.route_mode = old_mode.clone();
            if let Some(session) = self.runtime.as_ref() {
                let _ = session
                    .controller
                    .send_json(
                        Method::PATCH,
                        "configs",
                        json!({ "mode": old_mode.label().to_ascii_lowercase() }),
                    )
                    .await;
            }
            self.set_notice(format!("无法保存模式偏好：{error}"));
            return;
        }
        if self.runtime.is_some() {
            self.refresh_observations().await;
            self.request_home_egress(true);
        }
        self.set_notice("核心代理模式已回读确认");
    }

    async fn set_network_mode(&mut self, mode: &str) {
        let next = match mode.to_ascii_lowercase().as_str() {
            "system proxy" | "systemproxy" if !cfg!(target_os = "android") => {
                NetworkMode::SystemProxy
            }
            "tun" if platform::tun_platform_supported() => NetworkMode::Tun,
            "vpn" if cfg!(target_os = "android") => {
                self.set_notice("Android VPN Service 尚未接入，此入口不可用");
                return;
            }
            "system proxy" | "systemproxy" => {
                self.set_notice("Android 只提供 VPN 接管模式");
                return;
            }
            "tun" => {
                self.set_notice("当前平台尚未接入 TUN 权限和恢复适配");
                return;
            }
            _ => {
                self.set_notice("当前平台只支持已实现的网络接管模式");
                return;
            }
        };
        if next == self.store.network_mode {
            self.set_notice(format!("当前网络接管模式已是 {}", next.label()));
            return;
        }
        if matches!(next, NetworkMode::Tun) && !platform::tun_permission_available() {
            self.set_notice("Windows TUN 需要管理员权限；请以管理员身份重新启动 Lumen");
            return;
        }

        let was_running = self.runtime.is_some();
        if was_running && !self.stop_runtime_inner().await {
            return;
        }
        let previous = self.store.network_mode.clone();
        self.store.network_mode = next.clone();
        if let Err(error) = self.persist_store() {
            self.store.network_mode = previous;
            self.set_notice(format!("无法保存网络接管模式：{error}"));
            if was_running {
                self.start_runtime().await;
            }
            return;
        }
        self.set_notice(format!("网络接管模式已设为 {}", next.label()));
        if was_running {
            self.start_runtime().await;
        }
    }

    async fn check_core(&mut self) {
        #[cfg(target_os = "android")]
        {
            match self.resolve_android_core().await {
                Ok(_) => self.set_notice("已校验 APK 附带的 Mihomo Android 核心"),
                Err(error) => {
                    self.core_version = "核心不可用".into();
                    self.set_notice(format!(
                        "Mihomo Android 核心校验失败：{error}；请重新安装当前 ABI 的 Lumen APK"
                    ));
                }
            }
            return;
        }
        #[cfg(not(target_os = "android"))]
        match mihomo::validate_core(Path::new("mihomo")).await {
            Ok(version) => {
                self.core_version = version;
                self.set_notice("已读取 PATH 中 Mihomo 核心版本");
            }
            Err(error) => self.set_notice(format!("无法检测 PATH 中的 mihomo：{error}")),
        }
    }

    #[cfg(target_os = "android")]
    async fn resolve_android_core(&mut self) -> anyhow::Result<PathBuf> {
        let path = platform::android_mihomo_core_path().await?;
        let version = mihomo::validate_core(&path).await?;
        if !version.contains(&format!("v{}", mihomo::ANDROID_CORE_VERSION)) {
            anyhow::bail!(
                "APK 附带核心版本与构建版本 v{} 不匹配",
                mihomo::ANDROID_CORE_VERSION
            );
        }
        self.core_version = version;
        Ok(path)
    }

    fn add_override(&mut self, name: String, content: String) {
        if name.trim().is_empty() {
            self.set_notice("请输入 Override 名称");
            return;
        }
        if !content.trim().is_empty() {
            match serde_yaml::from_str::<YamlValue>(&content) {
                Ok(value) if value.is_mapping() => {}
                Ok(_) => {
                    self.set_notice("Override 顶层必须是 YAML 对象");
                    return;
                }
                Err(error) => {
                    self.set_notice(mihomo::yaml_error("Override YAML", error).to_string());
                    return;
                }
            }
        }
        let item = UserOverride {
            id: new_id(),
            name: name.trim().to_string(),
            content,
            profile_ids: Vec::new(),
            updated_at: Utc::now(),
        };
        self.store.overrides.push(item);
        if let Err(error) = self.persist_store() {
            self.store.overrides.pop();
            self.set_notice(format!("无法保存 Override：{error}"));
            return;
        }
        self.edit_id.clear();
        self.edit_name.clear();
        self.edit_body.clear();
        self.set_notice("YAML Override 已创建");
    }

    async fn import_override_url(&mut self, raw_url: &str) {
        if self.override_importing {
            return;
        }
        self.override_importing = true;
        self.override_import_error.clear();
        self.publish();

        let imported = match validate_override_import_url(raw_url) {
            Ok(url) => match self
                .fetch_url_with_label(url.as_str(), "Override 链接")
                .await
            {
                Ok(content) => match validate_override_yaml(&content) {
                    Ok(()) => Ok((override_name_from_url(&url), content)),
                    Err(error) => Err(error),
                },
                Err(error) => Err(error),
            },
            Err(error) => Err(error),
        };

        match imported {
            Ok((name, content)) => {
                self.store.overrides.push(UserOverride {
                    id: new_id(),
                    name,
                    content,
                    profile_ids: Vec::new(),
                    updated_at: Utc::now(),
                });
                if self.persist_store().is_err() {
                    self.store.overrides.pop();
                    self.override_import_error =
                        "已下载并校验，但无法保存 Override；请检查应用存储空间和权限。".into();
                } else {
                    self.override_import_revision = self.override_import_revision.wrapping_add(1);
                    self.notice = "YAML Override 已从链接导入".into();
                }
            }
            Err(error) => self.override_import_error = error,
        }

        self.override_importing = false;
        self.publish();
    }

    async fn choose_override_file(&mut self) {
        if self.override_importing {
            return;
        }
        #[cfg(target_os = "android")]
        {
            match platform::request_android_override_file_picker() {
                Ok(()) => self.set_notice("请选择 YAML/YML Override 文件"),
                Err(error) => self.set_notice(format!("无法打开 Android 文件选择器：{error}")),
            }
        }
        #[cfg(not(target_os = "android"))]
        {
            let picked = rfd::AsyncFileDialog::new()
                .add_filter("YAML Override", &["yaml", "yml"])
                .pick_file()
                .await;
            let Some(file) = picked else {
                return;
            };
            let bytes = file.read().await;
            if bytes.len() > MAX_PROFILE_BYTES {
                self.set_notice("Override 文件超过 20 MiB 上限");
                return;
            }
            let content = match String::from_utf8(bytes) {
                Ok(value) => value,
                Err(_) => {
                    self.set_notice("Override 文件不是有效 UTF-8 文本");
                    return;
                }
            };
            if let Err(error) = validate_override_yaml(&content) {
                self.set_notice(error);
                return;
            }
            let name = file
                .file_name()
                .rsplit_once('.')
                .map(|(stem, _)| stem)
                .filter(|stem| !stem.trim().is_empty())
                .unwrap_or("导入的 Override")
                .to_string();
            let item = UserOverride {
                id: new_id(),
                name,
                content,
                profile_ids: Vec::new(),
                updated_at: Utc::now(),
            };
            self.store.overrides.push(item);
            if let Err(error) = self.persist_store() {
                self.store.overrides.pop();
                self.set_notice(format!("无法保存导入的 Override：{error}"));
                return;
            }
            self.set_notice("YAML Override 已导入");
        }
    }

    #[cfg(target_os = "android")]
    async fn import_android_override_file(&mut self, display_name: String, contents: Vec<u8>) {
        if contents.len() > MAX_PROFILE_BYTES {
            self.override_import_error = "Override 文件超过 20 MiB 上限".into();
            self.override_importing = false;
            self.set_notice(self.override_import_error.clone());
            return;
        }
        let display_name = display_name
            .chars()
            .filter(|value| !value.is_control())
            .collect::<String>();
        let display_name = display_name
            .rsplit(['/', '\\'])
            .next()
            .unwrap_or_default()
            .trim();
        let lower_name = display_name.to_ascii_lowercase();
        if display_name.is_empty()
            || (!lower_name.ends_with(".yaml") && !lower_name.ends_with(".yml"))
        {
            self.override_import_error = "仅支持 .yaml 或 .yml 格式的 Override 文件".into();
            self.override_importing = false;
            self.set_notice(self.override_import_error.clone());
            return;
        }
        let content = match String::from_utf8(contents) {
            Ok(value) => value,
            Err(_) => {
                self.override_import_error = "Override 文件不是有效 UTF-8 文本".into();
                self.override_importing = false;
                self.set_notice(self.override_import_error.clone());
                return;
            }
        };
        self.notice = "正在校验 Override YAML…".into();
        self.publish();
        if let Err(error) = validate_override_yaml(&content) {
            self.override_import_error = error;
            self.override_importing = false;
            self.set_notice(self.override_import_error.clone());
            return;
        }
        let stem = display_name
            .rfind('.')
            .map(|index| &display_name[..index])
            .filter(|value| !value.trim().is_empty())
            .unwrap_or("导入的 Override");
        self.store.overrides.push(UserOverride {
            id: new_id(),
            name: stem.chars().take(128).collect(),
            content,
            profile_ids: Vec::new(),
            updated_at: Utc::now(),
        });
        if let Err(error) = self.persist_store() {
            self.store.overrides.pop();
            self.override_import_error = format!("无法保存导入的 Override：{error}").into();
            self.override_importing = false;
            self.set_notice(self.override_import_error.clone());
            return;
        }
        self.override_importing = false;
        self.override_import_error.clear();
        self.override_import_revision = self.override_import_revision.wrapping_add(1);
        self.set_notice("YAML Override 已从文件导入");
    }

    fn export_override(&mut self, id: &str) {
        #[cfg(target_os = "android")]
        {
            let Some(item) = self.store.overrides.iter().find(|item| item.id == id) else {
                self.set_notice("Override 不存在");
                return;
            };
            let name = format!("{}.yaml", sanitize_file_stem(&item.name));
            self.begin_android_export(
                name,
                "application/yaml",
                item.content.clone(),
                "YAML Override 已导出",
            );
        }
        #[cfg(not(target_os = "android"))]
        {
            let Some(item) = self.store.overrides.iter().find(|item| item.id == id) else {
                self.set_notice("Override 不存在");
                return;
            };
            let name = format!("{}.yaml", sanitize_file_stem(&item.name));
            let Some(path) = rfd::FileDialog::new()
                .set_file_name(&name)
                .add_filter("YAML", &["yaml", "yml"])
                .save_file()
            else {
                return;
            };
            match std::fs::write(path, &item.content) {
                Ok(()) => self.set_notice("YAML Override 已导出"),
                Err(_) => self.set_notice("Override 导出失败；请检查目标位置权限"),
            }
        }
    }

    fn export_profile(&mut self, id: &str) {
        let Some(profile) = self.store.profiles.iter().find(|profile| profile.id == id) else {
            self.set_notice("配置不存在");
            return;
        };
        let name = format!("{}.yaml", sanitize_file_stem(&profile.name));
        let source_file = profile.source_file.clone();
        let file = match std::fs::File::open(&source_file) {
            Ok(file) => file,
            Err(_) => {
                self.set_notice("无法读取配置来源文件；请确认配置仍可用");
                return;
            }
        };
        let mut bytes = Vec::new();
        if file
            .take((MAX_PROFILE_BYTES + 1) as u64)
            .read_to_end(&mut bytes)
            .is_err()
        {
            self.set_notice("无法读取配置来源文件；请确认配置仍可用");
            return;
        }
        if bytes.len() > MAX_PROFILE_BYTES {
            self.set_notice("配置文件超过 20 MiB 导出上限");
            return;
        }
        let contents = match String::from_utf8(bytes) {
            Ok(contents) => contents,
            Err(_) => {
                self.set_notice("配置来源文件不是有效 UTF-8 文本，无法导出");
                return;
            }
        };
        #[cfg(target_os = "android")]
        self.begin_android_export(name, "application/yaml", contents, "Profile 配置已导出");
        #[cfg(not(target_os = "android"))]
        {
            let Some(path) = rfd::FileDialog::new()
                .set_file_name(&name)
                .add_filter("YAML", &["yaml", "yml"])
                .save_file()
            else {
                return;
            };
            match std::fs::write(path, contents) {
                Ok(()) => self.set_notice("Profile 配置已导出"),
                Err(_) => self.set_notice("配置导出失败；请检查目标位置权限"),
            }
        }
    }

    #[cfg(target_os = "android")]
    fn begin_android_export(
        &mut self,
        display_name: String,
        mime_type: &str,
        contents: String,
        success_notice: &str,
    ) {
        if self.android_export_contents.is_some() || !self.android_export_success_notice.is_empty()
        {
            self.set_notice("另一个文件导出正在进行");
            return;
        }
        if contents.len() > MAX_PROFILE_BYTES {
            self.set_notice("导出文件超过 20 MiB 上限");
            return;
        }
        match platform::request_android_document_export(&display_name, mime_type) {
            Ok(()) => {
                self.android_export_contents = Some(contents);
                self.android_export_success_notice = success_notice.into();
                self.set_notice("请选择保存位置");
            }
            Err(error) => self.set_notice(format!("无法打开 Android 系统保存对话框：{error}")),
        }
    }

    async fn save_override(&mut self, id: &str, content: String) {
        if !content.trim().is_empty() {
            match serde_yaml::from_str::<YamlValue>(&content) {
                Ok(value) if value.is_mapping() => {}
                Ok(_) => {
                    self.set_notice("Override 顶层必须是 YAML 对象");
                    return;
                }
                Err(error) => {
                    self.set_notice(mihomo::yaml_error("Override YAML", error).to_string());
                    return;
                }
            }
        }
        let Some(index) = self.store.overrides.iter().position(|item| item.id == id) else {
            self.set_notice("Override 不存在");
            return;
        };
        let old_content = self.store.overrides[index].content.clone();
        let old_updated_at = self.store.overrides[index].updated_at;
        self.store.overrides[index].content = content;
        self.store.overrides[index].updated_at = Utc::now();
        if let Err(error) = self.persist_store() {
            self.store.overrides[index].content = old_content;
            self.store.overrides[index].updated_at = old_updated_at;
            self.set_notice(format!("无法保存 Override：{error}"));
            return;
        }
        self.edit_id.clear();
        self.edit_name.clear();
        self.edit_body.clear();
        if self.runtime.is_some()
            && self
                .store
                .current_profile_id
                .as_ref()
                .is_some_and(|profile_id| {
                    self.store.overrides[index].profile_ids.contains(profile_id)
                })
        {
            if let Err(error) = self.reload_current_config().await {
                self.set_notice(format!(
                    "Override 已保存为草稿；当前有效 Runtime 保持不变：{error}"
                ));
                return;
            }
        }
        self.set_notice("YAML Override 已保存");
    }

    fn edit_override(&mut self, id: &str) {
        let Some(item) = self.store.overrides.iter().find(|item| item.id == id) else {
            self.set_notice("Override 不存在");
            return;
        };
        self.edit_id = id.into();
        self.edit_name = item.name.clone();
        self.edit_body = item.content.clone();
        self.notice = "编辑 YAML Override；JavaScript 执行入口尚未开放".into();
        self.publish();
    }

    fn delete_override(&mut self, id: &str) {
        let Some(index) = self.store.overrides.iter().position(|item| item.id == id) else {
            self.set_notice("Override 不存在");
            return;
        };
        let previous_store = self.store.clone();
        self.store.overrides.remove(index);
        for profile in &mut self.store.profiles {
            profile.override_ids.retain(|bound| bound != id);
        }
        if let Err(error) = self.persist_store() {
            self.store = previous_store;
            self.set_notice(format!("无法删除 Override：{error}"));
            return;
        }
        self.set_notice("Override 已删除");
    }

    async fn apply_override(&mut self, id: &str) {
        let Some(profile_id) = self.store.current_profile_id.clone() else {
            self.set_notice("请先选择当前 Profile");
            return;
        };
        if !self.store.overrides.iter().any(|item| item.id == id) {
            self.set_notice("Override 不存在");
            return;
        }
        let previous_store = self.store.clone();
        let Some(profile) = self
            .store
            .profiles
            .iter_mut()
            .find(|item| item.id == profile_id)
        else {
            self.set_notice("当前 Profile 不存在");
            return;
        };
        if profile.override_ids.iter().any(|bound| bound == id) {
            profile.override_ids.retain(|bound| bound != id);
        } else {
            profile.override_ids.push(id.to_string());
        }
        let current_ids = profile.override_ids.clone();
        for item in &mut self.store.overrides {
            item.profile_ids.retain(|bound| bound != &profile_id);
            if current_ids.contains(&item.id) {
                item.profile_ids.push(profile_id.clone());
            }
        }
        if let Err(error) = self.persist_store() {
            self.store = previous_store;
            self.set_notice(format!("无法保存 Override 绑定：{error}"));
            return;
        }
        if self.runtime.is_some() {
            if let Err(error) = self.reload_current_config().await {
                self.set_notice(format!("绑定已保存；当前有效 Runtime 保持不变：{error}"));
                return;
            }
        }
        self.set_notice("Override 绑定已保存；执行顺序按列表顺序");
    }

    fn select_proxy_group(&mut self, name: &str) {
        self.selected_group = name.to_string();
        if let Some(value) = self.last_proxies_value() {
            self.update_proxies(value);
        } else {
            self.refresh_proxy_catalog_from_current_profile();
        }
        self.publish();
    }

    fn refresh_proxy_catalog_from_current_profile(&mut self) {
        self.proxy_groups.clear();
        self.proxy_nodes.clear();
        self.proxy_node_types.clear();
        self.proxy_group_order.clear();
        self.proxy_group_members.clear();
        self.proxy_endpoints.clear();
        self.cached_proxies = None;

        let Some(profile_id) = self.store.current_profile_id.as_deref() else {
            return;
        };
        let Some(profile) = self
            .store
            .profiles
            .iter()
            .find(|profile| profile.id == profile_id)
            .cloned()
        else {
            return;
        };
        let Ok(source) = self.paths.read_profile_source(&profile) else {
            return;
        };
        let Ok(config) = serde_yaml::from_str::<YamlValue>(&source) else {
            return;
        };

        if let Some(proxies) = config.get("proxies").and_then(YamlValue::as_sequence) {
            for proxy in proxies {
                let Some(name) = proxy.get("name").and_then(YamlValue::as_str) else {
                    continue;
                };
                let kind = proxy
                    .get("type")
                    .and_then(YamlValue::as_str)
                    .map(proxy_type_label)
                    .unwrap_or_else(|| "节点".into());
                self.proxy_node_types.insert(name.to_string(), kind);
                if let (Some(server), Some(port)) = (
                    proxy.get("server").and_then(YamlValue::as_str),
                    proxy
                        .get("port")
                        .and_then(YamlValue::as_u64)
                        .and_then(|port| u16::try_from(port).ok()),
                ) {
                    self.proxy_endpoints.insert(
                        name.to_string(),
                        ProxyEndpoint {
                            server: server.to_string(),
                            port,
                        },
                    );
                }
            }
        }

        let mut groups = Vec::new();
        if let Some(definitions) = config
            .get("proxy-groups")
            .and_then(YamlValue::as_sequence)
        {
            for definition in definitions {
                let Some(name) = definition.get("name").and_then(YamlValue::as_str) else {
                    continue;
                };
                let node_names = definition
                    .get("proxies")
                    .and_then(YamlValue::as_sequence)
                    .into_iter()
                    .flatten()
                    .filter_map(YamlValue::as_str)
                    .collect::<Vec<_>>();
                let group_kind = definition
                    .get("type")
                    .and_then(YamlValue::as_str)
                    .map(proxy_group_type_label)
                    .unwrap_or_else(|| "策略组".into());
                self.proxy_group_order.push(name.to_string());
                self.proxy_group_members
                    .insert(name.to_string(), node_names.iter().map(|name| (*name).to_string()).collect());
                let configured_default = node_names.first().copied().unwrap_or("");
                let (current, current_flag_code) = split_leading_flag(configured_default);
                let current_flag_index = crate::flag_assets::index_for_code(&current_flag_code)
                    .unwrap_or(-1);
                groups.push(ProxyGroup {
                    name: name.into(),
                    icon_emoji: proxy_group_icon_emoji(name).into(),
                    kind: group_kind.into(),
                    current: current.into(),
                    current_flag_code: current_flag_code.into(),
                    current_flag_index,
                    current_accessible: if configured_default.is_empty() {
                        "配置中没有可用节点".into()
                    } else {
                        configured_default.into()
                    },
                    nodes: node_names.join("、").into(),
                });

                if name == self.selected_group {
                    let mut nodes = node_names
                        .iter()
                        .map(|node_name| {
                            let (display_name, flag_code) = split_leading_flag(node_name);
                            let mut node = row(
                                *node_name,
                                display_name,
                                self.proxy_node_types
                                    .get(*node_name)
                                    .map(String::as_str)
                                    .unwrap_or_else(|| {
                                        if groups.iter().any(|group| group.name.as_str() == *node_name) {
                                            "策略组"
                                        } else if *node_name == "DIRECT" {
                                            "Direct"
                                        } else if *node_name == "REJECT" {
                                            "Reject"
                                        } else {
                                            "节点"
                                        }
                                    }),
                                self.proxy_delays
                                    .get(*node_name)
                                    .map(|delay| format_delay(*delay))
                                    .unwrap_or_else(|| "Ping".into()),
                            );
                            node.flag_code = flag_code.clone().into();
                            node.flag_index = crate::flag_assets::index_for_code(&flag_code)
                                .unwrap_or(-1);
                            node.delay_ms = self
                                .proxy_delays
                                .get(*node_name)
                                .map(|delay| (*delay).min(i32::MAX as u64) as i32)
                                .unwrap_or(-1);
                            node.accessible_title = (*node_name).into();
                            node.active = false;
                            node
                        })
                        .collect::<Vec<_>>();
                    self.order_proxy_nodes(&mut nodes);
                    self.proxy_nodes = nodes;
                }
            }
        }
        self.order_proxy_groups(&mut groups);
        self.proxy_groups = groups;
        self.home_proxy_group = self.preferred_home_group();
        self.clear_home_proxy_summary();
    }

    fn preferred_home_group(&self) -> String {
        let find_named = |needle: &str| {
            self.proxy_group_order
                .iter()
                .find(|name| name.to_lowercase().contains(needle))
                .cloned()
        };
        match &self.store.route_mode {
            RouteMode::Direct => "DIRECT".into(),
            RouteMode::Global => self
                .proxy_group_order
                .iter()
                .find(|name| name.eq_ignore_ascii_case("GLOBAL"))
                .cloned()
                .or_else(|| find_named("节点选择"))
                .or_else(|| find_named("proxy"))
                .unwrap_or_else(|| self.proxy_group_order.first().cloned().unwrap_or_default()),
            RouteMode::Rule => find_named("节点选择")
                .or_else(|| find_named("proxy"))
                .or_else(|| {
                    self.proxy_groups
                        .iter()
                        .find(|group| {
                            group.kind.as_str() == "Selector"
                                && !group.name.eq_ignore_ascii_case("GLOBAL")
                        })
                        .map(|group| group.name.to_string())
                })
                .or_else(|| {
                    self.proxy_group_order
                        .iter()
                        .find(|name| name.eq_ignore_ascii_case("GLOBAL"))
                        .cloned()
                })
                .unwrap_or_else(|| self.proxy_group_order.first().cloned().unwrap_or_default()),
        }
    }

    fn clear_home_proxy_summary(&mut self) {
        self.home_current_node_id.clear();
        self.home_current_node = "未知".into();
        self.home_current_accessible = "未知".into();
        self.home_current_flag_code.clear();
        self.home_current_flag_index = -1;
        self.home_current_delay = "—".into();
    }

    fn request_home_egress(&mut self, force: bool) {
        let Some(session) = self.runtime.as_ref() else {
            self.home_exit_ip = "—".into();
            self.home_exit_country_code.clear();
            self.home_exit_flag_index = -1;
            self.home_exit_status = "启动后获取".into();
            self.publish();
            return;
        };
        if self.home_egress_pending && !force {
            return;
        }
        if !force
            && self
                .home_egress_last_probe
                .is_some_and(|last| last.elapsed() < Duration::from_secs(300))
        {
            return;
        }

        self.home_egress_generation = self.home_egress_generation.wrapping_add(1).max(1);
        let generation = self.home_egress_generation;
        self.home_egress_pending = true;
        self.home_exit_status = "查询中".into();
        let proxy_port = (!matches!(&self.store.route_mode, RouteMode::Direct))
            .then_some(session.proxy_port);
        let events = self.event_sender.clone();
        tokio::spawn(async move {
            let result = lookup_home_egress(proxy_port).await;
            let _ = events
                .send(RuntimeEvent::HomeEgress { generation, result })
                .await;
        });
        self.publish();
    }

    fn reset_home_runtime_data(&mut self) {
        self.home_egress_generation = self.home_egress_generation.wrapping_add(1).max(1);
        self.home_egress_pending = false;
        self.home_egress_last_probe = None;
        self.home_exit_ip = "—".into();
        self.home_exit_country_code.clear();
        self.home_exit_flag_index = -1;
        self.home_exit_status = "代理已停止".into();
        self.home_current_delay = "—".into();
        self.home_rate_samples.clear();
    }

    fn update_home_proxy_summary(&mut self, value: Option<&Value>) {
        self.home_proxy_group = self.preferred_home_group();
        if self.runtime.is_none() {
            self.clear_home_proxy_summary();
            return;
        }
        let Some(proxy_map) = value
            .and_then(|value| value.get("proxies"))
            .and_then(Value::as_object)
        else {
            self.clear_home_proxy_summary();
            return;
        };

        let mut current_name = self.home_proxy_group.clone();
        if current_name.is_empty() {
            current_name = "DIRECT".into();
        }
        let mut visited = HashSet::new();
        for _ in 0..8 {
            if !visited.insert(current_name.clone()) {
                break;
            }
            let Some(entry) = proxy_map.get(&current_name) else {
                break;
            };
            let Some(now) = entry.get("now").and_then(Value::as_str) else {
                break;
            };
            if now.is_empty() || now == current_name {
                break;
            }
            current_name = now.to_string();
        }

        let (display, flag_code) = split_leading_flag(&current_name);
        self.home_current_node_id = current_name.clone();
        self.home_current_node = display;
        self.home_current_accessible = current_name.clone();
        self.home_current_flag_index = crate::flag_assets::index_for_code(&flag_code).unwrap_or(-1);
        self.home_current_flag_code = flag_code;
        self.home_current_delay = self
            .proxy_delays
            .get(&current_name)
            .map(|delay| format_delay(*delay))
            .unwrap_or_else(|| "—".into());
    }

    fn order_proxy_groups(&self, groups: &mut Vec<ProxyGroup>) {
        match self.proxy_sort_mode.as_str() {
            "按名称排序" => groups.sort_by_key(|group| group.name.to_lowercase()),
            "按延迟排序" => groups.sort_by_key(|group| {
                self.proxy_delays
                    .get(group.current_accessible.as_str())
                    .copied()
                    .unwrap_or(u64::MAX)
            }),
            _ => groups.sort_by_key(|group| {
                (
                    self.proxy_group_order
                        .iter()
                        .position(|name| name == group.name.as_str())
                        .unwrap_or(usize::MAX),
                    group.name.to_lowercase(),
                )
            }),
        }
    }

    fn order_proxy_nodes(&self, nodes: &mut Vec<ObservationRow>) {
        if !self.proxy_search.is_empty() {
            let query = self.proxy_search.to_lowercase();
            nodes.retain(|node| {
                node.title.to_lowercase().contains(&query)
                    || node.accessible_title.to_lowercase().contains(&query)
                    || node.subtitle.to_lowercase().contains(&query)
            });
        }
        match self.proxy_sort_mode.as_str() {
            "按名称排序" => nodes.sort_by_key(|node| node.title.to_lowercase()),
            "按延迟排序" => nodes.sort_by_key(|node| {
                node.trailing
                    .strip_suffix(" ms")
                    .and_then(|delay| delay.parse::<u64>().ok())
                    .unwrap_or(u64::MAX)
            }),
            _ => {}
        }
    }

    // Proxy JSON is reconstructed from rows when the API refreshes; names/current nodes remain available below.
    fn last_proxies_value(&self) -> Option<Value> {
        self.cached_proxies.clone()
    }

    async fn select_proxy(&mut self, group: &str, node: &str) {
        let Some(session) = self.runtime.as_ref() else {
            self.set_notice("Mihomo 未运行");
            return;
        };
        let path = api_path("proxies", group, None);
        if let Err(error) = session
            .controller
            .send_json(Method::PUT, &path, json!({ "name": node }))
            .await
        {
            self.set_notice(format!("节点切换失败：{error}"));
            return;
        }
        self.refresh_observations().await;
        self.request_home_egress(true);
        self.set_notice("节点切换已由 Mihomo 接受并回读");
    }

    async fn test_proxy(&mut self, group: &str, node: &str) {
        if node.is_empty() {
            self.test_proxy_group(group).await;
        } else {
            self.test_proxy_node(node).await;
        }
    }

    async fn test_proxy_node(&mut self, node: &str) {
        self.proxy_testing_node = node.to_string();
        self.publish();

        let result = if let Some(controller) = self
            .runtime
            .as_ref()
            .map(|session| session.controller.clone())
        {
            let path = api_path(
                "proxies",
                node,
                Some("delay?url=https%3A%2F%2Fwww.gstatic.com%2Fgenerate_204&timeout=5000"),
            );
            controller
                .get_json(&path)
                .await
                .map(|value| value.get("delay").and_then(Value::as_u64).unwrap_or(0))
                .map_err(|error| error.to_string())
        } else if self.proxy_group_members.contains_key(node) {
            self.proxy_testing_node.clear();
            self.test_proxy_group(node).await;
            return;
        } else if node == "DIRECT" {
            tcp_connect_latency(ProxyEndpoint {
                server: "www.gstatic.com".into(),
                port: 443,
            })
            .await
        } else if node == "REJECT" {
            Err("拒绝策略没有可连通的服务器".into())
        } else if let Some(endpoint) = self.proxy_endpoints.get(node).cloned() {
            tcp_connect_latency(endpoint).await
        } else {
            Err("当前配置没有该节点的服务器地址".into())
        };

        self.proxy_testing_node.clear();
        match result {
            Ok(delay) => {
                self.proxy_delays.insert(node.to_string(), delay);
                if let Some(proxies) = self.cached_proxies.clone() {
                    self.update_proxies(proxies);
                } else {
                    self.refresh_proxy_catalog_from_current_profile();
                }
                let kind = if self.runtime.is_some() {
                    "Mihomo"
                } else {
                    "TCP 连通性"
                };
                self.notice = format!("{node} {kind}延迟：{}", format_delay(delay));
            }
            Err(error) => {
                self.proxy_delays.insert(node.to_string(), 0);
                if let Some(proxies) = self.cached_proxies.clone() {
                    self.update_proxies(proxies);
                }
                self.notice = format!("{node} 测速失败：{error}");
            }
        }
        self.publish();
    }

    async fn test_proxy_group(&mut self, group: &str) {
        self.proxy_testing_group = group.to_string();
        self.publish();

        let result: Result<ProxyTestResults, String> = if let Some(controller) = self
            .runtime
            .as_ref()
            .map(|session| session.controller.clone())
        {
            if let Some(proxies) = self.cached_proxies.as_ref() {
                let mut members = Vec::new();
                collect_runtime_group_nodes(proxies, group, &mut HashSet::new(), &mut members);
                members.sort();
                members.dedup();
                members.truncate(MAX_PROXY_TEST_NODES);
                let results = futures_util::stream::iter(members)
                    .map(|name| {
                        let controller = controller.clone();
                        async move {
                            let path = api_path(
                                "proxies",
                                &name,
                                Some("delay?url=https%3A%2F%2Fwww.gstatic.com%2Fgenerate_204&timeout=5000"),
                            );
                            let result = controller
                                .get_json(&path)
                                .await
                                .map(|value| {
                                    value.get("delay").and_then(Value::as_u64).unwrap_or(0)
                                })
                                .map_err(|error| error.to_string());
                            (name, result)
                        }
                    })
                    .buffer_unordered(8)
                    .collect::<Vec<_>>()
                    .await;
                if results.is_empty() {
                    Err("当前策略组没有可测速的节点".into())
                } else {
                    Ok(ProxyTestResults::Mihomo(results))
                }
            } else {
                Err("Mihomo 代理列表尚未就绪".into())
            }
        } else {
            let mut members = Vec::new();
            self.collect_offline_group_endpoints(group, &mut HashSet::new(), &mut members);
            members.sort();
            members.dedup();
            members.truncate(MAX_PROXY_TEST_NODES);
            if members.is_empty() {
                Err("当前策略组没有可直接测试的代理服务器".into())
            } else {
                let endpoints = members
                    .into_iter()
                    .filter_map(|name| {
                        if name == "DIRECT" {
                            Some((
                                name,
                                ProxyEndpoint {
                                    server: "www.gstatic.com".into(),
                                    port: 443,
                                },
                            ))
                        } else {
                            self.proxy_endpoints
                                .get(&name)
                                .cloned()
                                .map(|endpoint| (name, endpoint))
                        }
                    })
                    .collect::<Vec<_>>();
                let results = futures_util::stream::iter(endpoints)
                    .map(|(name, endpoint)| async move {
                        (name, tcp_connect_latency(endpoint).await)
                    })
                    .buffer_unordered(8)
                    .collect::<Vec<_>>()
                    .await;
                Ok(ProxyTestResults::Tcp(results))
            }
        };

        self.proxy_testing_group.clear();
        match result {
            Ok(results) => {
                let (results, used_runtime) = match results {
                    ProxyTestResults::Mihomo(results) => (results, true),
                    ProxyTestResults::Tcp(results) => (results, false),
                };
                let tested = results.len();
                let failed = results.iter().filter(|(_, result)| result.is_err() || result.as_ref().is_ok_and(|delay| *delay == 0)).count();
                for (name, result) in results {
                    match result {
                        Ok(delay) => {
                            self.proxy_delays.insert(name, delay);
                        }
                        Err(_) => {
                            self.proxy_delays.insert(name, 0);
                        }
                    }
                }
                if let Some(proxies) = self.cached_proxies.clone() {
                    self.update_proxies(proxies);
                } else {
                    self.refresh_proxy_catalog_from_current_profile();
                }
                self.notice = if used_runtime {
                    format!("策略组 {group} 已完成 {tested} 个节点的 Mihomo 测速；{failed} 个节点超时")
                } else {
                    format!("策略组 {group} 已完成 {tested} 个节点的 TCP 连通性测试；{failed} 个节点超时。启动 Mihomo 后可测代理延迟")
                };
            }
            Err(error) => self.notice = format!("策略组 {group} 测速失败：{error}"),
        }
        self.publish();
    }

    fn collect_offline_group_endpoints(
        &self,
        name: &str,
        visited: &mut HashSet<String>,
        endpoints: &mut Vec<String>,
    ) {
        if !visited.insert(name.to_string()) {
            return;
        }
        if name == "DIRECT" {
            endpoints.push(name.to_string());
            return;
        }
        if name == "REJECT" {
            return;
        }
        if self.proxy_endpoints.contains_key(name) {
            endpoints.push(name.to_string());
            return;
        }
        if let Some(members) = self.proxy_group_members.get(name) {
            for member in members {
                self.collect_offline_group_endpoints(member, visited, endpoints);
            }
        }
    }

    async fn close_connection(&mut self, id: &str) {
        let Some(controller) = self
            .runtime
            .as_ref()
            .map(|session| session.controller.clone())
        else {
            self.set_notice("Mihomo 未运行");
            return;
        };
        let path = api_path("connections", id, None);
        self.connection_breaking_id = id.into();
        self.publish();
        let result = controller.send_json(Method::DELETE, &path, json!({})).await;
        self.connection_breaking_id.clear();
        match result {
            Ok(()) => {
                self.refresh_observations().await;
                self.set_notice("连接已请求打断");
            }
            Err(error) => self.set_notice(format!("无法打断连接：{error}")),
        }
    }

    async fn set_rule_enabled(&mut self, index: &str, enabled: bool) {
        let Some(controller) = self
            .runtime
            .as_ref()
            .map(|session| session.controller.clone())
        else {
            self.set_notice("Mihomo 未运行");
            return;
        };
        let Ok(index) = index.parse::<usize>() else {
            self.set_notice("运行规则序号无效");
            return;
        };
        let index = index.to_string();
        let disabled = !enabled;
        let mut change = serde_json::Map::new();
        change.insert(index.clone(), Value::Bool(disabled));
        self.rule_pending_index = index;
        self.publish();
        let result = controller
            .send_json(Method::PATCH, "rules/disable", Value::Object(change))
            .await;
        self.rule_pending_index.clear();
        match result {
            Ok(()) => {
                self.refresh_observations().await;
                self.set_notice("运行规则临时状态已更新；重启后恢复配置值");
            }
            Err(error) => self.set_notice(format!("运行规则更新失败：{error}")),
        }
    }

    async fn update_provider(&mut self, name: &str) {
        let Some(session) = self.runtime.as_ref() else {
            self.set_notice("Mihomo 未运行");
            return;
        };
        let provider_kind = self
            .providers
            .iter()
            .find(|row| row.id == name)
            .map(|row| row.subtitle.as_str())
            .unwrap_or("代理提供者");
        let base = if provider_kind == "规则提供者" {
            "providers/rules"
        } else {
            "providers/proxies"
        };
        let path = api_path(base, name, None);
        match session
            .controller
            .send_json(Method::PUT, &path, json!({}))
            .await
        {
            Ok(()) => {
                self.refresh_observations().await;
                self.set_notice("Provider 更新请求已接受");
            }
            Err(error) => self.set_notice(format!("Provider 更新失败：{error}")),
        }
    }

    fn export_logs(&mut self) {
        #[cfg(target_os = "android")]
        {
            let logs = self.visible_logs();
            if logs.is_empty() {
                self.set_notice("当前筛选结果没有可导出的 Mihomo 日志");
                return;
            }
            let content = logs
                .iter()
                .map(|row| format!("{} [{}] {}", row.title, row.subtitle, row.trailing))
                .collect::<Vec<_>>()
                .join("\n");
            self.begin_android_export(
                "lumen-runtime.log".into(),
                "text/plain",
                content,
                "日志已导出",
            );
        }
        #[cfg(not(target_os = "android"))]
        {
            let logs = self.visible_logs();
            if logs.is_empty() {
                self.set_notice("当前筛选结果没有可导出的 Mihomo 日志");
                return;
            }
            let target = rfd::FileDialog::new()
                .set_file_name("lumen-runtime.log")
                .add_filter("Text", &["log", "txt"])
                .save_file();
            let Some(path) = target else {
                return;
            };
            let content = logs
                .iter()
                .map(|row| format!("{} [{}] {}", row.title, row.subtitle, row.trailing))
                .collect::<Vec<_>>()
                .join("\n");
            match std::fs::write(path, content) {
                Ok(()) => self.set_notice("日志已导出"),
                Err(_) => self.set_notice("日志导出失败；请检查目标位置权限"),
            }
        }
    }

    async fn refresh_observations(&mut self) {
        let Some(controller) = self
            .runtime
            .as_ref()
            .map(|session| session.controller.clone())
        else {
            self.clear_observations();
            self.publish();
            return;
        };
        let (connections, proxies, rules, proxy_providers, rule_providers, config) = tokio::join!(
            controller.get_json("connections"),
            controller.get_json("proxies"),
            controller.get_json("rules"),
            controller.get_json("providers/proxies"),
            controller.get_json("providers/rules"),
            controller.get_json("configs"),
        );
        if let Ok(value) = connections {
            self.update_connections(value);
        }
        if let Ok(value) = proxies {
            self.update_proxies(value);
        }
        if let Ok(value) = rules {
            self.update_rules(value);
        }
        if let (Ok(proxy), Ok(rule)) = (proxy_providers, rule_providers) {
            self.update_providers(proxy, rule);
        }
        if let Ok(value) = config {
            let mode = value
                .get("mode")
                .and_then(Value::as_str)
                .unwrap_or_default();
            self.store.route_mode = match mode.to_ascii_lowercase().as_str() {
                "global" => RouteMode::Global,
                "direct" => RouteMode::Direct,
                _ => RouteMode::Rule,
            };
        }
        self.publish();
    }

    fn update_connections(&mut self, value: Value) {
        let next_connections = value
            .get("connections")
            .and_then(Value::as_array)
            .into_iter()
            .flatten()
            .take(MAX_CONNECTION_ROWS)
            .filter_map(|item| {
                let id = item.get("id")?.as_str()?.to_string();
                if id.is_empty() {
                    return None;
                }
                let metadata = item.get("metadata").unwrap_or(&Value::Null);
                let host = metadata
                    .get("host")
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty())
                    .or_else(|| metadata.get("destinationIP").and_then(Value::as_str))
                    .unwrap_or("未知目标")
                    .to_string();
                let process = metadata
                    .get("process")
                    .or_else(|| metadata.get("processPath"))
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty())
                    .unwrap_or("核心未提供进程名")
                    .to_string();
                let network = metadata
                    .get("network")
                    .and_then(Value::as_str)
                    .unwrap_or("连接");
                let connection_type = metadata
                    .get("type")
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty());
                let protocol = connection_type
                    .map(|value| format!("{network}/{value}"))
                    .unwrap_or_else(|| network.to_string());
                let chains = item
                    .get("chains")
                    .and_then(Value::as_array)
                    .map(|items| {
                        items
                            .iter()
                            .filter_map(Value::as_str)
                            .collect::<Vec<_>>()
                            .join(" → ")
                    })
                    .unwrap_or_default();
                let source = connection_address(metadata, "sourceIP", "sourcePort");
                let destination = metadata
                    .get("remoteDestination")
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty())
                    .map(str::to_string)
                    .unwrap_or_else(|| {
                        connection_address(metadata, "destinationIP", "destinationPort")
                    });
                let rule_type = item
                    .get("rule")
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty())
                    .unwrap_or("核心未提供");
                let rule_payload = item
                    .get("rulePayload")
                    .and_then(Value::as_str)
                    .filter(|value| !value.is_empty());
                let rule = rule_payload
                    .map(|payload| format!("{rule_type} · {payload}"))
                    .unwrap_or_else(|| rule_type.to_string());
                let providers = item
                    .get("providerChains")
                    .or_else(|| item.get("ruleProviderChain"))
                    .or_else(|| item.get("provider"))
                    .and_then(|value| {
                        value.as_str().map(str::to_string).or_else(|| {
                            value.as_array().map(|items| {
                                items
                                    .iter()
                                    .filter_map(Value::as_str)
                                    .collect::<Vec<_>>()
                                    .join(" → ")
                            })
                        })
                    })
                    .filter(|value| !value.is_empty())
                    .unwrap_or_else(|| "核心未提供".into());
                let started_raw = item
                    .get("start")
                    .and_then(Value::as_str)
                    .or_else(|| metadata.get("start").and_then(Value::as_str))
                    .unwrap_or_default();
                let started_at_epoch_ms = DateTime::parse_from_rfc3339(started_raw)
                    .map(|value| value.timestamp_millis())
                    .unwrap_or_default();
                let started_at = if started_at_epoch_ms > 0 {
                    DateTime::parse_from_rfc3339(started_raw)
                        .map(|value| {
                            value
                                .with_timezone(&Utc)
                                .format("%Y-%m-%d %H:%M:%S UTC")
                                .to_string()
                        })
                        .unwrap_or_else(|_| "未知".into())
                } else {
                    "未知".into()
                };
                Some(ConnectionEntry {
                    id,
                    host,
                    process,
                    protocol,
                    source,
                    destination,
                    rule,
                    chains: if chains.is_empty() {
                        "核心未提供代理链".into()
                    } else {
                        chains
                    },
                    providers,
                    started_at,
                    started_at_epoch_ms,
                    closed_at_epoch_ms: None,
                    upload_bytes: item.get("upload").and_then(Value::as_f64).unwrap_or(0.0),
                    download_bytes: item.get("download").and_then(Value::as_f64).unwrap_or(0.0),
                    active: true,
                })
            })
            .collect::<Vec<_>>();
        let next_ids = next_connections
            .iter()
            .map(|entry| entry.id.as_str())
            .collect::<HashSet<_>>();
        for mut previous in self.connections.drain(..) {
            if !next_ids.contains(previous.id.as_str()) {
                previous.active = false;
                previous.closed_at_epoch_ms = Some(Utc::now().timestamp_millis());
                self.closed_connections
                    .retain(|entry| entry.id != previous.id);
                self.closed_connections.push_front(previous);
            }
        }
        for current in &next_connections {
            self.closed_connections
                .retain(|entry| entry.id != current.id);
        }
        self.closed_connections.truncate(MAX_CLOSED_CONNECTION_ROWS);
        self.connections = next_connections;
    }

    fn update_proxies(&mut self, value: Value) {
        self.cached_proxies = Some(value.clone());
        if let Some(proxies) = value.get("proxies").and_then(Value::as_object) {
            for (name, proxy) in proxies {
                if let Some(history) = proxy.get("history").and_then(Value::as_array) {
                    if let Some(delay) = history
                        .last()
                        .and_then(|entry| entry.get("delay"))
                        .and_then(Value::as_u64)
                    {
                        self.proxy_delays.insert(name.clone(), delay);
                    }
                }
            }
        }
        let mut proxy_groups = value
            .get("proxies")
            .and_then(Value::as_object)
            .into_iter()
            .flat_map(|proxies| proxies.iter())
            .filter_map(|(name, proxy)| {
                let all = proxy.get("all").and_then(Value::as_array)?;
                let nodes = all.iter().filter_map(Value::as_str).collect::<Vec<_>>();
                let current_accessible = proxy
                    .get("now")
                    .and_then(Value::as_str)
                    .unwrap_or("自动");
                let (current, current_flag_code) = split_leading_flag(current_accessible);
                let current_flag_index =
                    crate::flag_assets::index_for_code(&current_flag_code).unwrap_or(-1);
                Some(ProxyGroup {
                    name: name.clone().into(),
                    icon_emoji: proxy_group_icon_emoji(name).into(),
                    kind: proxy
                        .get("type")
                        .and_then(Value::as_str)
                        .unwrap_or("策略组")
                        .into(),
                    current: current.into(),
                    current_flag_code: current_flag_code.into(),
                    current_flag_index,
                    current_accessible: current_accessible.into(),
                    nodes: nodes.join("、").into(),
                })
            })
            .collect::<Vec<_>>();
        self.order_proxy_groups(&mut proxy_groups);
        self.proxy_groups = proxy_groups;
        self.update_home_proxy_summary(Some(&value));
        let mut proxy_nodes = Vec::new();
        if let Some(proxy) = value
            .get("proxies")
            .and_then(|proxies| proxies.get(&self.selected_group))
        {
            let current = proxy.get("now").and_then(Value::as_str).unwrap_or_default();
            proxy_nodes = proxy
                .get("all")
                .and_then(Value::as_array)
                .into_iter()
                .flatten()
                .filter_map(Value::as_str)
                .map(|node| {
                    let (display_name, flag_code) = split_leading_flag(node);
                    let flag_index = crate::flag_assets::index_for_code(&flag_code).unwrap_or(-1);
                    let delay = self
                        .proxy_delays
                        .get(node)
                        .map(|delay| format_delay(*delay))
                        .unwrap_or_else(|| "Ping".into());
                    let mut node_row = row(
                        node,
                        display_name,
                        self.proxy_node_types
                            .get(node)
                            .map(String::as_str)
                            .unwrap_or("节点"),
                        delay,
                    );
                    node_row.flag_code = flag_code.into();
                    node_row.flag_index = flag_index;
                    node_row.delay_ms = self
                        .proxy_delays
                        .get(node)
                        .map(|delay| (*delay).min(i32::MAX as u64) as i32)
                        .unwrap_or(-1);
                    node_row.accessible_title = node.into();
                    node_row.active = node == current;
                    node_row
                })
                .collect();
        }
        self.order_proxy_nodes(&mut proxy_nodes);
        self.proxy_nodes = proxy_nodes;
    }

    fn update_rules(&mut self, value: Value) {
        self.rules = value
            .get("rules")
            .and_then(Value::as_array)
            .into_iter()
            .flatten()
            .take(1000)
            .enumerate()
            .map(|(ordinal, rule)| {
                let index = rule
                    .get("index")
                    .and_then(Value::as_u64)
                    .unwrap_or(ordinal as u64)
                    .to_string();
                let disabled = rule
                    .pointer("/extra/disabled")
                    .and_then(Value::as_bool)
                    .unwrap_or(false);
                let hit_count = rule
                    .pointer("/extra/hitCount")
                    .and_then(Value::as_u64)
                    .unwrap_or(0);
                row(
                    index,
                    rule.get("payload")
                        .and_then(Value::as_str)
                        .unwrap_or("规则"),
                    format!(
                        "{} → {}",
                        rule.get("type").and_then(Value::as_str).unwrap_or("未知"),
                        rule.get("proxy")
                            .and_then(Value::as_str)
                            .unwrap_or("未知策略")
                    ),
                    format!("命中 {hit_count}"),
                )
                .with_active(!disabled)
            })
            .collect();
    }

    fn update_providers(&mut self, proxies: Value, rules: Value) {
        let mut rows = Vec::new();
        for (kind, value) in [("代理提供者", proxies), ("规则提供者", rules)] {
            if let Some(items) = value.get("providers").and_then(Value::as_object) {
                for (name, item) in items.iter().take(300) {
                    let provider_type = item
                        .get("vehicleType")
                        .or_else(|| item.get("type"))
                        .and_then(Value::as_str)
                        .unwrap_or("资源");
                    let updated = item
                        .get("updatedAt")
                        .or_else(|| item.get("updated-at"))
                        .and_then(Value::as_str)
                        .unwrap_or("更新时间未知");
                    rows.push(row(name, kind, provider_type, updated));
                }
            }
        }
        self.providers = rows;
    }

    fn clear_observations(&mut self) {
        self.connections.clear();
        self.closed_connections.clear();
        self.selected_connection_id.clear();
        self.connection_breaking_id.clear();
        self.rules.clear();
        self.logs.clear();
        self.log_stream_status = "未运行".into();
        self.rule_pending_index.clear();
        self.providers.clear();
        self.proxy_groups.clear();
        self.proxy_nodes.clear();
        self.cached_proxies = None;
        self.traffic_samples.clear();
        self.traffic_stream_status = "未运行".into();
        self.traffic_stream_id = None;
        self.traffic_last_totals = None;
        self.down_rate = "0 B/s".into();
        self.up_rate = "0 B/s".into();
        self.total_down = "0 B".into();
        self.total_up = "0 B".into();
        self.refresh_proxy_catalog_from_current_profile();
    }

    async fn reload_current_config(&mut self) -> anyhow::Result<()> {
        let Some(id) = self.store.current_profile_id.clone() else {
            anyhow::bail!("没有当前 Profile");
        };
        let Some(profile) = self
            .store
            .profiles
            .iter()
            .find(|item| item.id == id)
            .cloned()
        else {
            anyhow::bail!("当前 Profile 不存在");
        };
        let content = mihomo::build_candidate(&self.store, &self.paths, &profile, true)?;
        let Some(session) = self.runtime.as_mut() else {
            anyhow::bail!("Runtime 未运行");
        };
        // Validate in a separate Mihomo check process before asking the live controller to reload.
        let candidate = self.paths.root.join(format!("candidate-{}.yaml", new_id()));
        let mut value: YamlValue = serde_yaml::from_str(&content)?;
        let port = value
            .get("mixed-port")
            .and_then(YamlValue::as_u64)
            .or_else(|| value.get("port").and_then(YamlValue::as_u64))
            .filter(|p| *p > 0 && *p <= u16::MAX as u64)
            .unwrap_or(session.proxy_port as u64) as u16;
        if port != session.proxy_port {
            anyhow::bail!("候选配置改变了系统代理端口；请先停止并重新启动 Runtime");
        }
        if value.get("mixed-port").is_none() && value.get("port").is_none() {
            value["mixed-port"] = YamlValue::Number(port.into());
        }
        value["external-controller"] = YamlValue::String(format!("127.0.0.1:{}", session.api_port));
        value["secret"] = YamlValue::String(session.api_secret.clone());
        value["mode"] = YamlValue::String(self.store.route_mode.label().to_ascii_lowercase());
        let yaml = serde_yaml::to_string(&value)?;
        self.paths.atomic_text(&candidate, &yaml)?;
        let mut check = tokio::process::Command::new("mihomo");
        check
            .arg("-t")
            .arg("-d")
            .arg(&self.paths.root)
            .arg("-f")
            .arg(&candidate)
            .current_dir(&self.paths.root);
        if let Some(origin) = profile
            .origin_directory
            .as_deref()
            .or_else(|| profile.source_file.parent())
        {
            let old = std::env::var("SAFE_PATHS").unwrap_or_default();
            let separator = if cfg!(windows) { ";" } else { ":" };
            let allowed = if old.is_empty() {
                origin.to_string_lossy().to_string()
            } else {
                format!("{old}{separator}{}", origin.to_string_lossy())
            };
            check.env("SAFE_PATHS", allowed);
        }
        let output = tokio::time::timeout(Duration::from_secs(20), check.output()).await;
        let _ = tokio::fs::remove_file(candidate).await;
        match output {
            Ok(Ok(result)) if result.status.success() => {}
            Ok(Ok(_)) => anyhow::bail!("Mihomo 未通过候选配置校验"),
            Ok(Err(_)) => anyhow::bail!("无法启动 Mihomo 配置校验进程"),
            Err(_) => anyhow::bail!("Mihomo 配置校验超时"),
        }
        session.reload(yaml, &self.paths).await?;
        self.refresh_observations().await;
        Ok(())
    }

    fn persist_store(&self) -> anyhow::Result<()> {
        self.paths.save(&self.store)
    }

    async fn shutdown(&mut self) {
        self.maybe_persist_traffic_history(true);
        if let Some(session) = self.runtime.as_mut() {
            let _ = session.stop(&self.paths).await;
        }
    }
}

fn cleanup_stale_runtime_files(root: &Path) {
    let Ok(entries) = std::fs::read_dir(root) else {
        return;
    };
    for entry in entries.flatten() {
        let path = entry.path();
        let name = entry.file_name();
        if entry.file_type().is_ok_and(|kind| kind.is_file())
            && name.to_string_lossy().starts_with("runtime-")
            && path.extension().and_then(|value| value.to_str()) == Some("yaml")
        {
            let _ = std::fs::remove_file(path);
        }
    }
}

fn validate_profile_yaml(content: &str) -> Result<String, String> {
    if content.trim().is_empty() {
        return Err("配置内容为空".into());
    }
    match serde_yaml::from_str::<YamlValue>(content) {
        Ok(value) if value.is_mapping() => Ok(content.to_string()),
        Ok(_) => Err("配置 YAML 顶层必须是对象".into()),
        Err(error) => Err(mihomo::yaml_error("配置 YAML", error).to_string()),
    }
}

fn decrypt_age_profile_content(content: &str, age_private_key: &str) -> Result<String, String> {
    if !content
        .trim_start()
        .starts_with("-----BEGIN AGE ENCRYPTED FILE-----")
    {
        return Ok(content.to_string());
    }
    if age_private_key.trim().is_empty() {
        return Err("此配置使用 Age 加密；请填写 Age 私钥后重试".into());
    }
    let identity = age_private_key
        .trim()
        .parse::<age::x25519::Identity>()
        .map_err(|_| "Age 私钥无效或无法解密配置内容".to_string())?;
    let decryptor = age::Decryptor::new_buffered(age::armor::ArmoredReader::new(content.as_bytes()))
        .map_err(|_| "Age 加密内容格式无效".to_string())?;
    let reader = decryptor
        .decrypt(std::iter::once(&identity as &dyn age::Identity))
        .map_err(|_| "Age 私钥无效或无法解密配置内容".to_string())?;
    let mut plaintext = Vec::new();
    reader
        .take((MAX_PROFILE_BYTES + 1) as u64)
        .read_to_end(&mut plaintext)
        .map_err(|_| "无法读取解密后的配置内容".to_string())?;
    if plaintext.len() > MAX_PROFILE_BYTES {
        return Err("解密后的配置文件超过 20 MiB 上限".into());
    }
    String::from_utf8(plaintext).map_err(|_| "Age 解密后的配置不是有效 UTF-8 文本".into())
}

fn validate_override_import_url(raw_url: &str) -> Result<Url, String> {
    let url = Url::parse(raw_url.trim()).map_err(|_| "请输入有效的 HTTP/HTTPS 链接".to_string())?;
    if !matches!(url.scheme(), "http" | "https") {
        return Err("链接仅支持 HTTP 或 HTTPS".into());
    }
    let filename = url
        .path_segments()
        .and_then(|mut segments| segments.next_back())
        .unwrap_or_default();
    if !(filename.to_ascii_lowercase().ends_with(".yaml")
        || filename.to_ascii_lowercase().ends_with(".yml"))
    {
        return Err("链接路径必须以 .yaml 或 .yml 结尾".into());
    }
    Ok(url)
}

fn override_name_from_url(url: &Url) -> String {
    let filename = url
        .path_segments()
        .and_then(|mut segments| segments.next_back())
        .unwrap_or_default();
    let stem = filename
        .rfind('.')
        .map(|index| &filename[..index])
        .filter(|stem| !stem.trim().is_empty());
    stem.unwrap_or("链接导入的 Override").to_string()
}

fn validate_override_yaml(content: &str) -> Result<(), String> {
    if content.trim().is_empty() {
        return Err("Override YAML 内容为空".into());
    }
    match serde_yaml::from_str::<YamlValue>(content) {
        Ok(value) if value.is_mapping() => Ok(()),
        Ok(_) => Err("Override YAML 顶层必须是对象".into()),
        Err(error) => Err(mihomo::yaml_error("Override YAML", error).to_string()),
    }
}

fn safe_url_label(url: &Url) -> String {
    let host = url.host_str().unwrap_or("订阅地址");
    let port = url
        .port()
        .map(|value| format!(":{value}"))
        .unwrap_or_default();
    format!("{}://{}{}/…", url.scheme(), host, port)
}

fn nonempty_name(value: &str, fallback: &str) -> String {
    if value.trim().is_empty() {
        fallback.into()
    } else {
        value.trim().to_string()
    }
}

fn row(
    id: impl Into<String>,
    title: impl Into<String>,
    subtitle: impl Into<String>,
    trailing: impl Into<String>,
) -> ObservationRow {
    let title = title.into();
    ObservationRow {
        id: id.into().into(),
        title: title.clone().into(),
        accessible_title: title.into(),
        flag_code: "".into(),
        flag_index: -1,
        delay_ms: -1,
        subtitle: subtitle.into().into(),
        trailing: trailing.into().into(),
        active: true,
    }
}

fn proxy_type_label(kind: &str) -> String {
    match kind.to_ascii_lowercase().as_str() {
        "ss" | "shadowsocks" => "SS".into(),
        "ssr" | "shadowsocksr" => "SSR".into(),
        "vmess" => "VMess".into(),
        "vless" => "VLESS".into(),
        "trojan" => "Trojan".into(),
        "hysteria" => "Hysteria".into(),
        "hysteria2" => "Hysteria2".into(),
        "tuic" => "TUIC".into(),
        "wireguard" => "WireGuard".into(),
        "http" => "HTTP".into(),
        "socks5" => "SOCKS5".into(),
        _ => kind.to_string(),
    }
}

fn proxy_group_type_label(kind: &str) -> String {
    match kind.to_ascii_lowercase().as_str() {
        "select" => "Selector".into(),
        "url-test" => "URLTest".into(),
        "fallback" => "Fallback".into(),
        "load-balance" => "LoadBalance".into(),
        "relay" => "Relay".into(),
        _ => kind.to_string(),
    }
}

fn proxy_group_icon_emoji(name: &str) -> String {
    if name.chars().any(is_emoji_presentation_character) {
        return String::new();
    }
    match name.trim().to_ascii_lowercase().as_str() {
        "节点选择" => "🚀".into(),
        "global" | "全球直连" => "🎯".into(),
        "ai 服务" => "💬".into(),
        _ => "🧭".into(),
    }
}

fn is_emoji_presentation_character(character: char) -> bool {
    let code = u32::from(character);
    matches!(
        code,
        0x1F000..=0x1FAFF | 0x2600..=0x27BF
    )
}

fn format_delay(delay: u64) -> String {
    if delay == 0 {
        "超时".into()
    } else {
        format!("{delay} ms")
    }
}

async fn tcp_connect_latency(endpoint: ProxyEndpoint) -> Result<u64, String> {
    let started = Instant::now();
    match timeout(
        Duration::from_secs(5),
        TcpStream::connect((endpoint.server.as_str(), endpoint.port)),
    )
    .await
    {
        Ok(Ok(stream)) => {
            drop(stream);
            Ok(started.elapsed().as_millis().max(1) as u64)
        }
        Ok(Err(_)) => Err("无法连接代理服务器".into()),
        Err(_) => Err("连接超时".into()),
    }
}

async fn lookup_home_egress(proxy_port: Option<u16>) -> Result<(String, String), String> {
    let builder = if let Some(proxy_port) = proxy_port {
        let proxy = reqwest::Proxy::all(format!("http://127.0.0.1:{proxy_port}"))
            .map_err(|_| "无法建立本地代理请求".to_string())?;
        Client::builder().proxy(proxy)
    } else {
        Client::builder().no_proxy()
    };
    let client = builder
        .timeout(Duration::from_secs(8))
        .user_agent("Lumen/0.1.0")
        .build()
        .map_err(|_| "无法初始化出口信息请求".to_string())?;
    let response = client
        .get("https://ipapi.co/json/")
        .header("Accept", "application/json")
        .send()
        .await
        .map_err(|_| "出口信息服务暂不可用".to_string())?;
    if !response.status().is_success() {
        return Err(format!(
            "出口信息服务返回 HTTP {}",
            response.status().as_u16()
        ));
    }
    if response
        .content_length()
        .is_some_and(|length| length > 64 * 1024)
    {
        return Err("出口信息响应超出大小限制".into());
    }
    let bytes = response
        .bytes()
        .await
        .map_err(|_| "读取出口信息失败".to_string())?;
    if bytes.len() > 64 * 1024 {
        return Err("出口信息响应超出大小限制".into());
    }
    let value = serde_json::from_slice::<Value>(&bytes)
        .map_err(|_| "出口信息服务返回了无效数据".to_string())?;
    let address = value
        .get("ip")
        .and_then(Value::as_str)
        .ok_or_else(|| "出口信息中没有 IP 地址".to_string())?
        .parse::<std::net::IpAddr>()
        .map_err(|_| "出口信息中的 IP 地址无效".to_string())?;
    let country_code = value
        .get("country_code")
        .and_then(Value::as_str)
        .filter(|value| value.len() == 2 && value.bytes().all(|byte| byte.is_ascii_alphabetic()))
        .map(str::to_ascii_lowercase)
        .unwrap_or_default();
    Ok((mask_public_ip(address), country_code))
}

fn mask_public_ip(address: std::net::IpAddr) -> String {
    match address {
        std::net::IpAddr::V4(ip) => {
            let octets = ip.octets();
            format!("{}.{}.***.{}", octets[0], octets[1], octets[3])
        }
        std::net::IpAddr::V6(ip) => {
            let segments = ip.segments();
            format!(
                "{:x}:{:x}:****:****:****:****:{:x}:{:x}",
                segments[0], segments[1], segments[6], segments[7]
            )
        }
    }
}

fn split_leading_flag(value: &str) -> (String, String) {
    let trimmed = value.trim_start();
    let mut characters = trimmed.chars();
    let Some(first) = characters.next().map(u32::from) else {
        return (value.to_string(), String::new());
    };
    let Some(second) = characters.next().map(u32::from) else {
        return (value.to_string(), String::new());
    };
    const REGIONAL_INDICATOR_A: u32 = 0x1f1e6;
    const REGIONAL_INDICATOR_Z: u32 = 0x1f1ff;
    if !(REGIONAL_INDICATOR_A..=REGIONAL_INDICATOR_Z).contains(&first)
        || !(REGIONAL_INDICATOR_A..=REGIONAL_INDICATOR_Z).contains(&second)
    {
        return (value.to_string(), String::new());
    }
    let code = String::from_utf8(vec![
        (b'a' + (first - REGIONAL_INDICATOR_A) as u8),
        (b'a' + (second - REGIONAL_INDICATOR_A) as u8),
    ])
    .expect("ASCII country code must be valid UTF-8");
    let mut remainder = characters.as_str();
    if let Some(stripped) = remainder.strip_prefix('\u{fe0f}') {
        remainder = stripped;
    }
    let display = remainder
        .trim_start_matches(|ch: char| ch.is_whitespace() || matches!(ch, '·' | '|' | '-' | '_'))
        .to_string();
    (display, code)
}

fn connection_address(metadata: &Value, address_key: &str, port_key: &str) -> String {
    let address = metadata
        .get(address_key)
        .and_then(Value::as_str)
        .filter(|value| !value.is_empty());
    let Some(address) = address else {
        return "核心未提供".into();
    };
    let port = metadata
        .get(port_key)
        .and_then(|value| {
            value
                .as_u64()
                .map(|number| number.to_string())
                .or_else(|| value.as_str().map(str::to_string))
        })
        .filter(|value| !value.is_empty());
    match port {
        Some(port) if address.contains(':') && !address.starts_with('[') => {
            format!("[{address}]:{port}")
        }
        Some(port) => format!("{address}:{port}"),
        None => address.into(),
    }
}

trait ActiveRow {
    fn with_active(self, active: bool) -> Self;
}
impl ActiveRow for ObservationRow {
    fn with_active(mut self, active: bool) -> Self {
        self.active = active;
        self
    }
}

fn api_path(base: &str, name: &str, suffix: Option<&str>) -> String {
    let mut url = Url::parse("http://127.0.0.1/").expect("static URL");
    let (tail, query) = suffix
        .map(|value| {
            value
                .split_once('?')
                .map(|(path, query)| (path, Some(query)))
                .unwrap_or((value, None))
        })
        .unwrap_or(("", None));
    {
        let mut segments = url
            .path_segments_mut()
            .expect("base URL supports path segments");
        for segment in base.split('/').filter(|segment| !segment.is_empty()) {
            segments.push(segment);
        }
        segments.push(name);
        for segment in tail.split('/').filter(|segment| !segment.is_empty()) {
            segments.push(segment);
        }
    }
    let value = url.path().trim_start_matches('/').to_string();
    if let Some(query) = query {
        format!("{value}?{query}")
    } else {
        value
    }
}

fn spawn_runtime_streams(
    controller: &Controller,
    secret: String,
    traffic_stream_id: String,
    sender: async_mpsc::Sender<RuntimeEvent>,
    session: &mut RuntimeSession,
) {
    let logs_url = controller.web_socket_url("logs?format=structured");
    let log_secret = secret.clone();
    let log_sender = sender.clone();
    let task = tokio::spawn(async move {
        websocket_logs(logs_url, log_secret, log_sender).await;
    });
    session.stream_tasks.push(task);
    let traffic_url = controller.web_socket_url("traffic");
    let traffic_sender = sender;
    session.stream_tasks.push(tokio::spawn(async move {
        websocket_traffic(traffic_url, secret, traffic_stream_id, traffic_sender).await;
    }));
}

async fn websocket_logs(url: String, secret: String, sender: async_mpsc::Sender<RuntimeEvent>) {
    loop {
        let mut request = match url.as_str().into_client_request() {
            Ok(value) => value,
            Err(_) => return,
        };
        let value = match tokio_tungstenite::tungstenite::http::HeaderValue::from_str(&format!(
            "Bearer {secret}"
        )) {
            Ok(value) => value,
            Err(_) => return,
        };
        request.headers_mut().insert(AUTHORIZATION, value);
        match tokio_tungstenite::connect_async(request).await {
            Ok((mut socket, _)) => {
                if sender
                    .send(RuntimeEvent::LogStreamStatus(true))
                    .await
                    .is_err()
                {
                    return;
                }
                while let Some(message) = socket.next().await {
                    match message {
                        Ok(Message::Text(text)) => {
                            if let Ok(value) = serde_json::from_str::<Value>(&text) {
                                let time = value
                                    .get("time")
                                    .and_then(Value::as_str)
                                    .unwrap_or("")
                                    .to_string();
                                let level = value
                                    .get("level")
                                    .and_then(Value::as_str)
                                    .or_else(|| value.get("type").and_then(Value::as_str))
                                    .unwrap_or("Info")
                                    .to_string();
                                let message = value
                                    .get("message")
                                    .and_then(Value::as_str)
                                    .or_else(|| value.get("payload").and_then(Value::as_str))
                                    .unwrap_or("");
                                let safe = redact_log(message, &secret);
                                if sender
                                    .send(RuntimeEvent::Log {
                                        time,
                                        level,
                                        message: safe,
                                    })
                                    .await
                                    .is_err()
                                {
                                    return;
                                }
                            }
                        }
                        Ok(Message::Close(_)) | Err(_) => break,
                        _ => {}
                    }
                }
                if sender
                    .send(RuntimeEvent::LogStreamStatus(false))
                    .await
                    .is_err()
                {
                    return;
                }
            }
            Err(_) => {
                let _ = sender.send(RuntimeEvent::LogStreamStatus(false)).await;
            }
        }
        tokio::time::sleep(Duration::from_secs(3)).await;
    }
}

async fn websocket_traffic(
    url: String,
    secret: String,
    stream_id: String,
    sender: async_mpsc::Sender<RuntimeEvent>,
) {
    loop {
        let mut request = match url.as_str().into_client_request() {
            Ok(value) => value,
            Err(_) => return,
        };
        let value = match tokio_tungstenite::tungstenite::http::HeaderValue::from_str(&format!(
            "Bearer {secret}"
        )) {
            Ok(value) => value,
            Err(_) => return,
        };
        request.headers_mut().insert(AUTHORIZATION, value);
        match tokio_tungstenite::connect_async(request).await {
            Ok((mut socket, _)) => {
                while let Some(message) = socket.next().await {
                    if let Ok(Message::Text(text)) = message {
                        if let Ok(value) = serde_json::from_str::<Value>(&text) {
                            if sender
                                .send(RuntimeEvent::Traffic {
                                    stream_id: stream_id.clone(),
                                    up: value.get("up").and_then(Value::as_f64).unwrap_or(0.0),
                                    down: value.get("down").and_then(Value::as_f64).unwrap_or(0.0),
                                    up_total: value
                                        .get("upTotal")
                                        .and_then(Value::as_u64)
                                        .unwrap_or(0),
                                    down_total: value
                                        .get("downTotal")
                                        .and_then(Value::as_u64)
                                        .unwrap_or(0),
                                })
                                .await
                                .is_err()
                            {
                                return;
                            }
                        }
                    }
                }
                if sender
                    .send(RuntimeEvent::StreamDisconnected(stream_id.clone()))
                    .await
                    .is_err()
                {
                    return;
                }
            }
            Err(_) => {
                let _ = sender
                    .send(RuntimeEvent::StreamDisconnected(stream_id.clone()))
                    .await;
            }
        }
        tokio::time::sleep(Duration::from_secs(3)).await;
    }
}

fn redact_log(text: &str, api_secret: &str) -> String {
    let mut safe = text.replace(api_secret, "••••••");
    let pattern =
        regex::Regex::new(r"(?i)(https?://)[^/@\s]+@").expect("static redaction expression");
    safe = pattern.replace_all(&safe, "$1••••••@").into_owned();
    let token = regex::Regex::new(r"(?i)([?&](?:token|secret|key|auth)=)[^&\s]+")
        .expect("static redaction expression");
    token.replace_all(&safe, "$1••••••").into_owned()
}

fn sanitize_file_stem(value: &str) -> String {
    let sanitized = value
        .trim()
        .chars()
        .take(80)
        .map(|character| {
            if character.is_control() || r#"<>:"/\|?*"#.contains(character) {
                '_'
            } else {
                character
            }
        })
        .collect::<String>()
        .trim_matches([' ', '.'])
        .to_string();
    let stem = if sanitized.is_empty() {
        "override".to_string()
    } else {
        sanitized
    };
    let reserved = [
        "CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8",
        "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9",
    ];
    if reserved.iter().any(|name| stem.eq_ignore_ascii_case(name)) {
        format!("override-{stem}")
    } else {
        stem
    }
}
