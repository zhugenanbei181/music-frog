        ui.on_preview_theme_color(move |hue, saturation, value| {
            let _ = sender.send(UiCommand::PreviewThemeColor(hue, saturation, value));
        });
    }
    {
        let sender = sender.clone();
        ui.on_cancel_theme_color_preview(move || {
            let _ = sender.send(UiCommand::CancelThemeColorPreview);
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_theme_color(move |color| {
            let _ = sender.send(UiCommand::SetThemeColor(color.to_string()));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_application_language(move |language| {
            let _ = sender.send(UiCommand::SetApplicationLanguage(language.to_string()));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_page_scale(move |percent| {
            let _ = sender.send(UiCommand::SetPageScale(percent));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_hide_bottom_bar_on_scroll(move |enabled| {
            let _ = sender.send(UiCommand::SetHideBottomBarOnScroll(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_predictive_back_enabled(move |enabled| {
            let _ = sender.send(UiCommand::SetPredictiveBackEnabled(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_hide_background_card(move |enabled| {
            let _ = sender.send(UiCommand::SetHideBackgroundCard(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_show_traffic_notification(move |enabled| {
            let _ = sender.send(UiCommand::SetShowTrafficNotification(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_release_ui_when_background(move |enabled| {
            let _ = sender.send(UiCommand::SetReleaseUiWhenBackground(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_request_ignore_battery_optimization(move || {
            let _ = sender.send(UiCommand::SetIgnoreBatteryOptimizations);
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_refresh_profile_on_start(move |enabled| {
            let _ = sender.send(UiCommand::SetRefreshProfileOnStart(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_auto_start(move |enabled| {
            let _ = sender.send(UiCommand::SetAutoStart(enabled));
        });
    }
    {
        let sender = sender.clone();
        ui.on_set_theme_mode(move |mode| {
            let _ = sender.send(UiCommand::SetThemeMode(mode.to_string()));
        });
    }
    {
        let sender = sender.clone();
        ui.on_clear_traffic_history(move || {
            let _ = sender.send(UiCommand::ClearTrafficHistory);
        });
    }
    {
        let sender = sender.clone();
        ui.on_search_licenses(move |query| {
            let _ = sender.send(UiCommand::SearchLicenses(query.to_string()));
        });
    }
    {
        let sender = sender.clone();
        ui.on_open_license(move |id| {
            let _ = sender.send(UiCommand::OpenLicense(id.to_string()));
        });
    }
    {
        let sender = sender.clone();
        ui.on_retry_license_catalog(move || {
            let _ = sender.send(UiCommand::RetryLicenseCatalog);
        });
    }
}

pub fn apply_state(ui: &AppWindow, state: UiState) {
    let theme_rgb = parse_theme_color(&state.theme_color).unwrap_or([1, 104, 136]);
    let selected_translation = if state.application_language == "system" {
        state.system_language.as_str()
    } else if state.application_language == "en" {
        "en"
    } else {
        "zh-CN"
    };
    if ui.get_current_translated_language() != selected_translation {
        if slint::select_bundled_translation(selected_translation).is_ok() {
            ui.set_current_translated_language(selected_translation.into());
        }
    }
    let previous_settings_id = ui.get_profile_settings_id();
    let previous_user_agent_revision = ui.get_user_agent_save_revision();
    let previous_user_agent_result = ui.get_user_agent_result_revision();
    let previous_theme_color_save_revision = ui.get_theme_color_save_revision();
    let previous_theme_color_result_revision = ui.get_theme_color_result_revision();
    let settings_opened_or_closed = previous_settings_id != state.profile_settings_id;
    ui.set_profiles(std::rc::Rc::new(slint::VecModel::from(state.profiles)).into());
    ui.set_profile_settings_overrides(
        std::rc::Rc::new(slint::VecModel::from(state.profile_settings_overrides)).into(),
    );
    ui.set_proxy_groups(std::rc::Rc::new(slint::VecModel::from(state.proxy_groups)).into());
    ui.set_proxy_nodes(std::rc::Rc::new(slint::VecModel::from(state.proxy_nodes)).into());
    ui.set_proxy_current_node_available(state.proxy_current_node_available);
    ui.set_proxy_testing_group(state.proxy_testing_group);
    ui.set_proxy_testing_node(state.proxy_testing_node);
    ui.set_overrides(std::rc::Rc::new(slint::VecModel::from(state.overrides)).into());
    ui.set_connections(std::rc::Rc::new(slint::VecModel::from(state.connections)).into());
    ui.set_rules(std::rc::Rc::new(slint::VecModel::from(state.rules)).into());
    ui.set_logs(std::rc::Rc::new(slint::VecModel::from(state.logs)).into());
    ui.set_providers(std::rc::Rc::new(slint::VecModel::from(state.providers)).into());
    if ui.get_license_rows_revision() != state.license_rows_revision {
        ui.set_license_rows(
            std::rc::Rc::new(slint::VecModel::from(state.license_rows.as_ref().clone())).into(),
        );
        ui.set_license_rows_revision(state.license_rows_revision);
    }
    ui.set_traffic_samples(std::rc::Rc::new(slint::VecModel::from(state.traffic_samples)).into());
    ui.set_traffic_today_bars(
        std::rc::Rc::new(slint::VecModel::from(state.traffic_today_bars)).into(),
    );
    ui.set_traffic_week_bars(
        std::rc::Rc::new(slint::VecModel::from(state.traffic_week_bars)).into(),
    );
    ui.set_active_profile(state.active_profile);
    ui.set_has_current_profile(state.has_current_profile);
    ui.set_runtime_status(state.runtime_status);
    ui.set_runtime_detail(state.runtime_detail);
    ui.set_route_mode(state.route_mode);
    ui.set_theme_mode(state.theme_mode);
    ui.set_application_dark_mode(state.application_dark_mode);
    ui.set_network_mode(state.network_mode);
    ui.set_network_mode_status(state.network_mode_status);
    ui.set_network_mode_status_warning(state.network_mode_status_warning);
    ui.set_tun_capable(state.tun_capable);
    ui.set_tun_capability_detail(state.tun_capability_detail);
    ui.set_core_version(state.core_version);
    ui.set_user_agent(state.user_agent);
    ui.set_user_agent_result_revision(state.user_agent_result_revision);
    if previous_user_agent_result != state.user_agent_result_revision {
        ui.set_user_agent_saving(false);
        if previous_user_agent_revision == state.user_agent_save_revision {
            ui.set_user_agent_error(state.notice.clone());
        }
    }
    ui.set_user_agent_save_revision(state.user_agent_save_revision);
    ui.set_refresh_current_profile_on_start(state.refresh_current_profile_on_start);
    ui.set_android_platform(state.android_platform);
    ui.set_back_request_revision(state.back_request_revision);
    ui.set_back_gesture_progress(state.back_gesture_progress);
    ui.set_back_gesture_active(state.back_gesture_active);
    ui.set_auto_start(state.auto_start);
    ui.set_application_language(state.application_language);
    ui.set_system_language(state.system_language);
    ui.set_theme_color(slint::Color::from_argb_u8(255, theme_rgb[0], theme_rgb[1], theme_rgb[2]));
    ui.set_theme_accent_light_foreground(state.theme_accent_light_foreground);
    ui.set_theme_color_code(state.theme_color.clone().into());
    ui.set_theme_color_input_code(state.theme_color_input_code);
    ui.set_theme_hue(state.theme_hue);
    ui.set_theme_saturation(state.theme_saturation);
    ui.set_theme_value(state.theme_value);
    ui.set_theme_color_save_revision(state.theme_color_save_revision);
    ui.set_theme_color_result_revision(state.theme_color_result_revision);
    if previous_theme_color_result_revision != state.theme_color_result_revision {
        ui.set_theme_color_saving(false);
        if previous_theme_color_save_revision == state.theme_color_save_revision {
            ui.set_theme_color_error(state.notice.clone());
        } else {
            ui.set_theme_color_dialog_open(false);
        }
    }
    ui.set_invert_theme_foreground(state.invert_theme_foreground);
    ui.set_page_scale_percent(state.page_scale_percent);
    ui.set_hide_bottom_bar_on_scroll(state.hide_bottom_bar_on_scroll);
    ui.set_predictive_back_enabled(state.predictive_back_enabled);
    ui.set_predictive_back_supported(state.predictive_back_supported);
    ui.set_hide_background_card(state.hide_background_card);
    ui.set_recents_screenshot_supported(state.recents_screenshot_supported);
    ui.set_show_traffic_notification(state.show_traffic_notification);
    ui.set_notification_permission_granted(state.notification_permission_granted);
    ui.set_release_ui_when_background(state.release_ui_when_background);
    ui.set_ignore_battery_optimizations(state.ignore_battery_optimizations);
    if previous_user_agent_revision != state.user_agent_save_revision {
        ui.set_user_agent_dialog_open(false);
    }
    ui.set_proxy_recovery_pending(state.proxy_recovery_pending);
    if settings_opened_or_closed {
        if !previous_settings_id.is_empty() && state.profile_settings_id.is_empty() {
            ui.set_page("Config".into());
        }
        ui.set_profile_settings_name(state.profile_settings_name);
        ui.set_profile_settings_location(state.profile_settings_location);
        ui.set_profile_settings_kind(state.profile_settings_kind);
        ui.set_profile_settings_url(state.profile_settings_url);
        ui.set_profile_settings_age_key(state.profile_settings_age_key);
        ui.set_profile_settings_id(state.profile_settings_id);
    }
    let (down_value, down_unit) = compact_rate_parts(state.stat_down.as_str());
    let (up_value, up_unit) = compact_rate_parts(state.stat_up.as_str());
    ui.set_stat_down(state.stat_down);
    ui.set_stat_up(state.stat_up);
    ui.set_stat_down_value(down_value.into());
    ui.set_stat_down_unit(down_unit.into());
    ui.set_stat_up_compact(format!("{up_value} {up_unit}").trim().into());
    ui.set_home_current_node(state.home_current_node);
    ui.set_home_current_accessible(state.home_current_accessible);
    ui.set_home_current_flag_code(state.home_current_flag_code);
    ui.set_home_current_flag_index(state.home_current_flag_index);
    ui.set_home_current_delay(state.home_current_delay);
    ui.set_home_exit_ip(state.home_exit_ip);
    ui.set_home_exit_country_code(state.home_exit_country_code);
    ui.set_home_exit_flag_index(state.home_exit_flag_index);
    ui.set_home_exit_status(state.home_exit_status);
    ui.set_home_traffic_points(
        std::rc::Rc::new(slint::VecModel::from(state.home_traffic_points)).into(),
    );
    ui.set_home_traffic_has_data(state.home_traffic_has_data);
    ui.set_traffic_stream_status(state.traffic_stream_status);
    ui.set_stat_connections(state.stat_connections);
    ui.set_connection_search(state.connection_search);
    ui.set_connection_sort(state.connection_sort);
    ui.set_connection_show_closed(state.connection_show_closed);
    ui.set_connection_detail_id(state.connection_detail_id);
    ui.set_connection_detail_host(state.connection_detail_host);
    ui.set_connection_detail_protocol(state.connection_detail_protocol);
    ui.set_connection_detail_process(state.connection_detail_process);
    ui.set_connection_detail_source(state.connection_detail_source);
    ui.set_connection_detail_destination(state.connection_detail_destination);
    ui.set_connection_detail_rule(state.connection_detail_rule);
    ui.set_connection_detail_chains(state.connection_detail_chains);
    ui.set_connection_detail_providers(state.connection_detail_providers);
    ui.set_connection_detail_start(state.connection_detail_start);
    ui.set_connection_detail_duration(state.connection_detail_duration);
    ui.set_connection_detail_upload(state.connection_detail_upload);
    ui.set_connection_detail_download(state.connection_detail_download);
    ui.set_connection_detail_active(state.connection_detail_active);
    ui.set_connection_breaking_id(state.connection_breaking_id);
    ui.set_log_search(state.log_search);
    ui.set_log_level(state.log_level);
    ui.set_log_stream_status(state.log_stream_status);
    ui.set_rule_search(state.rule_search);
    ui.set_rule_pending_index(state.rule_pending_index);
    ui.set_stat_total_down(state.stat_total_down);
    ui.set_stat_total_up(state.stat_total_up);
    ui.set_traffic_today_down(state.traffic_today_down);
    ui.set_traffic_today_up(state.traffic_today_up);
    ui.set_traffic_week_down(state.traffic_week_down);
    ui.set_traffic_week_up(state.traffic_week_up);
    ui.set_traffic_week_average_down(state.traffic_week_average_down);
    ui.set_traffic_week_average_up(state.traffic_week_average_up);
    ui.set_traffic_today_has_data(state.traffic_today_has_data);
    ui.set_traffic_week_has_data(state.traffic_week_has_data);
    ui.set_selected_group(state.selected_group);
    ui.set_content_preview(state.content_preview);
    ui.set_content_preview_profile(state.content_preview_profile);
    ui.set_license_query(state.license_query);
    ui.set_license_catalog_error(state.license_catalog_error);
    if ui.get_license_detail_revision() != state.license_detail_revision {
        if let Some(detail) = state.license_detail.as_ref() {
            ui.set_license_detail_name(detail.name.clone().into());
            ui.set_license_detail_version(detail.version.clone().into());
            ui.set_license_detail_identifier(detail.license.clone().into());
            ui.set_license_detail_text(detail.text.clone().into());
        } else {
            ui.set_license_detail_name("".into());
            ui.set_license_detail_version("".into());
            ui.set_license_detail_identifier("".into());
            ui.set_license_detail_text("".into());
        }
        ui.set_license_detail_error(state.license_detail_error);
        ui.set_license_detail_revision(state.license_detail_revision);
    }
    ui.set_override_edit_id(state.override_edit_id);
    ui.set_override_name(state.override_name);
    ui.set_override_body(state.override_body);
    ui.set_override_importing(state.override_importing);
    ui.set_override_import_error(state.override_import_error);
    let previous_override_import_revision = ui.get_override_import_revision();
    if previous_override_import_revision != state.override_import_revision {
        ui.set_override_url("".into());
        ui.set_override_import_revision(state.override_import_revision);
    }
    if ui.get_page() == "AppSettings" && ui.get_notice() != state.notice {
        ui.set_app_settings_message(state.notice.clone());
    }
    ui.set_notice(state.notice);
}

fn compact_rate_parts(rate: &str) -> (String, String) {
    let rate = rate.strip_suffix("/s").unwrap_or(rate).trim();
    match rate.rsplit_once(' ') {
        Some((value, unit)) => (value.trim().to_owned(), unit.trim().to_owned()),
        None => (rate.to_owned(), String::new()),
    }
}

