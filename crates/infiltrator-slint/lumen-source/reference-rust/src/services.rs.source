#[derive(Clone)]
struct ConnectionEntry {
    id: String,
    host: String,
    process: String,
    protocol: String,
    source: String,
    destination: String,
    rule: String,
    chains: String,
    providers: String,
    started_at: String,
    started_at_epoch_ms: i64,
    closed_at_epoch_ms: Option<i64>,
    upload_bytes: f64,
    download_bytes: f64,
    active: bool,
}

impl ConnectionEntry {
    fn row(&self, closed: bool) -> ObservationRow {
        let chain_count = self
            .chains
            .split(" → ")
            .filter(|item| !item.is_empty())
            .count();
        let subtitle = format!(
            "{} · {} · {} 个代理",
            self.protocol, self.process, chain_count
        );
        let status = if closed { "已关闭 · " } else { "" };
        row(
            self.id.clone(),
            self.host.clone(),
            subtitle,
            format!(
                "{status}{} · ↑ {}  ↓ {}",
                self.started_at,
                mihomo::format_bytes(self.upload_bytes),
                mihomo::format_bytes(self.download_bytes)
            ),
        )
        .with_active(!closed)
    }

    fn duration(&self) -> String {
        if self.started_at_epoch_ms <= 0 {
            return "未知".into();
        }
        let end = self
            .closed_at_epoch_ms
            .unwrap_or_else(|| Utc::now().timestamp_millis());
        let elapsed = end.saturating_sub(self.started_at_epoch_ms).max(0) as u64 / 1000;
        let hours = elapsed / 3600;
        let minutes = (elapsed % 3600) / 60;
        let seconds = elapsed % 60;
        if hours > 0 {
            format!("{hours} 小时 {minutes} 分钟")
        } else if minutes > 0 {
            format!("{minutes} 分钟 {seconds} 秒")
        } else {
            format!("{seconds} 秒")
        }
    }
}

#[derive(Clone)]
enum RuntimeEvent {
    Log {
        time: String,
        level: String,
        message: String,
    },
    Traffic {
