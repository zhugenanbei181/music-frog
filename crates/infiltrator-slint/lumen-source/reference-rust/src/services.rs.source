        "等待 Mihomo 日志流" => "Waiting for the Mihomo log stream",
        _ => return value.to_string(),
    };
    exact.to_string()
}

fn english_po_lookup(message: &str) -> Option<String> {
    static CATALOG: OnceLock<HashMap<String, String>> = OnceLock::new();
    let catalog = CATALOG.get_or_init(|| {
        let lines = include_str!("../translations/en/LC_MESSAGES/lumen.po")
            .lines()
            .collect::<Vec<_>>();
        let mut entries = HashMap::new();
        let mut index = 0;
        while index + 1 < lines.len() {
            if let Some(source) = lines[index].strip_prefix("msgid ") {
                if let Some(target) = lines[index + 1].strip_prefix("msgstr ") {
                    let source = decode_po_string(source);
                    let target = decode_po_string(target);
                    if !source.is_empty() {
                        entries.insert(source, target);
                    }
                    index += 2;
                    continue;
                }
            }
            index += 1;
        }
        entries
    });
    catalog.get(message).cloned().or_else(|| {
        catalog
            .iter()
            .filter(|(source, _)| source.ends_with('：') && message.starts_with(source.as_str()))
            .max_by_key(|(source, _)| source.len())
            .map(|(source, target)| format!("{target}{}", &message[source.len()..]))
    })
}

fn decode_po_string(value: &str) -> String {
    let value = value.trim().trim_matches('"');
    value
        .replace("\\n", "\n")
        .replace("\\t", "\t")
        .replace("\\\"", "\"")
        .replace("\\\\", "\\")
}

