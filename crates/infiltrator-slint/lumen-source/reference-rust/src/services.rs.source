fn parse_theme_color(value: &str) -> Option<[u8; 3]> {
    let input = value.trim();
    let hex = input
        .strip_prefix("##")
        .or_else(|| input.strip_prefix('#'))
        .unwrap_or(input);
    if hex.len() != 6 || !hex.is_ascii() {
        return None;
    }
    Some([
        u8::from_str_radix(&hex[0..2], 16).ok()?,
        u8::from_str_radix(&hex[2..4], 16).ok()?,
        u8::from_str_radix(&hex[4..6], 16).ok()?,
    ])
}

fn rgb_to_hsv([red, green, blue]: [u8; 3]) -> (f32, f32, f32) {
    let r = red as f32 / 255.0;
    let g = green as f32 / 255.0;
    let b = blue as f32 / 255.0;
    let max = r.max(g).max(b);
    let min = r.min(g).min(b);
    let delta = max - min;
    let hue = if delta == 0.0 {
        0.0
    } else if max == r {
        60.0 * (((g - b) / delta) % 6.0)
    } else if max == g {
        60.0 * (((b - r) / delta) + 2.0)
    } else {
        60.0 * (((r - g) / delta) + 4.0)
    };
    (hue.rem_euclid(360.0), if max == 0.0 { 0.0 } else { delta / max }, max)
}

fn hsv_to_theme_color(hue: f32, saturation: f32, value: f32) -> String {
    let hue = hue.rem_euclid(360.0);
    let saturation = saturation.clamp(0.0, 1.0);
    let value = value.clamp(0.0, 1.0);
    let chroma = value * saturation;
    let x = chroma * (1.0 - (((hue / 60.0) % 2.0) - 1.0).abs());
    let m = value - chroma;
    let (r, g, b) = match hue {
        h if h < 60.0 => (chroma, x, 0.0),
        h if h < 120.0 => (x, chroma, 0.0),
        h if h < 180.0 => (0.0, chroma, x),
        h if h < 240.0 => (0.0, x, chroma),
        h if h < 300.0 => (x, 0.0, chroma),
        _ => (chroma, 0.0, x),
    };
    format!("#{:02X}{:02X}{:02X}", ((r + m) * 255.0).round() as u8, ((g + m) * 255.0).round() as u8, ((b + m) * 255.0).round() as u8)
}

fn should_use_light_foreground(rgb: [u8; 3]) -> bool {
    let linear = rgb.map(|channel| {
        let value = channel as f32 / 255.0;
        if value <= 0.04045 { value / 12.92 } else { ((value + 0.055) / 1.055).powf(2.4) }
    });
    let luminance = linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722;
    luminance < 0.179
}

fn system_language_from_environment() -> String {
    #[cfg(windows)]
    {
        let mut locale = [0u16; 85];
        let length = unsafe {
            windows_sys::Win32::Globalization::GetUserDefaultLocaleName(
                locale.as_mut_ptr(),
                locale.len() as i32,
            )
        };
        if length > 1 {
            let name = String::from_utf16_lossy(&locale[..(length - 1) as usize]);
            if name.to_ascii_lowercase().starts_with("en") {
                return "en".into();
            }
            if name.to_ascii_lowercase().starts_with("zh") {
                return "zh-CN".into();
            }
        }
        return "zh-CN".into();
    }
    #[cfg(not(windows))]
    ["LC_ALL", "LC_MESSAGES", "LANGUAGE", "LANG"]
        .into_iter()
        .filter_map(|name| std::env::var(name).ok())
        .find_map(|value| {
            let normalized = value.to_ascii_lowercase();
            if normalized.starts_with("en") {
                Some("en".into())
            } else if normalized.starts_with("zh") {
                Some("zh-CN".into())
            } else {
                None
            }
        })
        .unwrap_or_else(|| "zh-CN".into())
}

fn english_ui_text(value: &str) -> String {
    if let Some(color) = value.strip_prefix("主题色已设为 ") {
        return format!("Theme color set to {color}");
    }
    if let Some(rest) = value.strip_prefix("无法保存") {
        let title = rest.split('：').next().unwrap_or_default();
        let subject = match title {
            " User-Agent" => "the User-Agent",
            "启动时更新设置" => "the update-on-launch setting",
            "前景色设置" => "the foreground setting",
            "主题色" => "the theme color",
            "应用语言" => "the application language",
            "页面缩放" => "the UI scale",
            "底栏设置" => "the navigation bar setting",
            "后台轻量模式" => "background light mode",
            "后台卡片设置" => "the Recents setting",
            "流量通知设置" => "the traffic notification setting",
            "自动启动偏好" => "the launch-at-startup setting",
            "预测返回设置" => "the predictive back setting",
            "模式偏好" => "the mode preference",
            "网络接管模式" => "the network control mode",
            _ => "the requested setting",
        };
        let reason = rest.strip_prefix(title).unwrap_or_default().replace('：', ":");
        return format!("Unable to save {subject}{reason}");
    }
    for (prefix, translated) in [
        ("无法修改登录自动启动：", "Unable to change launch at sign-in: "),
        ("无法打开 Android 电池设置：", "Unable to open Android battery settings: "),
        ("无法请求 Android 通知权限：", "Unable to request Android notification permission: "),
        ("无法启用 Android 开机通知：", "Unable to enable the Android startup notification: "),
        ("无法设置 Android 预测返回：", "Unable to configure Android predictive back: "),
        ("无法打开 Android 文件选择器：", "Unable to open the Android file picker: "),
        ("无法修改 Android 后台卡片：", "Unable to change Android Recents visibility: "),
        ("无法同步 Android 通知语言：", "Unable to synchronize the Android notification language: "),
    ] {
        if let Some(detail) = value.strip_prefix(prefix) {
            return format!("{translated}{detail}");
        }
    }
    if let Some(translation) = english_po_lookup(value) {
        return translation;
    }
    let exact = match value {
        "未选择配置" => "No profile selected",
        "尚未启动 Mihomo" => "Mihomo has not started",
        "本地 Mihomo 已就绪" => "Local Mihomo is ready",
        "Runtime 未运行" => "Runtime is stopped",
        "未运行" => "Not running",
        "未知" => "Unknown",
        "未检测" => "Not detected",
        "User-Agent 最多 512 字节" => "The User-Agent must be 512 bytes or fewer",
        "User-Agent 格式无效；请删除换行或控制字符" => "Invalid User-Agent; remove newlines and control characters",
        "不支持的应用语言" => "Unsupported application language",
        "不支持的主题模式" => "Unsupported theme mode",
        "核心不可用" => "Mihomo core unavailable",
        "启动后获取" => "Available after launch",
        "查询中" => "Checking…",
        "代理已停止" => "Proxy stopped",
        "状态不可用" => "Status unavailable",
        "服务运行中" => "Service running",
        "实时流已连接" => "Live stream connected",
        "正在连接流量采样" => "Connecting to traffic sampling",
        "系统代理已启用" => "System proxy enabled",
        "系统代理未启用" => "System proxy disabled",
        "VPN 未连接" => "VPN is disconnected",
        "TUN 平台适配待验证" => "TUN platform integration is unverified",
        "Linux TUN 权限与路由恢复适配尚未实现" => "Linux TUN permissions and route recovery are not implemented",
        "当前平台尚未接入 TUN 适配" => "TUN integration is not available on this platform",
        "当前 Lumen 已有管理员权限，可尝试启用 Windows TUN" => "Lumen has administrator access; Windows TUN can be enabled",
        "需以管理员身份重新启动 Lumen；应用不会自动提升权限" => "Restart Lumen as administrator; the app will not elevate itself",
        "Runtime 运行中；系统代理状态由平台适配器核对" => "Runtime is running; the platform adapter checks the system proxy state",
        "Runtime 未运行，但检测到 Lumen TUN 网卡或默认路由仍活动；请在 Windows 网络设置中恢复" => "Runtime is stopped, but a Lumen TUN adapter or default route is still active. Restore it in Windows network settings.",
