    callback navigate(string);
    callback color-scheme-changed(bool);
    callback add-url-profile(string, string, string);
    callback choose-profile-file(string, string);
    callback set-current-profile(string);
    callback move-profile(string, bool);
    callback delete-profile(string);
    callback refresh-profile(string);
    callback open-profile-settings(string);
    callback show-profile-preview(string);
    callback save-profile-settings(string, string, string, string);
    callback cancel-profile-settings();
    callback toggle-profile-override(string, bool);
    callback move-profile-override(string, bool);
    callback start-runtime();
    callback stop-runtime();
    callback set-route-mode(string);
    callback set-network-mode(string);
    callback check-core();
    callback retry-proxy-restore();
    callback add-override(string, string);
    callback import-override-url(string);
    callback choose-override-file();
    callback save-override(string, string);
    callback delete-override(string);
    callback export-override(string);
    callback edit-override(string);
    callback apply-override(string);
    callback select-proxy-group(string);
    callback select-proxy(string, string);
    callback search-proxy-nodes(string);
    callback set-proxy-sort(string);
    callback test-proxy(string, string);
    callback refresh-home-egress();
    callback close-connection(string);
    callback open-connection(string);
    callback search-connections(string);
    callback set-connection-view(bool);
    callback set-connection-sort(string);
    callback search-logs(string);
    callback set-log-level(string);
    callback search-rules(string);
    callback set-rule-enabled(string, bool);
    callback update-provider(string);
    callback export-logs();
    callback refresh-observations();
    callback save-user-agent(string);
    callback set-refresh-profile-on-start(bool);
    callback set-auto-start(bool);
    callback set-theme-mode(string);
    callback set-invert-theme-foreground(bool);
    callback preview-theme-color(float, float, float);
    callback cancel-theme-color-preview();
    callback set-theme-color(string);
    callback set-application-language(string);
    callback set-page-scale(int);
    callback set-hide-bottom-bar-on-scroll(bool);
    callback set-predictive-back-enabled(bool);
    callback set-hide-background-card(bool);
    callback set-show-traffic-notification(bool);
    callback set-release-ui-when-background(bool);
    callback request-ignore-battery-optimization();
    callback cache-back-preview();
    callback commit-back-preview();
    callback confirm-delete-profile(string);
    callback export-profile(string);
    callback clear-traffic-history();
    callback search-licenses(string);
    callback open-license(string);
    callback retry-license-catalog();

    changed page => {
        if root.page != "Proxy" && root.selected-group != "" {
            root.selected-group = "";
        }
        page-scroll.content-y = 0px * LumenUiScale.factor;
        root.last-page-scroll-y = 0px * LumenUiScale.factor;
        root.bottom-bar-visible = true;
        root.update-color-scheme();
    }

    changed selected-group => {
        root.proxy-active-node-position = 0px * LumenUiScale.factor;
        root.proxy-current-node-available = false;
        root.update-color-scheme();
        root.select-proxy-group(root.selected-group);
    }
    changed proxy-nodes => {
        root.proxy-active-node-position = 0px * LumenUiScale.factor;
    }
    changed profile-add-open => {
        root.update-color-scheme();
        root.profile-type-menu-open = false;
        if root.profile-add-open {
            profile-add-sheet.show();
        } else {
            profile-add-sheet.close();
        }
    }
    changed layout-debug-bounds => { LumenTheme.show-layout-bounds = root.layout-debug-bounds; }
    changed user-agent-dialog-open => {
        if root.user-agent-dialog-open { user-agent-sheet.show(); }
        else { user-agent-sheet.close(); }
    }
    changed profile-action-open => {
        if root.profile-action-open { profile-action-sheet.show(); }
        else { profile-action-sheet.close(); }
    }
    changed pending-delete-id => {
        if root.pending-delete-id != "" { profile-delete-sheet.show(); }
        else { profile-delete-sheet.close(); }
    }
    changed pending-profile-export-id => {
        if root.pending-profile-export-id != "" { profile-share-sheet.show(); }
        else { profile-share-sheet.close(); }
    }
    changed profile-settings-id => {
        if root.profile-settings-id != "" {
            root.profile-settings-type-index = 0;
            root.profile-settings-type-menu-open = false;
            profile-settings-sheet.show();
        } else {
            root.profile-settings-type-menu-open = false;
            profile-settings-sheet.close();
        }
    }
    changed back-request-revision => { root.go-back(); }
    changed application-dark-mode => { root.update-color-scheme(); }
    changed page-scale-percent => { LumenUiScale.factor = root.page-scale-percent / 100.0; }
    changed theme-color => {
        LumenTheme.user-accent = root.theme-color;
        MaterialPalette.schemes = LumenTheme.material-schemes;
    }
    changed theme-color-code => {
        if root.theme-color-dialog-open && !root.theme-color-code-edited {
            root.theme-color-code-draft = root.theme-color-input-code;
            root.theme-color-draft = root.theme-color-input-code;
        }
    }
    changed theme-color-input-code => {
        if root.theme-color-dialog-open && !root.theme-color-code-edited {
            root.theme-color-code-draft = root.theme-color-input-code;
            root.theme-color-draft = root.theme-color-input-code;
        }
    }
    changed theme-accent-light-foreground => {
        LumenTheme.accent-foreground = root.theme-accent-light-foreground ? #FFFFFF : #000000;
        MaterialPalette.schemes = LumenTheme.material-schemes;
    }
    changed invert-theme-foreground => {
        LumenTheme.invert-semantic-foreground = root.invert-theme-foreground;
        MaterialPalette.schemes = LumenTheme.material-schemes;
    }
    changed theme-color-dialog-open => {
        if root.theme-color-dialog-open { theme-color-sheet.show(); }
        else { theme-color-sheet.close(); }
    }
    changed page-scale-dialog-open => {
        if root.page-scale-dialog-open { page-scale-sheet.show(); }
        else {
            page-scale-sheet.close();
            if root.page-scale-committing { root.page-scale-committing = false; }
            else { LumenUiScale.factor = root.page-scale-percent / 100.0; }
        }
    }
    changed page-scale-draft => { LumenUiScale.factor = root.page-scale-draft / 100.0; }
    changed profiles => {
        if root.profile-add-open && root.profiles.length > root.profile-count-at-open {
            root.close-profile-add();
        }
    }

    function update-color-scheme() {
        LumenTheme.dark-mode = root.application-dark-mode;
        MaterialPalette.schemes = LumenTheme.material-schemes;
        root.color-scheme-changed(root.application-dark-mode);
    }

    function locate-current-node() {
        if !root.proxy-current-node-available || root.proxy-active-node-position == 0px * LumenUiScale.factor || page-scroll.visible-height <= 0px * LumenUiScale.factor {
            return;
        }
        let target-y = page-scroll.absolute-position.y + max(16px * LumenUiScale.factor, (page-scroll.visible-height - 76px * LumenUiScale.factor) / 2);
        let delta = root.proxy-active-node-position - target-y;
        page-scroll.content-y = max(
            page-scroll.visible-height - page-scroll.content-height,
            min(0px * LumenUiScale.factor, page-scroll.content-y - delta)
        );
    }

    function open-profile-add() {
        root.profile-name = "";
        root.profile-url = "";
        root.profile-age-key = "";
        root.notice = "";
        root.profile-add-kind-index = 0;
        root.profile-type-menu-open = false;
        root.profile-count-at-open = root.profiles.length;
        root.profile-add-open = true;
    }

    function close-profile-add() {
        root.profile-add-open = false;
        root.profile-type-menu-open = false;
        root.profile-name = "";
        root.profile-url = "";
        root.profile-age-key = "";
        root.notice = "";
    }

    function go-back() {
        if app-theme-menu.is-open {
            app-theme-menu.close();
            return;
        }
        if app-language-menu.is-open {
            app-language-menu.close();
            return;
        }
        proxy-sort-menu.close();
        app-theme-menu.close();
        if root.theme-color-dialog-open {
            root.theme-color-dialog-open = false;
            root.cancel-theme-color-preview();
        } else if root.page-scale-dialog-open {
            root.page-scale-dialog-open = false;
        } else if root.user-agent-dialog-open {
            root.user-agent-dialog-open = false;
        } else if root.profile-settings-type-menu-open {
            root.profile-settings-type-menu-open = false;
        } else if root.profile-type-menu-open {
            root.profile-type-menu-open = false;
        } else if root.profile-settings-id != "" {
            root.cancel-profile-settings();
        } else if root.profile-action-open {
            root.profile-action-open = false;
            root.profile-action-id = "";
            root.profile-action-name = "";
        } else if root.pending-profile-export-id != "" {
            root.pending-profile-export-id = "";
            root.pending-profile-export-name = "";
        } else if root.pending-delete-id != "" {
            root.pending-delete-id = "";
            root.pending-delete-name = "";
        } else if root.profile-add-open {
            root.close-profile-add();
        } else if root.page == "Proxy" && root.selected-group != "" {
            root.selected-group = "";
            root.proxy-search = "";
        } else if root.page == "ProfileSettings" || root.page == "Preview" {
            if root.page == "ProfileSettings" { root.cancel-profile-settings(); }
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = "Config";
            root.navigate("Config");
        } else if root.page == "ConnectionDetail" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = "Connections";
            root.navigate("Connections");
        } else if root.page == "LicenseDetail" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = "Licenses";
            root.navigate("Licenses");
        } else if root.page == "Licenses" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = "About";
            root.navigate("About");
        } else if root.page == "Network" || root.page == "AppSettings" || root.page == "Overrides" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = root.page-origin;
            root.navigate(root.page-origin);
        } else if root.page == "Providers" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = root.page-origin;
            root.navigate(root.page-origin);
        } else if root.page == "Meta" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = root.page-origin;
            root.navigate(root.page-origin);
        } else if root.page == "Connections" || root.page == "Logs" || root.page == "Rules" || root.page == "Traffic" {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = root.page-origin;
            root.navigate(root.page-origin);
        } else if root.page == "Home" || root.page == "Proxy" || root.page == "Config" || root.page == "Settings" {
            // Android system Back and the in-app back control never leave a root page.
        } else {
            if root.predictive-back-enabled { root.commit-back-preview(); }
            root.page = "Settings";
            root.navigate("Settings");
        }
    }

    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
        height: max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
        background: transparent;
        HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px * LumenUiScale.factor;
        if !root.compact-layout: Rectangle {
            width: 228px * LumenUiScale.factor;
            background: #FFFFFF;
            border-width: 0px * LumenUiScale.factor;
            VerticalLayout {
                x: 18px * LumenUiScale.factor; y: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height - 36px * LumenUiScale.factor;
                spacing: 6px * LumenUiScale.factor;
                HorizontalLayout {
                    height: 44px * LumenUiScale.factor; spacing: 10px * LumenUiScale.factor;
                    Rectangle { width: 34px * LumenUiScale.factor; height: 34px * LumenUiScale.factor; border-radius: 9px * LumenUiScale.factor; background: #0B667F;
                        Text { text: "L"; color: #FFFFFF; font-size: 19px * LumenUiScale.factor; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout { spacing: 0px * LumenUiScale.factor; alignment: center;
                        Text { text: "Lumen"; color: LumenTheme.text-primary; font-size: 16px * LumenUiScale.factor; font-weight: 700; }
                        Text { text: "MIHOMO CLIENT"; color: LumenTheme.text-secondary; font-size: 9px * LumenUiScale.factor; }
                    }
                }
                Rectangle { height: 20px * LumenUiScale.factor; background: transparent; }
                NavButton { label: @tr("首页"); target: "Home"; compact: false; icon: @image-url("../assets/icons/home.svg"); active-icon: @image-url("../assets/icons/home-active.svg"); active: root.page == "Home"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Home"; root.navigate("Home"); } }
                NavButton { label: @tr("代理"); target: "Proxy"; compact: false; icon: @image-url("../assets/icons/proxy.svg"); active-icon: @image-url("../assets/icons/proxy-active.svg"); active: root.page == "Proxy"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Proxy"; root.navigate("Proxy"); } }
                NavButton { label: @tr("配置"); target: "Config"; compact: false; icon: @image-url("../assets/icons/config.svg"); active-icon: @image-url("../assets/icons/config-active.svg"); active: root.page == "Config"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; root.navigate("Config"); } }
                Rectangle { height: 1px * LumenUiScale.factor; background: #E6E6E6; }
                NavButton { label: @tr("设置"); target: "Settings"; compact: false; icon: @image-url("../assets/icons/settings.svg"); active-icon: @image-url("../assets/icons/settings-active.svg"); active: root.page == "Settings" || root.page == "Network" || root.page == "AppSettings" || root.page == "Overrides" || root.page == "About" || root.page == "Licenses" || root.page == "LicenseDetail"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Settings"; root.navigate("Settings"); } }
                Rectangle { height: 1px * LumenUiScale.factor; background: #E6E6E6; }
                Text { text: @tr("运行观测"); color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; }
                NavButton { label: @tr("连接"); target: "Connections"; icon: @image-url("../assets/icons/connections.svg"); active-icon: @image-url("../assets/icons/connections.svg"); active: root.page == "Connections"; clicked => { root.page-origin = "Settings"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Connections"; root.navigate("Connections"); } }
                NavButton { label: @tr("日志"); target: "Logs"; icon: @image-url("../assets/icons/logs.svg"); active-icon: @image-url("../assets/icons/logs.svg"); active: root.page == "Logs"; clicked => { root.page-origin = "Settings"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Logs"; root.navigate("Logs"); } }
                NavButton { label: @tr("规则"); target: "Rules"; icon: @image-url("../assets/icons/rules.svg"); active-icon: @image-url("../assets/icons/rules.svg"); active: root.page == "Rules"; clicked => { root.page-origin = "Settings"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Rules"; root.navigate("Rules"); } }
                NavButton { label: @tr("流量"); target: "Traffic"; icon: @image-url("../assets/icons/traffic.svg"); active-icon: @image-url("../assets/icons/traffic.svg"); active: root.page == "Traffic"; clicked => { root.page-origin = "Settings"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Traffic"; root.navigate("Traffic"); } }
                Rectangle { height: 1px * LumenUiScale.factor; background: #E6E6E6; }
                Text { text: root.runtime-status; color: root.runtime-status == "Running" ? #0B667F : #666666; font-size: 12px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; }
                Text { text: root.runtime-detail; color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; wrap: word-wrap; }
                Rectangle { height: 1px * LumenUiScale.factor; background: #E6E6E6; }
                Text { text: root.active-profile; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; overflow: elide; }
                Text { text: root.network-mode; color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "Lumen · 0.1.0"; color: LumenTheme.text-secondary; font-size: 10px * LumenUiScale.factor; x: 10px * LumenUiScale.factor; }
            }
        }

        main-panel := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            height: root.compact-layout && root.primary-page
                ? max(0px * LumenUiScale.factor, parent.height - (root.bottom-bar-visible ? LumenTheme.navigation-height + 20px * LumenUiScale.factor : 0px * LumenUiScale.factor))
                : parent.height;
            clip: true;
            background: LumenTheme.canvas;
            VerticalLayout {
                width: parent.width; spacing: 0px * LumenUiScale.factor;
                height: parent.height;
                if root.primary-page && !(root.page == "Proxy" && root.selected-group != "") && !(root.compact-layout && (root.page == "Home" || root.page == "Proxy")): LargeAppBar {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    compact: root.compact-layout && root.page == "Settings";
                    title: root.page == "Home" ? "Lumen" : root.page == "Proxy" ? @tr("节点") : root.page == "Config" ? @tr("配置") : @tr("设置");
                    show-background: false;
                    trailing-buttons: root.page == "Proxy" ? [{ icon: @image-url("../assets/icons/sort.svg"), tooltip: @tr("代理排序和操作"), enabled: true }] : [];
                    trailing-button-clicked(index) => { proxy-sort-menu.show(); }
                }
                if root.compact-layout && root.page == "Proxy" && root.selected-group == "": Rectangle {
                    horizontal-stretch: 1;
                    height: 112px * LumenUiScale.factor;
                    background: transparent;
                    VerticalLayout {
                        x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height;
                        padding-top: 0px * LumenUiScale.factor;
                        spacing: 3px * LumenUiScale.factor;
                        HorizontalLayout {
                            width: parent.width; height: 48px * LumenUiScale.factor;
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            IconButton {
                                width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor;
                                icon: @image-url("../assets/icons/sort.svg");
                                tooltip: @tr("代理排序和操作");
                                clicked => { proxy-sort-menu.show(); }
                            }
                        }
                        Text { text: @tr("节点"); color: LumenTheme.text-primary; font-size: 38px * LumenUiScale.factor; font-weight: 450; height: 54px * LumenUiScale.factor; vertical-alignment: center; }
                    }
                }
                if root.compact-layout && root.page == "Home": Rectangle {
                    horizontal-stretch: 1;
                    height: root.height < 760px * LumenUiScale.factor ? 24px * LumenUiScale.factor : root.height < 840px * LumenUiScale.factor ? 32px * LumenUiScale.factor : 40px * LumenUiScale.factor;
                    background: transparent;
                    if page-scroll.content-y < -72px: Text {
                        horizontal-stretch: 1;
                        height: parent.height;
                        text: "Lumen";
                        color: LumenTheme.text-primary;
                        font-size: 20px * LumenUiScale.factor;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if !root.primary-page: SmallAppBar {
                    horizontal-stretch: 1;
                    title: root.page == "AppSettings" ? "" : root.page == "Meta" ? @tr("Meta 功能") : root.page == "Network" ? @tr("网络设置") : root.page == "AppSettings" ? @tr("应用设置") : root.page == "Overrides" ? @tr("覆写") : root.page == "Connections" ? @tr("连接") : root.page == "ConnectionDetail" ? @tr("连接详情") : root.page == "Logs" ? @tr("日志") : root.page == "Rules" ? @tr("规则") : root.page == "Traffic" ? @tr("流量统计") : root.page == "Providers" ? @tr("外部资源") : root.page == "Preview" ? root.content-preview-profile : root.page == "ProfileSettings" ? @tr("订阅设置") : root.page == "About" ? @tr("关于") : root.page == "Licenses" ? @tr("开源许可") : root.page == "LicenseDetail" ? root.license-detail-name : root.page;
                    show-background: false;
                    leading-button: { icon: @image-url("../assets/icons/back.svg"), tooltip: @tr("返回"), enabled: true };
                    leading-button-clicked => { root.go-back(); }
                }
                page-scroll := ScrollView {
                    content-width: self.width;
                    changed content-y => {
                        let delta = self.content-y - root.last-page-scroll-y;
                        if root.primary-page && root.hide-bottom-bar-on-scroll && abs(delta) > 3px * LumenUiScale.factor {
                            root.bottom-bar-visible = delta > 0px;
                        } else if !root.hide-bottom-bar-on-scroll || !root.primary-page {
                            root.bottom-bar-visible = true;
                        }
                        root.last-page-scroll-y = self.content-y;
                    }
                    mouse-drag-pan-enabled: root.android-platform;
                    vertical-stretch: 1;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        x: root.compact-layout ? (root.page == "Home" ? 24px * LumenUiScale.factor : root.page == "AppSettings" ? 10px * LumenUiScale.factor : 16px * LumenUiScale.factor) : 30px * LumenUiScale.factor;
                        width: parent.width - (root.compact-layout ? (root.page == "Home" ? 48px * LumenUiScale.factor : root.page == "AppSettings" ? 20px * LumenUiScale.factor : 32px * LumenUiScale.factor) : 60px * LumenUiScale.factor);
                        padding-left: 0px * LumenUiScale.factor;
                        padding-right: 0px * LumenUiScale.factor;
                        padding-top: root.compact-layout ? (root.page == "Home" || root.page == "Config" || root.page == "Settings" ? 8px * LumenUiScale.factor : root.page == "Proxy" && root.selected-group != "" ? 0px * LumenUiScale.factor : 16px * LumenUiScale.factor) : 24px * LumenUiScale.factor;
                        padding-bottom: root.compact-layout && root.primary-page ? (root.bottom-bar-visible ? LumenTheme.space-6 : LumenTheme.space-3) : 24px * LumenUiScale.factor;
                        spacing: 0px * LumenUiScale.factor;
                        alignment: start;

                        if root.page == "Home": VerticalLayout {
                            width: parent.width;
                            spacing: LumenTheme.space-4;
                            alignment: start;
                            if root.compact-layout: VerticalLayout {
                                width: parent.width;
                                spacing: 0px * LumenUiScale.factor;
                                alignment: start;
                                Text { text: "Lumen"; color: LumenTheme.text-primary; font-size: 32px * LumenUiScale.factor; font-weight: 400; height: 48px * LumenUiScale.factor; vertical-alignment: center; }
                                Rectangle { height: root.home-title-gap; background: transparent; }
                                HorizontalLayout {
                                    width: parent.width; height: 32px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                    Text { text: "DOWNLOAD"; color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; font-weight: 400; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if root.profiles.length > 0: HomeProfileBadge {
                                        badge-width: min(190px * LumenUiScale.factor, max(0px * LumenUiScale.factor, parent.width - 104px * LumenUiScale.factor));
                                        profile-name: root.active-profile;
                                        route-mode: root.route-mode;
                                    }
                                }
                                Rectangle { height: 0px * LumenUiScale.factor; background: transparent; }
                                HorizontalLayout {
                                    width: parent.width;
                                    height: 130px * LumenUiScale.factor;
                                    spacing: 4px * LumenUiScale.factor;
                                    Text {
                                        text: root.runtime-status == "Running" ? root.stat-down-value : "0";
                                        color: LumenTheme.accent;
                                        font-size: root.runtime-status == "Running" ? (parent.width < 300px * LumenUiScale.factor ? 72px * LumenUiScale.factor : 84px * LumenUiScale.factor) : 100px * LumenUiScale.factor;
                                        font-weight: 400;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        accessible-label: root.runtime-status == "Running" ? root.stat-down : "0 B/s";
                                    }
                                    Rectangle {
                                        width: root.runtime-status == "Running" && root.stat-down-unit != "B" ? 42px * LumenUiScale.factor : 18px * LumenUiScale.factor;
                                        height: parent.height;
                                        background: transparent;
                                        Text {
                                            x: 0px * LumenUiScale.factor; y: 93px * LumenUiScale.factor; width: parent.width; height: 34px * LumenUiScale.factor;
                                            text: root.runtime-status == "Running" ? root.stat-down-unit : "B";
                                            color: LumenTheme.accent.with_alpha(60%);
                                            font-size: 24px * LumenUiScale.factor;
                                            vertical-alignment: bottom;
                                            overflow: elide;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                                Rectangle { height: root.home-data-upload-gap; background: transparent; }
                                HorizontalLayout {
                                    width: parent.width; height: 38px * LumenUiScale.factor; spacing: 16px * LumenUiScale.factor; alignment: start;
                                    Text { text: "UPLOAD"; color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; horizontal-stretch: 0; vertical-alignment: center; }
                                    Text { text: root.runtime-status == "Running" ? root.stat-up-compact : "0 B"; color: LumenTheme.accent; font-size: 24px * LumenUiScale.factor; horizontal-stretch: 0; vertical-alignment: center; }
                                }
                                Rectangle { height: 0px * LumenUiScale.factor; background: transparent; }
                                if root.runtime-status == "Running": HorizontalLayout {
                                    width: parent.width; height: 48px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                    HomeStatusChip {
                                        min-chip-width: 90px * LumenUiScale.factor;
                                        label: @tr("运行中");
                                        icon: root.application-dark-mode ? @image-url("../assets/icons/activity-dark.svg") : @image-url("../assets/icons/activity.svg");
                                        active: true;
                                    }
                                    HomeStatusChip {
                                        min-chip-width: 80px * LumenUiScale.factor;
                                        label: root.network-mode;
                                        icon: root.application-dark-mode ? @image-url("../assets/icons/vpn-dark.svg") : @image-url("../assets/icons/vpn.svg");
                                        active: true;
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    HomeRoundActionButton {
                                        icon: root.application-dark-mode ? @image-url("../assets/icons/stop-dark.svg") : @image-url("../assets/icons/stop.svg");
                                        accessible-name: @tr("停止代理");
                                        clicked => { root.stop-runtime(); }
                                    }
                                }
                                if root.runtime-status != "Running": HomeActionButton {
                                    label: root.runtime-status == "Starting" ? @tr("启动中…") : root.runtime-status == "Stopping" ? @tr("停止中…") : root.has-current-profile ? @tr("轻触启动") : root.profiles.length == 0 ? @tr("添加配置") : @tr("选择配置");
                                    running: false;
                                    busy: root.runtime-status == "Starting" || root.runtime-status == "Stopping";
                                    clicked => {
                                        if root.runtime-status == "Starting" || root.runtime-status == "Stopping" { }
                                        else if root.has-current-profile { root.start-runtime(); }
                                        else { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; root.navigate("Config"); }
                                    }
                                }
                                Rectangle { height: root.home-before-node-gap; background: transparent; }
                                HorizontalLayout {
                                    width: parent.width; height: 28px * LumenUiScale.factor;
                                    Text { text: @tr("节点"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: @tr("延迟"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    width: parent.width; height: 34px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                    if root.home-current-flag-code != "": FlagIcon {
                                        country-code: root.home-current-flag-code;
                                        index: root.home-current-flag-index;
                                    }
                                    Text {
                                        text: root.runtime-status == "Running" ? root.home-current-node : @tr("未知");
                                        accessible-label: root.home-current-accessible;
                                        color: LumenTheme.text-primary; font-size: 16px * LumenUiScale.factor; horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
                                    }
                                    Text { text: root.runtime-status == "Running" ? root.home-current-delay : "—"; color: LumenTheme.text-secondary; font-size: 16px * LumenUiScale.factor; vertical-alignment: center; }
                                }
                                Rectangle { height: root.home-node-egress-gap; background: transparent; }
                                HorizontalLayout {
                                    width: parent.width; height: 24px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                    Text { text: @tr("出口 IP"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if root.home-exit-country-code != "" && root.home-exit-flag-index >= 0: FlagIcon {
                                        country-code: root.home-exit-country-code;
                                        index: root.home-exit-flag-index;
                                        diameter: 22px * LumenUiScale.factor;
                                    }
                                    if root.home-exit-country-code != "": Text { text: root.home-exit-country-code; color: LumenTheme.accent; font-size: 16px * LumenUiScale.factor; vertical-alignment: center; }
                                }
                                HorizontalLayout {
                                    width: parent.width; height: 32px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                    Text { text: root.home-exit-ip; color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    if root.home-exit-status != "" && root.home-exit-status != "已更新": Text { text: root.home-exit-status; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: parent.width;
                                    height: root.home-traffic-has-data ? 120px * LumenUiScale.factor : 32px * LumenUiScale.factor;
                                    background: transparent;
                                    if root.home-traffic-has-data: Rectangle { x: 0px * LumenUiScale.factor; y: parent.height - 8px * LumenUiScale.factor; width: parent.width; height: 1px * LumenUiScale.factor; background: LumenTheme.border.with_alpha(35%); }
                                    HorizontalLayout {
                                        width: parent.width; height: parent.height; spacing: 1px * LumenUiScale.factor;
                                        for point[index] in root.home-traffic-points: Rectangle {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            background: transparent;
                                            if point.download-fraction > 0.01: Rectangle {
                                                x: max(0px * LumenUiScale.factor, (parent.width - 4px * LumenUiScale.factor) / 2 - 2px * LumenUiScale.factor);
                                                y: parent.height - 8px * LumenUiScale.factor - min(86px * LumenUiScale.factor, parent.height - 12px * LumenUiScale.factor) * point.download-fraction;
                                                width: 2px * LumenUiScale.factor;
                                                height: min(86px * LumenUiScale.factor, parent.height - 12px * LumenUiScale.factor) * point.download-fraction;
                                                border-radius: 1px * LumenUiScale.factor;
                                                background: LumenTheme.accent;
                                                animate y, height { duration: 260ms; easing: ease-out; }
                                            }
                                            if point.upload-fraction > 0.01: Rectangle {
                                                x: max(0px * LumenUiScale.factor, (parent.width - 4px * LumenUiScale.factor) / 2 + 1px * LumenUiScale.factor);
                                                y: parent.height - 8px * LumenUiScale.factor - min(52px * LumenUiScale.factor, parent.height - 12px * LumenUiScale.factor) * point.upload-fraction;
                                                width: 2px * LumenUiScale.factor;
                                                height: min(52px * LumenUiScale.factor, parent.height - 12px * LumenUiScale.factor) * point.upload-fraction;
                                                border-radius: 1px * LumenUiScale.factor;
                                                background: LumenTheme.accent-soft;
                                                animate y, height { duration: 260ms; easing: ease-out; }
                                            }
                                        }
                                    }
                                }
                                if root.profiles.length > 0: SummaryRow { label: @tr("当前配置"); value: root.active-profile; actionable: true; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; root.navigate("Config"); } }
                                if root.profiles.length > 0: SummaryRow { label: @tr("代理模式"); value: root.route-mode == "Rule" ? @tr("规则") : root.route-mode == "Global" ? @tr("全局") : @tr("直连"); actionable: true; clicked => { root.page-origin = "Home"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Network"; root.navigate("Network"); } }
                                if root.profiles.length > 0: SummaryRow { label: @tr("活动连接"); value: root.stat-connections; emphasized: true; actionable: true; clicked => { root.page-origin = "Home"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Connections"; root.navigate("Connections"); } }
                                if root.traffic-today-has-data: HorizontalLayout {
                                    width: parent.width; height: 42px * LumenUiScale.factor;
                                    Text { text: @tr("今日流量"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: "↓ " + root.traffic-today-down + "   ↑ " + root.traffic-today-up; color: LumenTheme.text-primary; font-size: 14px * LumenUiScale.factor; vertical-alignment: center; }
                                }
                            }
                            if root.profiles.length == 0 && !root.compact-layout: SurfaceCard {
                                Text { text: @tr("尚未添加配置"); color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 600; }
                                Text { text: @tr("添加订阅或导入 YAML 文件后即可启动 Mihomo。"); color: LumenTheme.text-secondary; font-size: LumenTheme.body-size; wrap: word-wrap; }
                                FilledButton {
                                    text: @tr("添加配置");
                                    height: 52px * LumenUiScale.factor;
                                    horizontal-stretch: 1;
                                    clicked => { root.open-profile-add(); }
                                }
                            }
                            if root.profiles.length > 0 && !root.compact-layout: SurfaceCard {
                                HorizontalLayout { spacing: LumenTheme.space-2;
                                    Text { text: "DOWNLOAD"; color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    StatusBadge { label: root.runtime-status == "Running" ? @tr("运行中") : @tr("已停止"); active: root.runtime-status == "Running"; badge-width: 82px * LumenUiScale.factor; }
                                }
                                Text {
                                    text: root.runtime-status == "Running" ? root.stat-down : "0 B/s";
                                    color: LumenTheme.accent;
                                    font-size: parent.width < 280px * LumenUiScale.factor ? 38px * LumenUiScale.factor : 48px * LumenUiScale.factor;
                                    font-weight: 600;
                                    height: 60px * LumenUiScale.factor;
                                    vertical-stretch: 0;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-label: root.runtime-status == "Running" ? root.stat-down : "0 B/s";
                                }
                                Text { text: @tr("实时下载速度"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; }
                                Rectangle { height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
                                SummaryRow { label: @tr("上传"); value: root.runtime-status == "Running" ? root.stat-up : "0 B/s"; emphasized: true; }
                                Text {
                                    text: @tr("本次运行  ↓ ") + root.stat-total-down + "   ↑ " + root.stat-total-up;
                                    color: LumenTheme.text-secondary;
                                    font-size: 13px * LumenUiScale.factor;
                                    wrap: word-wrap;
                                    accessible-label: @tr("本次运行累计下载 ") + root.stat-total-down + @tr("，上传 ") + root.stat-total-up;
                                }
                                FilledButton {
                                    text: root.runtime-status == "Running" ? @tr("停止代理") : root.has-current-profile ? @tr("启动代理") : @tr("选择配置");
                                    height: 52px * LumenUiScale.factor;
                                    horizontal-stretch: 1;
                                    enabled: true;
                                    clicked => {
                                        if root.runtime-status == "Running" { root.stop-runtime(); }
                                        else if root.has-current-profile { root.start-runtime(); }
                                        else { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; root.navigate("Config"); }
                                    }
                                }
                            }
                            if root.profiles.length > 0 && !root.compact-layout: SurfaceCard {
                                Text { text: @tr("运行概况"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
                                SummaryRow { label: @tr("当前配置"); value: root.active-profile; actionable: true; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; root.navigate("Config"); } }
                                Rectangle { height: 48px * LumenUiScale.factor;
                                    HorizontalLayout { spacing: LumenTheme.space-3;
                                        Text { text: @tr("当前节点"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                        if root.proxy-groups.length > 0 && root.proxy-groups[0].current-flag-code != "": FlagIcon {
                                            country-code: root.proxy-groups[0].current-flag-code;
                                            index: root.proxy-groups[0].current-flag-index;
                                        }
                                        Text {
                                            text: root.proxy-groups.length > 0 ? root.proxy-groups[0].current : @tr("暂无可用节点");
                                            accessible-label: root.proxy-groups.length > 0 ? root.proxy-groups[0].current-accessible : @tr("暂无可用节点");
                                            color: LumenTheme.text-primary;
                                            font-size: LumenTheme.body-size;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    TouchArea { width: parent.width; height: parent.height; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Proxy"; root.navigate("Proxy"); } }
                                }
                                SummaryRow { label: @tr("网络接管"); value: root.network-mode; actionable: true; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Network"; root.page-origin = "Home"; root.navigate("Network"); } }
                                SummaryRow { label: @tr("代理模式"); value: root.route-mode == "Rule" ? @tr("规则") : root.route-mode == "Global" ? @tr("全局") : @tr("直连"); actionable: true; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Proxy"; root.navigate("Proxy"); } }
                                SummaryRow { label: @tr("活动连接"); value: root.stat-connections; emphasized: true; actionable: true; clicked => { root.page-origin = "Home"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Connections"; root.navigate("Connections"); } }
                            }
                            if root.traffic-today-has-data && !root.compact-layout: SurfaceCard {
                                HorizontalLayout { spacing: LumenTheme.space-2;
                                    Text { text: @tr("今日流量"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: @tr("过去 24 小时"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; vertical-alignment: center; }
                                }
                                HorizontalLayout { height: 76px * LumenUiScale.factor; spacing: 1px * LumenUiScale.factor;
                                    for bar in root.traffic-today-bars: Rectangle {
                                        width: 8px * LumenUiScale.factor;
                                        height: 76px * LumenUiScale.factor;
                                        background: transparent;
                                        Rectangle {
                                            x: 0px * LumenUiScale.factor;
                                            y: parent.height - max(2px * LumenUiScale.factor, 70px * LumenUiScale.factor * bar.download-fraction);
                                            width: 3px * LumenUiScale.factor;
                                            height: max(2px * LumenUiScale.factor, 70px * LumenUiScale.factor * bar.download-fraction);
                                            border-radius: 2px * LumenUiScale.factor;
                                            background: LumenTheme.accent;
                                        }
                                        Rectangle {
                                            x: 4px * LumenUiScale.factor;
                                            y: parent.height - max(2px * LumenUiScale.factor, 70px * LumenUiScale.factor * bar.upload-fraction);
                                            width: 3px * LumenUiScale.factor;
                                            height: max(2px * LumenUiScale.factor, 70px * LumenUiScale.factor * bar.upload-fraction);
                                            border-radius: 2px * LumenUiScale.factor;
                                            background: LumenTheme.accent-soft;
                                        }
                                    }
                                }
                                HorizontalLayout { spacing: LumenTheme.space-3;
                                    HorizontalLayout { spacing: LumenTheme.space-2; horizontal-stretch: 1;
                                        Rectangle { width: 8px * LumenUiScale.factor; height: 8px * LumenUiScale.factor; border-radius: 4px * LumenUiScale.factor; background: LumenTheme.accent; }
                                        Text { text: @tr("下载 ") + root.traffic-today-down; color: LumenTheme.text-primary; font-size: 12px * LumenUiScale.factor; horizontal-stretch: 1; overflow: elide; }
                                    }
                                    HorizontalLayout { spacing: LumenTheme.space-2; horizontal-stretch: 1;
                                        Rectangle { width: 8px * LumenUiScale.factor; height: 8px * LumenUiScale.factor; border-radius: 4px * LumenUiScale.factor; background: LumenTheme.accent-soft; }
                                        Text { text: @tr("上传 ") + root.traffic-today-up; color: LumenTheme.text-primary; font-size: 12px * LumenUiScale.factor; horizontal-stretch: 1; horizontal-alignment: right; overflow: elide; }
                                    }
                                }
                                TonalButton {
                                    text: @tr("查看流量统计");
                                    height: LumenTheme.min-touch-target;
                                    horizontal-stretch: 1;
                                    clicked => { root.page-origin = "Home"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Traffic"; root.navigate("Traffic"); }
                                }
                            }
                        }

                        if root.page == "Config": VerticalLayout {
                            width: parent.width;
                            spacing: LumenTheme.space-4;
                            alignment: start;
                            Rectangle {
                                width: parent.width;
                                height: 58px * LumenUiScale.factor;
                                border-radius: 29px * LumenUiScale.factor;
                                background: LumenTheme.surface;
                                HorizontalLayout {
                                    width: max(0px * LumenUiScale.factor, parent.width - 32px * LumenUiScale.factor);
                                    x: 16px * LumenUiScale.factor;
                                    height: parent.height;
                                    spacing: 10px * LumenUiScale.factor;
                                    alignment: center;
                                    Image { source: root.application-dark-mode ? @image-url("../assets/icons/add-dark.svg") : @image-url("../assets/icons/add.svg"); width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; y: (parent.height - self.height) / 2; image-fit: contain; }
                                    Text { text: @tr("添加配置"); color: LumenTheme.accent; font-size: 18px * LumenUiScale.factor; height: parent.height; vertical-alignment: center; }
                                }
                                TouchArea { width: parent.width; height: parent.height; clicked => { root.open-profile-add(); } }
                            }
                            if root.profiles.length == 0: SurfaceCard {
                                Text { text: @tr("暂无配置文件"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
                                Text { text: @tr("订阅或导入 YAML 配置后，可以选择当前配置并启动 Mihomo。"); color: LumenTheme.text-secondary; font-size: LumenTheme.body-size; wrap: word-wrap; }
                            }
                            for profile in root.profiles: ProfileCardSurface {
                                profile-name: profile.name;
                                profile-kind: profile.kind == "本地 YAML" ? @tr("本地文件") : profile.kind;
                                profile-location: profile.kind == "本地 YAML" ? @tr("本地配置文件") : profile.location;
                                current: profile.current;
                                set-current => { root.set-current-profile(profile.id); }
                                clear-current => { root.set-current-profile(""); }
                                open-settings => {
                                    root.profile-action-id = profile.id;
                                    root.profile-action-name = profile.name;
                                    root.profile-action-open = true;
                                }
                                share-profile => { root.pending-profile-export-id = profile.id; root.pending-profile-export-name = profile.name; }
                                delete-profile => { root.pending-delete-id = profile.id; root.pending-delete-name = profile.name; }
                            }
                        }

                        if root.page == "ProfileSettings": VerticalLayout {
                            width: parent.width; spacing: 16px * LumenUiScale.factor;
                            SectionCard { heading: @tr("订阅信息"); detail: root.profile-settings-kind == "订阅链接" ? @tr("当前地址：") + root.profile-settings-location + @tr("。留空保持已保存地址；新地址会先下载并校验。") : @tr("本地来源：") + root.profile-settings-location + @tr("。来源文件保持只读。");
                                Text { text: @tr("配置名称"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
                                LineEdit { text <=> root.profile-settings-name; placeholder-text: @tr("配置名称"); }
                                if root.profile-settings-kind == "订阅链接": LineEdit { text <=> root.profile-settings-url; input-type: password; placeholder-text: @tr("输入新订阅链接；留空不更改"); }
                                if root.profile-settings-kind == "订阅链接": TextField { label: @tr("Age 私钥（可选）"); input-type: password; text <=> root.profile-settings-age-key; supporting-text: @tr("输入新私钥以添加或替换；留空保留已保存的私钥。"); }
                                if root.profile-settings-kind != "订阅链接": Text { text: @tr("本地配置来源以解密后的 YAML 保存，无需继续保留 Age 私钥。"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                            }
                            SectionCard { heading: @tr("覆写配置"); detail: @tr("选中项按列表顺序应用。修改暂存到草稿，保存后生效。");
                                if root.profile-settings-overrides.length == 0: Text { text: @tr("暂无可绑定的用户 Override"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                for option in root.profile-settings-overrides: HorizontalLayout {
                                    CheckBox { text: option.name + "  ·  " + option.format; checked: option.selected; toggled => { root.toggle-profile-override(option.id, self.checked); } }
                                    Button { text: @tr("上移"); enabled: option.selected && option.can-move-up; clicked => { root.move-profile-override(option.id, true); } }
                                    Button { text: @tr("下移"); enabled: option.selected && option.can-move-down; clicked => { root.move-profile-override(option.id, false); } }
                                }
                            }
                            HorizontalLayout {
                                Button { text: @tr("取消"); clicked => { root.cancel-profile-settings(); if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Config"; } }
                                Button { text: @tr("保存设置"); clicked => { root.save-profile-settings(root.profile-settings-id, root.profile-settings-name, root.profile-settings-url, root.profile-settings-age-key); } }
                            }
                        }

                        if root.page == "Proxy": VerticalLayout {
                            width: parent.width;
                            spacing: LumenTheme.space-4;
                            alignment: start;
                            if root.selected-group != "": VerticalLayout {
                                width: parent.width;
                                spacing: 8px * LumenUiScale.factor;
                                HorizontalLayout {
                                    width: parent.width;
                                    height: 44px * LumenUiScale.factor;
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    IconButton {
                                        width: 44px * LumenUiScale.factor; height: 44px * LumenUiScale.factor;
                                        icon: @image-url("../assets/icons/sort.svg");
                                        tooltip: @tr("定位当前节点与排序");
                                        clicked => { proxy-sort-menu.show(); }
                                    }
                                }
                                Text { text: @tr("节点"); color: LumenTheme.text-primary; font-size: 38px * LumenUiScale.factor; font-weight: 450; height: 54px * LumenUiScale.factor; vertical-alignment: center; }
                                Rectangle { height: 16px * LumenUiScale.factor; background: transparent; }
                                search-box := Rectangle {
                                    width: parent.width; height: 56px * LumenUiScale.factor; border-radius: 28px * LumenUiScale.factor;
                                    background: LumenTheme.surface-muted;
                                    search-layout := HorizontalLayout {
                                        x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 12px * LumenUiScale.factor;
                                        cross-axis-alignment: center;
                                        search-icon := Image {
                                            source: root.application-dark-mode ? @image-url("../assets/icons/search-dark.svg") : @image-url("../assets/icons/search.svg");
                                            width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; image-fit: contain;
                                        }
                                        search-content := Rectangle {
                                            horizontal-stretch: 1; height: parent.height; background: transparent;
                                            TextInput {
                                                width: parent.width; height: parent.height;
                                                text <=> root.proxy-search;
                                                color: LumenTheme.text-primary;
                                                font-size: 18px * LumenUiScale.factor;
                                                vertical-alignment: center;
                                                edited => { root.search-proxy-nodes(self.text); }
                                            }
                                            if root.proxy-search == "": Text {
                                                x: 0px * LumenUiScale.factor; width: parent.width; height: parent.height;
                                                text: @tr("搜索"); color: LumenTheme.text-secondary; font-size: 18px * LumenUiScale.factor;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if root.layout-debug-bounds: Rectangle {
                                        x: search-layout.x + search-icon.x; y: search-layout.y + search-icon.y;
                                        width: search-icon.width; height: search-icon.height;
                                        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #007AFF;
                                    }
                                    if root.layout-debug-bounds: Rectangle {
                                        x: search-layout.x + search-content.x; y: search-layout.y + search-content.y;
                                        width: search-content.width; height: search-content.height;
                                        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
                                    }
                                    if root.layout-debug-bounds: LayoutOutline { outline-color: #FF2D55; }
                                }
                                if root.runtime-status != "Running": Text { text: @tr("内核未启动：Ping 测 TCP 连通性，切换节点需启动"); color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; height: 18px * LumenUiScale.factor; }
                            }
                            if root.selected-group == "" && !root.compact-layout: SurfaceCard {
                                Text { text: @tr("策略模式"); color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; font-weight: 600; }
                                Text { text: @tr("应用后会从 Mihomo 核心回读实际值"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; wrap: word-wrap; }
                                SegmentedButton {
                                    width: max(0px * LumenUiScale.factor, parent.width - 2 * LumenTheme.space-4);
                                    height: 48px * LumenUiScale.factor;
                                    items: [{ text: @tr("规则") }, { text: @tr("全局") }, { text: @tr("直连") }];
                                    current-index: root.route-mode == "Rule" ? 0 : root.route-mode == "Global" ? 1 : 2;
                                    index-changed(index) => {
                                        root.set-route-mode(index == 0 ? "Rule" : index == 1 ? "Global" : "Direct");
                                    }
                                }
                            }
                            if root.selected-group == "" && !root.compact-layout: Text { text: @tr("代理组"); color: LumenTheme.accent; font-size: 16px * LumenUiScale.factor; font-weight: 600; }
                            if root.selected-group == "" && root.proxy-groups.length == 0: SurfaceCard {
                                Text { text: root.runtime-status == "Running" ? @tr("正在读取代理组…") : @tr("暂无代理组"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
                                Text { text: root.runtime-status == "Running" ? @tr("正在读取当前 Mihomo 状态。") : @tr("选择当前配置后，可先查看配置中的代理组和节点。启动 Mihomo 后即可切换。"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; wrap: word-wrap; }
                            }
                            if root.selected-group == "": VerticalLayout {
                                width: parent.width;
                                spacing: LumenTheme.space-4;
                                for group in root.proxy-groups: ProxyGroupCard {
                                    group-name: group.name;
                                    group-icon-emoji: group.icon-emoji;
                                    group-kind: group.kind;
                                    current-node: group.current;
                                    current-flag-code: group.current-flag-code;
                                    current-flag-index: group.current-flag-index;
                                    current-accessible: group.current-accessible;
                                    compact: root.compact-layout;
                                    runtime-running: root.runtime-status == "Running";
                                    testing: root.proxy-testing-group == group.name;
                                    has-nodes: group.nodes != "";
                                    selected: false;
                                    clicked => { root.selected-group = group.name; }
                                    test-current => { root.test-proxy(group.name, ""); }
                                }
                            }
                            if root.selected-group != "" && root.proxy-nodes.length == 0: SurfaceCard {
                                Text { text: root.proxy-search == "" ? @tr("当前组没有可选节点") : @tr("没有匹配的节点"); color: LumenTheme.text-secondary; font-size: LumenTheme.body-size; wrap: word-wrap; }
                            }
                            if root.selected-group != "": VerticalLayout {
                                width: parent.width;
                                spacing: 14px * LumenUiScale.factor;
                                for node in root.proxy-nodes: node-row := Rectangle {
                                    width: parent.width;
                                    height: 76px * LumenUiScale.factor;
                                    border-radius: 20px * LumenUiScale.factor;
                                    background: LumenTheme.surface;
                                    border-width: 0px * LumenUiScale.factor;
                                    changed absolute-position => {
                                        if node.active {
                                            root.proxy-active-node-position = self.absolute-position.y;
                                            root.proxy-current-node-available = true;
                                        }
                                    }
                                    if root.runtime-status == "Running" && !node.active: TouchArea { width: parent.width; height: parent.height; clicked => { root.select-proxy(root.selected-group, node.id); } }
                                    node-content := HorizontalLayout {
                                        x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height; spacing: 12px * LumenUiScale.factor;
                                        cross-axis-alignment: center;
                                        flag-badge := Rectangle {
                                            width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; border-radius: 18px * LumenUiScale.factor;
                                            background: LumenTheme.dark-mode ? #303030 : LumenTheme.surface-muted;
                                            clip: true;
                                            flag-layout := HorizontalLayout {
                                                width: parent.width; height: parent.height;
                                                alignment: center; cross-axis-alignment: center;
                                                if node.flag-index >= 0: FlagIcon {
                                                    diameter: 40px * LumenUiScale.factor;
                                                    country-code: node.flag-code;
                                                    index: node.flag-index;
                                                    show-layout-bounds: root.layout-debug-bounds;
                                                }
                                                if node.flag-index < 0: Rectangle {
                                                    width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; background: transparent;
                                                    Image {
                                                        source: root.application-dark-mode ? @image-url("../assets/icons/proxy-dark.svg") : @image-url("../assets/icons/proxy.svg");
                                                        width: parent.width; height: parent.height; image-fit: contain;
                                                    }
                                                    if root.layout-debug-bounds: LayoutOutline { outline-color: #007AFF; }
                                                }
                                            }
                                            if root.layout-debug-bounds: LayoutOutline { outline-color: #FF2D55; }
                                        }
                                        node-info := VerticalLayout {
                                            horizontal-stretch: 1;
                                            height: parent.height;
                                            spacing: 5px * LumenUiScale.factor;
                                            alignment: center;
                                            cross-axis-alignment: start;
                                            node-title := Text {
                                                height: 24px * LumenUiScale.factor;
                                                text: node.title;
                                                accessible-label: node.accessible-title;
                                                color: LumenTheme.text-primary;
                                                font-size: 16px * LumenUiScale.factor;
                                                font-weight: node.active ? 600 : 450;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            proxy-details := HorizontalLayout {
                                                horizontal-stretch: 1; height: 24px * LumenUiScale.factor;
                                                spacing: 6px * LumenUiScale.factor;
                                                cross-axis-alignment: center;
                                                proxy-type-badge := Rectangle {
                                                    width: max(42px * LumenUiScale.factor, proxy-type-text.preferred-width + 18px * LumenUiScale.factor);
                                                    height: 22px * LumenUiScale.factor; border-radius: 11px * LumenUiScale.factor; background: LumenTheme.accent-soft;
                                                    proxy-type-text := Text {
                                                        x: 9px * LumenUiScale.factor; height: parent.height;
                                                        text: node.subtitle; color: LumenTheme.accent; font-size: 12px * LumenUiScale.factor;
                                                        vertical-alignment: center; overflow: elide;
                                                    }
                                                    if root.layout-debug-bounds: Rectangle {
                                                        x: proxy-type-text.x; y: proxy-type-text.y;
                                                        width: proxy-type-text.preferred-width; height: proxy-type-text.height;
                                                        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
                                                    }
                                                }
                                                PingBadge {
                                                    label: node.trailing == "" ? "Ping" : node.trailing;
                                                    delay-ms: node.delay-ms;
                                                    spinning: root.proxy-testing-node == node.id;
                                                    enabled: root.proxy-testing-node != node.id;
                                                    clicked => { root.test-proxy(root.selected-group, node.id); }
                                                }
                                            }
                                        }
                                        if node.active: Image { source: @image-url("../assets/icons/check.svg"); width: 28px * LumenUiScale.factor; height: 28px * LumenUiScale.factor; image-fit: contain; }
                                    }
                                    if root.layout-debug-bounds: Rectangle {
                                        x: node-content.x + node-info.x + node-title.x;
                                        y: node-content.y + node-info.y + node-title.y;
                                        width: node-title.width; height: node-title.height;
                                        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
                                    }
                                    if root.layout-debug-bounds: LayoutOutline { outline-color: #FF2D55; }
                                }
                            }
                        }

                        if root.page == "Settings": VerticalLayout {
                            width: parent.width; spacing: LumenTheme.space-2;
                            alignment: start;
                            Text { text: @tr("界面设置"); color: LumenTheme.accent; font-size: 16px * LumenUiScale.factor; font-weight: 600; }
                            SectionCard { heading: ""; detail: ""; content-spacing: 0px * LumenUiScale.factor; vertical-padding: 8px * LumenUiScale.factor; border-width: 0px * LumenUiScale.factor;
                                SettingRow { min-height: 76px * LumenUiScale.factor; preferred-height: 76px * LumenUiScale.factor; label: @tr("应用"); detail: @tr("主题、语言与启动行为"); icon: @image-url("../assets/icons/setting-app.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "AppSettings"; root.navigate("AppSettings"); } }
                                SettingRow { min-height: 76px * LumenUiScale.factor; preferred-height: 76px * LumenUiScale.factor; label: @tr("网络"); detail: @tr("代理模式、核心与平台接管"); icon: @image-url("../assets/icons/network-white.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Network"; root.navigate("Network"); } }
                                SettingRow { min-height: 76px * LumenUiScale.factor; preferred-height: 76px * LumenUiScale.factor; label: @tr("覆写"); detail: @tr("YAML 与规则覆写"); icon: @image-url("../assets/icons/list-checks-white.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Overrides"; root.navigate("Overrides"); } }
                                SettingRow { min-height: 76px * LumenUiScale.factor; preferred-height: 76px * LumenUiScale.factor; label: @tr("Meta 功能"); detail: @tr("连接、日志、规则和流量统计"); icon: @image-url("../assets/icons/setting-meta.svg"); clicked => { root.page-origin = "Settings"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Meta"; root.navigate("Meta"); } }
                            }
                            Text { text: @tr("更多"); color: LumenTheme.accent; font-size: 16px * LumenUiScale.factor; font-weight: 600; }
                            SectionCard { heading: ""; detail: ""; content-spacing: 0px * LumenUiScale.factor; vertical-padding: 8px * LumenUiScale.factor; border-width: 0px * LumenUiScale.factor;
                                SettingRow { label: @tr("关于"); detail: @tr("版本与许可证"); badge: "v0.1.0"; icon: @image-url("../assets/icons/setting-about.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "About"; root.navigate("About"); } }
                                if root.layout-debug-tools-enabled: CheckBox {
                                    text: @tr("显示布局边界（调试）");
                                    checked: root.layout-debug-bounds;
                                    toggled => { root.layout-debug-bounds = self.checked; }
                                }
                                if root.layout-debug-bounds: Text { text: @tr("洋红：外框 · 青色：内容区/输入框 · 蓝色：图标框"); color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; wrap: word-wrap; }
                            }
                        }

                        if root.page == "Meta": VerticalLayout {
                            width: parent.width;
                            spacing: LumenTheme.space-3;
                            alignment: start;
                            Text { text: @tr("运行观测"); color: LumenTheme.accent; font-size: 16px * LumenUiScale.factor; font-weight: 600; }
                            SectionCard { heading: ""; detail: "";
                                SettingRow { label: @tr("连接"); detail: @tr("查看并管理活动连接"); icon: @image-url("../assets/icons/network-white.svg"); clicked => { root.page-origin = "Meta"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Connections"; root.navigate("Connections"); } }
                                Rectangle { width: parent.width; height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
                                SettingRow { label: @tr("日志"); detail: @tr("筛选和导出 Mihomo 日志"); icon: @image-url("../assets/icons/logs-white.svg"); clicked => { root.page-origin = "Meta"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Logs"; root.navigate("Logs"); } }
                                Rectangle { width: parent.width; height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
                                SettingRow { label: @tr("运行规则"); detail: @tr("查看和临时启停规则"); icon: @image-url("../assets/icons/list-checks-white.svg"); clicked => { root.page-origin = "Meta"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Rules"; root.navigate("Rules"); } }
                                Rectangle { width: parent.width; height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
                                SettingRow { label: @tr("流量统计"); detail: @tr("查看今日和本周流量"); icon: @image-url("../assets/icons/traffic-white.svg"); clicked => { root.page-origin = "Meta"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Traffic"; root.navigate("Traffic"); } }
                                Rectangle { width: parent.width; height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
                                SettingRow { label: "Providers"; detail: @tr("更新代理与规则提供者"); icon: @image-url("../assets/icons/providers-white.svg"); clicked => { root.page-origin = "Meta"; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Providers"; root.navigate("Providers"); } }
                            }
                        }

                        if root.page == "Network": VerticalLayout {
                            width: parent.width; spacing: 16px * LumenUiScale.factor;
                            SectionCard { heading: @tr("代理模式"); detail: @tr("应用后由 Mihomo 核心回读实际模式。");
                                SegmentedButton {
                                    width: max(0px * LumenUiScale.factor, parent.width - 2 * LumenTheme.space-4);
                                    height: 48px * LumenUiScale.factor;
                                    items: [{ text: @tr("规则") }, { text: @tr("全局") }, { text: @tr("直连") }];
                                    current-index: root.route-mode == "Rule" ? 0 : root.route-mode == "Global" ? 1 : 2;
                                    index-changed(index) => { root.set-route-mode(index == 0 ? "Rule" : index == 1 ? "Global" : "Direct"); }
                                }
                            }
                            SectionCard { heading: @tr("运行模式"); detail: root.compact-layout ? @tr("Android 通过系统 VPN 接管其他应用流量；Lumen 核心与转发器自身流量直连以避免回环。") : @tr("桌面接管模式与 Mihomo 的 Rule/Global/Direct 代理策略相互独立。");
                                if root.compact-layout: HorizontalLayout {
                                    Button {
                                        text: root.runtime-status == "Running" ? @tr("停止 VPN") : @tr("启动 VPN");
                                        enabled: root.runtime-status == "Running" || root.has-current-profile;
                                        clicked => { if root.runtime-status == "Running" { root.stop-runtime(); } else { root.start-runtime(); } }
                                    }
                                    Text { text: root.network-mode-status; color: root.network-mode-status-warning ? #9A6810 : #0B667F; font-size: 13px * LumenUiScale.factor; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                                if !root.compact-layout: HorizontalLayout {
                                    Button {
                                        text: root.network-mode == "System Proxy" ? @tr("系统代理 ✓") : @tr("系统代理");
                                        enabled: root.network-mode != "System Proxy";
                                        clicked => {
                                            if root.runtime-status == "Running" {
                                                root.network-mode-draft = "System Proxy";
                                                root.network-mode-dialog-open = true;
                                            } else { root.set-network-mode("System Proxy"); }
                                        }
                                    }
                                    Button {
                                        text: root.network-mode == "TUN" ? "TUN ✓" : "TUN";
                                        enabled: root.tun-capable && root.network-mode != "TUN";
                                        clicked => {
                                            if root.runtime-status == "Running" {
                                                root.network-mode-draft = "TUN";
                                                root.network-mode-dialog-open = true;
                                            } else { root.set-network-mode("TUN"); }
                                        }
                                    }
                                }
                                if !root.compact-layout: Text { text: @tr("当前选择：") + root.network-mode + " · " + root.network-mode-status; color: root.network-mode-status-warning ? #9A6810 : #0B667F; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                if !root.compact-layout: Text { text: root.tun-capability-detail; color: root.tun-capable ? #666666 : #9A6810; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                            }
                            SectionCard { heading: @tr("Mihomo 核心"); detail: root.android-platform ? (@tr("官方 Android v1.19.32 · 随 Lumen APK 提供，独立进程运行；GPL-3.0 许可与源码见关于页。当前：") + root.core-version) : (@tr("从 PATH 运行 Mihomo；当前版本：") + root.core-version);
                                HorizontalLayout { Text { text: root.android-platform ? @tr("Android ABI 核心") : @tr("执行命令：mihomo"); color: LumenTheme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; } Button { text: @tr("检查版本"); clicked => { root.check-core(); } } }
                            }
                            SectionCard { heading: @tr("运行安全"); detail: @tr("控制 API 绑定 127.0.0.1，随机密钥仅驻留内存；未实现或未确认的系统接管能力不会报告为已生效。");
                                Button { text: @tr("重试恢复上次系统代理"); enabled: root.proxy-recovery-pending; clicked => { root.retry-proxy-restore(); } }
                            }
                        }

                        if root.page == "AppSettings": VerticalLayout {
                            width: parent.width; spacing: 0px * LumenUiScale.factor; alignment: start;
                            if root.app-settings-preview-section < 0: Text {
                                x: 18px * LumenUiScale.factor; text: @tr("应用设置"); font-size: 34px * LumenUiScale.factor; color: LumenTheme.text-primary;
                                min-height: 64px * LumenUiScale.factor; preferred-height: 64px * LumenUiScale.factor; vertical-alignment: center;
                            }
                            if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 0: AppPreferenceGroup {
                                heading: @tr("行为");
                                AppPreferenceRow { label: @tr("自动启动"); toggle: true; checked: root.auto-start; toggled(value) => { root.set-auto-start(value); } }
                                AppPreferenceRow { label: @tr("启动更新配置"); toggle: true; checked: root.refresh-current-profile-on-start; toggled(value) => { root.set-refresh-profile-on-start(value); } }
                            }
                            if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 1: AppPreferenceGroup {
                                heading: @tr("主题配色");
                                AppPreferenceRow { label: @tr("主题模式"); value: root.theme-mode == "light" ? @tr("浅色") : root.theme-mode == "dark" ? @tr("深色") : @tr("跟随系统"); expand: true; clicked => { root.app-theme-anchor-x = self.absolute-position.x + self.width; root.app-theme-anchor-y = self.absolute-position.y + self.height; app-theme-menu.show(); } }
                                AppPreferenceRow { label: @tr("反转主题前景色"); toggle: true; checked: root.invert-theme-foreground; toggled(value) => { root.set-invert-theme-foreground(value); } }
                                AppPreferenceRow { label: @tr("主题配色"); detail: @tr("当前主题色：") + root.theme-color-code; icon: @image-url("../assets/icons/palette.svg"); clicked => { root.theme-hue-draft = root.theme-hue; root.theme-saturation-draft = root.theme-saturation; root.theme-value-draft = root.theme-value; root.theme-color-draft = root.theme-color-input-code; root.theme-color-code-draft = root.theme-color-input-code; root.theme-color-code-edited = false; root.theme-color-error = ""; root.theme-color-dialog-open = true; } }
                                AppPreferenceRow { label: @tr("应用语言"); value: root.application-language == "en" ? "English" : root.application-language == "zh-CN" ? @tr("简体中文") : (root.system-language == "en" ? "English" : @tr("简体中文")); expand: true; clicked => { root.app-language-anchor-x = self.absolute-position.x + self.width; root.app-language-anchor-y = self.absolute-position.y + self.height; app-language-menu.show(); } }
                                AppPreferenceRow { label: @tr("页面缩放"); value: root.page-scale-percent + "%"; clicked => { root.page-scale-draft = root.page-scale-percent; root.page-scale-dialog-open = true; } }
                            }
                            if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 2): AppPreferenceGroup {
                                heading: @tr("导航");
                                AppPreferenceRow { label: @tr("滑动隐藏底栏"); toggle: true; checked: root.hide-bottom-bar-on-scroll; toggled(value) => { root.set-hide-bottom-bar-on-scroll(value); } }
                                AppPreferenceRow { label: @tr("预测返回手势"); toggle: true; checked: root.predictive-back-enabled; capability-enabled: root.predictive-back-supported; unavailable: root.predictive-back-supported ? "" : @tr("Android 14及以上支持系统手势进度"); clicked => { root.app-settings-message = @tr("Android 14及以上支持系统手势进度"); } toggled(value) => { root.set-predictive-back-enabled(value); } }
                            }
                            if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 3): AppPreferenceGroup {
                                heading: @tr("隐私");
                                AppPreferenceRow { label: @tr("隐藏后台卡片"); toggle: true; checked: root.hide-background-card; toggled(value) => { root.set-hide-background-card(value); } }
                            }
                            if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 4): AppPreferenceGroup {
                                heading: @tr("服务");
                                AppPreferenceRow { label: @tr("显示流量通知"); toggle: true; checked: root.show-traffic-notification; toggled(value) => { root.set-show-traffic-notification(value); } }
                                AppPreferenceRow { label: @tr("后台隐藏时释放界面"); toggle: true; checked: root.release-ui-when-background; toggled(value) => { root.set-release-ui-when-background(value); } }
                                AppPreferenceRow { label: @tr("电池优化无限制"); state-description: root.ignore-battery-optimizations ? @tr("系统已加入不优化名单") : @tr("系统正在优化 Lumen"); icon: root.ignore-battery-optimizations ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/chevron-right.svg"); checked: root.ignore-battery-optimizations; clicked => { root.request-ignore-battery-optimization(); } }
                            }
                            if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 5: AppPreferenceGroup {
                                heading: @tr("网络");
                                AppPreferenceRow { label: @tr("自定义 User-Agent"); detail: root.user-agent == "" ? @tr("未设置，使用默认值") : root.user-agent; clicked => { root.user-agent-draft = root.user-agent; root.user-agent-error = ""; root.user-agent-dialog-open = true; } }
                            }
                        }
                        if root.page == "Overrides": VerticalLayout {
                            width: parent.width; spacing: 16px * LumenUiScale.factor;
                            SectionCard { heading: @tr("新建 YAML Override"); detail: @tr("仅用户 Override 可编辑；JavaScript 尚未通过安全沙箱验证，因此不执行。");
                                LineEdit { placeholder-text: @tr("配置名称"); text <=> root.override-name; }
                                HorizontalLayout {
                                    LineEdit { placeholder-text: @tr("HTTP/HTTPS YAML 链接"); text <=> root.override-url; input-type: password; enabled: !root.override-importing; horizontal-stretch: 1; }
                                    Button { text: root.override-importing ? @tr("正在导入…") : @tr("从链接导入"); enabled: !root.override-importing && root.override-url != ""; clicked => { root.override-importing = true; root.override-import-error = ""; root.import-override-url(root.override-url); } }
                                }
                                if root.override-import-error != "": Text { text: root.override-import-error; color: #B3261E; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                                if root.override-importing: Text { text: @tr("正在导入并校验 YAML Override…"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
                                TextEdit { text <=> root.override-body; placeholder-text: @tr("填写 YAML 覆写内容"); height: 150px * LumenUiScale.factor; }
                                HorizontalLayout {
                                    Button { text: root.override-edit-id == "" ? @tr("创建覆写") : @tr("保存覆写"); clicked => {
                                        if root.override-edit-id == "" { root.add-override(root.override-name, root.override-body); }
                                        else { root.save-override(root.override-edit-id, root.override-body); }
                                    } }
                                    if root.override-edit-id != "": Button { text: @tr("取消编辑"); clicked => { root.override-edit-id = ""; root.override-name = ""; root.override-body = ""; } }
                                }
                                if root.android-platform: Button { text: @tr("从 YAML/YML 文件导入"); enabled: !root.override-importing; clicked => { root.choose-override-file(); } }
                                if !root.android-platform: Button { text: @tr("从 YAML/YML 文件导入"); clicked => { root.choose-override-file(); } }
                            }
                            for item in root.overrides: SectionCard {
                                heading: item.name + "   ·   " + item.kind; detail: item.format + @tr("  ·  绑定到 ") + item.bound-count + @tr(" 个配置");
                                HorizontalLayout {
                                    Button { text: @tr("编辑"); clicked => { root.edit-override(item.id); } }
                                    Button { text: @tr("应用到当前配置"); clicked => { root.apply-override(item.id); } }
                                    Button { text: @tr("导出"); clicked => { root.export-override(item.id); } }
                                    Button { text: @tr("删除"); clicked => { root.delete-override(item.id); } }
                                }
                            }
                        }

                        if root.page == "Connections": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("连接"); detail: root.connection-show-closed ? @tr("Lumen 本次运行中观察到的已关闭连接；最多保留 500 条。") : (root.runtime-status == "Running" ? @tr("本地 Mihomo 活动连接；最多显示 500 条。") : @tr("Runtime 未运行；不显示缓存数据作为实时状态。"));
                                HorizontalLayout {
                                    Button { text: root.connection-show-closed ? @tr("活动中") : @tr("✓ 活动中"); clicked => { root.connection-show-closed = false; root.set-connection-view(false); } }
                                    Button { text: root.connection-show-closed ? @tr("✓ 已关闭") : @tr("已关闭"); clicked => { root.connection-show-closed = true; root.set-connection-view(true); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button { text: @tr("刷新"); clicked => { root.refresh-observations(); } }
                                }
                                HorizontalLayout {
                                    LineEdit { placeholder-text: @tr("搜索主机或进程"); text <=> root.connection-search; horizontal-stretch: 1; edited(text) => { root.search-connections(text); } }
                                    Button { text: (root.connection-sort == "时间" ? "✓ " : "") + @tr("时间"); clicked => { root.connection-sort = "时间"; root.set-connection-sort("时间"); } }
                                    Button { text: (root.connection-sort == "上传" ? "✓ " : "") + @tr("上传"); clicked => { root.connection-sort = "上传"; root.set-connection-sort("上传"); } }
                                    Button { text: (root.connection-sort == "下载" ? "✓ " : "") + @tr("下载"); clicked => { root.connection-sort = "下载"; root.set-connection-sort("下载"); } }
                                    Button { text: (root.connection-sort == "主机" ? "✓ " : "") + @tr("主机"); clicked => { root.connection-sort = "主机"; root.set-connection-sort("主机"); } }
                                }
                                for row in root.connections: HorizontalLayout {
                                    Button { text: row.title; clicked => { root.open-connection(row.id); if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "ConnectionDetail"; } }
                                    Text { text: row.subtitle; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: row.trailing; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; vertical-alignment: center; }
                                    if row.active: Button { text: row.id == root.connection-breaking-id ? @tr("正在打断…") : @tr("打断"); enabled: row.id != root.connection-breaking-id; clicked => { root.close-connection(row.id); } }
                                }
                                if !root.connection-show-closed && root.connections.length == 0: Text { text: root.runtime-status == "Running" ? (root.connection-search == "" ? @tr("暂无活动连接") : @tr("没有匹配的活动连接")) : @tr("Runtime 未运行；活动连接不可用"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                if root.connection-show-closed && root.connections.length == 0: Text { text: root.runtime-status == "Running" ? (root.connection-search == "" ? @tr("尚未观察到已关闭连接") : @tr("没有匹配的已关闭连接")) : @tr("Runtime 未运行；已关闭连接不可用"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                            }
                        }
                        if root.page == "ConnectionDetail": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            Button { text: @tr("‹ 返回连接列表"); clicked => { root.go-back(); } }
                            if root.connection-detail-host == "": SectionCard { heading: @tr("连接不可用"); detail: @tr("此连接已从当前有界观测缓存中移除。返回列表刷新状态。"); }
                            if root.connection-detail-host != "": SectionCard { heading: @tr("连接信息"); detail: root.connection-detail-host;
                                Text { text: @tr("协议：") + root.connection-detail-protocol; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                Text { text: @tr("进程：") + root.connection-detail-process; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                Text { text: @tr("源地址：") + root.connection-detail-source; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                Text { text: @tr("目标地址：") + root.connection-detail-destination; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                Text { text: @tr("开始时间：") + root.connection-detail-start + "   " + @tr("持续时间：") + root.connection-detail-duration; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                Text { text: @tr("上传：") + root.connection-detail-upload + "   " + @tr("下载：") + root.connection-detail-download; color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                            }
                            if root.connection-detail-host != "": SectionCard { heading: @tr("规则"); detail: root.connection-detail-rule; }
                            if root.connection-detail-host != "": SectionCard { heading: @tr("代理链路"); detail: root.connection-detail-chains;
                                Text { text: "Provider：" + root.connection-detail-providers; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                            }
                            if root.connection-detail-host != "" && root.connection-detail-active: Button { text: root.connection-breaking-id == root.connection-detail-id ? @tr("正在打断连接…") : @tr("打断连接"); enabled: root.connection-breaking-id != root.connection-detail-id; clicked => { root.close-connection(root.connection-detail-id); } }
                        }
                        if root.page == "Logs": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("实时日志"); detail: root.runtime-status != "Running" ? @tr("Runtime 未运行；不显示缓存数据作为实时状态。") : (root.log-stream-status == "正在重连" ? @tr("日志流断开，正在重连；保留最近 300 条并脱敏。") : (root.log-stream-status == "已连接" ? @tr("Mihomo 实时日志流已连接；保留最近 300 条并脱敏。") : @tr("正在连接 Mihomo 实时日志流。")));
                                HorizontalLayout {
                                    LineEdit { placeholder-text: @tr("搜索日志"); text <=> root.log-search; horizontal-stretch: 1; edited(text) => { root.search-logs(text); } }
                                    Button { text: @tr("导出日志"); enabled: root.logs.length > 0; clicked => { root.export-logs(); } }
                                }
                                HorizontalLayout {
                                    Button { text: (root.log-level == "全部" ? "✓ " : "") + @tr("全部"); clicked => { root.log-level = "全部"; root.set-log-level("全部"); } }
                                    Button { text: (root.log-level == "Debug" ? "✓ " : "") + "Debug"; clicked => { root.log-level = "Debug"; root.set-log-level("Debug"); } }
                                    Button { text: (root.log-level == "Info" ? "✓ " : "") + "Info"; clicked => { root.log-level = "Info"; root.set-log-level("Info"); } }
                                    Button { text: (root.log-level == "Warning" ? "✓ " : "") + "Warning"; clicked => { root.log-level = "Warning"; root.set-log-level("Warning"); } }
                                    Button { text: (root.log-level == "Error" ? "✓ " : "") + "Error"; clicked => { root.log-level = "Error"; root.set-log-level("Error"); } }
                                }
                                for row in root.logs: Text { text: row.title + "  [" + row.subtitle + "]  " + row.trailing; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                                if root.logs.length == 0: Text { text: root.runtime-status != "Running" ? @tr("Runtime 未运行，日志不可用") : (root.log-search != "" || root.log-level != "全部" ? @tr("没有匹配的日志") : (root.log-stream-status == "正在重连" ? @tr("正在重连日志流") : @tr("等待 Mihomo 日志流"))); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                            }
                        }
                        if root.page == "Rules": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("运行规则"); detail: root.runtime-status == "Running" ? @tr("核心运行规则；启停仅影响当前会话，重启后恢复配置值。") : @tr("Runtime 未运行；不显示缓存数据作为实时状态。");
                                HorizontalLayout {
                                    LineEdit { placeholder-text: @tr("搜索规则"); text <=> root.rule-search; horizontal-stretch: 1; edited(text) => { root.search-rules(text); } }
                                    Button { text: @tr("刷新"); clicked => { root.refresh-observations(); } }
                                }
                                for row in root.rules: HorizontalLayout { Text { text: row.title + "  ·  " + row.subtitle; color: LumenTheme.text-primary; font-size: 13px * LumenUiScale.factor; horizontal-stretch: 1; } CheckBox { text: row.id == root.rule-pending-index ? @tr("更新中…") : @tr("启用"); enabled: row.id != root.rule-pending-index; checked: row.active; toggled => { root.set-rule-enabled(row.id, self.checked); } } Text { text: row.trailing; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; } }
                                if root.rules.length == 0: Text { text: root.runtime-status != "Running" ? @tr("Runtime 未运行，规则不可用") : (root.rule-search == "" ? @tr("暂无运行规则") : @tr("没有匹配的运行规则")); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                            }
                        }
                        if root.page == "Providers": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("外部资源"); detail: root.runtime-status == "Running" ? @tr("代理提供者和规则提供者均来自核心回读。") : @tr("Runtime 未运行；不显示缓存数据作为实时状态。");
                                Button { text: @tr("刷新"); clicked => { root.refresh-observations(); } }
                                for row in root.providers: HorizontalLayout { Text { text: row.title + "  ·  " + row.subtitle + "  ·  " + row.trailing; color: LumenTheme.text-primary; font-size: 13px * LumenUiScale.factor; horizontal-stretch: 1; } Button { text: @tr("更新"); clicked => { root.update-provider(row.id); } } }
                                if root.providers.length == 0: Text { text: @tr("当前配置未包含外部 Provider"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                            }
                        }
                        if root.page == "Traffic": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("实时流量"); detail: root.traffic-stream-status == "已连接" ? @tr("Mihomo /traffic 实时流已连接。") : (root.traffic-stream-status == "正在重连" ? @tr("实时流重连中；速率显示为 0，保留的统计仍可查看。") : (root.runtime-status == "Running" ? @tr("Runtime 已启动，正在连接流量采样。") : @tr("Runtime 未运行；实时采样已停止，保留的统计仍可查看。")));
                                Text { text: @tr("下载  ") + root.stat-down + "     " + @tr("上传  ") + root.stat-up; color: #0B667F; font-size: 20px * LumenUiScale.factor; }
                            }
                            SectionCard { heading: @tr("累计统计"); detail: @tr("按本地时间从 Mihomo 累计计数差分；仅统计 Lumen 观察到的核心总流量，最多保留近 7 日。");
                                HorizontalLayout {
                                    Button { text: root.traffic-range == "today" ? @tr("✓ 今日") : @tr("今日"); clicked => { root.traffic-range = "today"; root.traffic-selected-detail = ""; } }
                                    Button { text: root.traffic-range == "week" ? @tr("✓ 本周") : @tr("本周"); clicked => { root.traffic-range = "week"; root.traffic-selected-detail = ""; } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button { text: @tr("清空统计"); clicked => { root.clear-traffic-dialog-open = true; } }
                                }
                                HorizontalLayout {
                                    Rectangle { width: 10px * LumenUiScale.factor; height: 10px * LumenUiScale.factor; border-radius: 5px * LumenUiScale.factor; background: #0B667F; }
                                    Text { text: @tr("下载"); color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; }
                                    Rectangle { width: 10px * LumenUiScale.factor; height: 10px * LumenUiScale.factor; border-radius: 5px * LumenUiScale.factor; background: #0B667F; }
                                    Text { text: @tr("上传"); color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; }
                                }
                                if root.traffic-range == "today": VerticalLayout {
                                    Text { text: @tr("下载  ") + root.traffic-today-down + "     " + @tr("上传  ") + root.traffic-today-up; color: LumenTheme.text-secondary; font-size: 15px * LumenUiScale.factor; }
                                    if root.traffic-today-has-data: HorizontalLayout {
                                        height: 148px * LumenUiScale.factor; spacing: 2px * LumenUiScale.factor;
                                        for bar in root.traffic-today-bars: VerticalLayout {
                                            horizontal-stretch: 1; spacing: 3px * LumenUiScale.factor;
                                            Rectangle { height: 116px * LumenUiScale.factor; background: transparent;
                                                Rectangle { x: 1px * LumenUiScale.factor; y: parent.height - parent.height * bar.download-fraction; width: parent.width / 2 - 1px * LumenUiScale.factor; height: parent.height * bar.download-fraction; background: #0B667F; }
                                                Rectangle { x: parent.width / 2; y: parent.height - parent.height * bar.upload-fraction; width: parent.width / 2 - 1px * LumenUiScale.factor; height: parent.height * bar.upload-fraction; background: #0B667F; }
                                                TouchArea { width: parent.width; height: parent.height; clicked => { root.traffic-selected-detail = bar.detail-label + " · 下载 " + bar.download + " · 上传 " + bar.upload; } }
                                            }
                                            Text { text: bar.label; color: LumenTheme.text-secondary; font-size: 8px * LumenUiScale.factor; horizontal-alignment: center; }
                                        }
                                    }
                                    if !root.traffic-today-has-data: Text { text: @tr("暂无统计数据；运行 Mihomo 后开始记录。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                }
                                if root.traffic-range == "week": VerticalLayout {
                                    Text { text: @tr("下载  ") + root.traffic-week-down + "     " + @tr("上传  ") + root.traffic-week-up; color: LumenTheme.text-secondary; font-size: 15px * LumenUiScale.factor; }
                                    Text { text: @tr("日均下载 ") + root.traffic-week-average-down + "     " + @tr("日均上传 ") + root.traffic-week-average-up; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
                                    if root.traffic-week-has-data: HorizontalLayout {
                                        height: 166px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                        for bar in root.traffic-week-bars: VerticalLayout {
                                            horizontal-stretch: 1; spacing: 4px * LumenUiScale.factor;
                                            Rectangle { vertical-stretch: 1; background: transparent;
                                                Rectangle { x: 4px * LumenUiScale.factor; y: parent.height - parent.height * bar.download-fraction; width: parent.width / 2 - 5px * LumenUiScale.factor; height: parent.height * bar.download-fraction; background: #0B667F; }
                                                Rectangle { x: parent.width / 2; y: parent.height - parent.height * bar.upload-fraction; width: parent.width / 2 - 4px * LumenUiScale.factor; height: parent.height * bar.upload-fraction; background: #0B667F; }
                                                TouchArea { width: parent.width; height: parent.height; clicked => { root.traffic-selected-detail = bar.detail-label + " · 下载 " + bar.download + " · 上传 " + bar.upload; } }
                                            }
                                            Text { text: bar.label; color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; horizontal-alignment: center; }
                                        }
                                    }
                                    if !root.traffic-week-has-data: Text { text: @tr("本周暂无统计数据；运行 Mihomo 后开始记录。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                }
                                Text { text: root.traffic-selected-detail; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                                if root.android-platform: Text { text: @tr("Android 应用级流量统计待接入；此处仅显示 Mihomo 核心总量。"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                            }
                        }

                        if root.page == "Preview": VerticalLayout {
                            width: parent.width; spacing: 8px * LumenUiScale.factor;
                            HorizontalLayout {
                                width: parent.width; height: 28px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                                Text { text: @tr("有效配置"); color: LumenTheme.text-primary; font-size: 16px * LumenUiScale.factor; font-weight: 600; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Rectangle {
                                    width: 48px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; border-radius: 12px * LumenUiScale.factor; background: LumenTheme.surface-muted;
                                    Text { text: @tr("只读"); width: parent.width; height: parent.height; color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            Text { text: @tr("敏感字段已遮蔽 · 修改行为请使用覆写配置"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
                            Rectangle {
                                width: parent.width;
                                height: max(420px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 168px * LumenUiScale.factor);
                                border-radius: 8px * LumenUiScale.factor;
                                border-width: 1px * LumenUiScale.factor;
                                border-color: LumenTheme.border;
                                background: LumenTheme.surface;
                                TextEdit {
                                    x: 10px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; width: parent.width - 20px * LumenUiScale.factor; height: parent.height - 16px * LumenUiScale.factor;
                                    text: root.content-preview;
                                    read-only: true;
                                    font-family: "monospace";
                                    font-size: 12px * LumenUiScale.factor;
                                }
                            }
                        }

                        if root.page == "About": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: "Lumen"; detail: @tr("版本 0.1.0 · Mihomo ") + root.core-version;
                                Text { text: @tr("跨平台 Mihomo 客户端，使用 Rust + Slint。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                Text { text: @tr("Lumen 源码许可：MIT。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                Text { text: @tr("代理节点旗帜图形使用 Twemoji，© Twitter, Inc. 和贡献者，CC BY 4.0。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                if root.android-platform: Text { text: @tr("Mihomo v1.19.32 是独立 GPL-3.0 核心进程，随本 ABI APK 提供；在依赖许可列表中搜索 Mihomo Core 可查看许可证和源码标签。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                                if !root.android-platform: Text { text: @tr("Mihomo 核心由用户安装在 PATH 中。第三方依赖许可正文随应用离线提供。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                Button { text: @tr("查看第三方依赖许可"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Licenses"; root.navigate("Licenses"); } }
                            }
                        }

                        if root.page == "Licenses": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: @tr("第三方依赖许可证"); detail: @tr("按依赖名、版本或 SPDX 许可证标识搜索");
                                Button { text: @tr("返回关于"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "About"; root.navigate("About"); } }
                                LineEdit { text <=> root.license-query; placeholder-text: @tr("搜索依赖或 SPDX 标识"); edited(query) => { root.search-licenses(query); } }
                                Text { text: @tr("匹配 ") + root.license-rows.length + @tr(" 项"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
                                if root.license-catalog-error != "": HorizontalLayout {
                                    Text { text: @tr("无法读取内置许可证清单：") + root.license-catalog-error; color: #B3261E; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; horizontal-stretch: 1; }
                                    Button { text: @tr("重试"); clicked => { root.retry-license-catalog(); } }
                                }
                                if root.license-rows.length == 0 && root.license-catalog-error == "": Text { text: root.license-query == "" ? @tr("当前许可证清单为空") : @tr("没有匹配的依赖或许可证"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
                                for item in root.license-rows: Rectangle {
                                    height: 66px * LumenUiScale.factor; border-radius: 7px * LumenUiScale.factor; background: #FFFFFF; border-width: 1px * LumenUiScale.factor; border-color: #E6E6E6;
                                    VerticalLayout {
                                        x: 12px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; width: parent.width - 24px * LumenUiScale.factor; height: parent.height - 16px * LumenUiScale.factor; spacing: 3px * LumenUiScale.factor;
                                        Text { text: item.name + "  " + item.version; color: LumenTheme.text-primary; font-size: 13px * LumenUiScale.factor; font-weight: 600; overflow: elide; }
                                        Text { text: item.identifier; color: LumenTheme.text-secondary; font-size: 11px * LumenUiScale.factor; wrap: word-wrap; }
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.license-detail-name = item.name;
                                            root.license-detail-version = item.version;
                                            root.license-detail-identifier = item.identifier;
                                            root.license-detail-text = "";
                                            root.license-detail-error = "";
                                            if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "LicenseDetail";
                                            root.navigate("LicenseDetail");
                                            root.open-license(item.id);
                                        }
                                    }
                                }
                            }
                        }

                        if root.page == "LicenseDetail": VerticalLayout {
                            width: parent.width; spacing: 14px * LumenUiScale.factor;
                            SectionCard { heading: root.license-detail-name + "  " + root.license-detail-version; detail: @tr("许可证标识：") + root.license-detail-identifier;
                                Button { text: @tr("返回许可证列表"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Licenses"; root.navigate("Licenses"); } }
                                if root.license-detail-error != "": HorizontalLayout {
                                    Text { text: root.license-detail-error; color: #B3261E; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; horizontal-stretch: 1; }
                                    Button { text: @tr("重试读取"); clicked => { root.retry-license-catalog(); } }
                                }
                                Text { text: @tr("许可证全文可选择并复制；Windows/Linux 可使用 Ctrl+C。"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
                                TextEdit { text: root.license-detail-text; read-only: true; height: 560px * LumenUiScale.factor; }
                            }
                        }
                    }
                }
                Rectangle {
                    // Navigation space was already removed from this layout's height.
                    height: 0px * LumenUiScale.factor;
                    background: transparent;
                }
            }
        }
    }
    }
    proxy-sort-menu := PopupMenu {
        x: root.safe-area-insets.left + root.width - root.safe-area-insets.right - self.width - 16px * LumenUiScale.factor;
        y: root.safe-area-insets.top + 72px * LumenUiScale.factor;
        available_width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        first_item_height: 56px * LumenUiScale.factor;
        row_height: 48px * LumenUiScale.factor;
        show_layout_bounds: root.layout-debug-bounds;
        divider_before_index: 1;
        current_index: root.proxy-sort-mode == "默认顺序" ? 1 : root.proxy-sort-mode == "按名称排序" ? 2 : 3;
        items: [
            { text: @tr("定位当前节点"), enabled: root.proxy-current-node-available },
            { text: @tr("默认顺序"), enabled: true },
            { text: @tr("按名称排序"), enabled: true },
            { text: @tr("按延迟排序"), enabled: true },
        ];
        activated(index) => {
            proxy-sort-menu.close();
        app-theme-menu.close();
            if index == 0 {
                root.locate-current-node();
            } else {
                let sort-index = index - 1;
                root.proxy-sort-mode = sort-index == 0 ? "默认顺序" : sort-index == 1 ? "按名称排序" : "按延迟排序";
                root.set-proxy-sort(root.proxy-sort-mode);
            }
        }
    }
    profile-add-sheet := ModalBottomSheet {
        width: root.width;
        height: root.height;
        bottom_safe_inset: root.safe-area-insets.bottom;
        sheet_elevation_level: 1;
        show_layout_bounds: root.layout-debug-bounds;
        scrim_color: root.application-dark-mode ? #000000.with_alpha(94%) : #000000.with_alpha(32%);
        surface_color: LumenTheme.surface;
        corner_radius: 28px * LumenUiScale.factor;
        dismissed => { root.close-profile-add(); }
        Rectangle {
            width: root.profile-sheet-content-width;
            height: root.profile-sheet-content-height;
            background: transparent;
            border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
            border-color: #FF2D55;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding-bottom: 16px * LumenUiScale.factor;
                spacing: 8px * LumenUiScale.factor;
                alignment: start;
            HorizontalLayout {
                x: 16px * LumenUiScale.factor;
                width: max(0px * LumenUiScale.factor, root.profile-sheet-content-width - 32px * LumenUiScale.factor);
                height: 44px * LumenUiScale.factor;
                spacing: 4px * LumenUiScale.factor;
                IconButton {
                    width: 44px * LumenUiScale.factor; height: 44px * LumenUiScale.factor;
                    icon: @image-url("../assets/icons/close.svg");
                    tooltip: @tr("关闭添加配置");
                    clicked => { root.close-profile-add(); }
                }
                Text { text: @tr("添加配置文件"); color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 550; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                IconButton {
                    width: 44px * LumenUiScale.factor; height: 44px * LumenUiScale.factor;
                    icon: @image-url("../assets/icons/check.svg");
                    tooltip: @tr("确认添加");
                    enabled: root.profile-add-kind-index != 2;
                    clicked => {
                        if root.profile-add-kind-index == 0 {
                            if root.profile-url == "" { root.notice = @tr("请输入订阅链接"); }
                            else { root.notice = @tr("正在验证订阅链接…"); root.add-url-profile(root.profile-name, root.profile-url, root.profile-age-key); }
                        } else if root.profile-add-kind-index == 1 {
                            root.choose-profile-file(root.profile-name, root.profile-age-key);
                            root.close-profile-add();
                        }
                    }
                }
            }
            Rectangle {
                width: root.profile-sheet-content-width; height: 50px * LumenUiScale.factor;
                border-radius: 25px * LumenUiScale.factor; background: LumenTheme.surface-muted;
                HorizontalLayout {
                    x: 18px * LumenUiScale.factor; width: root.profile-sheet-content-width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                    Text { text: @tr("配置类型"); color: LumenTheme.text-secondary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.profile-add-kind-index == 0 ? @tr("订阅链接") : root.profile-add-kind-index == 1 ? @tr("本地文件") : @tr("扫码添加");
                        color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center;
                    }
                    Image { source: @image-url("../assets/icons/chevron-expand.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; y: (parent.height - self.height) / 2; image-fit: contain; }
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-type-menu-open = !root.profile-type-menu-open; } }
            }
            if root.profile-add-kind-index == 0: VerticalLayout {
                width: root.profile-sheet-content-width;
                spacing: 8px * LumenUiScale.factor;
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("配置名称"); text <=> root.profile-name; }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("订阅链接"); text <=> root.profile-url; }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("Age 私钥（可选）"); password: true; text <=> root.profile-age-key; }
            }
            if root.profile-add-kind-index == 1: VerticalLayout {
                width: root.profile-sheet-content-width;
                spacing: 8px * LumenUiScale.factor;
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("配置名称（可选）"); text <=> root.profile-name; }
                Rectangle {
                    width: root.profile-sheet-content-width; height: 50px * LumenUiScale.factor; border-radius: 25px * LumenUiScale.factor; background: LumenTheme.surface-muted;
                    Text { x: 20px * LumenUiScale.factor; width: parent.width - 40px * LumenUiScale.factor; height: parent.height; text: @tr("选择 YAML / YML 文件"); color: LumenTheme.text-secondary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.choose-profile-file(root.profile-name, root.profile-age-key); root.close-profile-add(); } }
                }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("Age 私钥（可选）"); password: true; text <=> root.profile-age-key; }
            }
            if root.profile-add-kind-index == 2: Rectangle {
                width: root.profile-sheet-content-width;
                height: 120px * LumenUiScale.factor;
                border-radius: 28px * LumenUiScale.factor;
                background: LumenTheme.surface;
                VerticalLayout {
                    x: 18px * LumenUiScale.factor; width: root.profile-sheet-content-width - 36px * LumenUiScale.factor; height: parent.height; spacing: 6px * LumenUiScale.factor; alignment: center;
                    Text { text: @tr("扫码添加"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 550; }
                    Text { text: @tr("二维码扫描尚未接入。请先使用订阅链接或本地文件。"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
            if root.notice != "": Text {
                width: root.profile-sheet-content-width;
                text: root.notice;
                color: root.notice == "请输入订阅链接" ? LumenTheme.error : LumenTheme.text-secondary;
                font-size: 13px * LumenUiScale.factor;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
            if root.profile-type-menu-open: Rectangle {
                x: max(0px * LumenUiScale.factor, parent.width - 236px * LumenUiScale.factor);
                y: 64px * LumenUiScale.factor;
                width: 220px * LumenUiScale.factor;
                height: 168px * LumenUiScale.factor;
                border-radius: 16px * LumenUiScale.factor;
                background: LumenTheme.surface;
                clip: true;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px * LumenUiScale.factor;
                    Rectangle {
                        width: parent.width; height: 56px * LumenUiScale.factor; background: transparent;
                        HorizontalLayout {
                            x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                            Text { text: @tr("订阅链接"); color: root.profile-add-kind-index == 0 ? LumenTheme.accent : LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.profile-add-kind-index == 0: Image { source: @image-url("../assets/icons/check.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-add-kind-index = 0; root.profile-type-menu-open = false; root.notice = ""; } }
                    }
                    Rectangle {
                        width: parent.width; height: 56px * LumenUiScale.factor; background: transparent;
                        HorizontalLayout {
                            x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                            Text { text: @tr("本地文件"); color: root.profile-add-kind-index == 1 ? LumenTheme.accent : LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.profile-add-kind-index == 1: Image { source: @image-url("../assets/icons/check.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-add-kind-index = 1; root.profile-type-menu-open = false; root.notice = ""; } }
                    }
                    Rectangle {
                        width: parent.width; height: 56px * LumenUiScale.factor; background: transparent;
                        HorizontalLayout {
                            x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                            Text { text: @tr("扫码添加"); color: root.profile-add-kind-index == 2 ? LumenTheme.accent : LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.profile-add-kind-index == 2: Image { source: @image-url("../assets/icons/check.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-add-kind-index = 2; root.profile-type-menu-open = false; root.notice = ""; } }
                    }
                }
            }
        }
    }
    profile-action-sheet := ModalBottomSheet {
        width: root.width;
        height: root.height;
        bottom_safe_inset: root.safe-area-insets.bottom;
        sheet_elevation_level: 1;
        show_layout_bounds: root.layout-debug-bounds;
        scrim_color: #000000.with_alpha(32%);
        surface_color: LumenTheme.surface;
        corner_radius: 32px * LumenUiScale.factor;
        side_inset: 12px * LumenUiScale.factor;
        dismissed => {
            root.profile-action-open = false;
            root.profile-action-id = "";
            root.profile-action-name = "";
        }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: 224px * LumenUiScale.factor;
            background: transparent;
            border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
            border-color: #FF2D55;
            VerticalLayout {
                x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height;
                padding-top: 8px * LumenUiScale.factor; padding-bottom: 8px * LumenUiScale.factor; spacing: 10px * LumenUiScale.factor;
                Text { text: @tr("编辑配置"); color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32px * LumenUiScale.factor; }
                SheetActionButton {
                    width: parent.width;
                    label: @tr("编辑器打开");
                    clicked => {
                        let id = root.profile-action-id;
                        root.profile-action-open = false;
                        root.profile-action-id = "";
                        root.profile-action-name = "";
                        if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Preview";
                        root.navigate("Preview");
                        root.show-profile-preview(id);
                    }
                }
                SheetActionButton {
                    width: parent.width;
                    label: @tr("订阅设置");
                    primary: true;
                    clicked => {
                        let id = root.profile-action-id;
                        root.profile-action-open = false;
                        root.profile-action-id = "";
                        root.profile-action-name = "";
                        root.open-profile-settings(id);
                    }
                }
            }
        }
    }
    profile-share-sheet := ModalBottomSheet {
        width: root.width;
        height: root.height;
        bottom_safe_inset: root.safe-area-insets.bottom;
        sheet_elevation_level: 1;
        show_layout_bounds: root.layout-debug-bounds;
        scrim_color: #000000.with_alpha(32%);
        surface_color: LumenTheme.surface;
        corner_radius: 32px * LumenUiScale.factor;
        side_inset: 12px * LumenUiScale.factor;
        dismissed => {
            root.pending-profile-export-id = "";
            root.pending-profile-export-name = "";
        }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: 252px * LumenUiScale.factor;
            background: transparent;
            border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
            border-color: #FF2D55;
            VerticalLayout {
                x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height;
                padding-top: 8px * LumenUiScale.factor; padding-bottom: 8px * LumenUiScale.factor; spacing: 10px * LumenUiScale.factor;
                Text { text: @tr("分享配置"); color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32px * LumenUiScale.factor; }
                Text {
                    width: parent.width;
                    text: @tr("来源配置可能包含节点认证信息；导出仅包含来源 YAML，不含订阅凭据或绑定的覆写。");
                    color: LumenTheme.text-secondary;
                    font-size: 13px * LumenUiScale.factor;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                SheetActionButton {
                    width: parent.width;
                    label: @tr("分享配置文件");
                    clicked => {
                        let id = root.pending-profile-export-id;
                        root.pending-profile-export-id = "";
                        root.pending-profile-export-name = "";
                        root.export-profile(id);
                    }
                }
                SheetActionButton {
                    width: parent.width;
                    label: @tr("取消");
                    clicked => {
                        root.pending-profile-export-id = "";
                        root.pending-profile-export-name = "";
                    }
                }
            }
        }
    }
    profile-delete-sheet := ModalBottomSheet {
        width: root.width;
        height: root.height;
        bottom_safe_inset: root.safe-area-insets.bottom;
        sheet_elevation_level: 1;
        show_layout_bounds: root.layout-debug-bounds;
        scrim_color: #000000.with_alpha(32%);
        surface_color: LumenTheme.surface;
        corner_radius: 32px * LumenUiScale.factor;
        side_inset: 12px * LumenUiScale.factor;
        dismissed => {
            root.pending-delete-id = "";
            root.pending-delete-name = "";
        }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: 224px * LumenUiScale.factor;
            background: transparent;
            border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
            border-color: #FF2D55;
            VerticalLayout {
                x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height;
                padding-top: 8px * LumenUiScale.factor; padding-bottom: 8px * LumenUiScale.factor; spacing: 10px * LumenUiScale.factor;
                Text { text: @tr("删除配置"); color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32px * LumenUiScale.factor; }
                Text {
                    width: parent.width;
                    text: @tr("确定要删除「") + root.pending-delete-name + @tr("」吗？如果该配置正在运行，会先停止代理。");
                    color: LumenTheme.text-secondary;
                    font-size: 16px * LumenUiScale.factor;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    width: parent.width; height: 56px * LumenUiScale.factor; spacing: 12px * LumenUiScale.factor;
                    SheetActionButton {
                        horizontal-stretch: 1;
                        label: @tr("取消");
                        clicked => { root.pending-delete-id = ""; root.pending-delete-name = ""; }
                    }
                    SheetActionButton {
                        horizontal-stretch: 1;
                        label: @tr("删除");
                        primary: true;
                        clicked => {
                            let id = root.pending-delete-id;
                            root.pending-delete-id = "";
                            root.pending-delete-name = "";
                            root.confirm-delete-profile(id);
                        }
                    }
                }
            }
        }
    }
    profile-settings-sheet := ModalBottomSheet {
        width: root.width;
        height: root.height;
        bottom_safe_inset: root.safe-area-insets.bottom;
        sheet_elevation_level: 1;
        show_layout_bounds: root.layout-debug-bounds;
        scrim_color: #000000.with_alpha(32%);
        surface_color: LumenTheme.surface;
        corner_radius: 32px * LumenUiScale.factor;
        side_inset: 12px * LumenUiScale.factor;
        dismissed => {
            root.profile-settings-type-menu-open = false;
            root.cancel-profile-settings();
        }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: root.profile-settings-sheet-height;
            background: transparent;
            border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
            border-color: #FF2D55;
            VerticalLayout {
                x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor; height: parent.height;
                padding-top: 8px * LumenUiScale.factor; padding-bottom: 8px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor;
                ProfileSheetTitle {
                    width: parent.width;
                    title: @tr("订阅设置");
                    close => { root.profile-settings-type-menu-open = false; root.cancel-profile-settings(); }
                    confirm => { root.save-profile-settings(root.profile-settings-id, root.profile-settings-name, root.profile-settings-url, root.profile-settings-age-key); }
                }
                Rectangle {
                    width: parent.width; height: 50px * LumenUiScale.factor; border-radius: 25px * LumenUiScale.factor; background: LumenTheme.surface-muted;
                    HorizontalLayout {
                        x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                        Text { text: @tr("设置类型"); color: LumenTheme.text-secondary; font-size: 17px * LumenUiScale.factor; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.profile-settings-type-index == 0 ? @tr("订阅信息") : @tr("覆写配置"); color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; vertical-alignment: center; }
                        Image { source: @image-url("../assets/icons/chevron-expand.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
                    }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-settings-type-menu-open = !root.profile-settings-type-menu-open; } }
                }
                ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: self.width;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        width: parent.width; spacing: 10px * LumenUiScale.factor; alignment: start;
                        if root.profile-settings-type-index == 0: VerticalLayout {
                            width: parent.width; spacing: 8px * LumenUiScale.factor;
                            LightRoundedInput { width: parent.width; label: @tr("配置名称"); text <=> root.profile-settings-name; }
                            if root.profile-settings-kind == "订阅链接": LightRoundedInput { width: parent.width; label: @tr("订阅链接"); text <=> root.profile-settings-url; }
                            if root.profile-settings-kind == "订阅链接": LightRoundedInput { width: parent.width; label: @tr("Age 私钥（可选）"); password: true; text <=> root.profile-settings-age-key; }
                            if root.profile-settings-kind != "订阅链接": Text { text: @tr("本地来源配置保持只读；名称可在此修改。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                        }
                        if root.profile-settings-type-index == 1: VerticalLayout {
                            width: parent.width; spacing: 8px * LumenUiScale.factor;
                            Text { text: @tr("覆写配置"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
                            Text { text: @tr("选中的覆写会按列表顺序合并；更改先保存为 Profile 绑定。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                            if root.profile-settings-overrides.length == 0: Text { text: @tr("暂无可绑定的 YAML 覆写"); color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; }
                            for option in root.profile-settings-overrides: HorizontalLayout {
                                width: parent.width; height: 56px * LumenUiScale.factor; spacing: 4px * LumenUiScale.factor;
                                CheckBox { text: option.name + " · " + option.format; checked: option.selected; horizontal-stretch: 1; toggled => { root.toggle-profile-override(option.id, self.checked); } }
                                Button { text: "↑"; enabled: option.selected && option.can-move-up; clicked => { root.move-profile-override(option.id, true); } }
                                Button { text: "↓"; enabled: option.selected && option.can-move-down; clicked => { root.move-profile-override(option.id, false); } }
                            }
                        }
                    }
                }
            }
            if root.profile-settings-type-menu-open: Rectangle {
                x: 0px * LumenUiScale.factor; y: 64px * LumenUiScale.factor; width: parent.width; height: max(0px * LumenUiScale.factor, parent.height - 64px * LumenUiScale.factor);
                background: transparent;
                TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-settings-type-menu-open = false; } }
            }
            if root.profile-settings-type-menu-open: Rectangle {
                x: max(0px * LumenUiScale.factor, parent.width - 236px * LumenUiScale.factor);
                y: 112px * LumenUiScale.factor;
                width: 220px * LumenUiScale.factor;
                height: 112px * LumenUiScale.factor;
                border-radius: 16px * LumenUiScale.factor;
                background: LumenTheme.surface;
                border-width: 1px * LumenUiScale.factor;
                border-color: LumenTheme.border;
                VerticalLayout {
                    width: parent.width; height: parent.height; spacing: 0px * LumenUiScale.factor;
                    for title[index] in [@tr("订阅信息"), @tr("覆写配置")]: Rectangle {
                        width: parent.width; height: 56px * LumenUiScale.factor; background: transparent;
                        HorizontalLayout {
                            x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor; height: parent.height; spacing: 8px * LumenUiScale.factor;
                            Text { text: title; color: root.profile-settings-type-index == index ? LumenTheme.accent : LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; horizontal-stretch: 1; vertical-alignment: center; }
                            if root.profile-settings-type-index == index: Image { source: @image-url("../assets/icons/check.svg"); width: 20px * LumenUiScale.factor; height: 20px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
                        }
                        TouchArea { width: parent.width; height: parent.height; clicked => { root.profile-settings-type-index = index; root.profile-settings-type-menu-open = false; } }
                    }
                }
            }
        }
    }
    if root.compact-layout && root.primary-page && root.bottom-bar-visible: Rectangle {
        width: min(360px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right - 64px * LumenUiScale.factor));
        x: root.safe-area-insets.left + (root.width - root.safe-area-insets.left - root.safe-area-insets.right - self.width) / 2;
        y: root.height - root.safe-area-insets.bottom - LumenTheme.navigation-height - LumenTheme.space-1;
        height: LumenTheme.navigation-height;
        border-width: 1px * LumenUiScale.factor;
        border-color: LumenTheme.border;
        border-radius: LumenTheme.navigation-height / 2;
        background: LumenTheme.surface;
        clip: true;
        NavigationBar {
            width: parent.width;
            height: parent.height;
            compact: true;
            show-layout-bounds: root.layout-debug-bounds;
            border-radius: LumenTheme.navigation-height / 2;
            items: [
                { icon: @image-url("../assets/icons/home.svg"), selected_icon: @image-url("../assets/icons/home-active.svg"), text: @tr("首页") },
                { icon: @image-url("../assets/icons/proxy.svg"), selected_icon: @image-url("../assets/icons/proxy-active.svg"), text: @tr("代理") },
                { icon: @image-url("../assets/icons/config.svg"), selected_icon: @image-url("../assets/icons/config-active.svg"), text: @tr("配置") },
                { icon: @image-url("../assets/icons/settings.svg"), selected_icon: @image-url("../assets/icons/settings-active.svg"), text: @tr("设置") },
            ];
            current-index: root.page == "Home" ? 0 : root.page == "Proxy" ? 1 : root.page == "Config" ? 2 : 3;
            index-changed(index) => {
                root.selected-group = "";
                if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = index == 0 ? "Home" : index == 1 ? "Proxy" : index == 2 ? "Config" : "Settings";
                root.navigate(root.page);
            }
        }
    }
    if root.back-gesture-active && root.back-preview-available: Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: max(0px * LumenUiScale.factor, (root.width - root.safe-area-insets.left - root.safe-area-insets.right) * clamp(root.back-gesture-progress, 0, 1));
        height: max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
        background: LumenTheme.canvas;
        clip: true;
        z: 900;
        Image {
            x: 0px * LumenUiScale.factor;
            y: 0px * LumenUiScale.factor;
            width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
            height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
            source: root.back-preview-image;
            image-fit: fill;
        }
        Rectangle {
            x: parent.width - 2px * LumenUiScale.factor;
            y: 0px * LumenUiScale.factor;
            width: 2px * LumenUiScale.factor;
            height: parent.height;
            background: #000000.with_alpha(18%);
        }
    }
    if root.clear-traffic-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #99000000;
        Rectangle {
            x: root.compact-layout ? 12px * LumenUiScale.factor : (parent.width - 430px * LumenUiScale.factor) / 2;
            y: (parent.height - 210px * LumenUiScale.factor) / 2;
            width: root.compact-layout ? parent.width - 24px * LumenUiScale.factor : 430px * LumenUiScale.factor;
            height: 210px * LumenUiScale.factor; border-radius: 12px * LumenUiScale.factor;
            background: #FFFFFF; border-width: 1px * LumenUiScale.factor; border-color: #E6E6E6;
            VerticalLayout {
                x: 22px * LumenUiScale.factor; y: 20px * LumenUiScale.factor; width: parent.width - 44px * LumenUiScale.factor; height: parent.height - 40px * LumenUiScale.factor; spacing: 12px * LumenUiScale.factor;
                Text { text: @tr("清空统计？"); color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; font-weight: 650; }
                Text { text: @tr("这会删除本地保留的近 7 日流量汇总，无法撤销。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: @tr("取消"); clicked => { root.clear-traffic-dialog-open = false; } }
                    Button { text: @tr("清空"); clicked => { root.clear-traffic-history(); root.clear-traffic-dialog-open = false; root.traffic-selected-detail = ""; } }
                }
            }
        }
    }
    app-theme-menu := PopupMenu {
        x: max(root.safe-area-insets.left + 12px * LumenUiScale.factor, min(root.width - root.safe-area-insets.right - self.width - 12px * LumenUiScale.factor, root.app-theme-anchor-x - self.width));
        y: max(root.safe-area-insets.top, min(root.app-theme-anchor-y, root.height - root.safe-area-insets.bottom - self.height - 12px * LumenUiScale.factor));
        available_width: root.width; show_layout_bounds: root.layout-debug-bounds;
        items: [{ text: @tr("跟随系统"), enabled: true }, { text: @tr("浅色"), enabled: true }, { text: @tr("深色"), enabled: true }];
        current_index: root.theme-mode == "light" ? 1 : root.theme-mode == "dark" ? 2 : 0;
        activated(index) => { root.set-theme-mode(index == 0 ? "system" : index == 1 ? "light" : "dark"); self.close(); }
    }
    app-language-menu := PopupMenu {
        x: max(root.safe-area-insets.left + 12px * LumenUiScale.factor, min(root.width - root.safe-area-insets.right - self.width - 12px * LumenUiScale.factor, root.app-language-anchor-x - self.width));
        y: max(root.safe-area-insets.top, min(root.app-language-anchor-y, root.height - root.safe-area-insets.bottom - self.height - 12px * LumenUiScale.factor));
        available_width: root.width; show_layout_bounds: root.layout-debug-bounds;
        items: [{ text: @tr("跟随系统"), enabled: true }, { text: @tr("简体中文"), enabled: true }, { text: "English", enabled: true }];
        current_index: root.application-language == "en" || (root.application-language == "system" && root.system-language == "en") ? 2 : root.application-language == "zh-CN" ? 1 : 0;
        activated(index) => { root.set-application-language(index == 0 ? "system" : index == 1 ? "zh-CN" : "en"); self.close(); }
    }
    theme-color-sheet := ModalBottomSheet {
        width: root.width; height: root.height; bottom_safe_inset: root.app-settings-bottom-inset;
        side_inset: 12px * LumenUiScale.factor; corner_radius: 32px * LumenUiScale.factor; sheet_elevation_level: 1;
        surface_color: LumenTheme.surface; scrim_color: #000000.with_alpha(32%);
        show_layout_bounds: root.layout-debug-bounds;
        dismissed => {
            root.theme-color-dialog-open = false;
            root.cancel-theme-color-preview();
        }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: min(540px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.app-settings-bottom-inset - 40px * LumenUiScale.factor));
            ScrollView {
                width: parent.width; height: parent.height; content-width: self.width;
                mouse-drag-pan-enabled: root.android-platform;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    x: 16px * LumenUiScale.factor; width: max(0px * LumenUiScale.factor, parent.width - 32px * LumenUiScale.factor);
                    padding-top: 12px * LumenUiScale.factor; padding-bottom: 18px * LumenUiScale.factor;
                    spacing: 8px * LumenUiScale.factor; alignment: start;
                    HorizontalLayout {
                        height: 48px * LumenUiScale.factor; cross-axis-alignment: center;
                        IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/close.svg"); tooltip: @tr("关闭"); clicked => { root.theme-color-dialog-open = false; root.cancel-theme-color-preview(); } }
                        Text { text: @tr("主题配色"); font-size: 18px * LumenUiScale.factor; color: LumenTheme.text-primary; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: center; }
                        Rectangle { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; }
                    }
                    Text { text: @tr("颜色预览"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; }
                    Rectangle { width: parent.width; height: 44px * LumenUiScale.factor; border-radius: 22px * LumenUiScale.factor; background: LumenTheme.accent; }
                    Text { text: @tr("色相"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; }
                    AppColorSlider {
                        width: parent.width; height: 44px * LumenUiScale.factor; value: root.theme-hue-draft; minimum: 0; maximum: 359; step: 1;
                        track-brush: LumenTheme.preference-off; fill-color: LumenTheme.accent; accessible-name: @tr("色相");
                        value-changed(value) => { root.theme-color-code-edited = false; root.theme-hue-draft = value; root.preview-theme-color(value, root.theme-saturation-draft, root.theme-value-draft); }
                    }
                    Text { text: @tr("饱和度"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; }
                    AppColorSlider {
                        width: parent.width; height: 44px * LumenUiScale.factor; value: root.theme-saturation-draft * 100; minimum: 0; maximum: 100; step: 1;
                        track-brush: LumenTheme.preference-off; fill-color: LumenTheme.accent; accessible-name: @tr("饱和度");
                        value-changed(value) => { root.theme-color-code-edited = false; root.theme-saturation-draft = value / 100; root.preview-theme-color(root.theme-hue-draft, value / 100, root.theme-value-draft); }
                    }
                    Text { text: @tr("明度"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; }
                    AppColorSlider {
                        width: parent.width; height: 44px * LumenUiScale.factor; value: root.theme-value-draft * 100; minimum: 0; maximum: 100; step: 1;
                        track-brush: LumenTheme.preference-off; fill-color: LumenTheme.accent; accessible-name: @tr("明度");
                        value-changed(value) => { root.theme-color-code-edited = false; root.theme-value-draft = value / 100; root.preview-theme-color(root.theme-hue-draft, root.theme-saturation-draft, value / 100); }
                    }
                    Text { text: @tr("颜色代码"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; }
                    RoundedInputField { width: parent.width; label: "##RRGGBB"; text <=> root.theme-color-code-draft; edited(value) => { root.theme-color-code-edited = true; } }
                    if root.theme-color-error != "": Text { text: root.theme-color-error; font-size: 14px * LumenUiScale.factor; color: LumenTheme.error; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 12px * LumenUiScale.factor;
                        SheetActionButton { horizontal-stretch: 1; label: @tr("取消"); clicked => { root.theme-color-dialog-open = false; root.cancel-theme-color-preview(); } }
                        SheetActionButton { horizontal-stretch: 1; label: root.theme-color-saving ? @tr("正在应用…") : @tr("应用颜色"); enabled: !root.theme-color-saving; primary: true; clicked => { root.theme-color-saving = true; root.theme-color-error = ""; root.set-theme-color(root.theme-color-code-draft); } }
                    }
                }
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #34C759; }
        }
    }
    page-scale-sheet := ModalBottomSheet {
        width: root.width; height: root.height; bottom_safe_inset: root.app-settings-bottom-inset;
        side_inset: 12px * LumenUiScale.factor; corner_radius: 32px * LumenUiScale.factor; sheet_elevation_level: 1;
        surface_color: LumenTheme.surface; scrim_color: #000000.with_alpha(32%);
        show_layout_bounds: root.layout-debug-bounds;
        dismissed => { root.page-scale-dialog-open = false; }
        Rectangle {
            width: root.profile-dialog-content-width; height: 280px * LumenUiScale.factor;
            VerticalLayout {
                x: 16px * LumenUiScale.factor; width: parent.width - 32px * LumenUiScale.factor;
                padding-top: 12px * LumenUiScale.factor; padding-bottom: 16px * LumenUiScale.factor; spacing: 12px * LumenUiScale.factor;
                HorizontalLayout {
                    height: 48px * LumenUiScale.factor; cross-axis-alignment: center;
                    IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/close.svg"); tooltip: @tr("取消"); clicked => { root.page-scale-dialog-open = false; } }
                    Text { text: @tr("页面缩放"); font-size: 18px * LumenUiScale.factor; color: LumenTheme.text-primary; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: center; }
                    Rectangle { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; }
                }
                Text { text: @tr("当前比例：") + root.page-scale-draft + "%"; font-size: 16px * LumenUiScale.factor; color: LumenTheme.text-primary; horizontal-alignment: center; horizontal-stretch: 1; }
                AppColorSlider {
                    width: parent.width; height: 54px * LumenUiScale.factor; value: root.page-scale-draft; minimum: 85; maximum: 115; step: 5;
                    track-brush: LumenTheme.preference-off; fill-color: LumenTheme.accent; accessible-name: @tr("页面缩放");
                    value-changed(value) => { root.page-scale-draft = Math.round(value / 5) * 5; }
                }
                Text { text: @tr("85%–115% · 以逻辑尺寸缩放文字、图标、间距和控件"); font-size: 13px * LumenUiScale.factor; color: LumenTheme.text-secondary; wrap: word-wrap; horizontal-alignment: center; horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 12px * LumenUiScale.factor;
                    SheetActionButton { horizontal-stretch: 1; label: @tr("取消"); clicked => { root.page-scale-dialog-open = false; } }
                    SheetActionButton { horizontal-stretch: 1; label: @tr("应用"); primary: true; clicked => { root.page-scale-committing = true; root.page-scale-percent = root.page-scale-draft; root.set-page-scale(root.page-scale-draft); root.page-scale-dialog-open = false; } }
                }
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #34C759; }
        }
    }
    user-agent-sheet := ModalBottomSheet {
        width: root.width; height: root.height; bottom_safe_inset: root.app-settings-bottom-inset;
        side_inset: 12px * LumenUiScale.factor; corner_radius: 32px * LumenUiScale.factor; sheet_elevation_level: 1;
        surface_color: LumenTheme.surface; scrim_color: #000000.with_alpha(32%);
        show_layout_bounds: root.layout-debug-bounds;
        dismissed => { root.user-agent-dialog-open = false; }
        Rectangle {
            width: root.profile-dialog-content-width;
            height: min(root.user-agent-error == "" ? 260px * LumenUiScale.factor : 320px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.app-settings-bottom-inset - 60px * LumenUiScale.factor));
            ScrollView {
                width: parent.width; height: parent.height; content-width: self.width;
                mouse-drag-pan-enabled: root.android-platform;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    x: 16px * LumenUiScale.factor; width: max(0px * LumenUiScale.factor, parent.width - 32px * LumenUiScale.factor); padding-bottom: 16px * LumenUiScale.factor; spacing: 14px * LumenUiScale.factor; alignment: start;
                    HorizontalLayout {
                        height: 48px * LumenUiScale.factor; cross-axis-alignment: center;
                        IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/close.svg"); tooltip: @tr("取消"); clicked => { root.user-agent-dialog-open = false; } }
                        Text { text: @tr("自定义 User-Agent"); font-size: 18px * LumenUiScale.factor; color: LumenTheme.text-primary; horizontal-stretch: 1; vertical-alignment: center; horizontal-alignment: center; }
                        Rectangle { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; }
                    }
                    Text { text: @tr("留空使用默认值 Lumen/0.1.0"); font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary; wrap: word-wrap; vertical-stretch: 0; }
                    RoundedInputField { width: parent.width; label: "User-Agent"; text <=> root.user-agent-draft; }
                    if root.user-agent-error != "": Text { text: root.user-agent-error; font-size: 14px * LumenUiScale.factor; color: LumenTheme.error; wrap: word-wrap; vertical-stretch: 0; }
                    HorizontalLayout {
                        spacing: 12px * LumenUiScale.factor;
                        SheetActionButton { horizontal-stretch: 1; label: @tr("取消"); clicked => { root.user-agent-dialog-open = false; } }
                        SheetActionButton { horizontal-stretch: 1; label: root.user-agent-saving ? @tr("保存中…") : @tr("应用"); enabled: !root.user-agent-saving; primary: true; clicked => { root.user-agent-saving = true; root.user-agent-error = ""; root.save-user-agent(root.user-agent-draft); } }
                    }
                }
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #34C759; }
        }
    }
    if root.network-mode-dialog-open: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #99000000;
        Rectangle {
            x: root.compact-layout ? 12px * LumenUiScale.factor : (parent.width - 480px * LumenUiScale.factor) / 2;
            y: (parent.height - 230px * LumenUiScale.factor) / 2;
            width: root.compact-layout ? parent.width - 24px * LumenUiScale.factor : 480px * LumenUiScale.factor;
            height: 230px * LumenUiScale.factor; border-radius: 12px * LumenUiScale.factor;
            background: #FFFFFF; border-width: 1px * LumenUiScale.factor; border-color: #E6E6E6;
            VerticalLayout {
                x: 22px * LumenUiScale.factor; y: 20px * LumenUiScale.factor; width: parent.width - 44px * LumenUiScale.factor; height: parent.height - 40px * LumenUiScale.factor; spacing: 12px * LumenUiScale.factor;
                Text { text: @tr("切换网络接管模式？"); color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; font-weight: 650; }
                Text { text: @tr("将停止当前 Mihomo，再以「") + root.network-mode-draft + @tr("」重新启动；切换期间网络可能短暂中断。若配置校验或平台状态确认失败，Runtime 会保持停止并显示恢复提示。"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Button { text: @tr("取消"); clicked => { root.network-mode-dialog-open = false; root.network-mode-draft = ""; } }
                    Button { text: @tr("切换并重启"); clicked => { root.set-network-mode(root.network-mode-draft); root.network-mode-dialog-open = false; root.network-mode-draft = ""; } }
                }
            }
        }
    }
    if root.page == "AppSettings" && root.app-settings-message != "" && !root.user-agent-dialog-open && !root.theme-color-dialog-open && !root.page-scale-dialog-open && !app-language-menu.is-open && !app-theme-menu.is-open: Rectangle {
        x: root.safe-area-insets.left + 12px * LumenUiScale.factor;
        width: max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right - 24px * LumenUiScale.factor);
        height: message-content.min-height;
        y: max(root.safe-area-insets.top, root.height - root.safe-area-insets.bottom - self.height - 12px * LumenUiScale.factor);
        background: LumenTheme.accent-soft; border-radius: 24px * LumenUiScale.factor;
        message-content := HorizontalLayout {
            width: parent.width; padding: 12px * LumenUiScale.factor; spacing: 8px * LumenUiScale.factor; cross-axis-alignment: center;
            Text { text: root.app-settings-message; color: LumenTheme.text-primary; font-size: 14px * LumenUiScale.factor; wrap: word-wrap; horizontal-stretch: 1; }
            IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/close.svg"); tooltip: @tr("关闭提示"); clicked => { root.app-settings-message = ""; } }
        }
    }
    if root.layout-debug-bounds: Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
        height: max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
        background: transparent;
        border-width: 1px * LumenUiScale.factor;
        border-color: #FF2D55;
        z: 1000;
    }
    app-settings-message-timeout := Timer {
        interval: 5s;
        running: root.app-settings-message != "";
        triggered => { root.app-settings-message = ""; }
    }
}
