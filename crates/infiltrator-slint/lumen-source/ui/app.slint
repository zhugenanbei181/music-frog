import { Button, CheckBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import {
    FilledButton, IconButton, LargeAppBar, MaterialPalette, MaterialSchemes,
    NavigationBar, PopupMenu, SegmentedButton, SmallAppBar, Switch, TextField, TonalButton,
    ModalBottomSheet, MaterialWindow
} from "@material";
import { FlagIcon, FlagImages } from "flag-icons.slint";
import { LumenUiScale } from "ui-scale.slint";
export { Palette } from "std-widgets.slint";
export { MaterialWindowAdapter } from "@material";

export global LumenTheme {
    in-out property <bool> dark-mode: false;
    in-out property <bool> show-layout-bounds: false;
    in-out property <color> user-accent: #016888;
    in-out property <color> accent-foreground: #FFFFFF;
    in-out property <bool> invert-semantic-foreground: false;
    out property <MaterialSchemes> material-schemes: {
        light: {
            primary: root.user-accent,
            surfaceTint: root.user-accent,
            onPrimary: root.accent-foreground,
            primaryContainer: #DCEEF2,
            onPrimaryContainer: #062F3A,
            secondary: #48666E,
            onSecondary: #FFFFFF,
            secondaryContainer: #D8EAED,
            onSecondaryContainer: #12343B,
            tertiary: #52635E,
            onTertiary: #FFFFFF,
            tertiaryContainer: #D7E8E1,
            onTertiaryContainer: #152A25,
            error: #BA1A1A,
            onError: #FFFFFF,
            errorContainer: #FFDAD6,
            onErrorContainer: #410002,
            background: #F7F7F7,
            onBackground: #17191A,
            surface: #FFFFFF,
            onSurface: root.invert-semantic-foreground ? #41494B : #17191A,
            surfaceVariant: #E8EEEE,
            onSurfaceVariant: root.invert-semantic-foreground ? #17191A : #41494B,
            outline: #747D7F,
            outlineVariant: #DDE3E4,
            shadow: #000000,
            scrim: #000000,
            inverseSurface: #2B3031,
            inverseOnSurface: #EFF1F1,
            inversePrimary: #A5D7E1,
            primaryFixed: #DCEEF2,
            onPrimaryFixed: #062F3A,
            primaryFixedDim: #A5D7E1,
            onPrimaryFixedVariant: #164F5D,
            secondaryFixed: #D8EAED,
            onSecondaryFixed: #12343B,
            secondaryFixedDim: #BBD2D6,
            onSecondaryFixedVariant: #354F55,
            tertiaryFixed: #D7E8E1,
            onTertiaryFixed: #152A25,
            tertiaryFixedDim: #BBCDC6,
            onTertiaryFixedVariant: #3A4E48,
            surfaceDim: #DEDFDF,
            surfaceBright: #FFFFFF,
            surfaceContainerLowest: #FFFFFF,
            surfaceContainerLow: #F4F6F6,
            surfaceContainer: #FFFFFF,
            surfaceContainerHigh: #E8ECEC,
            surfaceContainerHighest: #E1E6E6,
        },
        dark: {
            primary: root.user-accent,
            surfaceTint: root.user-accent,
            onPrimary: root.accent-foreground,
            primaryContainer: #06495B,
            onPrimaryContainer: #D5F1F8,
            secondary: #B8CDD2,
            onSecondary: #1D343A,
            secondaryContainer: #263E44,
            onSecondaryContainer: #D6E8EC,
            tertiary: #BECAC3,
            onTertiary: #28352F,
            tertiaryContainer: #3B4942,
            onTertiaryContainer: #DAE6DE,
            error: #FFB4AB,
            onError: #690005,
            errorContainer: #93000A,
            onErrorContainer: #FFDAD6,
            background: #000000,
            onBackground: #EEEEEE,
            surface: #000000,
            onSurface: root.invert-semantic-foreground ? #A4A4A4 : #EEEEEE,
            surfaceVariant: #303030,
            onSurfaceVariant: root.invert-semantic-foreground ? #EEEEEE : #A4A4A4,
            outline: #777777,
            outlineVariant: #353535,
            shadow: #000000,
            scrim: #000000,
            inverseSurface: #EEEEEE,
            inverseOnSurface: #252525,
            inversePrimary: #0B667F,
            primaryFixed: #DCEEF2,
            onPrimaryFixed: #062F3A,
            primaryFixedDim: #A5D7E1,
            onPrimaryFixedVariant: #164F5D,
            secondaryFixed: #D8EAED,
            onSecondaryFixed: #12343B,
            secondaryFixedDim: #BBD2D6,
            onSecondaryFixedVariant: #354F55,
            tertiaryFixed: #D7E8E1,
            onTertiaryFixed: #152A25,
            tertiaryFixedDim: #BBCDC6,
            onTertiaryFixedVariant: #3A4E48,
            surfaceDim: #000000,
            surfaceBright: #383838,
            surfaceContainerLowest: #111111,
            surfaceContainerLow: #171717,
            surfaceContainer: #222222,
            surfaceContainerHigh: #2B2B2B,
            surfaceContainerHighest: #333333,
        },
    };

    out property <color> canvas: root.dark-mode ? root.material-schemes.dark.background : root.material-schemes.light.background;
    out property <color> surface: root.dark-mode ? #222222 : root.material-schemes.light.surface;
    out property <color> surface-muted: root.dark-mode ? #1C1C1C : root.material-schemes.light.surfaceContainerLow;
    out property <color> accent: root.user-accent;
    out property <color> accent-soft: root.dark-mode ? root.material-schemes.dark.primaryContainer : root.material-schemes.light.primaryContainer;
    out property <color> text-primary: root.dark-mode ? root.material-schemes.dark.onSurface : root.material-schemes.light.onSurface;
    out property <color> text-secondary: root.dark-mode ? root.material-schemes.dark.onSurfaceVariant : root.material-schemes.light.onSurfaceVariant;
    out property <color> border: root.dark-mode ? root.material-schemes.dark.outlineVariant : root.material-schemes.light.outlineVariant;
    out property <color> disabled: (root.dark-mode ? root.material-schemes.dark.onSurfaceVariant : root.material-schemes.light.onSurfaceVariant).with_alpha(38%);
    out property <color> error: root.dark-mode ? root.material-schemes.dark.error : root.material-schemes.light.error;
    out property <color> ping-good: root.dark-mode ? #82D68D : #2E7D32;
    out property <color> ping-good-soft: root.dark-mode ? #233B27 : #E8F4E8;
    out property <color> ping-warning: root.dark-mode ? #FFD180 : #8A5A00;
    out property <color> ping-warning-soft: root.dark-mode ? #3C321F : #FFF2D1;
    out property <color> ping-bad: root.dark-mode ? #FFB4AB : #C62828;
    out property <color> ping-bad-soft: root.dark-mode ? #402624 : #FCE8E6;

    out property <color> preference-off: root.dark-mode ? #484848 : #E7E7E7;
    out property <color> preference-accent: root.accent;
    out property <length> preference-card-radius: 28px * LumenUiScale.factor;
    out property <length> preference-text-size: 18px * LumenUiScale.factor;
    out property <length> space-1: 4px * LumenUiScale.factor;
    out property <length> space-2: 8px * LumenUiScale.factor;
    out property <length> space-3: 12px * LumenUiScale.factor;
    out property <length> space-4: 16px * LumenUiScale.factor;
    out property <length> space-6: 24px * LumenUiScale.factor;
    out property <length> space-8: 32px * LumenUiScale.factor;
    out property <length> radius-control: 14px * LumenUiScale.factor;
    out property <length> radius-card: 24px * LumenUiScale.factor;
    out property <length> radius-sheet: 28px * LumenUiScale.factor;
    out property <length> min-touch-target: 48px * LumenUiScale.factor;
    out property <length> page-padding: 16px * LumenUiScale.factor;
    out property <length> navigation-height: 56px * LumenUiScale.factor;
    out property <length> title-size: 28px * LumenUiScale.factor;
    out property <length> body-size: 16px * LumenUiScale.factor;
    out property <length> supporting-size: 14px * LumenUiScale.factor;
}

component LayoutOutline inherits Rectangle {
    in property <color> outline-color: #FF2D55;
    background: transparent;
    border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
    border-color: root.outline-color;
}

component PingClock inherits Image {
    in property <bool> spinning: false;
    in property <color> icon-color: LumenTheme.text-secondary;
    in property <length> icon-size: 16px * LumenUiScale.factor;
    property <int> frame: 0;
    property <[image]> spin-frames: [
        @image-url("../assets/icons/ping-spin-000.svg"),
        @image-url("../assets/icons/ping-spin-045.svg"),
        @image-url("../assets/icons/ping-spin-090.svg"),
        @image-url("../assets/icons/ping-spin-135.svg"),
        @image-url("../assets/icons/ping-spin-180.svg"),
        @image-url("../assets/icons/ping-spin-225.svg"),
        @image-url("../assets/icons/ping-spin-270.svg"),
        @image-url("../assets/icons/ping-spin-315.svg"),
    ];

    width: root.icon-size;
    height: root.icon-size;
    source: root.spinning ? root.spin-frames[root.frame] : @image-url("../assets/icons/ping.svg");
    image-fit: contain;
    colorize: root.icon-color;

    Timer {
        interval: 80ms;
        running: root.spinning;
        triggered => {
            if root.frame >= root.spin-frames.length - 1 { root.frame = 0; }
            else { root.frame += 1; }
        }
    }
}

component PingBadge inherits Rectangle {
    in property <string> label: "Ping";
    in property <int> delay-ms: -1;
    in property <bool> spinning: false;
    in property <bool> enabled: true;
    callback clicked();

    property <color> state-color: root.spinning || root.delay-ms < 0
        ? LumenTheme.text-secondary
        : root.delay-ms == 0 || root.delay-ms > 800
            ? LumenTheme.ping-bad
            : root.delay-ms <= 250
                ? LumenTheme.ping-good
                : LumenTheme.ping-warning;
    property <color> state-background: root.spinning || root.delay-ms < 0
        ? LumenTheme.surface-muted
        : root.delay-ms == 0 || root.delay-ms > 800
            ? LumenTheme.ping-bad-soft
            : root.delay-ms <= 250
                ? LumenTheme.ping-good-soft
                : LumenTheme.ping-warning-soft;

    width: max(72px * LumenUiScale.factor, ping-label.preferred-width + 37px * LumenUiScale.factor);
    height: 24px * LumenUiScale.factor;
    border-radius: 12px * LumenUiScale.factor;
    background: root.state-background;
    accessible-role: button;
    accessible-label: root.spinning ? @tr("正在测速") : (root.label == "Ping" ? @tr("Ping 测速") : "Ping " + root.label);

    ping-layout := HorizontalLayout {
        x: 8px * LumenUiScale.factor;
        width: max(0px * LumenUiScale.factor, parent.width - 16px * LumenUiScale.factor);
        height: parent.height;
        spacing: 5px * LumenUiScale.factor;
        cross-axis-alignment: center;

        ping-icon := PingClock {
            spinning: root.spinning;
            icon-color: root.state-color;
        }
        ping-label := Text {
            text: root.spinning ? "Ping" : root.label;
            color: root.state-color;
            font-size: 13px * LumenUiScale.factor;
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-icon.x;
        y: ping-layout.y + ping-icon.y;
        width: ping-icon.width;
        height: ping-icon.height;
        background: transparent;
        border-width: 1px * LumenUiScale.factor;
        border-color: #007AFF;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-label.x;
        y: ping-layout.y + ping-label.y;
        width: ping-label.width;
        height: ping-label.height;
        background: transparent;
        border-width: 1px * LumenUiScale.factor;
        border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export struct ProfileCard {
