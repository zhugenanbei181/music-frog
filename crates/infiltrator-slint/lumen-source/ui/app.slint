component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> icon;
    in property <string> badge: "";
    callback clicked();
    background: transparent;
    min-height: 72px * LumenUiScale.factor;
    preferred-height: content-layout.preferred-height;
    content-layout := VerticalLayout {
        x: 0px * LumenUiScale.factor; width: parent.width;
        padding-top: 4px * LumenUiScale.factor; padding-bottom: 4px * LumenUiScale.factor;
        HorizontalLayout {
            spacing: 14px * LumenUiScale.factor;
            Rectangle {
                width: 40px * LumenUiScale.factor; height: 40px * LumenUiScale.factor; border-radius: 13px * LumenUiScale.factor;
                background: LumenTheme.accent;
                Image { x: 8px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; source: root.icon; width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; image-fit: contain; }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: 8px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor;
                    background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #007AFF;
                }
            }
            VerticalLayout {
                vertical-stretch: 1; alignment: center; spacing: 3px * LumenUiScale.factor;
                Text { text: root.label; color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; font-weight: 600; wrap: word-wrap; }
                Text { text: root.detail; color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; wrap: word-wrap; }
            }
            if root.badge != "": Rectangle {
                width: 72px * LumenUiScale.factor; height: 30px * LumenUiScale.factor; border-radius: 15px * LumenUiScale.factor; background: LumenTheme.accent-soft;
                Text { text: root.badge; width: parent.width; height: parent.height; color: LumenTheme.accent; font-size: 14px * LumenUiScale.factor; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Image { source: @image-url("../assets/icons/chevron-right.svg"); width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
        }
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

component ProxyGroupCard inherits Rectangle {
    in property <string> group-name;
    in property <string> group-icon-emoji;
    in property <string> group-kind;
    in property <string> current-node;
    in property <string> current-flag-code;
    in property <int> current-flag-index;
    in property <string> current-accessible;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> runtime-running;
    in property <bool> testing;
    in property <bool> has-nodes;
    callback clicked();
    callback test-current();
    min-height: group-layout.min-height;
    preferred-height: group-layout.min-height;
    border-radius: LumenTheme.radius-card;
    background: LumenTheme.surface;
    border-width: 0px * LumenUiScale.factor;
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    group-layout := VerticalLayout {
        x: LumenTheme.space-4; width: parent.width - 2 * LumenTheme.space-4;
        padding-top: 0px * LumenUiScale.factor; padding-bottom: 12px * LumenUiScale.factor;
        spacing: 0px * LumenUiScale.factor; alignment: start;
        HorizontalLayout {
            height: 48px * LumenUiScale.factor;
            spacing: LumenTheme.space-2;
            vertical-stretch: 0;
            if root.group-icon-emoji != "": Text {
                text: root.group-icon-emoji;
                font-size: 20px * LumenUiScale.factor;
                width: 24px * LumenUiScale.factor;
                height: parent.height;
                vertical-alignment: center;
            }
            Text {
                text: root.group-name;
                color: LumenTheme.text-primary;
                font-size: 18px * LumenUiScale.factor;
                font-weight: 450;
                height: parent.height;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                accessible-label: root.group-name;
            }
            Rectangle {
                width: 84px * LumenUiScale.factor;
                height: 48px * LumenUiScale.factor;
                background: transparent;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    height: 32px * LumenUiScale.factor;
                    border-radius: 16px * LumenUiScale.factor;
                    background: LumenTheme.accent-soft;
                    Text { text: root.group-kind; width: parent.width; height: parent.height; color: LumenTheme.accent; font-size: 13px * LumenUiScale.factor; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
            }
            IconButton {
                width: LumenTheme.min-touch-target;
                height: LumenTheme.min-touch-target;
                icon: @image-url("../assets/icons/speed.svg");
                tooltip: root.testing ? @tr("正在测试组内节点…") : @tr("测试策略组全部节点");
                enabled: root.has-nodes && !root.testing;
                clicked => { root.test-current(); }
            }
        }
        Rectangle {
            height: 36px * LumenUiScale.factor;
            border-radius: 18px * LumenUiScale.factor;
            background: LumenTheme.surface-muted;
            HorizontalLayout {
                x: LumenTheme.space-3;
                width: parent.width - 2 * LumenTheme.space-3;
                height: parent.height;
                spacing: LumenTheme.space-2;
                if root.current-flag-code != "": FlagIcon { country-code: root.current-flag-code; index: root.current-flag-index; }
                Text { text: root.current-node == "" ? @tr("暂无可用节点") : root.current-node; accessible-label: root.current-accessible; color: LumenTheme.text-primary; font-size: 14px * LumenUiScale.factor; horizontal-stretch: 1; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                Image { source: @image-url("../assets/icons/chevron-right.svg"); width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
            }
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

component ProfileCardSurface inherits Rectangle {
    in property <string> profile-name;
    in property <string> profile-kind;
    in property <string> profile-location;
    in property <bool> current;
    callback set-current();
    callback clear-current();
    callback open-settings();
    callback share-profile();
    callback delete-profile();
    vertical-stretch: 0;
    min-height: card-layout.min-height;
    preferred-height: card-layout.min-height;
    border-radius: 42px * LumenUiScale.factor;
    background: LumenTheme.surface;
    border-width: 0px * LumenUiScale.factor;
    card-layout := VerticalLayout {
        x: 18px * LumenUiScale.factor; width: parent.width - 36px * LumenUiScale.factor;
        padding-top: 16px * LumenUiScale.factor; padding-bottom: 8px * LumenUiScale.factor;
        spacing: 0px * LumenUiScale.factor; alignment: start;
        HorizontalLayout { spacing: 12px * LumenUiScale.factor; vertical-stretch: 0; height: 34px * LumenUiScale.factor;
            Text { text: root.profile-name; color: LumenTheme.text-primary; font-size: 20px * LumenUiScale.factor; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; accessible-label: root.profile-name; }
            Switch {
                checked: root.current;
                width: 52px * LumenUiScale.factor;
                height: 32px * LumenUiScale.factor;
                tooltip: root.current ? @tr("取消当前配置") : @tr("设为当前配置");
                checked-state-changed(checked) => {
                    if checked { root.set-current(); }
                    else { root.clear-current(); }
                }
            }
        }
        Text { text: root.profile-kind; color: LumenTheme.text-secondary; font-size: 15px * LumenUiScale.factor; vertical-stretch: 0; }
        Text { text: root.profile-location; color: LumenTheme.text-secondary; font-size: 16px * LumenUiScale.factor; vertical-stretch: 0; wrap: word-wrap; accessible-label: root.profile-location; }
        Rectangle { height: 12px * LumenUiScale.factor; background: transparent; }
        Rectangle { height: 1px * LumenUiScale.factor; background: LumenTheme.border; }
        Rectangle { height: 12px * LumenUiScale.factor; background: transparent; }
        HorizontalLayout { spacing: 12px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; vertical-stretch: 0;
            Rectangle {
                width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; background: transparent;
                Rectangle { x: 4px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: 40px * LumenUiScale.factor; height: 40px * LumenUiScale.factor; border-radius: 20px * LumenUiScale.factor; background: LumenTheme.surface-muted; }
                IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/share.svg"); tooltip: @tr("分享配置文件"); clicked => { root.share-profile(); } }
            }
            Rectangle {
                width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; background: transparent;
                Rectangle { x: 4px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: 40px * LumenUiScale.factor; height: 40px * LumenUiScale.factor; border-radius: 20px * LumenUiScale.factor; background: LumenTheme.surface-muted; }
                IconButton { width: 48px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; icon: @image-url("../assets/icons/delete.svg"); tooltip: @tr("删除配置"); clicked => { root.delete-profile(); } }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Rectangle {
                width: 96px * LumenUiScale.factor; height: 48px * LumenUiScale.factor; background: transparent;
                Rectangle { x: 0px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: parent.width; height: 40px * LumenUiScale.factor; border-radius: 20px * LumenUiScale.factor; background: LumenTheme.surface-muted; }
                edit-row := HorizontalLayout {
                    x: 0px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: parent.width; height: 40px * LumenUiScale.factor;
                    spacing: 8px * LumenUiScale.factor; alignment: center; cross-axis-alignment: center;
                    edit-icon := Image {
                        source: LumenTheme.dark-mode ? @image-url("../assets/icons/edit-dark.svg") : @image-url("../assets/icons/edit.svg");
                        width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; image-fit: contain;
                    }
                    edit-label := Text {
                        text: @tr("编辑"); color: LumenTheme.text-primary; font-size: 16px * LumenUiScale.factor;
                        height: parent.height; vertical-alignment: center;
                    }
                }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: edit-row.x; y: edit-row.y; width: parent.width; height: edit-row.height;
                    background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #FF2D55;
                }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: edit-row.x + edit-icon.x; y: edit-row.y + edit-icon.y;
                    width: edit-icon.width; height: edit-icon.height;
                    background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #007AFF;
                }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: edit-row.x + edit-label.x; y: edit-row.y + edit-label.y;
                    width: edit-label.width; height: edit-label.height;
                    background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
                }
                TouchArea { width: parent.width; height: parent.height; clicked => { root.open-settings(); } }
            }
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component AppWindow inherits MaterialWindow {
    title: "Lumen";
    background: LumenTheme.canvas;
    disable-hover: root.android-platform;
    default-font-family: root.android-platform ? "Noto Sans CJK SC" : "";
    in property <bool> compact-layout: false;
    in-out property <bool> android-platform: false;
    in-out property <bool> layout-debug-tools-enabled: false;
    in-out property <bool> layout-debug-bounds: false;
    in-out property <bool> application-dark-mode: false;
    in-out property <string> theme-mode: "system";
    in-out property <bool> auto-start: false;
    in-out property <bool> refresh-current-profile-on-start: false;
    in-out property <bool> invert-theme-foreground: false;
    in-out property <color> theme-color: #016888;
    in-out property <bool> theme-accent-light-foreground: true;
    in-out property <string> theme-color-code: "#016888";
    in-out property <string> theme-color-input-code: "##016888";
    in-out property <float> theme-hue: 198;
    in-out property <float> theme-saturation: 0.66;
    in-out property <float> theme-value: 0.50;
    in-out property <string> application-language: "system";
    in-out property <string> system-language: "zh-CN";
    in-out property <string> current-translated-language: "";
    in-out property <int> page-scale-percent: 100;
    in-out property <bool> hide-bottom-bar-on-scroll: false;
    in-out property <bool> bottom-bar-visible: true;
    in-out property <bool> predictive-back-enabled: false;
    in-out property <bool> predictive-back-supported: false;
    in-out property <bool> hide-background-card: false;
    in-out property <bool> recents-screenshot-supported: false;
    in-out property <bool> show-traffic-notification: false;
    in-out property <bool> notification-permission-granted: false;
    in-out property <bool> release-ui-when-background: false;
    in-out property <bool> ignore-battery-optimizations: false;
    in-out property <int> app-settings-preview-section: -1;
    in-out property <string> app-settings-message: "";
    in-out property <bool> theme-color-dialog-open: false;
    in-out property <string> theme-color-draft: "#016888";
    in-out property <string> theme-color-code-draft: "##016888";
    in-out property <float> theme-hue-draft: 198;
    in-out property <float> theme-saturation-draft: 0.66;
    in-out property <float> theme-value-draft: 0.50;
    in-out property <string> theme-color-error: "";
    in-out property <bool> theme-color-saving: false;
    in-out property <bool> theme-color-code-edited: false;
    in-out property <int> theme-color-save-revision: 0;
    in-out property <int> theme-color-result-revision: 0;
    in-out property <int> page-scale-draft: 100;
    in-out property <bool> page-scale-dialog-open: false;
    in-out property <bool> page-scale-committing: false;
    in-out property <length> app-language-anchor-x: 0px * LumenUiScale.factor;
    in-out property <length> app-language-anchor-y: 0px * LumenUiScale.factor;
    in-out property <length> app-theme-anchor-x: 0px * LumenUiScale.factor;
    in-out property <length> app-theme-anchor-y: 0px * LumenUiScale.factor;
    in-out property <length> last-page-scroll-y: 0px * LumenUiScale.factor;
    in-out property <bool> profile-add-open: false;
    in-out property <int> profile-add-kind-index: 0;
    in-out property <bool> profile-type-menu-open: false;
    in-out property <int> profile-count-at-open: 0;
    in-out property <int> back-request-revision: 0;
    in-out property <float> back-gesture-progress: 0;
    in-out property <bool> back-gesture-active: false;
    in-out property <image> back-preview-image: @image-url("../assets/icons/home.svg");
    in-out property <bool> back-preview-available: false;
    property <length> profile-sheet-width: min(640px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.width - 48px * LumenUiScale.factor));
    property <length> app-settings-bottom-inset: max(
        root.safe-area-insets.bottom,
        root.virtual-keyboard-size.height > 0px * LumenUiScale.factor ? max(0px * LumenUiScale.factor, root.height - root.virtual-keyboard-position.y) : 0px * LumenUiScale.factor
    );
    property <length> profile-sheet-content-width: max(0px * LumenUiScale.factor, root.profile-sheet-width - 16px * LumenUiScale.factor);
    property <length> profile-dialog-width: min(640px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.width - 24px * LumenUiScale.factor));
    property <length> profile-dialog-content-width: max(0px * LumenUiScale.factor, root.profile-dialog-width - 16px * LumenUiScale.factor);
    property <length> profile-sheet-content-height: 364px * LumenUiScale.factor;
    property <length> profile-settings-sheet-height: min(
        root.profile-settings-type-index == 1 ? 640px * LumenUiScale.factor : root.profile-settings-kind == "订阅链接" ? 520px * LumenUiScale.factor : 340px * LumenUiScale.factor,
        max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 52px * LumenUiScale.factor)
    );
    property <length> home-title-gap: root.height < 760px * LumenUiScale.factor ? 32px * LumenUiScale.factor : root.height < 840px * LumenUiScale.factor ? 64px * LumenUiScale.factor : 74px * LumenUiScale.factor;
    property <length> home-data-upload-gap: root.height < 760px * LumenUiScale.factor ? 24px * LumenUiScale.factor : root.height < 840px * LumenUiScale.factor ? 24px * LumenUiScale.factor : 40px * LumenUiScale.factor;
    property <length> home-before-node-gap: root.height < 760px * LumenUiScale.factor ? 16px * LumenUiScale.factor : root.height < 840px * LumenUiScale.factor ? 16px * LumenUiScale.factor : 28px * LumenUiScale.factor;
    property <length> home-node-egress-gap: 8px * LumenUiScale.factor;
    property <bool> primary-page: root.page == "Home" || root.page == "Proxy" || root.page == "Config" || root.page == "Settings";

    init => {
        MaterialPalette.schemes = LumenTheme.material-schemes;
        LumenTheme.show-layout-bounds = root.layout-debug-bounds;
        LumenUiScale.factor = root.page-scale-percent / 100.0;
        LumenTheme.user-accent = root.theme-color;
        LumenTheme.accent-foreground = root.theme-accent-light-foreground ? #FFFFFF : #000000;
        LumenTheme.invert-semantic-foreground = root.invert-theme-foreground;
    }

    in-out property <string> page: "Home";
    in-out property <string> page-origin: "Settings";
    in-out property <string> runtime-status: "Stopped";
    in-out property <string> runtime-detail: @tr("尚未启动 Mihomo");
    in-out property <string> active-profile: @tr("未选择配置");
    in-out property <bool> has-current-profile: false;
