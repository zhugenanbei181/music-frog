import { DesignType } from "./design-type.slint";
import { ProxyPillMetrics } from "./proxy_picker.slint";
import { ScrollView } from "std-widgets.slint";
import { LargeAppBar, SmallAppBar, IconButton } from "@material";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { PageTitles } from "./page_titles.slint";
import { LumenTheme } from "./theme.slint";
import { PillButton } from "./base_widgets.slint";
import {
        ProfileCard, OverrideCard, ProfileOverrideChoice, ObservationRow, ConnectionRow, ProxyGroup,
        TrafficBar, HomeTrafficPoint, LicenseRow, WorkbenchItem, NavigationSlot, DashboardFacts
} from "./models.slint";
import { DesktopSideBar } from "./sidebar.slint";
import { NavigationForm } from "./viewport_tier.slint";
import { PagesRouter } from "../pages/pages_router.slint";
import { ConnectionSort, LogLevel, NetworkMode, RouteMode, RuntimeStatus, ThemeMode, TrafficRange } from "./domain_enums.slint";
import { MobileDockBandState, MobileDockBandProjection } from "./mobile_dock_state.slint";

export component AppBody inherits Rectangle {
        in property <string> page;
        in property <[NavigationSlot]> navigation-items;
        in property <string> active-destination;
        in property <string> page-origin;
        in property <bool> compact-layout;
        // The chrome fact: what the shell mounts to navigate. The page density
        // above says how tightly the page packs; a medium window is a packed
        // page that still owns an icon rail, and conflating the two is what
        // made it pay a bottom bar instead (SPACEUTIL-006).
        in property <NavigationForm> navigation-form;
        in property <bool> primary-page;
        in property <bool> android-platform;
        in property <bool> application-dark-mode;
        in property <bool> layout-debug-bounds;
        in property <bool> layout-debug-tools-enabled;
        in property <bool> predictive-back-enabled;
        in property <bool> predictive-back-supported;
        in property <length> safe-top;
        in property <length> safe-bottom;
        in property <length> safe-left;
        in property <length> safe-right;
        // One typed state from the Rust projection owns both the reserved
        // region and the mounted dock. The body never derives a second state.
        in property <MobileDockBandState> mobile-dock-band-state;
        in-out property <length> last-page-scroll-y: 0 * LumenUiScale.unit;

        // One horizontal rhythm for the page body. Compact used to fork this per
        // page (Home 24, AppSettings 10, everything else 16), which meant three
        // pages could not share a left edge even though the reference phone
        // layout keeps one 16.6dp inset everywhere.
        property <length> page-margin: root.compact-layout
            ? LumenTheme.page-padding
            : LumenTheme.page-margin-desktop;
        // The reserved band is subtracted once from the column that carries
        // the page header and scroll viewport. The height is one theme token,
        // and the decision to use it comes from the typed state alone.
        property <length> dock-band-height: MobileDockBandProjection.reserves_band(root.mobile-dock-band-state)
            ? LumenTheme.bottom-bar-band-height
            : 0 * LumenUiScale.unit;
        // The air the page body keeps for itself, and it is a CHROME fact.
        //
        // The desktop chrome frames its content in a field: 8u above, 72u
        // below. The compact chrome has no shell air at all - its only bottom
        // room belongs to the floating dock, and the dock reserves its own
        // band in the column below, so a page that has no dock must not
        // reserve it either.
        //
        // The bottom air used to follow the DOCK instead of the chrome:
        // "no band reserved, so pay 72u". On the desktop that was right (the
        // desktop chrome keeps a page breath), but on the compact chrome
        // every dockless page - a pushed list page with no bottom nav -
        // paid 72u of dead ground under its last block. Measured on the
        // 720x480 compact tier that is 72 of 480 rows, 12.9% of the body,
        // and it is exactly why the framed list pages' frame floated above a
        // band of nothing while their sibling frames filled the page. The
        // dock band is still subtracted exactly once, by the column above.
        property <length> page-content-padding-top: root.compact-layout
            ? 0 * LumenUiScale.unit
            : 8 * LumenUiScale.unit;
        property <length> page-content-padding-bottom: root.compact-layout
            ? 0 * LumenUiScale.unit
            : 72 * LumenUiScale.unit;
        // The height one page body may use. The page scroll viewport is the
        // page's ground; the page's own air is subtracted here, so a list
        // page's card reaches the bottom of the page and still keeps clear
        // of the floating dock. The shell publishes this once and no page
        // measures the window for itself.
        property <length> page-body-height: page-scroll.visible-height
            - root.page-content-padding-top
            - root.page-content-padding-bottom;

        init => { LumenTheme.page-body-height = root.page-body-height; }
        changed page-body-height => { LumenTheme.page-body-height = root.page-body-height; }

        // Home
        in property <RuntimeStatus> runtime-status;
        in property <string> runtime-status-label;
        in property <string> runtime-detail;
        in property <string> active-profile;
        in property <bool> has-current-profile;
        in property <string> current-profile-id;
        in property <string> network-mode-label;
        in property <string> home-current-node;
        in property <string> home-current-accessible;
        in property <string> home-current-flag-code;
        in property <int> home-current-flag-index;
        in property <string> home-current-delay;
        in property <string> home-exit-ip;
        in property <string> home-exit-country-code;
        in property <int> home-exit-flag-index;
        in property <string> home-exit-status;
        in property <DashboardFacts> dashboard-facts;
        in property <[HomeTrafficPoint]> home-traffic-points;
        in property <bool> home-traffic-has-data;
        in property <string> stat-down;
        in property <string> stat-up;
        in property <string> stat-down-value;
        in property <string> stat-down-unit;
        in property <string> stat-up-compact;
        in property <string> stat-connections;
        in property <bool> traffic-today-has-data;
        in property <string> traffic-today-down;
        in property <string> traffic-today-up;
        in property <[TrafficBar]> traffic-today-bars;

        // Profiles & Config
        in property <[ProfileCard]> profiles;
        in property <string> profile-settings-id;
        in property <string> profile-settings-kind;
        in property <string> profile-settings-location;
        in-out property <string> profile-settings-name;
        in-out property <string> profile-settings-url;
        in-out property <string> profile-settings-age-key;
        in property <bool> profile-settings-age-configured;
        in property <[ProfileOverrideChoice]> profile-settings-overrides;

        // Proxies
        in property <RouteMode> route-mode;
        in property <string> selected-group;
        in property <string> proxy-testing-group;
        in property <string> proxy-testing-node;
        in property <[ProxyGroup]> proxy-groups;
        in property <[ObservationRow]> proxy-nodes;
        in-out property <string> proxy-search;
        in-out property <length> proxy-active-node-position;
        in-out property <bool> proxy-current-node-available;

        // Settings
        in property <string> product-version;
        in property <string> core-version;
        // Whether the owner's last system-proxy recovery attempt failed, i.e. whether
        // asking for it again is a real action. The 网络设置 page used to render the
        // retry button with this input never fed from anywhere, so the control sat
        // permanently disabled while its command path was live.
        in property <bool> proxy-recovery-pending;
        in property <NetworkMode> network-mode;
        in property <string> network-mode-status;
        in property <bool> network-mode-status-warning;
        in property <bool> tun-capable;
        in property <string> tun-capability-detail;
        in property <string> lan-sharing-heading;
        in property <string> lan-sharing-detail;
        in property <int> app-settings-preview-section;
        in property <bool> auto-start;
        in property <bool> refresh-current-profile-on-start;
        in property <ThemeMode> theme-mode;
        in property <bool> invert-theme-foreground;
        in property <string> theme-color-code;
        in property <string> application-language;
        in property <string> system-language;
        in property <int> page-scale-percent;
        in property <bool> hide-background-card;
        in property <bool> show-traffic-notification;
        in property <bool> release-ui-when-background;
        in property <bool> ignore-battery-optimizations;
        in property <string> user-agent;
        in property <[OverrideCard]> overrides;
        in property <bool> override-importing;
        in property <string> override-import-error;
        in-out property <string> override-name;
        in-out property <string> override-body;
        in-out property <string> override-url;
        in-out property <string> override-edit-id;

        // Observe
        in property <bool> connection-show-closed;
        in property <string> snapshot-window-warning;
        in-out property <string> connection-search;
        in-out property <ConnectionSort> connection-sort;
        in property <[ObservationRow]> connections;
        in property <[ConnectionRow]> home-connection-table;
        in property <string> connection-breaking-id;
        in property <string> connection-detail-id;
        in property <string> connection-detail-host;
        in property <string> connection-detail-protocol;
        in property <string> connection-detail-process;
        in property <string> connection-detail-source;
        in property <string> connection-detail-destination;
        in property <string> connection-detail-start;
        in property <string> connection-detail-duration;
        in property <string> connection-detail-upload;
        in property <string> connection-detail-download;
        in property <string> connection-detail-rule;
        in property <string> connection-detail-chains;
        in property <string> connection-detail-providers;
        in property <bool> connection-detail-active;
        in property <string> log-stream-status;
        in property <string> log-search-error;
        in-out property <string> log-search;
        in-out property <LogLevel> log-level;
        in property <[ObservationRow]> logs;
        in-out property <string> rule-search;
        in property <string> rule-pending-index;
        in property <[ObservationRow]> rules;
        in property <[ObservationRow]> providers;
        in property <string> traffic-stream-status;
        in-out property <TrafficRange> traffic-range;
        in-out property <string> traffic-selected-detail;
        in property <string> traffic-week-down;
        in property <string> traffic-week-up;
        in property <string> traffic-week-average-down;
        in property <string> traffic-week-average-up;
        in property <bool> traffic-week-has-data;
        in property <[TrafficBar]> traffic-week-bars;

        // Info
        in property <length> window-height;
        in property <string> content-preview;
        in property <string> content-preview-profile;
        in-out property <string> license-query;
        in property <[LicenseRow]> license-rows;
        in property <string> license-catalog-error;
        in property <string> license-detail-name;
        in property <string> license-detail-version;
        in property <string> license-detail-identifier;
        in property <string> license-detail-error;
        in property <string> license-detail-text;

        // Workbench pages
        in property <[WorkbenchItem]> workbench-items;
        in-out property <string> workbench-draft;
        in-out property <string> workbench-draft-2;
        in property <string> workbench-draft-id;
        in property <string> workbench-draft-2-id;
        in property <string> workbench-draft-placeholder;
        in property <string> workbench-draft-2-placeholder;

        // Callbacks
        callback navigate(string);
        callback open-sort-menu();
        callback go-back();
        callback start-runtime();
        callback stop-runtime();
        callback cache-back-preview();
        callback open-profile-add();
        callback set-current-profile(string);
        callback refresh-profile(string);
        callback open-profile-action(string, string);
        callback request-export(string, string);
        callback request-delete(string, string);
        callback cancel-profile-settings();
        callback save-profile-settings(string, string, string, string);
        callback clear-profile-age-key(string);
        callback toggle-profile-override(string, bool);
        callback move-profile-override(string, bool);
        callback select-group(string);
        callback select-proxy(string, string);
        callback search-proxy-nodes(string);
        callback test-proxy(string, string);
        callback set-route-mode(RouteMode);
        callback request-network-mode-change(NetworkMode);
        callback check-core();
        callback retry-proxy-restore();
        callback set-auto-start(bool);
        callback set-refresh-profile-on-start(bool);
        callback set-invert-theme-foreground(bool);
        callback set-predictive-back-enabled(bool);
        callback set-hide-background-card(bool);
        callback set-show-traffic-notification(bool);
        callback set-release-ui-when-background(bool);
        callback request-ignore-battery-optimization();
        callback open-theme-menu(length, length);
        callback open-language-menu(length, length);
        callback open-theme-color-dialog();
        callback open-page-scale-dialog();
        callback open-user-agent-dialog();
        callback show-message(string);
        callback add-override(string, string);
        callback save-override(string, string);
        callback delete-override(string);
        callback import-override-url(string);
        callback choose-override-file();
        callback export-override(string);
        callback apply-override(string);
        callback set-connection-view(bool);
        callback refresh-observations();
        callback search-connections(string);
        callback set-connection-sort(ConnectionSort);
        callback open-connection(string);
        callback close-connection(string);
        callback search-logs(string);
        callback set-log-level(LogLevel);
        callback export-logs();
        callback search-rules(string);
        callback toggle-rule(string, bool);
        callback update-provider(string);
        callback open-clear-dialog();
        callback search-licenses(string);
        callback retry-license-catalog();
        callback select-license(LicenseRow);
        callback workbench-action(string, string);
        callback workbench-draft-edited(string, string);
        callback refresh-home-egress();
        callback open-overview-order();

        public function scroll-to-top() {
        page-scroll.content-y = 0 * LumenUiScale.unit;
        }

        public function scroll-to-y(pos: length) {
        page-scroll.content-y = max(page-scroll.visible-height - page-scroll.content-height, min(0 * LumenUiScale.unit, -pos));
        }

        public function locate-current-node(pos: length, available: bool) {
        if !available || pos == 0 * LumenUiScale.unit || page-scroll.visible-height <= 0 * LumenUiScale.unit {
            return;
        }
        let target-y = page-scroll.absolute-position.y + max(16 * LumenUiScale.unit, (page-scroll.visible-height - ProxyPillMetrics.node-card-height) / 2);
        let delta = pos - target-y;
        page-scroll.content-y = max(page-scroll.visible-height - page-scroll.content-height, min(0 * LumenUiScale.unit, page-scroll.content-y - delta));
        }

        background: transparent;

        HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0 * LumenUiScale.unit;

        if root.navigation-form != NavigationForm.bottom-nav: DesktopSideBar {
            page: root.page;
            navigation-items: root.navigation-items;
            active-destination: root.active-destination;
            navigate-to(target) => { root.navigate(target); }
        }

        main-panel := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            height: parent.height;
            clip: true;
            background: LumenTheme.zinc-0; // #154: the page void is zinc-0, never raw black

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0 * LumenUiScale.unit;
                // The dock band is subtracted exactly once, here, from the column
                // that carries the page header and the page viewport together. An
                // absolute height on the scroll view itself was the second copy, and
                // it only matched while the column held one child: on the compact
                // 工具 page the header row shares this column, so the viewport was
                // pushed down by the header and its last rows were cut behind the
                // pill again - the covering bar the reference never shows.
                padding-bottom: root.dock-band-height;

                if !root.compact-layout && root.primary-page && !(root.page == "Proxy" && root.selected-group != ""): HorizontalLayout {
                    height: 56 * LumenUiScale.unit;
                    padding-left: LumenTheme.page-margin-desktop;
                    padding-right: LumenTheme.page-margin-desktop;
                    Text {
                        text: PageTitles.page-name(root.page);
                        color: LumenTheme.text-primary;
                        font-size: DesignType.display-size;
                        font-weight: DesignType.display-weight;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    // The config page's add action belongs in the ONE page
                    // header, not in a second 38u row whose 702px of the row
                    // was empty air. The shell owns the header and already
                    // carries the typed open-profile-add intent.
                    if root.page == "Config": PillButton {
                        label: @tr("+ 添加配置");
                        selected: true;
                        pill-height: 36 * LumenUiScale.unit;
                        min-pill-width: 104 * LumenUiScale.unit;
                        clicked => { root.open-profile-add(); }
                    }
                    if root.page == "Proxy" && root.selected-group == "": IconButton {
                        width: 44 * LumenUiScale.unit;
                        height: 44 * LumenUiScale.unit;
                        icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg");
                        tooltip: @tr("代理排序和操作");
                        clicked => { root.open-sort-menu(); }
                    }
                }

                // Home / Proxy / Config own their compact header inside the
                // page (one shared CompactPageHeader component). Settings has
                // no page-level action cluster, so the shell prints its title.
                // The shell can no longer print a SECOND header over a page
                // that already has one, and the scroll padding no longer
                // forks 0/8u between pages.
                if root.compact-layout && root.primary-page && root.page == "Settings" && !(root.page == "Proxy" && root.selected-group != ""): HorizontalLayout {
                    height: LumenTheme.page-header-height;
                    padding-left: LumenTheme.page-padding;
                    padding-right: LumenTheme.page-padding;
                    Text {
                        text: PageTitles.phone-title(root.page);
                        color: LumenTheme.text-primary;
                        font-size: DesignType.display-size;
                        font-weight: DesignType.display-weight;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.page == "Proxy" && root.selected-group == "": IconButton {
                        width: 40 * LumenUiScale.unit;
                        height: 40 * LumenUiScale.unit;
                        icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg");
                        tooltip: @tr("代理排序和操作");
                        clicked => { root.open-sort-menu(); }
                    }
                }

                if !root.primary-page: HorizontalLayout {
                    height: 48 * LumenUiScale.unit;
                    padding-left: root.compact-layout ? 8 * LumenUiScale.unit : 20 * LumenUiScale.unit;
                    padding-right: LumenTheme.space-4;
                    spacing: LumenTheme.space-2;
                    cross-axis-alignment: center;
                    IconButton {
                        width: 44 * LumenUiScale.unit;
                        height: 44 * LumenUiScale.unit;
                        icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-left.svg");
                        tooltip: @tr("返回上一页");
                        clicked => { root.go-back(); }
                    }
                    Text {
                        text: PageTitles.title(root.page, root.content-preview-profile, root.license-detail-name);
                        color: LumenTheme.text-primary;
                        font-size: DesignType.subheading-size;
                        font-weight: DesignType.subheading-weight;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                page-scroll := ScrollView {
                    content-width: self.width;
                    changed content-y => {
                        // hide-on-scroll is retired: hiding a mounted dock is
                        // an illegal `reserved-without-dock` stage. The typed
                        // owner closes the whole band or keeps it reserved.
                        root.last-page-scroll-y = self.content-y;
                    }
                    mouse-drag-pan-enabled: root.android-platform;
                    vertical-stretch: 1;
                    // Mobile chrome never paints a scroll rail; desktop keeps
                    // the shared auto-hide rail. Both axes read the one compact
                    // viewport fact, not a second platform guess.
                    vertical-scrollbar-policy: LumenTheme.compact-layout ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    VerticalLayout {
                        x: root.page-margin;
                        width: parent.width - 2 * root.page-margin;
                        padding-top: root.page-content-padding-top;
                        // The distance from the clip line to the pill is the band's
                        // own `dock-top-air`, exactly one card gap, which is also what
                        // the reference measures between its last card and the floating
                        // bar (24-25px @1156 = 8.5u). The page pays nothing here:
                        // adding `space-mobile-card-gap` a second time would make the
                        // rest gap two card gaps, and the old 48u literal made it five.
                        // The compact chrome pays NOTHING at all: its bottom room is
                        // the dock band's own, and the desktop chrome's 72u is its
                        // page breath, not a second answer to the dock's clearance.
                        padding-bottom: root.page-content-padding-bottom;
                        spacing: LumenTheme.space-3;

                        PagesRouter {
                            page: root.page; android-platform: root.android-platform; compact-layout: root.compact-layout;
                            application-dark-mode: root.application-dark-mode; layout-debug-bounds: root.layout-debug-bounds;
                            layout-debug-tools-enabled: root.layout-debug-tools-enabled; predictive-back-enabled: root.predictive-back-enabled;
                            runtime-status: root.runtime-status; active-profile: root.active-profile; has-current-profile: root.has-current-profile; current-profile-id: root.current-profile-id;
                            network-mode-label: root.network-mode-label; home-current-node: root.home-current-node;
                            home-current-accessible: root.home-current-accessible; home-current-flag-code: root.home-current-flag-code;
                            home-current-flag-index: root.home-current-flag-index; home-current-delay: root.home-current-delay;
                            home-exit-ip: root.home-exit-ip; home-exit-country-code: root.home-exit-country-code;
                            home-exit-flag-index: root.home-exit-flag-index; home-exit-status: root.home-exit-status;
                            dashboard-facts: root.dashboard-facts;
                            home-traffic-points: root.home-traffic-points; home-traffic-has-data: root.home-traffic-has-data;
                            stat-down: root.stat-down; stat-up: root.stat-up; stat-down-value: root.stat-down-value;
                            stat-down-unit: root.stat-down-unit; stat-up-compact: root.stat-up-compact; stat-connections: root.stat-connections;
                            traffic-today-has-data: root.traffic-today-has-data; traffic-today-down: root.traffic-today-down;
                            traffic-today-up: root.traffic-today-up; traffic-today-bars: root.traffic-today-bars;
                            profiles: root.profiles; profile-settings-id: root.profile-settings-id;
                            profile-settings-kind: root.profile-settings-kind; profile-settings-location: root.profile-settings-location;
                            profile-settings-name <=> root.profile-settings-name; profile-settings-url <=> root.profile-settings-url;
                            profile-settings-age-key <=> root.profile-settings-age-key; profile-settings-age-configured: root.profile-settings-age-configured;
                            profile-settings-overrides: root.profile-settings-overrides; route-mode: root.route-mode;
                            selected-group: root.selected-group; proxy-testing-group: root.proxy-testing-group;
                            proxy-testing-node: root.proxy-testing-node; proxy-groups: root.proxy-groups; proxy-nodes: root.proxy-nodes;
                            proxy-search <=> root.proxy-search; proxy-active-node-position <=> root.proxy-active-node-position;
                            proxy-current-node-available <=> root.proxy-current-node-available; product-version: root.product-version;
                            core-version: root.core-version; proxy-recovery-pending: root.proxy-recovery-pending; network-mode: root.network-mode; network-mode-status: root.network-mode-status;
                            network-mode-status-warning: root.network-mode-status-warning; tun-capable: root.tun-capable;
                            tun-capability-detail: root.tun-capability-detail; app-settings-preview-section: root.app-settings-preview-section; lan-sharing-heading: root.lan-sharing-heading; lan-sharing-detail: root.lan-sharing-detail;
                            auto-start: root.auto-start; refresh-current-profile-on-start: root.refresh-current-profile-on-start;
                            theme-mode: root.theme-mode; invert-theme-foreground: root.invert-theme-foreground;
                            theme-color-code: root.theme-color-code; application-language: root.application-language;
                            system-language: root.system-language; page-scale-percent: root.page-scale-percent;
                            predictive-back-supported: root.predictive-back-supported;
                            hide-background-card: root.hide-background-card; show-traffic-notification: root.show-traffic-notification;
                            release-ui-when-background: root.release-ui-when-background; ignore-battery-optimizations: root.ignore-battery-optimizations;
                            user-agent: root.user-agent; overrides: root.overrides; override-importing: root.override-importing;
                            override-import-error: root.override-import-error; override-name <=> root.override-name;
                            override-body <=> root.override-body; override-url <=> root.override-url; override-edit-id <=> root.override-edit-id;
                            connection-show-closed: root.connection-show-closed; snapshot-window-warning: root.snapshot-window-warning;
                            connection-search <=> root.connection-search; connection-sort <=> root.connection-sort; connections: root.connections;
                            home-connection-table: root.home-connection-table;
                            connection-breaking-id: root.connection-breaking-id; connection-detail-id: root.connection-detail-id;
                            connection-detail-host: root.connection-detail-host; connection-detail-protocol: root.connection-detail-protocol;
                            connection-detail-process: root.connection-detail-process; connection-detail-source: root.connection-detail-source;
                            connection-detail-destination: root.connection-detail-destination; connection-detail-start: root.connection-detail-start;
