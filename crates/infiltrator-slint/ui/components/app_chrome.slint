import { DesignType } from "./design-type.slint";
import { IconButton, PopupMenu } from "@material";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "./theme.slint";
import { NavButton, NavButtonMetrics, PillButton } from "./base_widgets.slint";
import { ViewportTier } from "./viewport_tier.slint";
import { PageTitles } from "./page_titles.slint";
import { MobileDockBandState, MobileDockBandProjection } from "./mobile_dock_state.slint";

// The reserved band's page ground. This is the window's own bottom background,
// not a plinth or scrim: it paints no content, has no z-order and is mounted
// below the floating pill. The page body clips scrolling content above this
// band; any overlay that bypasses the scroll view still meets page ground
// here instead of a transparent hole.
export component MobileDockPageGround inherits Rectangle {
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-bottom;

    width: root.window-width;
    x: 0;
    height: root.safe-bottom + LumenTheme.bottom-bar-band-height;
    y: root.window-height - self.height;
    background: LumenTheme.zinc-0;
}

export component AppBottomBar inherits Rectangle {
    in property <MobileDockBandState> mobile-dock-band-state;
    in property <string> page;
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-bottom;
    in property <bool> layout-debug-bounds;

    callback select-page(string);

    // The strip is the typed band and stays transparent: the pill is the floating
    // dock geometry. `MobileDockPageGround` paints the page ground
    // below this component; the page body clips its content at the same band's
    // top edge.
    width: root.window-width;
    x: 0;
    height: root.safe-bottom + LumenTheme.bottom-bar-band-height;
    y: root.window-height - self.height;
    background: transparent;

    // One page margin on each side, and a hard ceiling so the bar never turns
    // into a stretched pill on a tablet-width window.
    private property <length> dock-width: min(LumenTheme.bottom-bar-max-width, max(0 * LumenUiScale.unit, root.window-width - root.safe-left - root.safe-right - 2 * LumenTheme.page-padding));
    private property <length> dock-x: root.safe-left + (root.window-width - root.safe-left - root.safe-right - self.dock-width) / 2;
    // The four equal tabs share the dock's content box. Keeping the geometry
    // here lets the tab centers and the active pill derive from one width,
    // without changing the band, top air or bottom inset.
    private property <length> tab-width: (self.dock-width - 2 * LumenTheme.bottom-bar-padding) / 4;

    dock := Rectangle {
        x: root.dock-x;
        width: root.dock-width;
        height: LumenTheme.bottom-bar-height;
        // The pill is bottom-anchored inside the band: the strip grew by the
        // same air it now carries on top, so the pill itself does not move when
        // the viewport is trimmed further.
        y: LumenTheme.dock-top-air;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.dock-rim-color;
        border-radius: self.height / 2;
        // The floating glass veil. `LumenTheme.floating-surface` carries the
        // contract's one alpha (`MobileDockMaterial::VEIL_ALPHA`), so the page
        // ground reads through the capsule and the dock floats instead of
        // covering. The scrolling viewport pre-reserves bottom space so no
        // content ever needs to pass behind it: the transparency is a
        // material decision, never a licence for content to slide under the
        // tabs and turn into ghost lines.
        background: LumenTheme.floating-surface;
        // The shadow has to decay inside the dock's own bottom inset: a blur
        // that reaches further than the inset is cut off by the window edge and
        // reads as a hard dark band under the pill.
        drop-shadow-blur: LumenTheme.dock-shadow-blur;
        drop-shadow-offset-y: LumenTheme.dock-shadow-offset-y;
        drop-shadow-color: LumenTheme.dock-shadow-color;
        clip: true;

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            cross-axis-alignment: center;
            padding-left: LumenTheme.bottom-bar-padding;
            padding-right: LumenTheme.bottom-bar-padding;
            NavButton {
                width: root.tab-width;
                horizontal-stretch: 0;
                label: PageTitles.phone-title("Home");
                target: "Home";
                active: root.page == "Home";
                compact: true;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/layout-grid.svg");
                active-icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/layout-grid.svg");
                clicked => { root.select-page("Home"); }
            }
            NavButton {
                width: root.tab-width;
                horizontal-stretch: 0;
                label: PageTitles.phone-title("Proxy");
                target: "Proxy";
                active: root.page == "Proxy";
                compact: true;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/globe.svg");
                active-icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/globe.svg");
                clicked => { root.select-page("Proxy"); }
            }
            NavButton {
                width: root.tab-width;
                horizontal-stretch: 0;
                label: PageTitles.phone-title("Config");
                target: "Config";
                active: root.page == "Config";
                compact: true;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg");
                active-icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg");
                clicked => { root.select-page("Config"); }
            }
            NavButton {
                width: root.tab-width;
                horizontal-stretch: 0;
                label: PageTitles.phone-title("Settings");
                target: "Settings";
                active: root.page != "Home" && root.page != "Proxy" && root.page != "Config";
                compact: true;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/settings.svg");
                active-icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/settings.svg");
                clicked => { root.select-page("Settings"); }
            }
        }
    }
}

export component ClearTrafficDialog inherits PopupWindow {
    in property <bool> compact-layout;

    callback cancel();
    callback confirm();

    // The modal overlay is the toolkit's popup: it owns the layer above the
    // page, the input focus and the open/close lifecycle. The scrim and the
    // card stay the product's skin.
    close_policy: no_auto_close;
    width: 100%;
    height: 100%;

    forward-focus: focus;

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: LumenTheme.shadow-ambient-color;

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            x: root.compact-layout ? 16 * LumenUiScale.unit : (parent.width - 420 * LumenUiScale.unit) / 2;
            y: (parent.height - 180 * LumenUiScale.unit) / 2;
            width: root.compact-layout ? parent.width - 32 * LumenUiScale.unit : 420 * LumenUiScale.unit;
            height: 180 * LumenUiScale.unit;
            border-radius: 12 * LumenUiScale.unit;
            background: LumenTheme.surface;
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.border;

            // Stop click propagation to the scrim
            TouchArea { }

            VerticalLayout {
                x: 20 * LumenUiScale.unit;
                y: 18 * LumenUiScale.unit;
                width: parent.width - 40 * LumenUiScale.unit;
                height: parent.height - 36 * LumenUiScale.unit;
                spacing: LumenTheme.space-3;

                HorizontalLayout {
                    spacing: 8 * LumenUiScale.unit;
                    cross-axis-alignment: center;
                    Text { text: "⚠"; color: LumenTheme.error; font-size: DesignType.subheading-size; }
                    Text { text: @tr("清空流量统计？"); color: LumenTheme.text-primary; font-size: DesignType.subheading-size; font-weight: DesignType.subheading-weight; }
                }
                Text { text: @tr("将删除今日与本周本地统计记录，并清空当前已关闭连接历史。正在运行的连接不受影响。"); color: LumenTheme.text-secondary; font-size: DesignType.mono-size; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: LumenTheme.space-2;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    PillButton { label: @tr("取消"); clicked => { root.cancel(); } }
                    PillButton { label: @tr("清空"); danger: true; clicked => { root.confirm(); } }
                }
            }
        }
    }
}

export component NoticeBanner inherits Rectangle {
    in property <string> notice;
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <bool> compact-layout;
    in property <MobileDockBandState> mobile-dock-band-state;

    callback close();

    width: root.compact-layout
        ? max(0 * LumenUiScale.unit, root.window-width - root.safe-left - root.safe-right - 24 * LumenUiScale.unit)
        : min(560 * LumenUiScale.unit, root.window-width - 48 * LumenUiScale.unit);
    x: root.safe-left + (root.window-width - root.safe-left - root.safe-right - self.width) / 2;
    height: notice-content.min-height;
    // The dock owns a band at the bottom of the window, so a toast clears the
    // whole band plus one shared clearance instead of re-measuring the pill:
    // with only one page-margin of offset a long notice landed on top of the
    // dock and covered the page action row underneath it.
    y: max(root.safe-top, root.window-height - root.safe-bottom - self.height - (MobileDockBandProjection.reserves_band(root.mobile-dock-band-state) ? LumenTheme.bottom-bar-band-height + LumenTheme.dock-toast-clearance : 16 * LumenUiScale.unit));
    z: 950;
    background: LumenTheme.surface;
    border-radius: 20 * LumenUiScale.unit;
    border-width: 1 * LumenUiScale.unit;
    border-color: LumenTheme.border;

    notice-content := HorizontalLayout {
        width: parent.width;
        padding: LumenTheme.space-2;
        spacing: LumenTheme.space-2;
        cross-axis-alignment: center;
        Text {
            text: root.notice;
            color: LumenTheme.text-primary;
            font-size: DesignType.mono-size;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        IconButton {
            width: 44 * LumenUiScale.unit;
            height: 44 * LumenUiScale.unit;
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/x.svg");
            tooltip: @tr("关闭提示");
            clicked => { root.close(); }
        }
    }
}

export component SettingsMessageBanner inherits Rectangle {
    in property <string> message;
    in property <length> window-width;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;

    callback close();

    width: min(560 * LumenUiScale.unit, max(0 * LumenUiScale.unit, root.window-width - root.safe-left - root.safe-right - 24 * LumenUiScale.unit));
    x: root.safe-left + (root.window-width - root.safe-left - root.safe-right - self.width) / 2;
    height: message-content.min-height;
    y: max(root.safe-top, root.safe-top + 12 * LumenUiScale.unit);
    background: LumenTheme.accent-soft;
    border-radius: 24 * LumenUiScale.unit;

    message-content := HorizontalLayout {
        width: parent.width;
        padding: LumenTheme.space-3;
        spacing: LumenTheme.space-2;
        cross-axis-alignment: center;
        Text {
            text: root.message;
            color: LumenTheme.text-primary;
            font-size: DesignType.label-size;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        IconButton {
            width: 48 * LumenUiScale.unit;
            height: 48 * LumenUiScale.unit;
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/x.svg");
            tooltip: @tr("关闭提示");
            clicked => { root.close(); }
        }
    }
}

// The settings sheet's type dropdown. It is the same toolkit popup menu as
// the theme, language and proxy-sort menus of the window.
export component ProfileSettingsTypeMenu inherits PopupMenu {
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <bool> layout-debug-bounds;
    in property <int> selected-index;

    callback select(int);

    x: max(root.safe-left + 12 * LumenUiScale.unit, min(root.window-width - root.safe-right - self.width - 12 * LumenUiScale.unit, root.anchor-x - self.width));
    y: max(root.safe-top, min(root.anchor-y, root.window-height - root.safe-bottom - self.height - 12 * LumenUiScale.unit));
    available_width: root.window-width; show_layout_bounds: root.layout-debug-bounds;
    items: [{ text: @tr("订阅信息"), enabled: true }, { text: @tr("覆写配置"), enabled: true }];
    current_index: root.selected-index;
    activated(index) => {
        root.select(index);
        self.close();
    }
}

// The add sheet's type dropdown: the same toolkit popup menu as the settings
// sheet's, so both sheets share one dropdown vocabulary.
export component ProfileAddTypeMenu inherits PopupMenu {
    in property <length> window-width;
    in property <length> window-height;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <bool> layout-debug-bounds;
    in property <int> selected-index;

    callback select(int);

    x: max(root.safe-left + 12 * LumenUiScale.unit, min(root.window-width - root.safe-right - self.width - 12 * LumenUiScale.unit, root.anchor-x - self.width));
    y: max(root.safe-top, min(root.anchor-y, root.window-height - root.safe-bottom - self.height - 12 * LumenUiScale.unit));
    available_width: root.window-width; show_layout_bounds: root.layout-debug-bounds;
    items: [{ text: @tr("订阅链接"), enabled: true }, { text: @tr("本地文件"), enabled: true }, { text: @tr("扫码添加"), enabled: true }];
    current_index: root.selected-index;
    activated(index) => {
        root.select(index);
        self.close();
    }
}

export component ProxySortMenu inherits PopupMenu {
    in property <length> window-width;
    in property <length> safe-left;
    in property <length> safe-right;
    in property <length> safe-top;
    in property <bool> layout-debug-bounds;
    in property <bool> proxy-current-node-available;
    in property <string> proxy-sort-mode;

    callback locate-current-node();
    callback set-sort(string);

    x: root.safe-left + root.window-width - root.safe-right - self.width - 16 * LumenUiScale.unit;
    y: root.safe-top + 72 * LumenUiScale.unit;
    available_width: root.window-width - root.safe-left - root.safe-right;
    first_item_height: 56 * LumenUiScale.unit;
    row_height: 48 * LumenUiScale.unit;
    show_layout_bounds: root.layout-debug-bounds;
    divider_before_index: 1;
    current_index: root.proxy-sort-mode == "name_asc" ? 1 : root.proxy-sort-mode == "name_desc" ? 2 : root.proxy-sort-mode == "latency_asc" ? 3 : root.proxy-sort-mode == "latency_desc" ? 4 : 3;
    items: [
        { text: @tr("定位当前节点"), enabled: root.proxy-current-node-available },
        { text: @tr("按名称排序"), enabled: true },
        { text: @tr("按名称降序"), enabled: true },
        { text: @tr("按延迟排序"), enabled: true },
        { text: @tr("按延迟降序"), enabled: true },
    ];
    activated(index) => {
        self.close();
        if index == 0 { root.locate-current-node(); }
        else {
            let mode = index == 1 ? "name_asc" : index == 2 ? "name_desc" : index == 3 ? "latency_asc" : "latency_desc";
            root.set-sort(mode);
        }
    }
}


component WindowControlButton inherits Rectangle {
    in property <bool> danger: false;
    out property <bool> has-hover: (button-touch.has-hover && LumenTheme.hover-allowed);
    callback clicked();
    width: 46 * LumenUiScale.unit;
    height: 100%;
    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
    background: (button-touch.has-hover && LumenTheme.hover-allowed)
        ? (root.danger ? #E81123 : LumenTheme.zinc-4)
        : transparent;
    animate background { duration: 120ms; easing: ease-out; }
}

// EFFECTS-041 #167: the frameless desktop window's own chrome — a drag
// region (the builtin WindowMoveArea), the product title, and three window
// controls drawn from pure geometry so no icon asset is needed. The
// callbacks land in the host (lib.rs installs them on the real window).
export component DesktopTitleBar inherits Rectangle {
    in property <bool> maximized;
    in property <string> upload-rate: "0 B/s";
    in property <string> download-rate: "0 B/s";
    in property <bool> has-traffic-capsule: true;
    callback search-clicked();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    height: 40 * LumenUiScale.unit;
    background: LumenTheme.zinc-1;
    clip: true;

    Text {
        x: LumenTheme.rail-inset;
        y: 0 * LumenUiScale.unit;
        height: parent.height;
        text: @tr("Lumen");
        color: LumenTheme.text-secondary;
        font-size: DesignType.caption-size;
        font-weight: DesignType.caption-weight;
        font-family: DesignType.caption-family;
        vertical-alignment: center;
    }

    if root.has-traffic-capsule && LumenTheme.viewport-tier != ViewportTier.phone: Rectangle {
        x: max(160 * LumenUiScale.unit, parent.width - title-buttons.width - search-btn.width - self.width - 16 * LumenUiScale.unit);
        y: (parent.height - self.height) / 2;
        width: traffic-layout.min-width + 16 * LumenUiScale.unit;
        height: 26 * LumenUiScale.unit;
        border-radius: 13 * LumenUiScale.unit;
        background: LumenTheme.zinc-3;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;

        traffic-layout := HorizontalLayout {
            padding-left: 10 * LumenUiScale.unit;
            padding-right: 10 * LumenUiScale.unit;
            spacing: 8 * LumenUiScale.unit;
            cross-axis-alignment: center;

            HorizontalLayout {
                spacing: 3 * LumenUiScale.unit;
                cross-axis-alignment: center;
                Text {
                    text: "↑";
                    color: LumenTheme.status-info;
                    font-size: DesignType.tag-size;
                    font-weight: DesignType.tag-weight;
                    vertical-alignment: center;
                }
                Text {
                    text: root.upload-rate;
                    color: LumenTheme.text-primary;
                    font-size: DesignType.monoMicro-size;
                    font-family: DesignType.monoMicro-family;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 3 * LumenUiScale.unit;
                cross-axis-alignment: center;
                Text {
                    text: "↓";
                    color: LumenTheme.accent;
                    font-size: DesignType.tag-size;
                    font-weight: DesignType.tag-weight;
                    vertical-alignment: center;
                }
                Text {
                    text: root.download-rate;
                    color: LumenTheme.text-primary;
                    font-size: DesignType.monoMicro-size;
                    font-family: DesignType.monoMicro-family;
                    vertical-alignment: center;
                }
            }
        }
    }

    search-btn := Rectangle {
        x: parent.width - title-buttons.width - self.width - 8 * LumenUiScale.unit;
        y: (parent.height - self.height) / 2;
        width: search-layout.min-width + 16 * LumenUiScale.unit;
        visible: LumenTheme.viewport-tier != ViewportTier.phone;
        height: 26 * LumenUiScale.unit;
        border-radius: 6 * LumenUiScale.unit;
        background: (search-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-4 : LumenTheme.zinc-3;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;
        animate background { duration: 120ms; easing: ease-out; }

        search-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.search-clicked(); }
        }

        search-layout := HorizontalLayout {
            padding-left: 8 * LumenUiScale.unit;
            padding-right: 8 * LumenUiScale.unit;
            spacing: 6 * LumenUiScale.unit;
            cross-axis-alignment: center;

            Image {
                source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/search.svg");
                width: 12 * LumenUiScale.unit;
                height: 12 * LumenUiScale.unit;
                image-fit: contain;
                colorize: LumenTheme.text-muted;
                vertical-alignment: center;
            }

            Text {
                text: @tr("搜索");
                color: LumenTheme.text-secondary;
                font-size: DesignType.micro-size;
                font-weight: DesignType.micro-weight;
                font-family: DesignType.micro-family;
                vertical-alignment: center;
            }

            Rectangle {
                border-radius: 3 * LumenUiScale.unit;
                background: LumenTheme.zinc-4;
                height: 16 * LumenUiScale.unit;
                width: kbd-text.preferred-width + 8 * LumenUiScale.unit;
                kbd-text := Text {
                    text: "Ctrl+K";
                    color: LumenTheme.text-muted;
                    font-size: DesignType.monoTag-size;
                    font-family: DesignType.monoTag-family;
                    font-weight: DesignType.monoTag-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    title-buttons := HorizontalLayout {
        x: parent.width - self.width;
        width: 138 * LumenUiScale.unit;
        height: parent.height;

        WindowControlButton {
            clicked => { root.window-minimize(); }
            Rectangle {
                x: (parent.width - 10 * LumenUiScale.unit) / 2;
                y: (parent.height - 1 * LumenUiScale.unit) / 2;
                width: 10 * LumenUiScale.unit;
                height: 1 * LumenUiScale.unit;
                background: LumenTheme.text-secondary;
            }
        }
        WindowControlButton {
            clicked => { root.window-toggle-maximize(); }
            if !root.maximized: Rectangle {
                x: (parent.width - 10 * LumenUiScale.unit) / 2;
                y: (parent.height - 10 * LumenUiScale.unit) / 2;
                width: 10 * LumenUiScale.unit;
                height: 10 * LumenUiScale.unit;
                border-width: 1 * LumenUiScale.unit;
                border-color: LumenTheme.text-secondary;
                background: transparent;
            }
            if root.maximized: Rectangle {
                width: 10 * LumenUiScale.unit;
                height: 10 * LumenUiScale.unit;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                Rectangle {
                    x: 2 * LumenUiScale.unit;
                    y: 0 * LumenUiScale.unit;
                    width: 8 * LumenUiScale.unit;
                    height: 8 * LumenUiScale.unit;
                    border-width: 1 * LumenUiScale.unit;
                    border-color: LumenTheme.text-secondary;
                    background: transparent;
                }
                Rectangle {
                    x: 0 * LumenUiScale.unit;
                    y: 2 * LumenUiScale.unit;
                    width: 8 * LumenUiScale.unit;
                    height: 8 * LumenUiScale.unit;
                    border-width: 1 * LumenUiScale.unit;
                    border-color: LumenTheme.text-secondary;
                    background: LumenTheme.zinc-1;
                }
            }
        }
        close-btn := WindowControlButton {
            danger: true;
            clicked => { root.window-close(); }
            Path {
                width: 10 * LumenUiScale.unit;
                height: 10 * LumenUiScale.unit;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                stroke: (close-btn.has-hover && LumenTheme.hover-allowed) ? #FFFFFF : LumenTheme.text-secondary;
                stroke-width: LumenTheme.hairline-width;
            }
        }
    }

    // ONE drag region, ending exactly where the first interactive control
    // begins. A second raw TouchArea used to cover the traffic capsule and
    // the left 127px of the search button with a different (double-click
    // only) behaviour, and the two regions disagreed about x=896..1039.
    // WindowMoveArea already owns drag + native double-click maximize.
    WindowMoveArea {
        x: 0 * LumenUiScale.unit;
        y: 0 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit,
            search-btn.visible ? search-btn.x : title-buttons.x);
        height: parent.height;
    }
}
