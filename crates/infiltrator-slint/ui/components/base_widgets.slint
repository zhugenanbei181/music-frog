import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";
export struct SegmentedItem {
    icon: image,
    text: string,
}

export component LayoutOutline inherits Rectangle {
    in property <color> outline-color: #FF2D55;
    background: transparent;
    border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
    border-color: root.outline-color;
}

export component PingClock inherits Image {
    in property <bool> spinning: false;
    in property <color> icon-color: LumenTheme.text-secondary;
    in property <length> icon-size: 16 * LumenUiScale.unit;
    property <int> frame: 0;
    property <[image]> spin-frames: [
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-000.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-045.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-090.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-135.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-180.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-225.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-270.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-315.svg"),
    ];

    width: root.icon-size;
    height: root.icon-size;
    source: root.spinning ? root.spin-frames[root.frame] : @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping.svg");
    image-fit: contain;
    colorize: root.icon-color;

    Timer {
        interval: 80ms;
        running: root.spinning;
        triggered => {
            if root.frame >= root.spin-frames.length - 1 { root.frame = 0; }
            else { root.frame += 1; }
        }
    }
}

export component PingBadge inherits Rectangle {
    in property <string> label: "Ping";
    in property <int> delay-ms: -1;
    in property <bool> spinning: false;
    in property <bool> enabled: true;
    callback clicked();

    property <color> state-color: root.spinning || root.delay-ms < 0
        ? LumenTheme.text-secondary
        : root.delay-ms == 0 || root.delay-ms > 500
            ? LumenTheme.ping-bad
            : root.delay-ms <= 200
                ? LumenTheme.ping-good
                : LumenTheme.ping-warning;
    property <color> state-background: root.spinning || root.delay-ms < 0
        ? LumenTheme.surface-muted
        : root.delay-ms == 0 || root.delay-ms > 500
            ? LumenTheme.ping-bad-soft
            : root.delay-ms <= 200
                ? LumenTheme.ping-good-soft
                : LumenTheme.ping-warning-soft;

    width: max(72 * LumenUiScale.unit, ping-label.preferred-width + 34 * LumenUiScale.unit);
    height: 24 * LumenUiScale.unit;
    border-radius: 12 * LumenUiScale.unit;
    background: root.state-background;
    accessible-role: button;
    accessible-label: root.spinning ? @tr("正在测速") : (root.label == "Ping" ? @tr("Ping 测速") : "Ping " + root.label);

    ping-layout := HorizontalLayout {
        x: 8 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - 16 * LumenUiScale.unit);
        height: parent.height;
        spacing: 5 * LumenUiScale.unit;
        cross-axis-alignment: center;

        ping-icon := PingClock {
            spinning: root.spinning;
            icon-color: root.state-color;
            icon-size: 14 * LumenUiScale.unit;
        }
        ping-label := Text {
            text: root.spinning ? "Ping" : root.label;
            color: root.state-color;
            font-size: 12 * LumenUiScale.unit;
            font-family: LumenTheme.mono-family;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-icon.x;
        y: ping-layout.y + ping-icon.y;
        width: ping-icon.width;
        height: ping-icon.height;
        background: transparent;
        border-width: 1 * LumenUiScale.unit;
        border-color: #007AFF;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-label.x;
        y: ping-layout.y + ping-label.y;
        width: ping-label.width;
        height: ping-label.height;
        background: transparent;
        border-width: 1 * LumenUiScale.unit;
        border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <bool> active;
    in property <bool> compact;
    in property <image> icon;
    in property <image> active-icon;
    callback clicked();
    height: compact ? 48 * LumenUiScale.unit : 44 * LumenUiScale.unit;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    nav-touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    // EFFECTS-039 #160/#161/#13: hover lifts the face -1px with the
    // hairline glow; every state change rides the 120ms ease-out ramp.
    face := Rectangle {
        y: nav-touch.has-hover && !root.active ? -1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        width: parent.width;
        height: parent.height;
        border-radius: root.compact ? 22 * LumenUiScale.unit : 14 * LumenUiScale.unit;
        background: root.active ? LumenTheme.accent-soft : (nav-touch.has-hover ? LumenTheme.surface-muted : transparent);
        border-width: nav-touch.has-hover && !root.active ? 1px : 0px;
        border-color: LumenTheme.hairline-glow;
        animate y, background, border-width { duration: 120ms; easing: ease-out; }
        if root.compact: VerticalLayout {
            alignment: center;
            spacing: 2 * LumenUiScale.unit;
            Image {
                source: root.active ? root.active-icon : root.icon;
                width: 22 * LumenUiScale.unit;
                height: 22 * LumenUiScale.unit;
                image-fit: contain;
                horizontal-alignment: center;
                colorize: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary;
            }
            Text {
                text: root.label;
                color: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary;
                font-size: 11 * LumenUiScale.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if !root.compact: HorizontalLayout {
            padding-left: LumenTheme.space-4;
            padding-right: LumenTheme.space-4;
            width: parent.width;
            height: parent.height;
            spacing: LumenTheme.space-3;
            alignment: start;
            cross-axis-alignment: center;
            Image { source: root.active ? root.active-icon : root.icon; width: 22 * LumenUiScale.unit; height: 22 * LumenUiScale.unit; image-fit: contain; colorize: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary; }
            Text { text: root.label; color: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary; font-size: 14 * LumenUiScale.unit; vertical-alignment: center; }
        }
    }
}

export component AppPreferenceSwitch inherits FocusScope {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 54 * LumenUiScale.unit; height: 48 * LumenUiScale.unit;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    key-pressed(event) => {
        if root.enabled && (event.text == " " || event.text == "\n") {
            root.toggled(!root.checked); return accept;
        }
        return reject;
    }
    Rectangle {
        y: (parent.height - 31 * LumenUiScale.unit) / 2; width: parent.width; height: 31 * LumenUiScale.unit;
        border-radius: self.height / 2;
        background: root.checked ? LumenTheme.preference-accent : LumenTheme.preference-off;
        border-width: 0 * LumenUiScale.unit;
        Rectangle {
            x: root.checked ? parent.width - self.width - 4 * LumenUiScale.unit : 4 * LumenUiScale.unit;
            y: (parent.height - self.height) / 2;
            width: 22 * LumenUiScale.unit; height: 22 * LumenUiScale.unit; border-radius: 11 * LumenUiScale.unit; background: LumenTheme.accent-foreground;
        }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #AF52DE; }
}

export component AppPreferenceRow inherits FocusScope {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    in property <string> unavailable;
    in property <string> state-description;
    in property <bool> capability-enabled: true;
    in property <bool> toggle: false;
    in property <bool> checked: false;
    in property <bool> expand: false;
    in property <image> icon: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg");
    callback clicked();
    callback toggled(bool);
    min-height: max(root.detail == "" ? 66 * LumenUiScale.unit : 82 * LumenUiScale.unit, words.min-height + 24 * LumenUiScale.unit);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-action-default => {
        if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
        else { root.clicked(); }
    }
    key-pressed(event) => {
        if event.text == " " || event.text == "\n" {
            if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
            else { root.clicked(); }
            return accept;
        }
        return reject;
    }
    accessible-label: root.label + (root.detail == "" ? "" : "，" + root.detail) + (root.unavailable == "" ? "" : "，" + root.unavailable) + (root.state-description == "" ? "" : "，" + root.state-description);
    row := HorizontalLayout {
        width: parent.width; height: parent.height; spacing: LumenTheme.space-3;
        cross-axis-alignment: center;
        words := VerticalLayout {
            spacing: 2 * LumenUiScale.unit; alignment: center; horizontal-stretch: 1;
            title := Text { text: root.label; font-size: LumenTheme.preference-text-size; color: LumenTheme.text-primary; wrap: word-wrap; }
            if root.detail != "": Text {
                text: root.detail; font-size: 14 * LumenUiScale.unit; color: LumenTheme.text-secondary;
                overflow: elide; accessible-label: root.detail;
            }
        }
        if root.toggle: AppPreferenceSwitch {
            checked: root.checked; enabled: root.capability-enabled; label: root.label + " " + root.unavailable;
            toggled(value) => { root.toggled(value); }
        }
        if !root.toggle && root.value != "": Text {
            text: root.value; font-size: 18 * LumenUiScale.unit; color: LumenTheme.text-secondary;
            vertical-alignment: center; horizontal-stretch: 0;
        }
        if !root.toggle: trailing-icon := Image {
            source: root.expand ? @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-expand.svg") : root.icon;
            width: 24 * LumenUiScale.unit; height: 24 * LumenUiScale.unit; image-fit: contain;
            colorize: root.expand || root.icon == @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg") ? LumenTheme.text-secondary : LumenTheme.preference-accent;
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #007AFF; }
        }
    }
    TouchArea { enabled: !root.toggle || !root.capability-enabled; clicked => { root.clicked(); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #00A6A6; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: words.x; y: words.y; width: words.width; height: words.height; outline-color: #FF9500; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: title.x + words.x; y: title.y + words.y; width: title.width; height: title.height; outline-color: #007AFF; }
}

export component AppPreferenceGroup inherits Rectangle {
    in property <string> heading;
    min-height: group-layout.min-height;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    group-layout := VerticalLayout {
        spacing: LumenTheme.space-3; padding-top: LumenTheme.space-3; alignment: start;
        Text { x: 18 * LumenUiScale.unit; text: root.heading; font-size: 16 * LumenUiScale.unit; color: LumenTheme.preference-accent; height: 24 * LumenUiScale.unit; vertical-alignment: center; }
        surface := Rectangle {
            background: LumenTheme.surface; border-radius: LumenTheme.preference-card-radius;
            min-height: contents.min-height; preferred-height: self.min-height; vertical-stretch: 0;
            contents := VerticalLayout {
                x: 18 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit);
                padding-top: 0 * LumenUiScale.unit; padding-bottom: 0 * LumenUiScale.unit; spacing: 0 * LumenUiScale.unit; alignment: start;
                @children
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
            if LumenTheme.show-layout-bounds: LayoutOutline { x: contents.x; y: contents.y; width: contents.width; height: contents.height; outline-color: #34C759; }
        }
    }
}

export component LightRoundedInput inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    property <bool> show-password: false;
    height: 44 * LumenUiScale.unit;
    border-radius: 22 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }
    input := TextInput {
        x: 18 * LumenUiScale.unit;
        width: parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit);
        height: parent.height;
        text <=> root.text;
        input-type: (root.password && !root.show-password) ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: 15 * LumenUiScale.unit;
        vertical-alignment: center;
        accessible-label: root.label;
    }
    if root.text == "": Text {
        x: 18 * LumenUiScale.unit;
        width: parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit);
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: 15 * LumenUiScale.unit;
        vertical-alignment: center;
    }
    if root.password: Rectangle {
        x: parent.width - 34 * LumenUiScale.unit;
        y: (parent.height - 24 * LumenUiScale.unit) / 2;
        width: 24 * LumenUiScale.unit;
        height: 24 * LumenUiScale.unit;
        border-radius: 12 * LumenUiScale.unit;
        background: eye-touch.has-hover ? LumenTheme.surface-raised : transparent;
        Text {
            text: root.show-password ? "👁" : "🔒";
            font-size: 12 * LumenUiScale.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        eye-touch := TouchArea {
            clicked => { root.show-password = !root.show-password; }
        }
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 18 * LumenUiScale.unit; y: 4 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit); height: parent.height - 8 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component RoundedInputField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    property <bool> show-password: false;
    callback edited(string);
    height: 44 * LumenUiScale.unit;
    border-radius: 22 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }
    input := TextInput {
        x: 18 * LumenUiScale.unit; y: 0 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit));
        height: parent.height;
        text <=> root.text;
        input-type: (root.password && !root.show-password) ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: 15 * LumenUiScale.unit;
        vertical-alignment: center;
        accessible-label: root.label;
        edited => { root.edited(root.text); }
    }
    if root.text == "": Text {
        x: 18 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit));
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: 15 * LumenUiScale.unit;
        vertical-alignment: center;
    }
    if root.password: Rectangle {
        x: parent.width - 34 * LumenUiScale.unit;
        y: (parent.height - 24 * LumenUiScale.unit) / 2;
        width: 24 * LumenUiScale.unit;
        height: 24 * LumenUiScale.unit;
        border-radius: 12 * LumenUiScale.unit;
        background: eye-btn-touch.has-hover ? LumenTheme.surface-raised : transparent;
        Text {
            text: root.show-password ? "👁" : "🔒";
            font-size: 12 * LumenUiScale.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        eye-btn-touch := TouchArea {
            clicked => { root.show-password = !root.show-password; }
        }
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 18 * LumenUiScale.unit; y: 4 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit); height: parent.height - 8 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> icon;
    in property <brush> icon-bg: LumenTheme.surface-raised;
    in property <color> icon-color: LumenTheme.text-primary;
    in property <string> badge: "";
    in property <bool> show-divider: false;
    callback clicked();
    background: transparent;
    min-height: 56 * LumenUiScale.unit;
    preferred-height: content-layout.preferred-height;
    content-layout := VerticalLayout {
        x: 0 * LumenUiScale.unit; width: parent.width;
        padding-top: LumenTheme.space-1; padding-bottom: LumenTheme.space-1;
        HorizontalLayout {
            spacing: 12 * LumenUiScale.unit;
            cross-axis-alignment: center;
            Rectangle {
                width: 32 * LumenUiScale.unit; height: 32 * LumenUiScale.unit; border-radius: 8 * LumenUiScale.unit;
                background: root.icon-bg;
                border-width: 1 * LumenUiScale.unit;
                border-color: LumenTheme.border;
                Image { x: 6 * LumenUiScale.unit; y: 6 * LumenUiScale.unit; source: root.icon; width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit; image-fit: contain; colorize: root.icon-color; }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: 6 * LumenUiScale.unit; y: 6 * LumenUiScale.unit; width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit;
                    background: transparent; border-width: 1 * LumenUiScale.unit; border-color: #007AFF;
                }
            }
            VerticalLayout {
                vertical-stretch: 1; alignment: center; spacing: 2 * LumenUiScale.unit;
                Text { text: root.label; color: LumenTheme.text-primary; font-size: 15 * LumenUiScale.unit; font-weight: 550; wrap: word-wrap; }
                Text { text: root.detail; color: LumenTheme.text-secondary; font-size: 12 * LumenUiScale.unit; wrap: word-wrap; }
            }
            if root.badge != "": Rectangle {
                width: 64 * LumenUiScale.unit; height: 24 * LumenUiScale.unit; border-radius: 12 * LumenUiScale.unit; background: LumenTheme.accent-soft;
                Text { text: root.badge; width: parent.width; height: parent.height; color: LumenTheme.accent; font-size: 12 * LumenUiScale.unit; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Image { source: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg"); width: 18 * LumenUiScale.unit; height: 18 * LumenUiScale.unit; image-fit: contain; vertical-alignment: center; }
        }
        if root.show-divider: Rectangle {
            x: 48 * LumenUiScale.unit;
            width: parent.width - 48 * LumenUiScale.unit;
            height: 1 * LumenUiScale.unit;
            background: LumenTheme.border;
        }
    }
    row-touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    // EFFECTS-039 #160/#161: the row answers hover with the zinc wash and
    // the hairline glow on the 120ms ease-out ramp; no lift — rows live in
    // scroll lists where movement reads as jitter.
    states [
        hovered when row-touch.has-hover: {
            background: LumenTheme.zinc-2;
            border-width: 1px; border-color: LumenTheme.hairline-glow;
            in-out { animate background, border-width { duration: 120ms; easing: ease-out; } }
        }
    ]
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

// EFFECTS-039 #162/#14: the shell's own segmented selector — the selection
// capsule physically slides between items with a slight overshoot
// (cubic-bezier spring), instead of the vendored per-item instant highlight.
// The item type stays the vendored SegmentedItem so call sites keep their
// item tables.
export component SegmentedControl {
    in property <[SegmentedItem]> items;
    in-out property <int> current-index: 0;
    callback index-changed(int);

    min-height: 40 * LumenUiScale.unit;
    min-width: 240 * LumenUiScale.unit;
    accessible-role: list;
    accessible-item-count: root.items.length;

    track := Rectangle {
        clip: true;
        border-radius: self.height / 2;
        background: LumenTheme.zinc-3;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;

        // The sliding capsule: its slot width is the track divided by the
        // item count, so the geometry is derived, never per-item constant.
        capsule := Rectangle {
            width: root.items.length > 0 ? track.width / root.items.length : 0 * LumenUiScale.unit;
            height: parent.height;
            x: self.width * root.current-index;
            border-radius: self.height / 2;
            background: LumenTheme.accent-soft;
            // The elastic move: overshoot bezier, 280ms.
            animate x { duration: 280ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }
        }

        layout := HorizontalLayout {
            width: parent.width;
            height: parent.height;
            for item[index] in root.items: Rectangle {
                horizontal-stretch: 1;
                item-touch := TouchArea {
                    width: parent.width; height: parent.height;
                    accessible-role: list-item;
                    accessible-label: item.text;
                    accessible-item-selectable: true;
                    accessible-item-selected: index == root.current-index;
                    accessible-item-index: index;
                    clicked => {
                        root.current-index = index;
                        root.index-changed(index);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: item.text;
                        color: index == root.current-index ? LumenTheme.accent-active : LumenTheme.text-secondary;
                        font-size: LumenTheme.supporting-size;
                        font-weight: index == root.current-index ? 650 : 400;
                        horizontal-alignment: center;
                        overflow: elide;
                        animate color, font-weight { duration: 120ms; easing: ease-out; }
                    }
                }
            }
        }
    }
}

// The search field of the observation pages: one hover accent, one
// placeholder, one search callback. The pages bind their own draft and the
// owner decides what the query means.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;

    callback search(string);

    height: 38 * LumenUiScale.unit;
    border-radius: 19 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: search-input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14 * LumenUiScale.unit;
        padding-right: 14 * LumenUiScale.unit;
        spacing: 10 * LumenUiScale.unit;
        cross-axis-alignment: center;

        Image {
            source: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/search.svg");
            width: 18 * LumenUiScale.unit;
            height: 18 * LumenUiScale.unit;
            image-fit: contain;
            colorize: LumenTheme.text-muted;
        }

        search-input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            color: LumenTheme.text-primary;
            font-size: 13 * LumenUiScale.unit;
            vertical-alignment: center;
            edited => { root.search(self.text); }
            accepted => { root.search(self.text); }
        }

        if root.text != "": Rectangle {
            width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit; border-radius: 10 * LumenUiScale.unit;
            background: clear-touch.has-hover ? LumenTheme.surface-raised : transparent;
            Text { text: "✕"; color: LumenTheme.text-secondary; font-size: 11 * LumenUiScale.unit; horizontal-alignment: center; vertical-alignment: center; }
            clear-touch := TouchArea { clicked => { root.text = ""; root.search(""); } }
        }
    }

    if root.text == "": Text {
        x: 42 * LumenUiScale.unit;
        width: parent.width - 56 * LumenUiScale.unit;
        height: parent.height;
        text: root.placeholder;
        color: LumenTheme.text-muted;
        font-size: 13 * LumenUiScale.unit;
        vertical-alignment: center;
    }
}

// One selectable pill of the observation toolbars: view switchers, sort
// dimensions, level filters and the plain action pills. The selected look is
// either the accent fill or — for pills that must not shout — the soft tint
// with an accent label; a per-pill fill override carries the semantic tone
// (warning, error) of the choice it stands for.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> tinted: false;
    in property <bool> danger: false;
    in property <brush> select-fill: LumenTheme.accent;
    in property <bool> enabled: true;
    in property <bool> check-prefix: false;
    in property <bool> segmented: false;
    in property <length> pill-height: 32 * LumenUiScale.unit;
    in property <length> min-pill-width: 0 * LumenUiScale.unit;

    callback clicked();

    height: root.pill-height;
    min-width: root.min-pill-width;
    border-radius: self.height / 2;
    background: root.danger && root.enabled ? (pill-touch.has-hover ? LumenTheme.error.darker(10%) : LumenTheme.error) : (root.selected ? (root.tinted ? LumenTheme.accent-soft : root.select-fill) : (pill-touch.has-hover && root.enabled ? LumenTheme.surface-raised : (root.segmented ? transparent : LumenTheme.surface-muted)));
    border-width: 1 * LumenUiScale.unit;
    border-color: root.danger && root.enabled ? LumenTheme.error : (root.selected ? (root.tinted ? LumenTheme.accent : root.select-fill) : (pill-touch.has-hover && root.enabled ? (root.segmented ? transparent : LumenTheme.accent) : (root.segmented ? transparent : LumenTheme.border)));
    animate background, border-color { duration: 120ms; easing: ease-out; }
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: 10 * LumenUiScale.unit;
        padding-right: 10 * LumenUiScale.unit;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: (root.check-prefix && root.selected ? "✓ " : "") + root.label;
            color: root.danger && root.enabled ? LumenTheme.accent-foreground : (root.selected ? (root.tinted ? LumenTheme.accent : LumenTheme.accent-foreground) : (pill-touch.has-hover && root.enabled ? LumenTheme.text-primary : LumenTheme.text-secondary));
            font-size: 12 * LumenUiScale.unit;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    pill-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
