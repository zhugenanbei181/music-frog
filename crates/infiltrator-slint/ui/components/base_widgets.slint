import { DesignType, TextRole } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";
import { PageTitles } from "./page_titles.slint";
export struct SegmentedItem {
    icon: image,
    text: string,
}

// The navigation button owns the reusable chrome geometry that the desktop
// rail and the floating dock both consume. Each fact is declared once here;
// the dock's band, top air and inset remain in LumenTheme.
export global NavButtonMetrics {
    out property <length> desktop-height: LumenTheme.rail-row-height;
    out property <length> icon-size: 20 * LumenUiScale.unit;
    out property <length> desktop-radius: LumenTheme.radius-control;
    out property <length> compact-radius: LumenTheme.bottom-bar-pill-height / 2;
    out property <length> compact-icon-label-gap: 2 * LumenUiScale.unit;
    out property <length> compact-pill-gutter: LumenTheme.space-1;
    // The desktop pill is content-width but may not exceed the rail content
    // column. The gap between a short label and the card right edge is
    // legitimate breathing room, not waste; the metric measures dead air
    // *inside* the pill box only.
    out property <length> desktop-pill-max-width: LumenTheme.rail-width - 2 * LumenTheme.rail-inset - 2 * LumenTheme.rail-item-padding;
}

// One compact page header action button, shared by the action clusters. Its
// ink box stays inside the cluster's minimum touch target.
export global HeaderActionMetrics {
    out property <length> action-control-size: 40 * LumenUiScale.unit;
    out property <length> cluster-inset: 2 * LumenUiScale.unit;
    out property <length> search-height: 42 * LumenUiScale.unit;
    out property <length> search-inset: LumenTheme.space-4;
}

export component LayoutOutline inherits Rectangle {
    in property <color> outline-color: LumenTheme.debug-frame;
    background: transparent;
    border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
    border-color: root.outline-color;
}

export component PingClock inherits Image {
    in property <bool> spinning: false;
    in property <color> icon-color: LumenTheme.text-secondary;
    in property <length> icon-size: 16 * LumenUiScale.unit;
    property <int> frame: 0;
    property <[image]> spin-frames: [
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-000.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-045.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-090.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-135.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-180.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-225.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-270.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-315.svg"),
    ];

    width: root.icon-size;
    height: root.icon-size;
    source: root.spinning ? root.spin-frames[root.frame] : @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg");
    image-fit: contain;
    colorize: root.icon-color;

    Timer {
        interval: 80ms;
        running: root.spinning;
        triggered => {
            if root.frame >= root.spin-frames.length - 1 { root.frame = 0; }
            else { root.frame += 1; }
        }
    }
}

export component PingBadge inherits Rectangle {
    in property <string> label: "Ping";
    // The latency colour is data the projection hands over, graded once by the
    // contract's `LatencyGrade` ladder. This widget no longer sees milliseconds
    // at all, so it cannot invent a second, different ladder.
    in property <color> latency-ink: LumenTheme.text-secondary;
    in property <bool> spinning: false;
    in property <bool> enabled: true;
    callback clicked();

    // A probe in flight has no verdict yet, so it paints the neutral ink.
    property <color> state-color: root.spinning
        ? LumenTheme.text-secondary
        : root.latency-ink;

    // The reference reads latency as a right-aligned coloured value, not as a
    // filled pill: the colour carries the grade, so a background would only
    // compete with it and widen the row for no information.
    width: max(64 * LumenUiScale.unit, ping-label.preferred-width + 22 * LumenUiScale.unit);
    height: 28 * LumenUiScale.unit;
    border-radius: 14 * LumenUiScale.unit;
    background: transparent;
    accessible-role: button;
    accessible-label: root.spinning ? @tr("正在测速") : (root.label == "Ping" ? @tr("Ping 测速") : "Ping " + root.label);

    ping-layout := HorizontalLayout {
        x: 4 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - 8 * LumenUiScale.unit);
        height: parent.height;
        spacing: 5 * LumenUiScale.unit;
        cross-axis-alignment: center;
        alignment: end;

        ping-icon := PingClock {
            spinning: root.spinning;
            icon-color: root.state-color;
            icon-size: 14 * LumenUiScale.unit;
        }
        ping-label := Text {
            text: root.spinning ? "Ping" : root.label;
            color: root.state-color;
            font-size: DesignType.monoCaption-size;
            font-family: DesignType.monoCaption-family;
            font-weight: DesignType.monoCaption-weight;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-icon.x;
        y: ping-layout.y + ping-icon.y;
        width: ping-icon.width;
        height: ping-icon.height;
        background: transparent;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.debug-icon;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-label.x;
        y: ping-layout.y + ping-label.y;
        width: ping-label.width;
        height: ping-label.height;
        background: transparent;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.debug-content;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component NavButton inherits Rectangle {
    private property <length> desktop-pill-width: min(
        2 * LumenTheme.rail-item-padding + NavButtonMetrics.icon-size + LumenTheme.space-3 + nav-label.preferred-width,
        NavButtonMetrics.desktop-pill-max-width);

    in property <string> label;
    in property <string> target;
    in property <bool> active;
    in property <bool> compact;
    in property <image> icon;
    in property <image> active-icon;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 0;
    height: compact ? LumenTheme.bottom-bar-pill-height : NavButtonMetrics.desktop-height;
    background: transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.active;
    nav-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.clicked(); } }
    // EFFECTS-039 #160/#161/#13: hover lifts the face -1px with the
    // hairline glow; every state change rides the 120ms ease-out ramp.
    face := Rectangle {
        x: root.compact ? 0 * LumenUiScale.unit : LumenTheme.rail-item-padding;
        y: (nav-touch.has-hover && LumenTheme.hover-allowed) && !root.active ? -1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        width: root.compact ? parent.width : root.desktop-pill-width;
        height: parent.height;
        border-radius: root.compact ? NavButtonMetrics.compact-radius : NavButtonMetrics.desktop-radius;
        background: root.compact ? transparent : (root.active ? LumenTheme.accent-soft : ((nav-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-muted : transparent));
        border-width: !root.compact && (nav-touch.has-hover && LumenTheme.hover-allowed) && !root.active ? LumenTheme.hairline-width : 0 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;
        animate y, background, border-width { duration: 120ms; easing: ease-out; }
        if root.compact: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: min(parent.width - NavButtonMetrics.compact-pill-gutter, LumenTheme.bottom-bar-pill-width);
            height: LumenTheme.bottom-bar-pill-height;
            // The reference pill is a full stadium (radius = half its height),
            // which at 90 x 56dp reads as a soft chip, not a coin.
            border-radius: NavButtonMetrics.compact-radius;
            // The active tab uses the same skin tokens as the desktop sidebar's
            // active item, so one theme decision cannot fork into a second one
            // per layout.
            background: root.active ? LumenTheme.accent-soft : ((nav-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-muted : transparent);
            animate background { duration: 120ms; easing: ease-out; }
            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: NavButtonMetrics.compact-icon-label-gap;
                Image {
                    source: root.active ? root.active-icon : root.icon;
                    width: NavButtonMetrics.icon-size; height: NavButtonMetrics.icon-size; image-fit: contain;
                    colorize: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary;
                }
                Text {
                    text: root.label;
                    color: root.active ? LumenTheme.accent-active : LumenTheme.text-secondary;
                    font-size: DesignType.size(TextRole.micro);
                    font-weight: DesignType.weight(TextRole.micro);
                    font-family: DesignType.family(TextRole.micro);
                    horizontal-alignment: center;
                }
            }
        }
        // Gated by `visible` rather than `if` so the named label stays in the
        // component tree and the root can size the pill to its preferred width
        // (Slint cannot resolve an id declared inside a conditional block).
        HorizontalLayout {
            visible: !root.compact;
            padding-left: LumenTheme.rail-item-padding;
            padding-right: LumenTheme.rail-item-padding;
            width: parent.width;
            height: parent.height;
            spacing: LumenTheme.space-3;
            alignment: start;
            cross-axis-alignment: center;
            Image { source: root.active ? root.active-icon : root.icon; width: NavButtonMetrics.icon-size; height: NavButtonMetrics.icon-size; image-fit: contain; colorize: root.active ? LumenTheme.accent-active : ((nav-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.text-primary : LumenTheme.text-secondary); }
            // The label is named so the pill can hug its preferred width; the
            // layout still fills the face, so `overflow: elide` engages when a
            // long localized label reaches the pill's max-width cap.
            nav-label := Text { text: root.label; color: root.active ? LumenTheme.accent-active : ((nav-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.text-primary : LumenTheme.text-secondary); font-size: DesignType.size(TextRole.label); font-weight: DesignType.weight(TextRole.label); font-family: DesignType.family(TextRole.label); vertical-alignment: center; horizontal-stretch: 1; min-width: 0 * LumenUiScale.unit; overflow: elide; }
        }
    }
}

export component LightRoundedInput inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    property <bool> show-password: false;
    height: 44 * LumenUiScale.unit;
    border-radius: 22 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }
    input := TextInput {
        x: 18 * LumenUiScale.unit;
        width: parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit);
        height: parent.height;
        text <=> root.text;
        input-type: (root.password && !root.show-password) ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: DesignType.body-size;
        vertical-alignment: center;
        accessible-label: root.label;
    }
    if root.text == "": Text {
        x: 18 * LumenUiScale.unit;
        width: parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit);
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: DesignType.body-size;
        vertical-alignment: center;
    }
    if root.password: Rectangle {
        x: parent.width - 34 * LumenUiScale.unit;
        y: (parent.height - 24 * LumenUiScale.unit) / 2;
        width: 24 * LumenUiScale.unit;
        height: 24 * LumenUiScale.unit;
        border-radius: 12 * LumenUiScale.unit;
        background: (eye-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-raised : transparent;
        Text {
            text: root.show-password ? "👁" : "🔒";
            font-size: DesignType.caption-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        eye-touch := TouchArea {
            clicked => { root.show-password = !root.show-password; }
        }
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 18 * LumenUiScale.unit; y: 4 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit); height: parent.height - 8 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-content;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component RoundedInputField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    property <bool> show-password: false;
    callback edited(string);
    height: 44 * LumenUiScale.unit;
    border-radius: 22 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }
    input := TextInput {
        x: 18 * LumenUiScale.unit; y: 0 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit));
        height: parent.height;
        text <=> root.text;
        input-type: (root.password && !root.show-password) ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: DesignType.body-size;
        vertical-alignment: center;
        accessible-label: root.label;
        edited => { root.edited(root.text); }
    }
    if root.text == "": Text {
        x: 18 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - (root.password ? 60 * LumenUiScale.unit : 36 * LumenUiScale.unit));
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: DesignType.body-size;
        vertical-alignment: center;
    }
    if root.password: Rectangle {
        x: parent.width - 34 * LumenUiScale.unit;
        y: (parent.height - 24 * LumenUiScale.unit) / 2;
        width: 24 * LumenUiScale.unit;
        height: 24 * LumenUiScale.unit;
        border-radius: 12 * LumenUiScale.unit;
        background: (eye-btn-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-raised : transparent;
        Text {
            text: root.show-password ? "👁" : "🔒";
            font-size: DesignType.caption-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        eye-btn-touch := TouchArea {
            clicked => { root.show-password = !root.show-password; }
        }
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 18 * LumenUiScale.unit; y: 4 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit); height: parent.height - 8 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-content;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

// The one seam used between the rows of a grouped list. Every surface that
// splits rows draws this instead of hand-placing a rectangle, so the inset,
// the thickness and the colour stay a single theme decision: the hairline sits
// on the row's bottom edge, starts at the ink column and stops at the card's
// own padding, which is how the reference keeps a row group readable without
// ever drawing a frame around it.
export component RowDivider inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;
    // The line is a child, not the root: a component's root element cannot
    // read `parent`, and the seam has to be measured against the row it closes.
    Rectangle {
        x: LumenTheme.row-divider-inset-start;
        width: max(0 * LumenUiScale.unit, parent.width - LumenTheme.row-divider-inset-start - LumenTheme.row-divider-inset-end);
        y: parent.height - LumenTheme.row-divider-thickness;
        height: LumenTheme.row-divider-thickness;
        background: LumenTheme.row-divider;
    }
}

// The same seam for the lists that lay their rules out as an item instead of
// pinning one to a row's edge - the sidebar's nav groups and a profile card's
// action strip. It is a hairline that never stretches, so a group cannot
// quietly grow a second separator tier.
export component ListRule inherits Rectangle {
    vertical-stretch: 0;
    min-height: LumenTheme.row-divider-thickness;
    preferred-height: LumenTheme.row-divider-thickness;
    background: LumenTheme.row-divider;
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> icon;
    // The destination this row opens, in the same vocabulary as `clicked =>
    // navigate(...)`. The identity hue is looked up from it here instead of
    // being passed in: a tile is the destination's colour, not the list's, so
    // 日志 is the same colour in the 工具 list and in the 运行观测 list, and a new
    // entry point cannot invent a second identity for an existing page. The
    // table lives in this component rather than in a global helper because
    // Slint rejects calling an impure function from a binding.
    in property <string> destination: "";
    private property <color> icon-hue: root.destination == "" ? LumenTheme.text-primary
        : root.destination == "Meta" ? LumenTheme.tile-magenta
        : root.destination == "Logs" || root.destination == "AppSettings" ? LumenTheme.tile-azure
        : root.destination == "Network" || root.destination == "Traffic" ? LumenTheme.tile-teal
        : root.destination == "Overrides" || root.destination == "Rules" ? LumenTheme.tile-violet
        : root.destination == "Dns" || root.destination == "Editor" || root.destination == "Filters" ? LumenTheme.tile-amber
        : root.destination == "Doctor" || root.destination == "Sync" || root.destination == "Connections" ? LumenTheme.tile-indigo
        : root.destination == "AppRouting" ? LumenTheme.tile-orange
        : LumenTheme.tile-slate;
    in property <string> badge: "";
    in property <bool> show-divider: false;
    callback clicked();
    background: transparent;
    private property <length> row-height: 56 * LumenUiScale.unit;
    private property <length> icon-box-size: 32 * LumenUiScale.unit;
    private property <length> icon-size: 20 * LumenUiScale.unit;
    private property <length> icon-inset: 6 * LumenUiScale.unit;
    private property <length> chevron-size: 18 * LumenUiScale.unit;
    // A long label must grow the row instead of wrapping into a fixed-height
    // ink block and losing its second line. Slint forbids `height` and
    // `min-height` together, so the content-driven height IS the minimum:
    // the inner layout reports its own preferred height and the row follows.
    min-height: max(root.row-height, content-layout.preferred-height);
    preferred-height: self.min-height;
    content-layout := VerticalLayout {
        x: 0 * LumenUiScale.unit; y: 0 * LumenUiScale.unit; width: parent.width;
        // The ink block centres in the whole row while the separator is pinned to
        // the row's bottom edge: as the layout's last child the separator floated
        // right under the text, 17.5u above and 38.5u below the next row's ink.
        padding-top: LumenTheme.space-1; padding-bottom: LumenTheme.space-1;
        // The trailing affordance keeps the reference's air: its ink ends 24u
        // from the card's edge, not on it.
        padding-right: LumenTheme.row-trailing-inset;
        alignment: center;
        HorizontalLayout {
            spacing: LumenTheme.space-4;
            cross-axis-alignment: center;
            Rectangle {
                width: root.icon-box-size; height: root.icon-box-size; border-radius: LumenTheme.space-2;
                background: root.icon-hue.with_alpha(LumenTheme.tile-fill-alpha);
                Image { x: root.icon-inset; y: root.icon-inset; source: root.icon; width: root.icon-size; height: root.icon-size; image-fit: contain; colorize: root.icon-hue; }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: root.icon-inset; y: root.icon-inset; width: root.icon-size; height: root.icon-size;
                    background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
                }
            }
            VerticalLayout {
                vertical-stretch: 1; alignment: center; spacing: 2 * LumenUiScale.unit; min-width: 0 * LumenUiScale.unit;
                Text { text: root.label; color: LumenTheme.text-primary; font-size: DesignType.body-size; font-weight: DesignType.body-weight; wrap: word-wrap; min-width: 0 * LumenUiScale.unit; }
                Text { text: root.detail; color: LumenTheme.text-secondary; font-size: DesignType.caption-size; wrap: word-wrap; min-width: 0 * LumenUiScale.unit; }
            }
            if root.badge != "": Rectangle {
                width: 64 * LumenUiScale.unit; height: 24 * LumenUiScale.unit; border-radius: 12 * LumenUiScale.unit; background: LumenTheme.accent-soft;
                Text { text: root.badge; width: parent.width; height: parent.height; color: LumenTheme.accent; font-size: DesignType.caption-size; font-weight: DesignType.caption-weight; horizontal-alignment: center; vertical-alignment: center; }
            }
            // Every shipped Lucide SVG strokes with `currentColor`: without an
            // explicit colorize it lands on black and disappears into the dark
            // cards, so a row's whole trailing affordance vanishes.
            Image { source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg"); width: root.chevron-size; height: root.chevron-size; image-fit: contain; colorize: LumenTheme.text-secondary; vertical-alignment: center; }
        }
    }
    if root.show-divider: RowDivider {}
    row-touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    // EFFECTS-039 #160/#161: the row answers hover with the zinc wash and
    // the 120ms ease-out ramp; no lift - rows live in scroll lists where
    // movement reads as jitter. The hairline glow that used to come with it is
    // gone on purpose: a row inside a card has no edge of its own, so drawing
    // one invented a nested frame around a single row and doubled the seam
    // lines above and below it. The rule is now one dialect for every row in a
    // card - wash answers hover, the card alone owns the edge. A standalone
    // control (the rail chip, a capsule) keeps its hairline because there its
    // edge is real.
    //
    // The wash is one tier OFF the card, not the card's own tier. It used to be
    // `zinc-2` inside a `zinc-2` SectionCard, which answered a hover with the
    // exact colour the row was already sitting on - the documented "wash
    // answers hover" was silently a no-op on every settings row.
    states [
        hovered when (row-touch.has-hover && LumenTheme.hover-allowed): {
            background: LumenTheme.zinc-3;
            in-out { animate background { duration: 120ms; easing: ease-out; } }
        }
    ]
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

// EFFECTS-039 #162/#14: the shell's own segmented selector — the selection
// capsule physically slides between items with a slight overshoot
// (cubic-bezier spring), instead of the vendored per-item instant highlight.
// The item type stays the vendored SegmentedItem so call sites keep their
// item tables.
export component SegmentedControl {
    in property <[SegmentedItem]> items;
    in-out property <int> current-index: 0;
    callback index-changed(int);

    min-height: 40 * LumenUiScale.unit;
    min-width: 240 * LumenUiScale.unit;
    accessible-role: list;
    accessible-item-count: root.items.length;

    track := Rectangle {
        clip: true;
        border-radius: self.height / 2;
        background: LumenTheme.zinc-3;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;

        // The sliding capsule: its slot width is the track divided by the
        // item count, so the geometry is derived, never per-item constant.
        capsule := Rectangle {
            width: root.items.length > 0 ? track.width / root.items.length : 0 * LumenUiScale.unit;
            height: parent.height;
            x: self.width * root.current-index;
            border-radius: self.height / 2;
            background: LumenTheme.accent-soft;
            // The elastic move: overshoot bezier, 280ms.
            animate x { duration: 280ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }
        }

        layout := HorizontalLayout {
            width: parent.width;
            height: parent.height;
            for item[index] in root.items: Rectangle {
                horizontal-stretch: 1;
                item-touch := TouchArea {
                    width: parent.width; height: parent.height;
                    accessible-role: list-item;
                    accessible-label: item.text;
                    accessible-item-selectable: true;
                    accessible-item-selected: index == root.current-index;
                    accessible-item-index: index;
                    clicked => {
                        root.current-index = index;
                        root.index-changed(index);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: item.text;
                        color: index == root.current-index ? LumenTheme.accent-active : LumenTheme.text-secondary;
                        font-size: DesignType.size(TextRole.label);
                        font-weight: DesignType.weight(index == root.current-index ? TextRole.labelStrong : TextRole.label);
                        horizontal-alignment: center;
                        overflow: elide;
                        animate color { duration: 120ms; easing: ease-out; }
                    }
                }
            }
        }
    }
}

// The search field of the observation pages: one hover accent, one
// placeholder, one search callback. The pages bind their own draft and the
// owner decides what the query means.
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;

    callback search(string);

    height: 38 * LumenUiScale.unit;
    border-radius: 19 * LumenUiScale.unit;
    background: LumenTheme.surface-muted;
    border-width: 1 * LumenUiScale.unit;
    border-color: search-input.has-focus ? LumenTheme.accent : LumenTheme.border;
    animate border-color { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14 * LumenUiScale.unit;
        padding-right: 14 * LumenUiScale.unit;
        spacing: 10 * LumenUiScale.unit;
        cross-axis-alignment: center;

        Image {
            source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/search.svg");
            width: 18 * LumenUiScale.unit;
            height: 18 * LumenUiScale.unit;
            image-fit: contain;
            colorize: LumenTheme.text-muted;
        }

        search-input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            color: LumenTheme.text-primary;
            font-size: DesignType.mono-size;
            vertical-alignment: center;
            edited => { root.search(self.text); }
            accepted => { root.search(self.text); }
        }

        if root.text != "": Rectangle {
            width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit; border-radius: 10 * LumenUiScale.unit;
            background: (clear-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-raised : transparent;
            Text { text: "✕"; color: LumenTheme.text-secondary; font-size: DesignType.micro-size; horizontal-alignment: center; vertical-alignment: center; }
            clear-touch := TouchArea { clicked => { root.text = ""; root.search(""); } }
        }
    }

    if root.text == "": Text {
        x: 42 * LumenUiScale.unit;
        width: parent.width - 56 * LumenUiScale.unit;
        height: parent.height;
        text: root.placeholder;
        color: LumenTheme.text-muted;
        font-size: DesignType.mono-size;
        vertical-alignment: center;
    }
}

// One selectable pill of the observation toolbars: view switchers, sort
// dimensions, level filters and the plain action pills. The selected look is
// either the accent fill or — for pills that must not shout — the soft tint
// with an accent label; a per-pill fill override carries the semantic tone
// (warning, error) of the choice it stands for.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> tinted: false;
    in property <bool> danger: false;
    in property <brush> select-fill: LumenTheme.accent;
    in property <bool> enabled: true;
    in property <bool> check-prefix: false;
    in property <bool> segmented: false;
    in property <length> pill-height: 32 * LumenUiScale.unit;
    in property <length> min-pill-width: 0 * LumenUiScale.unit;

    callback clicked();

    height: root.pill-height;
    min-width: root.min-pill-width;
    border-radius: self.height / 2;
    background: root.danger && root.enabled ? ((pill-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.error.darker(10%) : LumenTheme.error) : (root.selected ? (root.tinted ? LumenTheme.accent-soft : root.select-fill) : ((pill-touch.has-hover && LumenTheme.hover-allowed) && root.enabled ? LumenTheme.surface-raised : (root.segmented ? transparent : LumenTheme.surface-muted)));
    border-width: 1 * LumenUiScale.unit;
    border-color: root.danger && root.enabled ? LumenTheme.error : (root.selected ? (root.tinted ? LumenTheme.accent : root.select-fill) : ((pill-touch.has-hover && LumenTheme.hover-allowed) && root.enabled ? (root.segmented ? transparent : LumenTheme.accent) : (root.segmented ? transparent : LumenTheme.border)));
    animate background, border-color { duration: 120ms; easing: ease-out; }
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: 14 * LumenUiScale.unit;
        padding-right: 14 * LumenUiScale.unit;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: (root.check-prefix && root.selected ? "✓ " : "") + root.label;
            color: root.danger && root.enabled ? LumenTheme.accent-foreground : (root.selected ? (root.tinted ? LumenTheme.accent : LumenTheme.accent-foreground) : ((pill-touch.has-hover && LumenTheme.hover-allowed) && root.enabled ? LumenTheme.text-primary : LumenTheme.text-secondary));
            font-size: DesignType.caption-size;
            font-family: DesignType.caption-family;
            font-weight: DesignType.caption-weight;
            vertical-alignment: center;
        }
    }

    pill-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The compact page header's action cluster.
//
// Paired actions share one capsule and a lone action becomes a circle of the
// same height, which is how the reference lays its page actions out. The height
// and the corner live here so a page cannot invent a fifth header metric.
export component HeaderActionCluster inherits Rectangle {
    // The cluster is as tall as the surface's own declared minimum touch
    // target, so a header action cannot be smaller than the rule every other
    // control already obeys.
    min-height: LumenTheme.min-touch-target;
    border-radius: self.height / 2;
    background: LumenTheme.zinc-3;
    border-width: 1 * LumenUiScale.unit;
    border-color: LumenTheme.hairline-glow;
    cluster-layout := HorizontalLayout {
        width: parent.width; height: parent.height;
        padding-left: HeaderActionMetrics.cluster-inset; padding-right: HeaderActionMetrics.cluster-inset;
        alignment: center; cross-axis-alignment: center;
        @children
    }
}

// The compact/phone page header: one title, one trailing action slot and one
// height for all four top-level pages.
//
// The four pages used to draw this row themselves with two different fonts,
// three private heights and a shell-level padding-top fork, so their title
// ink sat at y16-35 / y17-34 / y24-43 / y25-42 - an 8-9px baseline split
// between screens that are supposed to share one header. The shell also
// printed a second title on some pages, which is why the compact padding
// fork existed at all. One component owns the row now.
export component CompactPageHeader inherits HorizontalLayout {
    in property <string> page;
    height: LumenTheme.page-header-height;
    width: 100%;
    // The page body already applies one 16u page margin to the scroll
    // content; the header must not add a SECOND one. Settings (whose title
    // the shell prints) starts at x17, so the three page-owned headers
    // must too - the old x32-33 split was that duplicated inset.
    padding-left: 0 * LumenUiScale.unit;
    padding-right: 0 * LumenUiScale.unit;
    spacing: LumenTheme.space-2;
    cross-axis-alignment: center;
    Text {
        text: PageTitles.phone-title(root.page);
        color: LumenTheme.text-primary;
        font-size: DesignType.display-size;
        font-weight: DesignType.display-weight;
        horizontal-stretch: 1;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
}
