import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";

export component LayoutOutline inherits Rectangle {
    in property <color> outline-color: #FF2D55;
    background: transparent;
    border-width: LumenTheme.show-layout-bounds ? 1px * LumenUiScale.factor : 0px * LumenUiScale.factor;
    border-color: root.outline-color;
}

export component PingClock inherits Image {
    in property <bool> spinning: false;
    in property <color> icon-color: LumenTheme.text-secondary;
    in property <length> icon-size: 16px * LumenUiScale.factor;
    property <int> frame: 0;
    property <[image]> spin-frames: [
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-000.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-045.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-090.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-135.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-180.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-225.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-270.svg"),
        @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping-spin-315.svg"),
    ];

    width: root.icon-size;
    height: root.icon-size;
    source: root.spinning ? root.spin-frames[root.frame] : @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/ping.svg");
    image-fit: contain;
    colorize: root.icon-color;

    Timer {
        interval: 80ms;
        running: root.spinning;
        triggered => {
            if root.frame >= root.spin-frames.length - 1 { root.frame = 0; }
            else { root.frame += 1; }
        }
    }
}

export component PingBadge inherits Rectangle {
    in property <string> label: "Ping";
    in property <int> delay-ms: -1;
    in property <bool> spinning: false;
    in property <bool> enabled: true;
    callback clicked();

    property <color> state-color: root.spinning || root.delay-ms < 0
        ? LumenTheme.text-secondary
        : root.delay-ms == 0 || root.delay-ms > 800
            ? LumenTheme.ping-bad
            : root.delay-ms <= 250
                ? LumenTheme.ping-good
                : LumenTheme.ping-warning;
    property <color> state-background: root.spinning || root.delay-ms < 0
        ? LumenTheme.surface-muted
        : root.delay-ms == 0 || root.delay-ms > 800
            ? LumenTheme.ping-bad-soft
            : root.delay-ms <= 250
                ? LumenTheme.ping-good-soft
                : LumenTheme.ping-warning-soft;

    width: max(72px * LumenUiScale.factor, ping-label.preferred-width + 37px * LumenUiScale.factor);
    height: 24px * LumenUiScale.factor;
    border-radius: 12px * LumenUiScale.factor;
    background: root.state-background;
    accessible-role: button;
    accessible-label: root.spinning ? @tr("正在测速") : (root.label == "Ping" ? @tr("Ping 测速") : "Ping " + root.label);

    ping-layout := HorizontalLayout {
        x: 8px * LumenUiScale.factor;
        width: max(0px * LumenUiScale.factor, parent.width - 16px * LumenUiScale.factor);
        height: parent.height;
        spacing: 5px * LumenUiScale.factor;
        cross-axis-alignment: center;

        ping-icon := PingClock {
            spinning: root.spinning;
            icon-color: root.state-color;
        }
        ping-label := Text {
            text: root.spinning ? "Ping" : root.label;
            color: root.state-color;
            font-size: 13px * LumenUiScale.factor;
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-icon.x;
        y: ping-layout.y + ping-icon.y;
        width: ping-icon.width;
        height: ping-icon.height;
        background: transparent;
        border-width: 1px * LumenUiScale.factor;
        border-color: #007AFF;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: ping-layout.x + ping-label.x;
        y: ping-layout.y + ping-label.y;
        width: ping-label.width;
        height: ping-label.height;
        background: transparent;
        border-width: 1px * LumenUiScale.factor;
        border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> target;
    in property <bool> active;
    in property <bool> compact;
    in property <image> icon;
    in property <image> active-icon;
    callback clicked();
    height: compact ? 48px * LumenUiScale.factor : 44px * LumenUiScale.factor;
    border-radius: compact ? 22px * LumenUiScale.factor : 14px * LumenUiScale.factor;
    background: active ? LumenTheme.accent-soft : (nav-touch.has-hover ? LumenTheme.surface-muted : transparent);
    nav-touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    if compact: Image {
        x: (parent.width - 23px * LumenUiScale.factor) / 2; y: 0px * LumenUiScale.factor;
        source: root.active ? root.active-icon : root.icon;
        width: 23px * LumenUiScale.factor; height: 23px * LumenUiScale.factor; image-fit: contain;
    }
    if compact: Text {
        x: 0px * LumenUiScale.factor; y: 22px * LumenUiScale.factor; width: parent.width; height: 18px * LumenUiScale.factor;
        text: root.label; color: root.active ? LumenTheme.accent : LumenTheme.text-secondary;
        font-size: 12px * LumenUiScale.factor; horizontal-alignment: center; vertical-alignment: center;
    }
    if !compact: HorizontalLayout {
        x: 12px * LumenUiScale.factor; width: parent.width - 24px * LumenUiScale.factor; height: parent.height; spacing: 12px * LumenUiScale.factor;
        alignment: center;
        Image { source: root.active ? root.active-icon : root.icon; width: 21px * LumenUiScale.factor; height: 21px * LumenUiScale.factor; image-fit: contain; }
        Text { text: root.label; color: root.active ? LumenTheme.accent : LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; vertical-alignment: center; }
    }
}

export component AppPreferenceSwitch inherits FocusScope {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 54px * LumenUiScale.factor; height: 48px * LumenUiScale.factor;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    key-pressed(event) => {
        if root.enabled && (event.text == " " || event.text == "\n") {
            root.toggled(!root.checked); return accept;
        }
        return reject;
    }
    Rectangle {
        y: (parent.height - 31px * LumenUiScale.factor) / 2; width: parent.width; height: 31px * LumenUiScale.factor;
        border-radius: self.height / 2;
        background: root.checked ? LumenTheme.preference-accent : LumenTheme.preference-off;
        border-width: 0px * LumenUiScale.factor;
        Rectangle {
            x: root.checked ? parent.width - self.width - 4px * LumenUiScale.factor : 4px * LumenUiScale.factor;
            y: (parent.height - self.height) / 2;
            width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; border-radius: 11px * LumenUiScale.factor; background: #FFFFFF;
        }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #AF52DE; }
}

export component AppColorSlider inherits FocusScope {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <brush> track-brush: LumenTheme.surface-muted;
    in property <color> fill-color: LumenTheme.accent;
    in property <string> accessible-name;
    callback value-changed(value: float);
    callback released(value: float);
    property <float> progress: clamp((root.value - root.minimum) / max(0.001, root.maximum - root.minimum), 0, 1);
    min-height: 48px * LumenUiScale.factor;
    preferred-height: 48px * LumenUiScale.factor;
    accessible-role: slider;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(value) => {
        if value.is-float() && root.enabled {
            root.value = clamp(round(value.to-float() / root.step) * root.step, root.minimum, root.maximum);
            root.value-changed(root.value);
            root.released(root.value);
        }
    }
    key-pressed(event) => {
        if root.enabled && (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
            root.value = max(root.minimum, root.value - root.step);
            root.value-changed(root.value);
            root.released(root.value);
            return accept;
        }
        if root.enabled && (event.text == Key.RightArrow || event.text == Key.UpArrow) {
            root.value = min(root.maximum, root.value + root.step);
            root.value-changed(root.value);
            root.released(root.value);
            return accept;
        }
        return reject;
    }
    Rectangle {
        y: (parent.height - 31px * LumenUiScale.factor) / 2;
        width: parent.width; height: 31px * LumenUiScale.factor; border-radius: self.height / 2;
        background: root.track-brush;
        Rectangle {
            width: parent.width * root.progress; height: parent.height; border-radius: self.height / 2;
            background: root.fill-color;
        }
        Rectangle {
            x: clamp(parent.width * root.progress - self.width / 2, 2px * LumenUiScale.factor, max(2px * LumenUiScale.factor, parent.width - self.width - 2px * LumenUiScale.factor));
            y: (parent.height - self.height) / 2;
            width: 23px * LumenUiScale.factor; height: 23px * LumenUiScale.factor;
            border-radius: self.width / 2; background: #FFFFFF;
        }
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        changed pressed => {
            if self.pressed && parent.width > 0px {
                root.value = clamp(root.minimum + self.mouse_x / parent.width * (root.maximum - root.minimum), root.minimum, root.maximum);
                root.value-changed(root.value);
            } else if !self.pressed {
                root.released(root.value);
            }
        }
        moved => {
            if self.pressed && parent.width > 0px {
                root.value = clamp(root.minimum + self.mouse_x / parent.width * (root.maximum - root.minimum), root.minimum, root.maximum);
                root.value-changed(root.value);
            }
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #AF52DE; }
}

export component AppPreferenceRow inherits FocusScope {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    in property <string> unavailable;
    in property <string> state-description;
    in property <bool> capability-enabled: true;
    in property <bool> toggle: false;
    in property <bool> checked: false;
    in property <bool> expand: false;
    in property <image> icon: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg");
    callback clicked();
    callback toggled(bool);
    min-height: max(root.detail == "" ? 66px * LumenUiScale.factor : 82px * LumenUiScale.factor, words.min-height + 24px * LumenUiScale.factor);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-action-default => {
        if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
        else { root.clicked(); }
    }
    key-pressed(event) => {
        if event.text == " " || event.text == "\n" {
            if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
            else { root.clicked(); }
            return accept;
        }
        return reject;
    }
    accessible-label: root.label + (root.detail == "" ? "" : "，" + root.detail) + (root.unavailable == "" ? "" : "，" + root.unavailable) + (root.state-description == "" ? "" : "，" + root.state-description);
    row := HorizontalLayout {
        width: parent.width; height: parent.height; spacing: 10px * LumenUiScale.factor;
        cross-axis-alignment: center;
        words := VerticalLayout {
            spacing: 2px * LumenUiScale.factor; alignment: center; horizontal-stretch: 1;
            title := Text { text: root.label; font-size: LumenTheme.preference-text-size; color: LumenTheme.text-primary; wrap: word-wrap; }
            if root.detail != "": Text {
                text: root.detail; font-size: 14px * LumenUiScale.factor; color: LumenTheme.text-secondary;
                overflow: elide; accessible-label: root.detail;
            }
        }
        if root.toggle: AppPreferenceSwitch {
            checked: root.checked; enabled: root.capability-enabled; label: root.label + " " + root.unavailable;
            toggled(value) => { root.toggled(value); }
        }
        if !root.toggle && root.value != "": Text {
            text: root.value; font-size: 18px * LumenUiScale.factor; color: LumenTheme.text-secondary;
            vertical-alignment: center; horizontal-stretch: 0;
        }
        if !root.toggle: trailing-icon := Image {
            source: root.expand ? @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-expand.svg") : root.icon;
            width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; image-fit: contain;
            colorize: root.expand || root.icon == @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg") ? LumenTheme.text-secondary : LumenTheme.preference-accent;
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #007AFF; }
        }
    }
    TouchArea { enabled: !root.toggle || !root.capability-enabled; clicked => { root.clicked(); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #00A6A6; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: words.x; y: words.y; width: words.width; height: words.height; outline-color: #FF9500; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: title.x + words.x; y: title.y + words.y; width: title.width; height: title.height; outline-color: #007AFF; }
}

export component AppPreferenceGroup inherits Rectangle {
    in property <string> heading;
    min-height: group-layout.min-height;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    group-layout := VerticalLayout {
        spacing: 10px * LumenUiScale.factor; padding-top: 12px * LumenUiScale.factor; alignment: start;
        Text { x: 18px * LumenUiScale.factor; text: root.heading; font-size: 16px * LumenUiScale.factor; color: LumenTheme.preference-accent; height: 24px * LumenUiScale.factor; vertical-alignment: center; }
        surface := Rectangle {
            background: LumenTheme.surface; border-radius: LumenTheme.preference-card-radius;
            min-height: contents.min-height; preferred-height: self.min-height; vertical-stretch: 0;
            contents := VerticalLayout {
                x: 18px * LumenUiScale.factor; width: max(0px * LumenUiScale.factor, parent.width - 36px * LumenUiScale.factor);
                padding-top: 0px * LumenUiScale.factor; padding-bottom: 0px * LumenUiScale.factor; spacing: 0px * LumenUiScale.factor; alignment: start;
                @children
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
            if LumenTheme.show-layout-bounds: LayoutOutline { x: contents.x; y: contents.y; width: contents.width; height: contents.height; outline-color: #34C759; }
        }
    }
}

export component LightRoundedInput inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    height: 50px * LumenUiScale.factor;
    border-radius: 25px * LumenUiScale.factor;
    background: LumenTheme.surface-muted;
    TextInput {
        x: 20px * LumenUiScale.factor;
        width: parent.width - 40px * LumenUiScale.factor;
        height: parent.height;
        text <=> root.text;
        input-type: root.password ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: 17px * LumenUiScale.factor;
        vertical-alignment: center;
        accessible-label: root.label;
    }
    if root.text == "": Text {
        x: 20px * LumenUiScale.factor;
        width: parent.width - 40px * LumenUiScale.factor;
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: 17px * LumenUiScale.factor;
        vertical-alignment: center;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 20px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: max(0px * LumenUiScale.factor, parent.width - 40px * LumenUiScale.factor); height: parent.height - 8px * LumenUiScale.factor;
        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component RoundedInputField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    in property <bool> password: false;
    callback edited(string);
    height: 50px * LumenUiScale.factor;
    border-radius: 25px * LumenUiScale.factor;
    background: LumenTheme.surface-muted;
    TextInput {
        x: 20px * LumenUiScale.factor; y: 0px * LumenUiScale.factor;
        width: max(0px * LumenUiScale.factor, parent.width - 40px * LumenUiScale.factor);
        height: parent.height;
        text <=> root.text;
        input-type: root.password ? InputType.password : InputType.text;
        color: LumenTheme.text-primary;
        font-size: 18px * LumenUiScale.factor;
        vertical-alignment: center;
        accessible-label: root.label;
        edited => { root.edited(root.text); }
    }
    if root.text == "": Text {
        x: 20px * LumenUiScale.factor;
        width: max(0px * LumenUiScale.factor, parent.width - 40px * LumenUiScale.factor);
        height: parent.height;
        text: root.label;
        color: LumenTheme.text-secondary;
        font-size: 18px * LumenUiScale.factor;
        vertical-alignment: center;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 20px * LumenUiScale.factor; y: 4px * LumenUiScale.factor; width: max(0px * LumenUiScale.factor, parent.width - 40px * LumenUiScale.factor); height: parent.height - 8px * LumenUiScale.factor;
        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #00A6A6;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <image> icon;
    in property <string> badge: "";
    callback clicked();
    background: transparent;
    min-height: 72px * LumenUiScale.factor;
    preferred-height: content-layout.preferred-height;
    content-layout := VerticalLayout {
        x: 0px * LumenUiScale.factor; width: parent.width;
        padding-top: 4px * LumenUiScale.factor; padding-bottom: 4px * LumenUiScale.factor;
        HorizontalLayout {
            spacing: 14px * LumenUiScale.factor;
            Rectangle {
                width: 40px * LumenUiScale.factor; height: 40px * LumenUiScale.factor; border-radius: 13px * LumenUiScale.factor;
                background: LumenTheme.accent;
                Image { x: 8px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; source: root.icon; width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; image-fit: contain; }
                if LumenTheme.show-layout-bounds: Rectangle {
                    x: 8px * LumenUiScale.factor; y: 8px * LumenUiScale.factor; width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor;
                    background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #007AFF;
                }
            }
            VerticalLayout {
                vertical-stretch: 1; alignment: center; spacing: 3px * LumenUiScale.factor;
                Text { text: root.label; color: LumenTheme.text-primary; font-size: 17px * LumenUiScale.factor; font-weight: 600; wrap: word-wrap; }
                Text { text: root.detail; color: LumenTheme.text-secondary; font-size: 14px * LumenUiScale.factor; wrap: word-wrap; }
            }
            if root.badge != "": Rectangle {
                width: 72px * LumenUiScale.factor; height: 30px * LumenUiScale.factor; border-radius: 15px * LumenUiScale.factor; background: LumenTheme.accent-soft;
                Text { text: root.badge; width: parent.width; height: parent.height; color: LumenTheme.accent; font-size: 14px * LumenUiScale.factor; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Image { source: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-right.svg"); width: 22px * LumenUiScale.factor; height: 22px * LumenUiScale.factor; image-fit: contain; vertical-alignment: center; }
        }
    }
    TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: #FF2D55; }
}
