import { DesignType } from "./design-type.slint";
import { IconButton, Switch } from "@material";
import { FlagIcon } from "../lumen-flags.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";
import { LayoutOutline } from "base_widgets.slint";
import { RouteMode } from "./domain_enums.slint";
import { CardHeight } from "./card_height.slint";

export component SectionCard inherits Rectangle {
    in property <string> heading;
    in property <string> detail;
    // How tall this card is. A content card is exactly as tall as what it
    // holds; a page-body card is the page's frame, so the list inside it
    // scrolls and the page never shows empty ground under a short card.
    in property <CardHeight> height-mode: CardHeight.content;
    in property <length> content-spacing: LumenTheme.card-content-gap;
    in property <length> inset: LumenTheme.card-inset;
    in property <length> vertical-padding: LumenTheme.card-vertical-padding;
    in property <length> radius: LumenTheme.card-radius;
    vertical-stretch: 0;
    min-height: root.height-mode == CardHeight.page-body ? LumenTheme.page-body-height : card-layout.min-height;
    preferred-height: card-layout.min-height;
    border-radius: root.radius;
    background: LumenTheme.zinc-3;
    // #151/#152: ambient diffuse shadow plus the 1px inner hairline.
    drop-shadow-blur: LumenTheme.shadow-ambient-blur;
    drop-shadow-offset-y: LumenTheme.shadow-ambient-offset-y;
    drop-shadow-color: LumenTheme.shadow-ambient-color;
    border-width: 1 * LumenUiScale.unit;
    border-color: LumenTheme.hairline-glow;
    card-layout := VerticalLayout {
        x: root.inset; y: 0 * LumenUiScale.unit; width: parent.width - 2 * root.inset;
        // The frame owns the card's whole height. A content card is exactly
        // as tall as its content, so this changes nothing for it. A page-body
        // card is as tall as the page body, and the scrolling body under the
        // toolbar takes the leftover height.
        height: parent.height;
        padding-top: root.vertical-padding; padding-bottom: root.vertical-padding;
        spacing: root.content-spacing;
        // The frame's own height is the space the body may use. A content
        // card hands out no slack, so this changes nothing for it. A
        // page-body card gives the leftover to its scrolling body, which is
        // the one child that asks to grow.
        alignment: stretch;
        if heading != "": Text { text: heading; width: parent.width; color: LumenTheme.text-primary; font-size: DesignType.subheading-size; font-weight: DesignType.subheading-weight; wrap: word-wrap; vertical-stretch: 0; }
        if detail != "": Text { text: detail; width: parent.width; color: LumenTheme.text-secondary; font-size: DesignType.label-size; wrap: word-wrap; vertical-stretch: 0; }
        @children
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

// The heading of one section in a grouped list.
//
// It owns the air above and below itself instead of leaving it to the list's
// uniform spacing: a heading that sits 8dp above its card and 8dp below the
// previous card reads as another row of the list, not as a section. The
// reference spends 27dp above and 17dp below, so the heading owns both.
export component SectionHeading inherits Rectangle {
    in property <string> text;
    in property <length> gap-above: LumenTheme.space-mobile-section-head-above;
    in property <length> gap-below: LumenTheme.space-mobile-section-head-below;
    vertical-stretch: 0;
    min-height: self.gap-above + label.preferred-height + self.gap-below;
    preferred-height: self.min-height;
    label := Text {
        x: 0 * LumenUiScale.unit; y: root.gap-above;
        width: parent.width;
        text: root.text;
        color: LumenTheme.text-secondary;
        font-size: DesignType.bodyStrong-size;
        font-weight: DesignType.bodyStrong-weight;
    }
}

export component SurfaceCard inherits Rectangle {
    in property <length> inset: LumenTheme.card-inset;
    vertical-stretch: 0;
    min-height: content.min-height;
    preferred-height: content.min-height;
    border-radius: LumenTheme.card-radius;
    background: LumenTheme.zinc-3;
    // #151/#152: key shadow (one tier up from SectionCard's ambient) and
    // the inner hairline.
    drop-shadow-blur: LumenTheme.shadow-key-blur;
    drop-shadow-offset-y: LumenTheme.shadow-key-offset-y;
    drop-shadow-color: LumenTheme.shadow-key-color;
    border-width: 1 * LumenUiScale.unit;
    border-color: LumenTheme.hairline-glow;

    content := VerticalLayout {
        // The inset is applied by the layout's own padding, so the content
        // box is inset on BOTH sides. Binding `width` by hand only ever
        // moved the content to the right of the card, which let a trailing
        // control (a switch) cross the card's own border.
        width: parent.width;
        padding-left: root.inset;
        padding-right: root.inset;
        padding-top: root.inset;
        padding-bottom: root.inset;
        spacing: LumenTheme.card-content-gap;
        alignment: stretch;
        @children
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component SummaryRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    in property <bool> emphasized;
    // A summary row is a fact, not a target: the optional `actionable`
    // TouchArea and its `clicked` callback were wired to nothing - no caller
    // ever set the flag or bound the handler - so the affordance is gone
    // rather than kept as a knob nobody can turn.
    min-height: 48 * LumenUiScale.unit;
    preferred-height: 48 * LumenUiScale.unit;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: LumenTheme.space-3;
        if root.icon.width > 0 && root.icon.height > 0: Image {
            source: root.icon;
            width: 22 * LumenUiScale.unit;
            height: 22 * LumenUiScale.unit;
            image-fit: contain;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: LumenTheme.text-secondary;
            font-size: LumenTheme.supporting-size;
            horizontal-stretch: 0;
            vertical-alignment: center;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            color: root.value == "" ? LumenTheme.text-muted : (root.emphasized ? LumenTheme.accent : LumenTheme.text-primary);
            font-size: LumenTheme.body-size;
            // SLINTUI-007 #31: metric values ride the mono family.
            font-family: DesignType.mono-family;
            font-weight: DesignType.mono-weight;
            min-width: 0 * LumenUiScale.unit;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            accessible-label: root.value == "" ? @tr("未设定") : root.value;
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <length> badge-width: 96 * LumenUiScale.unit;
    width: badge-width;
    height: 32 * LumenUiScale.unit;
    border-radius: 16 * LumenUiScale.unit;
    background: active ? LumenTheme.status-running-soft : LumenTheme.surface-muted;
    HorizontalLayout {
        x: 11 * LumenUiScale.unit; width: parent.width - 22 * LumenUiScale.unit; height: parent.height; spacing: 7 * LumenUiScale.unit;
        alignment: center;
        Rectangle { width: 8 * LumenUiScale.unit; height: 8 * LumenUiScale.unit; y: (parent.height - self.height) / 2; border-radius: 4 * LumenUiScale.unit; background: root.active ? LumenTheme.status-running : LumenTheme.text-secondary; }
        Text { text: root.label; color: root.active ? LumenTheme.status-running : LumenTheme.text-secondary; font-size: DesignType.captionStrong-size; font-weight: DesignType.captionStrong-weight; font-family: DesignType.captionStrong-family; height: parent.height; vertical-alignment: center; overflow: elide; }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component HomeProfileBadge inherits Rectangle {
    in property <string> profile-name;
    in property <RouteMode> route-mode;
    in property <length> badge-width;
    width: badge-width; height: 32 * LumenUiScale.unit; border-radius: 16 * LumenUiScale.unit;
    background: LumenTheme.surface-raised; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.hairline-glow;
    HorizontalLayout {
        padding-left: 12 * LumenUiScale.unit; padding-right: 12 * LumenUiScale.unit;
        height: parent.height; spacing: 6 * LumenUiScale.unit; cross-axis-alignment: center;
        Text {
            text: root.profile-name; color: LumenTheme.text-primary;
            font-size: DesignType.caption-size; font-weight: DesignType.caption-weight; font-family: DesignType.caption-family;
            horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
        }
        Text { text: "•"; color: LumenTheme.accent-active; font-size: DesignType.caption-size; vertical-alignment: center; }
        Text {
            text: root.route-mode == RouteMode.rule ? @tr("规则") : root.route-mode == RouteMode.global ? @tr("全局") : @tr("直连");
            color: LumenTheme.accent-active; font-size: DesignType.captionStrong-size; font-weight: DesignType.captionStrong-weight; font-family: DesignType.captionStrong-family; vertical-alignment: center;
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component HomeStatusChip inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    in property <length> min-chip-width: 0 * LumenUiScale.unit;
    width: max(root.min-chip-width, chip-label.preferred-width + 48 * LumenUiScale.unit);
    height: 32 * LumenUiScale.unit;
    border-radius: 16 * LumenUiScale.unit;
    background: active ? LumenTheme.accent-soft : LumenTheme.surface-muted;
    HorizontalLayout {
        x: 12 * LumenUiScale.unit;
        width: max(0 * LumenUiScale.unit, parent.width - 24 * LumenUiScale.unit);
        height: parent.height;
        spacing: 6 * LumenUiScale.unit;
        Image { source: root.icon; width: 18 * LumenUiScale.unit; height: 18 * LumenUiScale.unit; y: (parent.height - self.height) / 2; image-fit: contain; }
        chip-label := Text {
            text: root.label;
            color: root.active ? LumenTheme.accent : LumenTheme.text-secondary;
            font-size: DesignType.label-size;
            horizontal-stretch: 1;
            height: parent.height;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 12 * LumenUiScale.unit; y: 7 * LumenUiScale.unit; width: 18 * LumenUiScale.unit; height: 18 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
    }
    if LumenTheme.show-layout-bounds: Rectangle {
        x: 36 * LumenUiScale.unit; y: 2 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 48 * LumenUiScale.unit); height: 28 * LumenUiScale.unit;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-content;
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component HomeRoundActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    callback clicked();
    width: 48 * LumenUiScale.unit;
    height: 48 * LumenUiScale.unit;
    background: transparent;
    action := TouchArea {
        width: parent.width;
        height: parent.height;
        accessible-role: button;
        accessible-label: root.accessible-name;
        clicked => { root.clicked(); }
    }
    face := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: action.pressed ? 32 * LumenUiScale.unit : 36 * LumenUiScale.unit;
        height: action.pressed ? 32 * LumenUiScale.unit : 36 * LumenUiScale.unit;
        border-radius: self.height / 2;
        background: action.pressed ? LumenTheme.accent.with_alpha(24%) : LumenTheme.accent-soft;
        animate width, height, x, y, background { duration: 120ms; easing: ease-out; }
        Image { source: root.icon; width: 18 * LumenUiScale.unit; height: 18 * LumenUiScale.unit; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; image-fit: contain; }
        if LumenTheme.show-layout-bounds: Rectangle {
            x: (parent.width - 18 * LumenUiScale.unit) / 2; y: (parent.height - 18 * LumenUiScale.unit) / 2; width: 18 * LumenUiScale.unit; height: 18 * LumenUiScale.unit;
            background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export component HomeActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> running;
    in property <bool> busy;
    callback clicked();
    min-width: 120 * LumenUiScale.unit;
    preferred-width: 136 * LumenUiScale.unit;
    height: 48 * LumenUiScale.unit;
    background: transparent;
    action := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.busy;
        clicked => { root.clicked(); }
    }
    face := Rectangle {
        x: action.pressed ? 2 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        y: action.pressed ? 10 * LumenUiScale.unit : 8 * LumenUiScale.unit;
        width: action.pressed ? parent.width - 4 * LumenUiScale.unit : parent.width;
        height: action.pressed ? 28 * LumenUiScale.unit : 32 * LumenUiScale.unit;
        border-radius: self.height / 2;
        background: root.running ? LumenTheme.accent.with_alpha(16%) : LumenTheme.accent-soft;
        animate x, y, width, height { duration: 110ms; easing: ease-out; }
        animate background { duration: 160ms; easing: ease-in-out; }
        action-content := HorizontalLayout {
            x: 9 * LumenUiScale.unit;
            width: parent.width - 18 * LumenUiScale.unit;
            height: parent.height;
            spacing: 6 * LumenUiScale.unit;
            cross-axis-alignment: center;
            action-icon := Image {
                source: root.running
                    ? @image-url("../../../infiltrator-shared/assets/ui/iced/svg/square.svg")
                    : @image-url("../../../infiltrator-shared/assets/ui/iced/svg/zap.svg");
                width: 16 * LumenUiScale.unit;
                height: 16 * LumenUiScale.unit;
                image-fit: contain;
                colorize: LumenTheme.accent;
            }
            action-label := Text {
                text: root.label;
                color: LumenTheme.accent;
                font-size: DesignType.label-size;
                horizontal-stretch: 1;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if LumenTheme.show-layout-bounds: Rectangle {
            x: action-content.x + action-icon.x; y: action-icon.y;
            width: action-icon.width; height: action-icon.height;
            background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
        }
        if LumenTheme.show-layout-bounds: Rectangle {
            x: action-content.x + action-label.x; y: action-label.y;
            width: action-label.width; height: action-label.height;
            background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-content;
        }
        if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
    }
}

export component SheetActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> button-height: 56 * LumenUiScale.unit;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    height: button-height;
    border-radius: self.height / 2;
    background: root.danger ? LumenTheme.error : (root.primary ? LumenTheme.accent : LumenTheme.surface-muted);
    action := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
    Text {
        x: 16 * LumenUiScale.unit;
        width: parent.width - 32 * LumenUiScale.unit;
        height: parent.height;
        text: root.label;
        color: (root.danger || root.primary) ? LumenTheme.accent-foreground : LumenTheme.text-primary;
        font-size: DesignType.subheading-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    states [
        pressed when action.pressed: {
            background: root.danger ? LumenTheme.error.with_alpha(82%) : (root.primary ? LumenTheme.accent.with_alpha(82%) : LumenTheme.surface-muted.with_alpha(80%));
            in-out { animate background { duration: 120ms; easing: ease-in-out; } }
        }
    ]
}

export component ProfileSheetTitle inherits Rectangle {
    in property <string> title;
    callback close();
    callback confirm();
    height: 48 * LumenUiScale.unit;
    background: transparent;
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: LumenTheme.space-1;
        IconButton {
            width: 44 * LumenUiScale.unit; height: 44 * LumenUiScale.unit;
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/x.svg");
            tooltip: @tr("关闭");
            clicked => { root.close(); }
        }
        Text {
            text: root.title;
            color: LumenTheme.text-primary;
            font-size: DesignType.title-size;
            font-weight: DesignType.title-weight;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        IconButton {
            width: 44 * LumenUiScale.unit; height: 44 * LumenUiScale.unit;
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/square.svg");
            tooltip: @tr("保存");
            clicked => { root.confirm(); }
        }
    }
}

export component ProxyGroupCard inherits Rectangle {
    in property <string> group-name;
    in property <string> group-icon-emoji;
    in property <string> group-kind;
    in property <string> current-node;
    in property <string> current-flag-code;
    in property <int> current-flag-index;
    in property <string> current-accessible;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> runtime-running;
    in property <bool> testing;
    in property <bool> has-nodes;
    callback clicked();
    callback test-current();
    min-height: group-layout.min-height;
    preferred-height: group-layout.min-height;
    border-radius: LumenTheme.radius-card;
    background: (group-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-5 : LumenTheme.zinc-3;
    border-width: 1 * LumenUiScale.unit;
    border-color: (group-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.border : LumenTheme.hairline-glow;
    animate background, border-color { duration: 120ms; easing: ease-out; }
    group-touch := TouchArea { width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { root.clicked(); } }
    group-layout := VerticalLayout {
        x: LumenTheme.space-4; width: parent.width - 2 * LumenTheme.space-4;
        padding-top: 0 * LumenUiScale.unit; padding-bottom: LumenTheme.space-3;
        spacing: 0 * LumenUiScale.unit; alignment: start;
        HorizontalLayout {
            height: 48 * LumenUiScale.unit;
            spacing: LumenTheme.space-2;
            vertical-stretch: 0;
            if root.group-icon-emoji != "": Text {
                text: root.group-icon-emoji;
                font-size: DesignType.title-size;
                width: 24 * LumenUiScale.unit;
                height: parent.height;
                vertical-alignment: center;
            }
            Text {
                text: root.group-name;
                color: LumenTheme.text-primary;
                font-size: DesignType.subheading-size;
                font-weight: DesignType.subheading-weight;
                height: parent.height;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
                accessible-label: root.group-name;
            }
            Rectangle {
                width: max(68 * LumenUiScale.unit, kind-label.preferred-width + 20 * LumenUiScale.unit);
                height: 28 * LumenUiScale.unit;
                border-radius: 14 * LumenUiScale.unit;
                background: LumenTheme.accent-soft;
                HorizontalLayout {
                    alignment: center; cross-axis-alignment: center;
                    kind-label := Text {
                        text: root.group-kind; color: LumenTheme.accent;
                        font-size: DesignType.caption-size; font-weight: DesignType.caption-weight; vertical-alignment: center;
                    }
                }
            }
            IconButton {
                width: LumenTheme.min-touch-target;
                height: LumenTheme.min-touch-target;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/zap.svg");
                tooltip: root.testing ? @tr("正在测试组内节点…") : @tr("测试策略组全部节点");
                enabled: root.has-nodes && !root.testing;
                clicked => { root.test-current(); }
            }
        }
        Rectangle {
            height: 36 * LumenUiScale.unit;
            border-radius: 18 * LumenUiScale.unit;
            background: LumenTheme.surface-muted;
            HorizontalLayout {
                padding-left: LumenTheme.space-3;
                padding-right: LumenTheme.space-3;
                width: parent.width;
                height: parent.height;
                spacing: LumenTheme.space-2;
                cross-axis-alignment: center;
                if root.current-flag-code != "": FlagIcon { country-code: root.current-flag-code; index: root.current-flag-index; }
                Text { text: root.current-node == "" ? @tr("暂无可用节点") : root.current-node; accessible-label: root.current-accessible; color: LumenTheme.text-primary; font-size: DesignType.label-size; horizontal-stretch: 1; horizontal-alignment: left; vertical-alignment: center; overflow: elide; }
                Image { source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg"); width: 22 * LumenUiScale.unit; height: 22 * LumenUiScale.unit; image-fit: contain; colorize: LumenTheme.text-secondary; vertical-alignment: center; }
            }
        }
    }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
}

export { ProfileCardSurface } from "profile_card.slint";
