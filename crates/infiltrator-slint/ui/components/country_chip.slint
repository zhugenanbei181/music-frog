import { DesignType, TextRole } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";
import { FlagIcon } from "../lumen-flags.slint";

// The one owner of a country's identity chip: the flag's own rectangle, or the
// country code on that same rectangle when no flag resolved.
//
// A flag is rectangular artwork, so the chip is the plate - not a ground the
// plate sits inside. Both halves of that were once wrong here: the two home
// rows each painted a private circle around the plate, and the chip that
// replaced them was a square whose ground still showed as two bands above and
// below the 36x26 plate, which read as a medallion rather than as a country.
// Then the inventory itself still baked a 4-of-36 corner into every asset, and
// that corner still read as a container. The shared assets are now full-bleed
// 4:3 artwork with square corners: the chip takes that exact rectangle,
// declares no corner of its own, and paints a ground only in the code fallback
// - a resolved flag is the whole visual.
export component CountryChip inherits Rectangle {
    in property <length> side: 38 * LumenUiScale.unit;
    // The owner's resolved flag; negative is "no flag resolved", which is the
    // only state that paints the code, and the only state that paints ground.
    in property <int> flag-index: -1;
    in property <string> country-code;
    // The row that holds the chip decides how large its code reads.
    in property <TextRole> code-role: TextRole.label;

    // The plate's own 4:3 geometry, in the artwork's own numbers.
    private property <length> plate-height: root.side * 3 / 4;

    width: root.side;
    height: root.plate-height;
    background: root.flag-index >= 0 ? transparent : LumenTheme.zinc-4;
    if root.flag-index >= 0: FlagIcon {
        index: root.flag-index;
        country-code: root.country-code;
        size: root.side;
    }
    if root.flag-index < 0: Text {
        text: root.country-code != "" ? root.country-code.to_uppercase() : "—";
        color: LumenTheme.text-primary;
        font-size: DesignType.size(root.code-role);
        font-weight: DesignType.weight(root.code-role);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
