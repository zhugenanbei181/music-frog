export struct ProfileCard {
    id: string,
    name: string,
    kind: string,
    location: string,
    updated: string,
    current: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct ProfileOverrideChoice {
    id: string,
    name: string,
    format: string,
    selected: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct ProxyGroup {
    name: string,
    icon-emoji: string,
    kind: string,
    current: string,
    current-flag-code: string,
    current-flag-index: int,
    current-accessible: string,
    nodes: string,
}

export struct OverrideCard {
    id: string,
    name: string,
    kind: string,
    format: string,
    bound-count: string,
}

export struct ObservationRow {
    id: string,
    title: string,
    accessible-title: string,
    flag-code: string,
    flag-index: int,
    delay-ms: int,
    subtitle: string,
    trailing: string,
    active: bool,
}

export struct TrafficBar {
    label: string,
    detail-label: string,
    download: string,
    upload: string,
    download-fraction: float,
    upload-fraction: float,
}

export struct HomeTrafficPoint {
    download-fraction: float,
    upload-fraction: float,
}

export struct LicenseRow {
    id: string,
    name: string,
    version: string,
    identifier: string,
}

// One reorderable Overview card slot.
//
// The order of the slots is the order the shared owner published, so the
// surface never keeps a copy of the card order of its own.
export struct OverviewCardSlot {
    id: string,
    title: string,
    can-move-up: bool,
    can-move-down: bool,
}

// One rendered cell of a workbench page. The surface renders a flat list of
// these cells so every business of a page shares one carrier.
export struct WorkbenchItem {
    id: string,
    kind: string,
    title: string,
    status: string,
    detail: string,
    trailing: string,
    tone: string,
    label: string,
    enabled: bool,
    action-id: string,
    row-id: string,
}
