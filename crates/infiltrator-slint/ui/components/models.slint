import { LumenTheme } from "./theme.slint";

export struct ProfileCard {
    id: string,
    name: string,
    kind: string,
    location: string,
    updated: string,
    current: bool,
    can-move-up: bool,
    can-move-down: bool,
    has-quota: bool,
    used-text: string,
    total-text: string,
    expire-text: string,
    usage-fraction: float,
    quota-grade: string,
}

export struct ProfileOverrideChoice {
    id: string,
    name: string,
    format: string,
    selected: bool,
    can-move-up: bool,
    can-move-down: bool,
}

export struct ProxyGroup {
    name: string,
    icon-emoji: string,
    kind: string,
    current: string,
    current-flag-code: string,
    current-flag-index: int,
    current-accessible: string,
    nodes: string,
}

export struct OverrideCard {
    id: string,
    name: string,
    kind: string,
    format: string,
    bound-count: string,
}

export struct ObservationRow {
    id: string,
    title: string,
    accessible-title: string,
    flag-code: string,
    flag-index: int,
    // The graded latency: the value text and the colour the contract's
    // `LatencyGrade` ladder names for it, both decided once in the projection.
    // Raw milliseconds deliberately do not travel with the row — a widget that
    // can see them can start grading them again, which is how `PingBadge` came
    // to disagree with the shared ladder.
    latency-ink: color,
    subtitle: string,
    trailing: string,
    // The two rate facts of a connection row are typed, separate columns.
    // `trailing` is still the display sentence for the other observation
    // lists (logs, rules, providers, nodes); only a connection row fills
    // these, and the connections widget renders them as two fixed-width,
    // right-aligned columns. One concatenated right-aligned sentence made
    // every digit share an edge that moved with the length of the value
    // (measured 14-21px drift between six rows).
    upload-rate: string,
    download-rate: string,
    active: bool,
}

// One row of the dashboard's live-connection table. Every field is
// preformatted by the shared projection from owner facts; the widget only
// places text, so no column can re-derive its own value.
export struct ConnectionRow {
    source: string,
    destination: string,
    protocol: string,
    outbound: string,
    download: string,
    upload: string,
    duration: string,
}

export struct TrafficBar {
    label: string,
    detail-label: string,
    download: string,
    upload: string,
    download-fraction: float,
    upload-fraction: float,
}

export struct HomeTrafficPoint {
    download-fraction: float,
    upload-fraction: float,
}

export struct LicenseRow {
    id: string,
    name: string,
    version: string,
    identifier: string,
}

// One reorderable Overview card slot.
//
// The order of the slots is the order the shared owner published, so the
// surface never keeps a copy of the card order of its own.
export struct OverviewCardSlot {
    id: string,
    title: string,
    can-move-up: bool,
    can-move-down: bool,
}

// One desktop sidebar destination. The projection publishes the typed
// registry from the shared contract; the rail renders the list and owns no
// destination, label, group or icon of its own. `group` is a typed id, not a
// second copy of the heading text.
export struct NavigationSlot {
    id: string,
    label: string,
    group: string,
    group-label: string,
    icon: string,
}

// A fact cell as the shared contract typed it: the value, whether an owner
// published it, how it is typeset and which edge of its column it hugs. The
// surface renders the cell; it never invents a fallback value and never
// picks a second type role for the row.
export enum FactAlignment {
    start,
    end,
}

export struct FactCell {
    value: string,
    observed: bool,
    alignment: FactAlignment,
}

export global FactCellDefaults {
    // The one honest shape of a fact nobody has observed: the shared marker,
    // flagged as unobserved so the surface can mute it.
    out property <FactCell> value: {
        value: "—",
        observed: false,
        alignment: FactAlignment.start,
    };
}

// High-density dashboard facts projected from the shared owner snapshots
// (DashboardHeroProjection, QuickSwitchesProjection, ServiceHealthMatrixProjection,
// MemoryInfoCardProjection, ProfileQuickCardProjection). The UI surfaces
// bind exclusively to these typed fields; no component may hardcode facts.
export struct DashboardFacts {
    // Hero card facts
    quality-tag: string,
    // The hero card's bottom fact row, typed by the shared contract: one
    // cell per fact, so a value can never slide onto the other column.
    hero-fact-uptime: FactCell,
    hero-fact-organization: FactCell,
    // Traffic card facts
    traffic-peak-up: string,
    traffic-peak-down: string,
    // Cumulative traffic, formatted once by the owner projection.
    traffic-total-up: string,
    traffic-total-down: string,
    // Live connection mini table counters
    connection-count: string,
    request-count: string,
    dns-query-count: string,
    // LAN share facts
    lan-ip: string,
    lan-shared: bool,
    // Profile quick card facts
    profile-groups-count: int,
    profile-proxies-count: int,
    profile-rules-count: int,
    profile-updated-relative: string,
    // Service health latencies (empty/dash when unobserved)
    latency-google: string,
    latency-github: string,
    latency-youtube: string,
    latency-openai: string,
    // One honest summary of the four probes: never a hardcoded "全部可用".
    services-summary: string,
    // One owner-graded color per service, from the shared latency ladder.
    latency-google-color: color,
    latency-github-color: color,
    latency-youtube-color: color,
    latency-openai-color: color,
    // Memory consumption
    memory-total: string,
    // The owner publishes one core memory reading plus its soft limit, so the
    // card shows that pair. An app/kernel split would be a second, invented
    // truth: no owner readback reports one.
    memory-limit: string,
    memory-fraction: float,
    // Observed CPU load, formatted once by the owner projection.
    cpu-text: string,
    cpu-fraction: float,
    // SVG path commands for the two speed sparklines, derived from the
    // owner's waveform samples. Empty while no sample has arrived.
    upload-wave: string,
    download-wave: string,
}

// The dashboard facts before the owner's first readback. Every field is an
// explicit "not observed" placeholder: the surface never opens with a
// fabricated number, a fabricated address or a fabricated latency.
export global DashboardFactsDefaults {
    out property <DashboardFacts> value: {
        quality-tag: "—",
        hero-fact-uptime: FactCellDefaults.value,
        hero-fact-organization: FactCellDefaults.value,
        traffic-peak-up: "—",
        traffic-peak-down: "—",
        traffic-total-up: "—",
        traffic-total-down: "—",
        connection-count: "—",
        request-count: "—",
        dns-query-count: "—",
        lan-ip: "—",
        lan-shared: false,
        profile-groups-count: 0,
        profile-proxies-count: 0,
        profile-rules-count: 0,
        profile-updated-relative: "—",
        latency-google: "—",
        latency-github: "—",
        latency-youtube: "—",
        latency-openai: "—",
        services-summary: "未观测",
        latency-google-color: LumenTheme.text-muted,
        latency-github-color: LumenTheme.text-muted,
        latency-youtube-color: LumenTheme.text-muted,
        latency-openai-color: LumenTheme.text-muted,
        memory-total: "—",
        memory-limit: "—",
        memory-fraction: 0,
        cpu-text: "—",
        cpu-fraction: 0,
        upload-wave: "",
        download-wave: "",
    };
}

// One rendered cell of a workbench page. The surface renders a flat list of
// these cells so every business of a page shares one carrier.
export struct WorkbenchItem {
    id: string,
    kind: string,
    title: string,
    status: string,
    detail: string,
    trailing: string,
    tone: string,
    label: string,
    enabled: bool,
    action-id: string,
    row-id: string,
}
