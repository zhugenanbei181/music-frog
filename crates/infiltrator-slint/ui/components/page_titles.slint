import { NetworkMode, RouteMode } from "domain_enums.slint";

// The localized title of every product page route.
//
// One pure function owns the page → title mapping so no app bar re-types
// the ternary chain and the routes drift out of sync. The two dynamic
// titles (the profile preview and the license detail) arrive as arguments;
// the function invents no fact the bars did not already hold.
export global PageTitles {
    public pure function title(page: string, preview-profile: string, license-name: string) -> string {
        if (page == "AppSettings") { return @tr("应用设置"); }
        if (page == "Meta") { return @tr("Meta 功能"); }
        if (page == "Network") { return @tr("网络设置"); }
        if (page == "Overrides") { return @tr("覆写"); }
        if (page == "Connections") { return @tr("连接审计"); }
        if (page == "ConnectionDetail") { return @tr("连接详情"); }
        if (page == "Logs") { return @tr("运行日志"); }
        if (page == "Rules") { return @tr("分流规则"); }
        if (page == "Traffic") { return @tr("流量统计"); }
        if (page == "Providers") { return @tr("外部资源"); }
        if (page == "Preview") { return preview-profile; }
        if (page == "ProfileSettings") { return @tr("订阅设置"); }
        if (page == "About") { return @tr("关于软件"); }
        if (page == "Licenses") { return @tr("开源许可"); }
        if (page == "LicenseDetail") { return license-name; }
        if (page == "Dns") { return @tr("域名解析"); }
        if (page == "Editor") { return @tr("编辑器"); }
        if (page == "Filters") { return @tr("过滤与聚合"); }
        if (page == "Doctor") { return @tr("自愈诊断"); }
        if (page == "Sync") { return @tr("数据同步"); }
        if (page == "AppRouting") { return @tr("应用分流"); }
        if (page == "ConnectionsWorkbench") { return @tr("连接"); }
        if (page == "LogsWorkbench") { return @tr("日志"); }
        if (page == "RuntimeWorkbench") { return @tr("运行时"); }
        if (page == "ProxiesWorkbench") { return @tr("代理"); }
        if (page == "RulesWorkbench") { return @tr("规则"); }
        if (page == "SettingsWorkbench") { return @tr("设置"); }
        if (page == "ShellWorkbench") { return @tr("外壳"); }
        if (page == "OverviewWorkbench") { return @tr("概览"); }
        return page;
    }

    // The shared localized label of the proxy route mode.
    public pure function route-title(mode: RouteMode) -> string {
        if (mode == RouteMode.rule) { return @tr("规则"); }
        if (mode == RouteMode.global) { return @tr("全局"); }
        return @tr("直连");
    }

    // The shared localized label of the owner's takeover mode.
    //
    // The sidebar and the settings page used to read a `network-mode-label`
    // string that no projection ever filled, so both showed "未获取模式"
    // forever. The copy now comes from the typed enum the owner publishes.
    public pure function network-mode-title(mode: NetworkMode) -> string {
        if (mode == NetworkMode.system-proxy) { return @tr("系统代理"); }
        if (mode == NetworkMode.tun) { return @tr("虚拟网卡"); }
        if (mode == NetworkMode.vpn) { return @tr("系统 VPN"); }
        if (mode == NetworkMode.core-only) { return @tr("仅核心转发"); }
        return @tr("未获取模式");
    }

    // The mobile top bar only names the top-level tabs it hosts.
    public pure function top-title(page: string) -> string {
        if (page == "Home") { return @tr("核心概览"); }
        if (page == "Proxy") { return @tr("代理策略"); }
        if (page == "Config") { return @tr("配置订阅"); }
        return @tr("系统设置");
    }

    // The name of a top-level page, in the vocabulary the desktop rail and
    // the desktop app bar share.
    //
    // The desktop app bar used to print the PRODUCT name ("Lumen") over the
    // dashboard while the rail called the same page "核心概览", so one screen
    // showed the brand three times (title bar, rail brand block, rail
    // footer) and its page heading was the one place a name appeared that
    // was not a page at all. The route name is the shared fact - the same
    // "核心概览" the Iced and Bevy shells print for this route - so the bar
    // now prints the page, never the product.
    //
    // The phone keeps its own shorter dialect (仪表盘 / 代理 / 配置 / 工具):
    // that is the reference's mobile vocabulary, and the bottom dock names
    // the same four destinations in the same words.
    public pure function page-name(page: string) -> string {
        return top-title(page);
    }

    // The name of a top-level page in the PHONE and compact-window
    // vocabulary.
    //
    // The phone speaks the reference's words - 仪表盘 / 代理 / 配置 / 工具 -
    // because they are what a thumb-sized header and a four-slot dock can
    // carry. That dialect used to be spelled out in three places (the phone
    // header, the compact header row and the dock's four tabs), so the phone
    // could name one page three ways; it has one owner now.
    //
    // The desktop keeps the route names above (核心概览 / 代理策略 /
    // 配置订阅 / 系统设置) - the same names the Iced and Bevy shells print
    // for these routes - because a rail can afford them.
    public pure function phone-title(page: string) -> string {
        if (page == "Home") { return @tr("仪表盘"); }
        if (page == "Proxy") { return @tr("代理"); }
        if (page == "Config") { return @tr("配置"); }
        return @tr("工具");
    }
}
