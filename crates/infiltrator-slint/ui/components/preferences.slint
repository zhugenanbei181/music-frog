// App preference chrome: the switch, the row and the group that wraps them.
//
// Split out of base_widgets.slint so the settings surface's row family lives in
// one module; base_widgets.slint stays inside its line budget.
import { DesignType } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "theme.slint";
import { LayoutOutline } from "base_widgets.slint";

export component AppPreferenceSwitch inherits FocusScope {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 54 * LumenUiScale.unit; height: 48 * LumenUiScale.unit;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    key-pressed(event) => {
        if root.enabled && (event.text == " " || event.text == "\n") {
            root.toggled(!root.checked); return accept;
        }
        return reject;
    }
    track := Rectangle {
        y: (parent.height - 28 * LumenUiScale.unit) / 2; width: parent.width; height: 28 * LumenUiScale.unit;
        border-radius: self.height / 2;
        background: root.checked ? LumenTheme.preference-accent : LumenTheme.preference-off;
        border-width: root.checked ? 0 * LumenUiScale.unit : 1 * LumenUiScale.unit;
        border-color: root.checked ? transparent : LumenTheme.border;
        animate background, border-color { duration: 180ms; easing: ease-out; }
        thumb := Rectangle {
            x: root.checked ? parent.width - self.width - 3 * LumenUiScale.unit : 3 * LumenUiScale.unit; y: (parent.height - self.height) / 2;
            width: root.checked ? 22 * LumenUiScale.unit : 16 * LumenUiScale.unit; height: self.width; border-radius: self.width / 2;
            background: root.checked ? LumenTheme.accent-foreground : LumenTheme.text-muted;
            drop-shadow-blur: root.checked ? 4 * LumenUiScale.unit : 0 * LumenUiScale.unit; drop-shadow-offset-y: 1 * LumenUiScale.unit; drop-shadow-color: #00000040;
            animate x, width, height, background { duration: 180ms; easing: ease-out; }
        }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-title; }
}

export component AppPreferenceRow inherits FocusScope {
    in property <string> label;
    in property <string> detail;
    in property <string> value;
    in property <string> unavailable;
    in property <string> state-description;
    in property <bool> capability-enabled: true;
    in property <bool> toggle: false;
    in property <bool> checked: false;
    in property <bool> expand: false;
    in property <image> icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg");
    callback clicked();
    callback toggled(bool);
    min-height: max(root.detail == "" ? 66 * LumenUiScale.unit : 82 * LumenUiScale.unit, words.min-height + 24 * LumenUiScale.unit);
    preferred-height: self.min-height;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-action-default => {
        if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
        else { root.clicked(); }
    }
    key-pressed(event) => {
        if event.text == " " || event.text == "\n" {
            if root.toggle && root.capability-enabled { root.toggled(!root.checked); }
            else { root.clicked(); }
            return accept;
        }
        return reject;
    }
    accessible-label: root.label + (root.detail == "" ? "" : "，" + root.detail) + (root.unavailable == "" ? "" : "，" + root.unavailable) + (root.state-description == "" ? "" : "，" + root.state-description);
    row := HorizontalLayout {
        width: parent.width; height: parent.height; spacing: LumenTheme.space-3;
        cross-axis-alignment: center;
        words := VerticalLayout {
            spacing: 2 * LumenUiScale.unit; alignment: center; horizontal-stretch: 1;
            title := Text { text: root.label; font-size: LumenTheme.preference-text-size; color: LumenTheme.text-primary; wrap: word-wrap; }
            if root.detail != "": Text {
                text: root.detail; font-size: DesignType.label-size; color: LumenTheme.text-secondary;
                overflow: elide; accessible-label: root.detail;
            }
        }
        if root.toggle: AppPreferenceSwitch {
            checked: root.checked; enabled: root.capability-enabled; label: root.label + " " + root.unavailable;
            toggled(value) => { root.toggled(value); }
        }
        if !root.toggle && root.value != "": Text {
            text: root.value; font-size: DesignType.subheading-size; color: LumenTheme.text-secondary;
            vertical-alignment: center; horizontal-stretch: 0;
        }
        if !root.toggle: trailing-icon := Image {
            source: root.expand ? @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-down.svg") : root.icon;
            width: 24 * LumenUiScale.unit; height: 24 * LumenUiScale.unit; image-fit: contain;
            colorize: root.expand || root.icon == @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg") ? LumenTheme.text-secondary : LumenTheme.preference-accent;
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-icon; }
        }
    }
    TouchArea { enabled: !root.toggle || !root.capability-enabled; clicked => { root.clicked(); } }
    if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-content; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: words.x; y: words.y; width: words.width; height: words.height; outline-color: LumenTheme.debug-word; }
    if LumenTheme.show-layout-bounds: LayoutOutline { x: title.x + words.x; y: title.y + words.y; width: title.width; height: title.height; outline-color: LumenTheme.debug-icon; }
}

export component AppPreferenceGroup inherits Rectangle {
    in property <string> heading;
    min-height: group-layout.min-height;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    group-layout := VerticalLayout {
        spacing: LumenTheme.space-3; padding-top: LumenTheme.space-3; alignment: start;
        Text { x: 18 * LumenUiScale.unit; text: root.heading; font-size: DesignType.bodyLarge-size; color: LumenTheme.preference-accent; height: 24 * LumenUiScale.unit; vertical-alignment: center; }
        surface := Rectangle {
            background: LumenTheme.surface; border-radius: LumenTheme.preference-card-radius;
            min-height: contents.min-height; preferred-height: self.min-height; vertical-stretch: 0;
            contents := VerticalLayout {
                x: 18 * LumenUiScale.unit; width: max(0 * LumenUiScale.unit, parent.width - 36 * LumenUiScale.unit);
                padding-top: 0 * LumenUiScale.unit; padding-bottom: 0 * LumenUiScale.unit; spacing: 0 * LumenUiScale.unit; alignment: start;
                @children
            }
            if LumenTheme.show-layout-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
            if LumenTheme.show-layout-bounds: LayoutOutline { x: contents.x; y: contents.y; width: contents.width; height: contents.height; outline-color: LumenTheme.debug-text; }
        }
    }
}

