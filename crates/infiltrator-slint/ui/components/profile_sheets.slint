import { CheckBox, ScrollView } from "std-widgets.slint";
import { ModalBottomSheet } from "@material";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "./theme.slint";
import { ProfileOverrideChoice } from "./models.slint";
import { LightRoundedInput, RoundedInputField, PillButton } from "./base_widgets.slint";
import { ProfileSheetTitle, SheetActionButton } from "./cards.slint";

export component ProfileAddSheet inherits ModalBottomSheet {
    in property <length> profile-sheet-content-width;
    in property <length> profile-sheet-content-height;
    in property <bool> application-dark-mode;
    in property <bool> layout-debug-bounds;
    in property <int> profile-add-kind-index;
    in property <string> notice;
    in-out property <string> profile-name;
    in-out property <string> profile-url;
    in-out property <string> profile-age-key;

    callback dismiss();
    callback confirm();
    // The type dropdown is the toolkit's popup menu of the window, so the
    // sheet only asks the window to open it at the trigger's position.
    callback open-type-menu(length, length);
    callback choose-file();
    callback scan-qr();

    sheet_elevation_level: 1;
    show_layout_bounds: root.layout-debug-bounds;
    scrim_color: root.application-dark-mode ? #000000.with_alpha(55%) : #000000.with_alpha(32%);
    surface_color: LumenTheme.surface;
    corner_radius: 28 * LumenUiScale.unit;
    dismissed => { root.dismiss(); }

    Rectangle {
        width: root.profile-sheet-content-width;
        height: root.profile-sheet-content-height;
        background: transparent;
        border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        border-color: #FF2D55;
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-bottom: LumenTheme.space-4;
            spacing: LumenTheme.space-2;
            alignment: start;

            HorizontalLayout {
                x: 16 * LumenUiScale.unit;
                width: max(0 * LumenUiScale.unit, root.profile-sheet-content-width - 32 * LumenUiScale.unit);
                height: 44 * LumenUiScale.unit;
                spacing: LumenTheme.space-1;
                PillButton {
                    label: @tr("取消");
                    pill-height: 32 * LumenUiScale.unit;
                    min-pill-width: 64 * LumenUiScale.unit;
                    clicked => { root.dismiss(); }
                }
                Text { text: @tr("添加配置文件"); color: LumenTheme.text-primary; font-size: 18 * LumenUiScale.unit; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                PillButton {
                    label: @tr("添加");
                    selected: true;
                    pill-height: 32 * LumenUiScale.unit;
                    min-pill-width: 64 * LumenUiScale.unit;
                    enabled: root.profile-add-kind-index != 2;
                    clicked => { root.confirm(); }
                }
            }

            Rectangle {
                width: root.profile-sheet-content-width; height: 50 * LumenUiScale.unit;
                border-radius: 25 * LumenUiScale.unit; background: LumenTheme.surface-muted;
                HorizontalLayout {
                    x: 18 * LumenUiScale.unit; width: root.profile-sheet-content-width - 36 * LumenUiScale.unit; height: parent.height; spacing: LumenTheme.space-2;
                    Text { text: @tr("配置类型"); color: LumenTheme.text-secondary; font-size: 18 * LumenUiScale.unit; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.profile-add-kind-index == 0 ? @tr("订阅链接") : root.profile-add-kind-index == 1 ? @tr("本地文件") : @tr("扫码添加");
                        color: LumenTheme.text-primary; font-size: 18 * LumenUiScale.unit; vertical-alignment: center;
                    }
                    Image { source: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-expand.svg"); width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit; y: (parent.height - self.height) / 2; image-fit: contain; }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.open-type-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
            }

            if root.profile-add-kind-index == 0: VerticalLayout {
                width: root.profile-sheet-content-width;
                spacing: LumenTheme.space-2;
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("配置名称"); text <=> root.profile-name; }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("订阅链接"); text <=> root.profile-url; }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("Age 私钥（可选）"); password: true; text <=> root.profile-age-key; }
            }
            if root.profile-add-kind-index == 1: VerticalLayout {
                width: root.profile-sheet-content-width;
                spacing: LumenTheme.space-2;
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("配置名称（可选）"); text <=> root.profile-name; }
                Rectangle {
                    width: root.profile-sheet-content-width; height: 50 * LumenUiScale.unit; border-radius: 25 * LumenUiScale.unit; background: LumenTheme.surface-muted;
                    Text { x: 20 * LumenUiScale.unit; width: parent.width - 40 * LumenUiScale.unit; height: parent.height; text: @tr("选择 YAML / YML 文件"); color: LumenTheme.text-secondary; font-size: 18 * LumenUiScale.unit; vertical-alignment: center; }
                    TouchArea { width: parent.width; height: parent.height; clicked => { root.choose-file(); } }
                }
                RoundedInputField { width: root.profile-sheet-content-width; label: @tr("Age 私钥（可选）"); password: true; text <=> root.profile-age-key; }
            }
            if root.profile-add-kind-index == 2: Rectangle {
                width: root.profile-sheet-content-width;
                height: 130 * LumenUiScale.unit;
                border-radius: 28 * LumenUiScale.unit;
                background: LumenTheme.surface;
                VerticalLayout {
                    x: 18 * LumenUiScale.unit; width: root.profile-sheet-content-width - 36 * LumenUiScale.unit; height: parent.height; spacing: 6 * LumenUiScale.unit; alignment: center;
                    Text { text: @tr("扫码添加"); color: LumenTheme.text-primary; font-size: 18 * LumenUiScale.unit; font-weight: 550; }
                    Text { text: @tr("扫描二维码以导入配置订阅地址"); color: LumenTheme.text-secondary; font-size: 14 * LumenUiScale.unit; wrap: word-wrap; horizontal-alignment: center; }
                    PillButton { label: @tr("开始扫描"); clicked => { root.scan-qr(); } }
                }
            }
            if root.notice != "": Text {
                width: root.profile-sheet-content-width;
                text: root.notice;
                color: root.notice == "请输入订阅链接" ? LumenTheme.error : LumenTheme.text-secondary;
                font-size: 13 * LumenUiScale.unit;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component ProfileActionSheet inherits ModalBottomSheet {
    in property <length> profile-dialog-content-width;
    in property <bool> layout-debug-bounds;

    callback dismiss();
    callback open-editor();
    callback open-settings();
    callback refresh();

    sheet_elevation_level: 1;
    show_layout_bounds: root.layout-debug-bounds;
    scrim_color: #000000.with_alpha(32%);
    surface_color: LumenTheme.surface;
    corner_radius: 32 * LumenUiScale.unit;
    side_inset: 12 * LumenUiScale.unit;
    dismissed => { root.dismiss(); }

    Rectangle {
        width: root.profile-dialog-content-width;
        height: 280 * LumenUiScale.unit;
        background: transparent;
        border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        border-color: #FF2D55;
        VerticalLayout {
            x: 16 * LumenUiScale.unit; width: parent.width - 32 * LumenUiScale.unit; height: parent.height;
            padding-top: LumenTheme.space-2; padding-bottom: LumenTheme.space-2; spacing: LumenTheme.space-3;
            Text { text: @tr("编辑配置"); color: LumenTheme.text-primary; font-size: 20 * LumenUiScale.unit; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32 * LumenUiScale.unit; }
            SheetActionButton {
                width: parent.width;
                label: @tr("编辑器打开");
                clicked => { root.open-editor(); }
            }
            SheetActionButton {
                width: parent.width;
                label: @tr("刷新");
                clicked => { root.refresh(); }
            }
            SheetActionButton {
                width: parent.width;
                label: @tr("订阅设置");
                primary: true;
                clicked => { root.open-settings(); }
            }
        }
    }
}

export component ProfileShareSheet inherits ModalBottomSheet {
    in property <length> profile-dialog-content-width;
    in property <bool> layout-debug-bounds;

    callback dismiss();
    callback share();

    sheet_elevation_level: 1;
    show_layout_bounds: root.layout-debug-bounds;
    scrim_color: #000000.with_alpha(32%);
    surface_color: LumenTheme.surface;
    corner_radius: 32 * LumenUiScale.unit;
    side_inset: 12 * LumenUiScale.unit;
    dismissed => { root.dismiss(); }

    Rectangle {
        width: root.profile-dialog-content-width;
        height: 252 * LumenUiScale.unit;
        background: transparent;
        border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        border-color: #FF2D55;
        VerticalLayout {
            x: 16 * LumenUiScale.unit; width: parent.width - 32 * LumenUiScale.unit; height: parent.height;
            padding-top: LumenTheme.space-2; padding-bottom: LumenTheme.space-2; spacing: LumenTheme.space-3;
            Text { text: @tr("分享配置"); color: LumenTheme.text-primary; font-size: 20 * LumenUiScale.unit; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32 * LumenUiScale.unit; }
            Text {
                width: parent.width;
                text: @tr("来源配置可能包含节点认证信息；导出仅包含来源 YAML，不含订阅凭据或绑定的覆写。");
                color: LumenTheme.text-secondary;
                font-size: 13 * LumenUiScale.unit;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            SheetActionButton {
                width: parent.width;
                label: @tr("分享配置文件");
                clicked => { root.share(); }
            }
            SheetActionButton {
                width: parent.width;
                label: @tr("取消");
                clicked => { root.dismiss(); }
            }
        }
    }
}

export component ProfileDeleteSheet inherits ModalBottomSheet {
    in property <length> profile-dialog-content-width;
    in property <bool> layout-debug-bounds;
    in property <string> pending-delete-name;

    callback dismiss();
    callback confirm-delete();

    sheet_elevation_level: 1;
    show_layout_bounds: root.layout-debug-bounds;
    scrim_color: #000000.with_alpha(32%);
    surface_color: LumenTheme.surface;
    corner_radius: 32 * LumenUiScale.unit;
    side_inset: 12 * LumenUiScale.unit;
    dismissed => { root.dismiss(); }

    Rectangle {
        width: root.profile-dialog-content-width;
        height: 224 * LumenUiScale.unit;
        background: transparent;
        border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        border-color: #FF2D55;
        VerticalLayout {
            x: 16 * LumenUiScale.unit; width: parent.width - 32 * LumenUiScale.unit; height: parent.height;
            padding-top: LumenTheme.space-2; padding-bottom: LumenTheme.space-2; spacing: LumenTheme.space-3;
            Text { text: @tr("删除配置"); color: LumenTheme.text-primary; font-size: 20 * LumenUiScale.unit; font-weight: 550; horizontal-alignment: center; vertical-alignment: center; height: 32 * LumenUiScale.unit; }
            Text {
                width: parent.width;
                text: @tr("确定要删除「") + root.pending-delete-name + @tr("」吗？如果该配置正在运行，会先停止代理。");
                color: LumenTheme.text-secondary;
                font-size: 16 * LumenUiScale.unit;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
            HorizontalLayout {
                width: parent.width; height: 56 * LumenUiScale.unit; spacing: LumenTheme.space-3;
                SheetActionButton {
                    horizontal-stretch: 1;
                    label: @tr("取消");
                    clicked => { root.dismiss(); }
                }
                SheetActionButton {
                    horizontal-stretch: 1;
                    label: @tr("删除");
                    primary: true;
                    danger: true;
                    clicked => { root.confirm-delete(); }
                }
            }
        }
    }
}

export component ProfileSettingsSheet inherits ModalBottomSheet {
    in property <length> profile-dialog-content-width;
    in property <length> sheet-height;
    in property <bool> layout-debug-bounds;
    in property <string> profile-settings-id;
    in property <string> profile-settings-kind;
    in property <bool> profile-settings-age-configured;
    in property <[ProfileOverrideChoice]> profile-settings-overrides;
    in-out property <int> profile-settings-type-index;
    in-out property <string> profile-settings-name;
    in-out property <string> profile-settings-url;
    in-out property <string> profile-settings-age-key;

    callback dismiss();
    callback save();
    callback clear-age-key();
    callback toggle-override(string, bool);
    callback move-override(string, bool);
    // The type dropdown is the toolkit's popup menu of the window, so the
    // sheet only asks the window to open it at the trigger's position.
    callback open-type-menu(length, length);

    sheet_elevation_level: 1;
    show_layout_bounds: root.layout-debug-bounds;
    scrim_color: #000000.with_alpha(32%);
    surface_color: LumenTheme.surface;
    corner_radius: 32 * LumenUiScale.unit;
    side_inset: 12 * LumenUiScale.unit;
    dismissed => { root.dismiss(); }

    Rectangle {
        width: root.profile-dialog-content-width;
        height: root.sheet-height;
        background: transparent;
        border-width: LumenTheme.show-layout-bounds ? 1 * LumenUiScale.unit : 0 * LumenUiScale.unit;
        border-color: #FF2D55;
        VerticalLayout {
            x: 16 * LumenUiScale.unit; width: parent.width - 32 * LumenUiScale.unit; height: parent.height;
            padding-top: LumenTheme.space-2; padding-bottom: LumenTheme.space-2; spacing: LumenTheme.space-2;
            ProfileSheetTitle {
                width: parent.width;
                title: @tr("订阅设置");
                close => { root.dismiss(); }
                confirm => { root.save(); }
            }
            Rectangle {
                width: parent.width; height: 50 * LumenUiScale.unit; border-radius: 25 * LumenUiScale.unit; background: LumenTheme.surface-muted;
                HorizontalLayout {
                    x: 18 * LumenUiScale.unit; width: parent.width - 36 * LumenUiScale.unit; height: parent.height; spacing: LumenTheme.space-2;
                    Text { text: @tr("设置类型"); color: LumenTheme.text-secondary; font-size: 17 * LumenUiScale.unit; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: root.profile-settings-type-index == 0 ? @tr("订阅信息") : @tr("覆写配置"); color: LumenTheme.text-primary; font-size: 17 * LumenUiScale.unit; vertical-alignment: center; }
                    Image { source: @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/chevron-expand.svg"); width: 20 * LumenUiScale.unit; height: 20 * LumenUiScale.unit; image-fit: contain; vertical-alignment: center; }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.open-type-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                }
            }
            ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                content-width: self.width;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    width: parent.width; spacing: LumenTheme.space-3; alignment: start;
                    if root.profile-settings-type-index == 0: VerticalLayout {
                        width: parent.width; spacing: LumenTheme.space-2;
                        LightRoundedInput { width: parent.width; label: @tr("配置名称"); text <=> root.profile-settings-name; }
                        if root.profile-settings-kind == "remote_subscription": LightRoundedInput { width: parent.width; label: @tr("订阅链接"); text <=> root.profile-settings-url; }
                        if root.profile-settings-kind == "remote_subscription": HorizontalLayout {
                            width: parent.width;
                            spacing: LumenTheme.space-2;
                            LightRoundedInput {
                                horizontal-stretch: 1;
                                label: @tr("Age 私钥（可选）");
                                password: true;
                                text <=> root.profile-settings-age-key;
                            }
                            if root.profile-settings-age-configured: PillButton {
                                label: @tr("清除");
                                clicked => { root.clear-age-key(); }
                            }
                        }
                        if root.profile-settings-kind != "remote_subscription": Text { text: @tr("本地来源配置保持只读；名称可在此修改。"); color: LumenTheme.text-secondary; font-size: 13 * LumenUiScale.unit; wrap: word-wrap; }
                    }
                    if root.profile-settings-type-index == 1: VerticalLayout {
                        width: parent.width; spacing: LumenTheme.space-2;
                        Text { text: @tr("覆写配置"); color: LumenTheme.text-primary; font-size: 18 * LumenUiScale.unit; font-weight: 600; }
                        Text { text: @tr("选中的覆写会按列表顺序合并；更改先保存为 Profile 绑定。"); color: LumenTheme.text-secondary; font-size: 13 * LumenUiScale.unit; wrap: word-wrap; }
                        if root.profile-settings-overrides.length == 0: Text { text: @tr("暂无可绑定的 YAML 覆写"); color: LumenTheme.text-secondary; font-size: 14 * LumenUiScale.unit; }
                        for option in root.profile-settings-overrides: HorizontalLayout {
                            width: parent.width; height: 56 * LumenUiScale.unit; spacing: LumenTheme.space-1;
                            CheckBox { text: option.name + " · " + option.format; checked: option.selected; horizontal-stretch: 1; toggled => { root.toggle-override(option.id, self.checked); } }
                            PillButton { label: "↑"; enabled: option.selected && option.can-move-up; clicked => { root.move-override(option.id, true); } }
                            PillButton { label: "↓"; enabled: option.selected && option.can-move-down; clicked => { root.move-override(option.id, false); } }
                        }
                    }
                }
            }
        }
    }
}
