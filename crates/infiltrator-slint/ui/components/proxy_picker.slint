// The reference's proxy picker: one persistent row of policy-group pills above
// a dense grid of node cards. The group row never disappears, so switching
// egress is one tap and the node list stays on screen. The Slint page used to
// hide the groups behind a drill-down, which made every group change a round
// trip and left the node list as one tall column of near-empty rows.

import { DesignType, TextRole } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "./theme.slint";
import { FlagIcon } from "../lumen-flags.slint";
import { ObservationRow, ProxyGroup } from "./models.slint";
import { ScrollView } from "std-widgets.slint";

// Pills share one width so the row can scroll without measuring every label;
// a long group name elides instead of pushing its neighbours off screen.
export global ProxyPillMetrics {
    out property <length> pill-min-width: 72 * LumenUiScale.unit;
    out property <length> pill-height: 36 * LumenUiScale.unit;
    out property <length> pill-spacing: LumenTheme.space-2;
    out property <length> pill-inset: 10 * LumenUiScale.unit;
    out property <length> pill-gap: 7 * LumenUiScale.unit;
    out property <length> pill-identity-size: 20 * LumenUiScale.unit;
    // The name receives the width left after the flag/avatar, one gap and the
    // two symmetric insets. A short name reads in full instead of inheriting a
    // 152u fixed-width row placeholder.
    out property <length> pill-name-allowance: 112 * LumenUiScale.unit;
    // The active node card owns its own height; scroll-to-current needs the
    // same number instead of a second 76u literal in the shell.
    out property <length> node-card-height:
        10 * LumenUiScale.unit + 22 * LumenUiScale.unit + 6 * LumenUiScale.unit
        + 18 * LumenUiScale.unit + 10 * LumenUiScale.unit;
    out property <length> node-card-inset: 12 * LumenUiScale.unit;
    out property <length> node-card-top-inset: 10 * LumenUiScale.unit;
    out property <length> node-card-row-gap: 6 * LumenUiScale.unit;
    out property <length> node-card-title-height: 22 * LumenUiScale.unit;
    out property <length> node-card-meta-height: 18 * LumenUiScale.unit;
    out property <length> node-card-title-gap: 7 * LumenUiScale.unit;
    out property <length> node-card-flag-size: 18 * LumenUiScale.unit;
    out property <length> node-card-badge-size: 20 * LumenUiScale.unit;
    out property <length> node-card-probe-size: 14 * LumenUiScale.unit;
}

/// One policy group in the pill row.
export component ProxyGroupPill inherits Rectangle {
    in property <ProxyGroup> group;
    in property <bool> selected;
    callback picked();

    width: Math.max(ProxyPillMetrics.pill-min-width,
        min(group-name.preferred-width, ProxyPillMetrics.pill-name-allowance)
        + ProxyPillMetrics.pill-identity-size + ProxyPillMetrics.pill-gap
        + 2 * ProxyPillMetrics.pill-inset);
    height: ProxyPillMetrics.pill-height;
    border-radius: self.height / 2;
    background: root.selected ? LumenTheme.selection : ((pill-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-4 : LumenTheme.zinc-3);
    border-width: 1 * LumenUiScale.unit;
    border-color: root.selected ? transparent : LumenTheme.hairline-glow;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.group.name;
    accessible-checked: root.selected;

    pill-layout := HorizontalLayout {
        x: ProxyPillMetrics.pill-inset;
        width: parent.width - 2 * ProxyPillMetrics.pill-inset;
        height: parent.height;
        spacing: ProxyPillMetrics.pill-gap;
        cross-axis-alignment: center;

        // The reference puts a pictograph on every pill. The owner publishes a
        // flag for the group's current egress and a single-letter avatar; an
        // invented per-group emoji would be a second source of truth, so the
        // flag is used when the owner resolved one and the avatar otherwise.
        if root.group.current-flag-index >= 0: FlagIcon {
            index: root.group.current-flag-index;
            country-code: root.group.current-flag-code;
            size: ProxyPillMetrics.pill-identity-size;
        }
        if root.group.current-flag-index < 0: Rectangle {
            width: ProxyPillMetrics.pill-identity-size;
            height: ProxyPillMetrics.pill-identity-size;
            border-radius: ProxyPillMetrics.pill-identity-size / 2;
            background: root.selected
                ? LumenTheme.accent-foreground.with_alpha(24%)
                : LumenTheme.zinc-4;
            Text {
                text: root.group.icon-emoji;
                color: root.selected ? LumenTheme.accent-foreground : LumenTheme.text-secondary;
                font-size: DesignType.tagStrong-size;
                font-weight: DesignType.tagStrong-weight;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        group-name := Text {
            width: parent.width - ProxyPillMetrics.pill-identity-size - ProxyPillMetrics.pill-gap;
            text: root.group.name;
            color: root.selected ? LumenTheme.accent-foreground : LumenTheme.text-primary;
            font-size: DesignType.size(TextRole.caption);
            font-weight: DesignType.weight(root.selected ? TextRole.captionStrong : TextRole.caption);
            vertical-alignment: center;
            overflow: elide;
        }
    }

    pill-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

/// The persistent group row, scrolled horizontally when it overflows.
export component ProxyGroupPillBar inherits ScrollView {
    in property <[ProxyGroup]> groups;
    in property <string> selected-group;
    callback picked(string);

    horizontal-scrollbar-policy: LumenTheme.compact-layout ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;

    min-height: ProxyPillMetrics.pill-height + 2 * LumenTheme.space-1;

    HorizontalLayout {
        height: ProxyPillMetrics.pill-height;
        spacing: ProxyPillMetrics.pill-spacing;
        cross-axis-alignment: center;

        for group in root.groups: ProxyGroupPill {
            selected: group.name == root.selected-group;
            group: group;
            picked => { root.picked(group.name); }
        }
    }
}

/// One outbound as the reference draws it: flag and name on top, quiet
/// protocol metadata bottom-left, the graded latency bottom-right.
export component ProxyNodeCard inherits Rectangle {
    in property <ObservationRow> node;
    in property <bool> testing: false;
    // Switching an egress needs a running core, which the page already knows.
    // The card keeps the fact as an input so a tap never looks alive and then
    // does nothing.
    in property <bool> switching-allowed: true;
    callback picked();
    callback probed();

    // The reference node card is 66.9dp tall at the same density. Its two ink
    // rows are 22 + 6 + 18 with 10 above and below; the shared metric owns
    // that sum for both the card and the scroll-to-current centring offset.
    height: ProxyPillMetrics.node-card-height;
    border-radius: LumenTheme.radius-mobile-card;
    background: root.node.active
        ? LumenTheme.zinc-5
        : ((touch.has-hover && LumenTheme.hover-allowed) && root.switching-allowed ? LumenTheme.zinc-5 : LumenTheme.zinc-3);
    border-width: 1 * LumenUiScale.unit;
    border-color: root.node.active
        ? LumenTheme.hairline-glow
        : ((touch.has-hover && LumenTheme.hover-allowed) && root.switching-allowed ? LumenTheme.border : LumenTheme.hairline-glow);
    animate background, border-color { duration: 120ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: node.accessible-title;
    accessible-checked: root.node.active;

    card-content := VerticalLayout {
        x: ProxyPillMetrics.node-card-inset;
        y: ProxyPillMetrics.node-card-top-inset;
        width: parent.width - 2 * ProxyPillMetrics.node-card-inset;
        height: parent.height - 2 * ProxyPillMetrics.node-card-top-inset;
        spacing: ProxyPillMetrics.node-card-row-gap;

        HorizontalLayout {
            height: ProxyPillMetrics.node-card-title-height;
            spacing: ProxyPillMetrics.node-card-title-gap;
            cross-axis-alignment: center;

            if root.node.flag-index >= 0: FlagIcon {
                index: root.node.flag-index;
                country-code: root.node.flag-code;
                size: ProxyPillMetrics.node-card-flag-size;
            }
            Text {
                text: root.node.title;
                color: LumenTheme.text-primary;
                font-size: DesignType.bodyStrong-size;
                font-weight: DesignType.bodyStrong-weight;
                horizontal-stretch: 1;
                min-width: 0 * LumenUiScale.unit;
                vertical-alignment: center;
                overflow: elide;
            }
            // The reference marks the chosen egress with a filled circular
            // check, not a bare square glyph floating mid-row.
            if root.node.active: Rectangle {
                width: ProxyPillMetrics.node-card-badge-size;
                height: ProxyPillMetrics.node-card-badge-size;
                border-radius: ProxyPillMetrics.node-card-badge-size / 2;
                background: LumenTheme.selection;
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M 7 12.5 L 10.5 16 L 17 8.5";
                    stroke: LumenTheme.accent-foreground;
                    stroke-width: 2.2 * LumenUiScale.unit;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
        }

        HorizontalLayout {
            height: ProxyPillMetrics.node-card-meta-height;
            spacing: LumenTheme.space-2;
            cross-axis-alignment: center;

            // The reference's second line is quiet ink: the protocol name on
            // the left, the probe affordance on the right, neither of them in a
            // filled chip. Two tinted rectangles per card gave every row of the
            // grid a pair of boxes the reference does not draw, and the grade
            // was carried twice - once by the tint, once by the ink. The
            // measurement now lives in the ink colour alone.
            if root.node.subtitle != "": Text {
                horizontal-stretch: 1;
                min-width: 0 * LumenUiScale.unit;
                text: root.node.subtitle;
                color: LumenTheme.text-secondary;
                font-size: DesignType.micro-size;
                font-weight: DesignType.micro-weight;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.testing: Text {
                text: @tr("正在测速");
                color: LumenTheme.text-secondary;
                font-size: DesignType.micro-size;
                vertical-alignment: center;
            }
            if !root.testing && root.node.trailing != "": Text {
                text: root.node.trailing;
                color: root.node.latency-ink;
                font-size: DesignType.monoCaption-size;
                font-family: DesignType.monoCaption-family;
                font-weight: DesignType.monoCaption-weight;
                vertical-alignment: center;
            }
            if !root.testing && root.node.trailing == "": Image {
                source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/zap.svg");
                width: ProxyPillMetrics.node-card-probe-size;
                height: ProxyPillMetrics.node-card-probe-size;
                image-fit: contain;
                colorize: LumenTheme.text-muted;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: (!root.node.active && root.switching-allowed) || root.node.active ? pointer : default;
        enabled: (!root.node.active && root.switching-allowed) || root.node.active;
        clicked => {
            if root.node.active {
                root.probed();
            } else if root.switching-allowed {
                root.picked();
            }
        }
    }
}
