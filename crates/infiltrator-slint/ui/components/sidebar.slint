import { DesignType } from "./design-type.slint";
import { TextRole } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "./theme.slint";
import { NavigationForm, NavigationSeparator } from "./viewport_tier.slint";
import { NavigationSlot } from "./models.slint";
import { NavigationIcons } from "./navigation_icons.slint";
import { PageTitles } from "./page_titles.slint";
import { ViewportLadder } from "./viewport-ladder.slint";

// The desktop sidebar is a pure navigation surface, matching the FlClash
// desktop reference: destinations only, no status card, no throughput, no
// brand tile and no version line. Those facts already have a single owner in
// the title bar and the dashboard cards; publishing them here was a second
// truth source. The rail consumes the typed registry the projection publishes.
export component DesktopSideBar inherits Rectangle {
    in property <string> page;
    in property <[NavigationSlot]> navigation-items;
    in property <string> active-destination;

    // Where this pane's navigation stack ends, in window coordinates. The
    // shell publishes it into the frame's chrome receipt, which is what lets
    // the space-utilization judge tell a navigation row from a second content
    // block parked under the stack - in a short window as well as a tall one -
    // without re-adding row tokens in Python or guessing a fraction of the
    // window height (`SPACEUTIL-009`). A pane that is never mounted never
    // writes it, so a bottom-bar frame states no stack end (0), exactly as the
    // receipt's invariant requires.
    in-out property <length> nav-stack-bottom;

    // The leading this pane gives away before it paints anything, in window
    // coordinates: the ground between the column's left edge and the first
    // glyph box. The rows are padded with this same property, so the fact the
    // receipt publishes and the geometry the pane paints cannot drift apart
    // (`SPACEUTIL-010`). A rail centres its glyphs in the column instead of
    // indenting them, so it states 0; the receipt's pair rule is that a form
    // which labels its rows is the form that states a leading.
    in-out property <length> nav-content-offset;
    init => {
        root.nav-content-offset = root.labelled
            ? LumenTheme.rail-content-leading
            : 0 * LumenUiScale.unit;
    }

    // The stack's extent is the last destination row's own bottom edge, and
    // only that row publishes it. b157 measured every alternative against the
    // real frames before landing here:
    //   * the tail spacer's offset was pane coordinates, not window pixels
    //     (b154 published 466 against a true 502 and had to withdraw it);
    //   * reading the layouts' own `y` was measured in a diagnostic capture
    //     and published 40 - the body's offset with the nav layout and the
    //     free-air cell both still at 0 - where the true extent is 502; a
    //     layout places a stretch cell once and never relocates it;
    //   * `changed y` / `changed absolute-position` fire only for the cells a
    //     pass actually relocates, so watching one event alone missed seven of
    //     the eight rows on the 1180x780 frame.
    // `init` is exact for the row the registry puts last - on the published
    // 1180x780 frame that row occupies 458..502 in window pixels - and the
    // `changed` handlers re-publish whenever a pass relocates it, so the pair
    // converges on the geometry the pane really painted instead of a number
    // remembered from tokens.
    function publish-stack-bottom(bottom: length, row-index: int) {
        if (row-index == root.navigation-items.length - 1) {
            root.nav-stack-bottom = bottom;
        }
    }

    // Two shapes, one column. FlClash's 48px rail (`_compactWidth`) shows
    // nothing but glyphs and keeps its labels in a tooltip; its 220px pane
    // (`_expandedWidth`) shows labels. This surface owns the same pair: 64u of
    // icons where the exported form is a rail, the labelled list where it is a
    // standard or wide column. Both forms read the contract's separator policy,
    // which measures the reference's one uninterrupted destination list.
    property <bool> labelled: ViewportLadder.labelled_sidebar(LumenTheme.viewport-tier);
    in property <NavigationForm> navigation-form;
    property <NavigationSeparator> separator:
        ViewportLadder.navigation_separator(root.navigation-form);

    callback navigate-to(string);

    width: LumenTheme.rail-width;
    background: LumenTheme.zinc-2;
    border-width: 0 * LumenUiScale.unit;

    VerticalLayout {
        x: 0;
        y: LumenTheme.rail-vertical-inset;
        width: parent.width;
        height: parent.height - 2 * LumenTheme.rail-vertical-inset;
        spacing: LumenTheme.rail-item-gap;

        for item[index] in root.navigation-items: VerticalLayout {
            spacing: 0 * LumenUiScale.unit;

            // `NavigationSeparator::heading` is the only form that may paint a
            // group heading. Every exported desktop form currently reads
            // `none`, matching FlClash: headings spent a line box plus 16u of
            // air and split one navigation stack into two detached stacks.
            if root.separator == NavigationSeparator.heading
                && (index == 0 || root.navigation-items[index - 1].group != item.group): HorizontalLayout {
                padding-left: root.nav-content-offset;
                padding-top: LumenTheme.rail-section-gap;
                padding-bottom: LumenTheme.space-1;
                Text {
                    text: item.group-label;
                    color: LumenTheme.text-muted;
                    font-size: DesignType.tag-size;
                    font-weight: DesignType.tag-weight;
                    letter-spacing: 0.5 * LumenUiScale.unit;
                }
            }

            // The selected destination is a full-width 8% wash plus a 3u
            // primary indicator, both spanning the row. A content-width pill
            // was the wrong geometry for a navigation rail: the empty right
            // side of a selected row is breathing room, not dead waste.
            nav-face := Rectangle {
                height: LumenTheme.rail-row-height;
                background: item.id == root.active-destination ? LumenTheme.nav-selected-fill : transparent;
                border-radius: LumenTheme.radius-control;

                // The last row is the stack, in window pixels. `init` is the
                // pass that first places the row (measured exact for the last
                // row of both the labelled pane and the icon rail); the
                // `changed` handlers re-publish whenever a later pass
                // relocates it, which is what the group headings do to every
                // row below them.
                init => {
                    root.publish-stack-bottom(self.absolute-position.y + self.height, index);
                }
                changed absolute-position => {
                    root.publish-stack-bottom(self.absolute-position.y + self.height, index);
                }
                changed height => {
                    root.publish-stack-bottom(self.absolute-position.y + self.height, index);
                }

                nav-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.navigate-to(item.id); }
                }

                if item.id == root.active-destination: Rectangle {
                    x: 0 * LumenUiScale.unit;
                    y: (parent.height - LumenTheme.nav-indicator-height) / 2;
                    width: LumenTheme.nav-indicator-width;
                    height: LumenTheme.nav-indicator-height;
                    border-radius: LumenTheme.nav-indicator-width / 2;
                    background: LumenTheme.accent-active;
                }

                HorizontalLayout {
                    padding-left: root.nav-content-offset;
                    padding-right: root.labelled ? LumenTheme.rail-item-padding : 0 * LumenUiScale.unit;
                    spacing: LumenTheme.rail-label-gap;
                    width: parent.width;
                    height: parent.height;
                    alignment: start;
                    cross-axis-alignment: center;

                    // In a rail the icon is the whole row, so it takes the
                    // centre of the column; the stretches only ever exist to
                    // push it there, and they vanish once there is a label.
                    if !root.labelled: Rectangle { horizontal-stretch: 1; background: transparent; }
                    Image {
                        source: NavigationIcons.icon(item.icon);
                        width: LumenTheme.nav-icon-size;
                        height: LumenTheme.nav-icon-size;
                        image-fit: contain;
                        colorize: item.id == root.active-destination ? LumenTheme.accent-active : LumenTheme.text-secondary;
                    }
                    if root.labelled: Text {
                        // The four primary destinations are named by the
                        // shared desktop page-name owner; observation rows
                        // carry the shared copy-table label the projection
                        // published. Neither path invents a second word.
                        text: root.primary-name(item.id) != "" ? root.primary-name(item.id) : item.label;
                        color: item.id == root.active-destination ? LumenTheme.text-primary : LumenTheme.text-secondary;
                        font-size: DesignType.size(TextRole.label);
                        font-weight: DesignType.weight(TextRole.label);
                        font-family: DesignType.family(TextRole.label);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0 * LumenUiScale.unit;
                        overflow: elide;
                    }
                    if !root.labelled: Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            }
        }
        // The free air belongs above the bottom of the rail, never between
        // navigation rows. It stays the rail's last cell: the stack's extent is
        // published by the last destination row itself, not read from here.
        Rectangle { vertical-stretch: 1; background: transparent; }
    }

    // Map a typed registry id onto the one desktop page-name owner. A
    // non-primary id returns empty so its shared copy-table label is used.
    public pure function primary-name(id: string) -> string {
        if id == "overview" { return PageTitles.page-name("Home"); }
        if id == "proxies" { return PageTitles.page-name("Proxy"); }
        if id == "profiles" { return PageTitles.page-name("Config"); }
        if id == "settings" { return PageTitles.page-name("Settings"); }
        return "";
    }
}
