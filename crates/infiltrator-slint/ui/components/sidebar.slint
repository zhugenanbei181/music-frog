import { DesignType } from "./design-type.slint";
import { TextRole } from "./design-type.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "./theme.slint";
import { NavigationSlot } from "./models.slint";
import { NavigationIcons } from "./navigation_icons.slint";
import { PageTitles } from "./page_titles.slint";

// The desktop sidebar is a pure navigation surface, matching the FlClash
// desktop reference: destinations only, no status card, no throughput, no
// brand tile and no version line. Those facts already have a single owner in
// the title bar and the dashboard cards; publishing them here was a second
// truth source. The rail consumes the typed registry the projection publishes.
export component DesktopSideBar inherits Rectangle {
    in property <string> page;
    in property <[NavigationSlot]> navigation-items;
    in property <string> active-destination;

    callback navigate-to(string);

    width: LumenTheme.rail-width;
    background: LumenTheme.zinc-2;
    border-width: 0 * LumenUiScale.unit;

    VerticalLayout {
        x: 0;
        y: LumenTheme.rail-vertical-inset;
        width: parent.width;
        height: parent.height - 2 * LumenTheme.rail-vertical-inset;
        spacing: LumenTheme.rail-item-gap;

        for item[index] in root.navigation-items: VerticalLayout {
            spacing: 0 * LumenUiScale.unit;

            // A group heading is the only separator: it owns the air above
            // and below itself, exactly when the group changes. No hairline
            // repeats the same boundary a second time.
            if index == 0 || root.navigation-items[index - 1].group != item.group: HorizontalLayout {
                padding-left: LumenTheme.rail-content-leading;
                padding-top: LumenTheme.rail-section-gap;
                padding-bottom: LumenTheme.space-1;
                Text {
                    text: item.group-label;
                    color: LumenTheme.text-muted;
                    font-size: DesignType.tag-size;
                    font-weight: DesignType.tag-weight;
                    letter-spacing: 0.5 * LumenUiScale.unit;
                }
            }

            // The selected destination is a full-width 8% wash plus a 3u
            // primary indicator, both spanning the row. A content-width pill
            // was the wrong geometry for a navigation rail: the empty right
            // side of a selected row is breathing room, not dead waste.
            nav-face := Rectangle {
                height: LumenTheme.rail-row-height;
                background: item.id == root.active-destination ? LumenTheme.nav-selected-fill : transparent;
                border-radius: LumenTheme.radius-control;

                nav-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.navigate-to(item.id); }
                }

                if item.id == root.active-destination: Rectangle {
                    x: 0 * LumenUiScale.unit;
                    y: (parent.height - LumenTheme.nav-indicator-height) / 2;
                    width: LumenTheme.nav-indicator-width;
                    height: LumenTheme.nav-indicator-height;
                    border-radius: LumenTheme.nav-indicator-width / 2;
                    background: LumenTheme.accent-active;
                }

                HorizontalLayout {
                    padding-left: LumenTheme.rail-content-leading;
                    padding-right: LumenTheme.rail-item-padding;
                    spacing: LumenTheme.rail-label-gap;
                    width: parent.width;
                    height: parent.height;
                    alignment: start;
                    cross-axis-alignment: center;

                    Image {
                        source: NavigationIcons.icon(item.icon);
                        width: LumenTheme.nav-icon-size;
                        height: LumenTheme.nav-icon-size;
                        image-fit: contain;
                        colorize: item.id == root.active-destination ? LumenTheme.accent-active : LumenTheme.text-secondary;
                    }
                    Text {
                        // The four primary destinations are named by the
                        // shared desktop page-name owner; observation rows
                        // carry the shared copy-table label the projection
                        // published. Neither path invents a second word.
                        text: root.primary-name(item.id) != "" ? root.primary-name(item.id) : item.label;
                        color: item.id == root.active-destination ? LumenTheme.text-primary : LumenTheme.text-secondary;
                        font-size: DesignType.size(TextRole.label);
                        font-weight: DesignType.weight(TextRole.label);
                        font-family: DesignType.family(TextRole.label);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0 * LumenUiScale.unit;
                        overflow: elide;
                    }
                }
            }
        }
        // The free air belongs above the bottom of the rail, never between
        // navigation rows.
        Rectangle { vertical-stretch: 1; background: transparent; }
    }

    // Map a typed registry id onto the one desktop page-name owner. A
    // non-primary id returns empty so its shared copy-table label is used.
    public pure function primary-name(id: string) -> string {
        if id == "overview" { return PageTitles.page-name("Home"); }
        if id == "proxies" { return PageTitles.page-name("Proxy"); }
        if id == "profiles" { return PageTitles.page-name("Config"); }
        if id == "settings" { return PageTitles.page-name("Settings"); }
        return "";
    }
}
