// Generated by scripts/generate_viewport_ladder.py from
// crates/infiltrator-contract/assets/page-structure.json. Do not edit: the
// shared contract's `responsive_viewport` owns the ladder, and the structure
// gate fails this file open when the two drift.
//
// Every boundary, navigation column and column count below is the exported
// projection of one `ViewportTier`. A surface that writes its own boundary
// would be a second idea of the same window - the defect this file exists to
// make impossible. Lengths are design units, so the consumer applies the
// user zoom itself and the ladder never has an opinion about it.

import { LumenUiScale } from "../lumen-ui-scale.slint";
import { DashboardDensity, NavigationForm, NavigationSeparator, ProfileGridForm, ProxyGridForm, SidebarExpansionPreference, ViewportTier } from "./viewport_tier.slint";

export global ViewportLadder {
    // The first window width that leaves each tier behind, in design units.
    // The half-open spans tile the width axis: `compact` < `medium` <
    // `expanded` < `ultra`, and the widest tier owns no upper bound, so the
    // chain that reads these ends in `ultra` without a fourth number.
    out property <length> compact-max: 600 * LumenUiScale.unit;
    out property <length> medium-max: 840 * LumenUiScale.unit;
    out property <length> expanded-max: 1200 * LumenUiScale.unit;

    // The gutter every page body keeps on each side, in design units.
    //
    // The reference draws the same 16dp on a phone page and on a 4K desktop
    // page (`dashboard.dart` `fromSTEB(16, …)`, `proxies/list.dart`
    // `_groupInset = 16`, `profiles.dart` `_horizontalPadding = 16`, and
    // `dashboardMobileSideOf = max(16, (width - 560) / 2)`), so this is one
    // exported number rather than a per-tier table. A surface that could ask
    // for "the padding of my tier" is a surface that will drift, which is
    // exactly how Slint reached 30u while its siblings drew 24/40/48px.
    out property <length> page-padding: 16 * LumenUiScale.unit;

    // The air the shell keeps for itself below the page body, in design units,
    // and the ceiling that air may not pass.
    //
    // The reference keeps one band under its last content row: 39px on the
    // tracked desktop scene, which is 20.00dp at that scene's 1.95 px/dp.
    // This surface used to keep 72u - 3.6 times the reference - and because
    // the band sits outside the measured page body, nothing ever paid for
    // it: the window grew a fifth of its height that no judgement could
    // see. The contract therefore exports the measured reference and the
    // bounded headroom above it, and the judge refuses any frame whose own
    // receipt says it kept more than the exported ceiling.
    //
    // Both numbers come from the contract export, so the surface cannot keep
    // a second opinion about how much air a window deserves.
    out property <length> shell-bottom-air: 20 * LumenUiScale.unit;
    out property <length> shell-bottom-air-limit: 28 * LumenUiScale.unit;

    // How many proxy node cards fit in the page body. The contract exports
    // FlClash's `getProxiesColumns` standard-layout width rule: divide the
    // page body by the 250dp floor and keep at least two columns. The page
    // passes its own width, so a wide window no longer paints a tier's fixed
    // three oversized cards. The rule pays no inset of its own because the
    // shell already subtracted `page_padding` once; the reference's
    // `max(width - 32, 0)` *is* that gutter, not a second one.
    public pure function proxy_columns(form: ProxyGridForm, page-width: length) -> int {
        if (form == ProxyGridForm.stacked) { return 1; }
        return Math.max(2, Math.ceil(page-width / (250 * LumenUiScale.unit)));
    }

    // Whether a navigation form may paint a group heading.
    //
    // FlClash's desktop scene and prism_ui sidebar both publish one
    // uninterrupted destination list. A heading spends its own line box and
    // the air above it, so it splits one navigation stack into two. The
    // exported contract decides the separator; this generated lookup only
    // projects that decision into the surface vocabulary.
    public pure function navigation_separator(form: NavigationForm) -> NavigationSeparator {
        if (form == NavigationForm.bottom-nav) { return NavigationSeparator.none; }
        if (form == NavigationForm.rail) { return NavigationSeparator.none; }
        if (form == NavigationForm.standard) { return NavigationSeparator.none; }
        if (form == NavigationForm.wide) { return NavigationSeparator.none; }
        return NavigationSeparator.none;
    }

    // FlClash persists only `sidebarExpanded` in app settings and derives one
    // `expanded` fact from the viewport capability. The contract exports the
    // closed preference x tier x surface-kind table below; this generated
    // lookup only spells its typed answer in the surface vocabulary. A user
    // who collapses a desktop window therefore gets the existing rail form,
    // and a touch surface keeps its bottom bar without a second UI decision.
    public pure function sidebar_form(preference: SidebarExpansionPreference, tier: ViewportTier, touch-surface: bool) -> NavigationForm {
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == false) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == false) { return NavigationForm.rail; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == false) { return NavigationForm.standard; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == false) { return NavigationForm.wide; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == false) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == false) { return NavigationForm.rail; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == false) { return NavigationForm.rail; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == true) { return NavigationForm.bottom-nav; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == false) { return NavigationForm.rail; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == true) { return NavigationForm.bottom-nav; }
        return NavigationForm.bottom-nav;
    }

    // FlClash persists only `sidebarExpanded` in app settings and derives one
    // `expanded` fact from the viewport capability. The contract exports the
    // closed preference x tier x surface-kind table below; this generated
    // lookup only spells its typed answer in the surface vocabulary. A user
    // who collapses a desktop window therefore gets the existing rail form,
    // and a touch surface keeps its bottom bar without a second UI decision.
    public pure function sidebar_nav_column(preference: SidebarExpansionPreference, tier: ViewportTier, touch-surface: bool) -> int {
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == false) { return 0; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == false) { return 64; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == false) { return 240; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == false) { return 280; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == false) { return 0; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == false) { return 64; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == false) { return 64; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == true) { return 0; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == false) { return 64; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == true) { return 0; }
        return 0;
    }

    // FlClash persists only `sidebarExpanded` in app settings and derives one
    // `expanded` fact from the viewport capability. The contract exports the
    // closed preference x tier x surface-kind table below; this generated
    // lookup only spells its typed answer in the surface vocabulary. A user
    // who collapses a desktop window therefore gets the existing rail form,
    // and a touch surface keeps its bottom bar without a second UI decision.
    public pure function sidebar_labelled(preference: SidebarExpansionPreference, tier: ViewportTier, touch-surface: bool) -> bool {
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == true) { return false; }
        return false;
    }

    // FlClash persists only `sidebarExpanded` in app settings and derives one
    // `expanded` fact from the viewport capability. The contract exports the
    // closed preference x tier x surface-kind table below; this generated
    // lookup only spells its typed answer in the surface vocabulary. A user
    // who collapses a desktop window therefore gets the existing rail form,
    // and a touch surface keeps its bottom bar without a second UI decision.
    public pure function sidebar_toggle_available(preference: SidebarExpansionPreference, tier: ViewportTier, touch-surface: bool) -> bool {
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.compact && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.medium && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.expanded && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.expanded && tier == ViewportTier.ultra && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.compact && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == false) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.medium && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.expanded && touch-surface == true) { return false; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == false) { return true; }
        if (preference == SidebarExpansionPreference.collapsed && tier == ViewportTier.ultra && touch-surface == true) { return false; }
        return false;
    }

    // Whether this tier's shell has a labelled navigation column at all.
    //
    // This is the tier-only half of the same exported ladder, and the page
    // density reads it instead of the preference-aware table above. FlClash
    // computes `viewMode` from the window width and lets `sidebarExpanded`
    // narrow only the sidebar (`expanded ? 220 : 48`), so collapsing the
    // column on a desktop window gives the dashboard MORE room, never a
    // phone layout. A surface that derived page density from the collapse
    // preference would turn a 1180x780 desktop into the 400x800 phone page:
    // one-column grids, no page air, phone margins. `SPACEUTIL-006` retired
    // the other direction of the same conflation (density answering which
    // navigation to mount); this lookup retires the remaining one.
    public pure function labelled_sidebar(tier: ViewportTier) -> bool {
        if (tier == ViewportTier.compact) { return false; }
        if (tier == ViewportTier.medium) { return false; }
        if (tier == ViewportTier.expanded) { return true; }
        return true;
    }

    // How many equal shares the dashboard's span grid owns at this page width.
    //
    // The contract's `DashboardColumns::GridShares` answers this by page width
    // (FlClash `dashboardColumnsOf`: below 860 -> 2, at or above -> 4), while
    // `overview_card_columns` answers a different question - cards per row in a
    // wrapping flow (1/2/2/3 by tier). SPACEUTIL-008 existed because Slint's
    // private 2/4 and the contract's 1/2/2/3 were both called `card columns`.
    // A rail-form window is held to two shares regardless of width: its grid
    // is the compact `DashboardDensity` and a four-share row there clipped the
    // last card off the right edge (measured at 720px). That is a typed form
    // switch, not a second width rule. This lookup is generated from the
    // exported threshold, so neither the surface nor this generator owns a
    // second copy of the number.
    public pure function dashboard_grid_shares(page-width: length, tier: ViewportTier) -> int {
        if (tier == ViewportTier.compact || tier == ViewportTier.medium) { return 2; }
        if (page-width < 860 * LumenUiScale.unit) { return 2; }
        return 4;
    }

    // The one seam between the cards of a grid, in design units.
    //
    // The reference states it once (`lib/common/layout.dart`
    // `cardSpacingOf`) and keys it on the view width alone: mobile at or
    // below 600, laptop at or below 840, desktop above - 8 / 12 / 16. The
    // dashboard grid and the proxies group grid both read that one function.
    // The window height never enters it: upstream's density lookup decides
    // type and tile density, while the seam stays the seam.
    //
    // A surface that prices the seam twice - once for the share arithmetic
    // and once for the row spacing - leaves a dead band between the rows and
    // paints card edges that do not line up across rows. Both callers read
    // this one function.
    public pure function card_spacing(page-width: length) -> length {
        if (page-width <= 600 * LumenUiScale.unit) { return 8 * LumenUiScale.unit; }
        if (page-width <= 840 * LumenUiScale.unit) { return 12 * LumenUiScale.unit; }
        return 16 * LumenUiScale.unit;
    }

    // How many profile cards fit side by side at this page-body width.
    //
    // FlClash's profiles grid sizes one card from `profileItemMinWidth = 300.0`
    // and clamps `getProfilesColumns` to three columns; it passes the row gap
    // the grid is already paying, so the same arithmetic is a pure function of
    // room. Exporting the two numbers keeps every surface from stacking cards
    // one per row and leaving the horizontal twin of page dead ground.
    public pure function profile_columns(form: ProfileGridForm, page-width: length, gap: length) -> int {
        if (form == ProfileGridForm.stacked) { return 1; }
        return Math.min(3, Math.max(1, Math.floor((page-width + gap) / (300 * LumenUiScale.unit + gap))));
    }

    // The typed dashboard density for the page body's own room.
    //
    // FlClash resolves `DashboardDensity.of(size)` inside the scaffold's
    // LayoutBuilder, then injects it through a scope so every card asks one
    // fact instead of measuring the window. The exported thresholds below
    // are that decision projected into Slint design units: a page narrower
    // than 640 is mobile, a four-share page narrower than 1040 is compact,
    // and a desktop page shorter than 824 is compact. `is_compact` is the
    // only derived answer the dashboard grid consumes.
    public pure function dashboard_density(page-width: length, page-height: length) -> DashboardDensity {
        if (page-width < 640 * LumenUiScale.unit) { return DashboardDensity.mobile; }
        if ((page-width >= 860 * LumenUiScale.unit && page-width < 1040 * LumenUiScale.unit) || page-height < 824 * LumenUiScale.unit) { return DashboardDensity.compact; }
        return DashboardDensity.standard;
    }

    public pure function dashboard_is_compact(density: DashboardDensity) -> bool {
        return density == DashboardDensity.compact;
    }
}
