        workbench-items: root.workbench-items; workbench-draft <=> root.workbench-draft; workbench-draft-2 <=> root.workbench-draft-2;
        workbench-draft-id: root.workbench-draft-id; workbench-draft-2-id: root.workbench-draft-2-id; workbench-draft-placeholder: root.workbench-draft-placeholder; workbench-draft-2-placeholder: root.workbench-draft-2-placeholder;
