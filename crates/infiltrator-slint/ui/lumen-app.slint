        export-logs => { root.export-logs(); } search-rules(q) => { root.search-rules(q); }
        toggle-rule(i, en) => { root.set-rule-enabled(i, en); } update-provider(id) => { root.update-provider(id); }
        open-clear-dialog => { root.clear-traffic-dialog-open = true; }
