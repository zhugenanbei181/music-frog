        application-dark-mode: root.application-dark-mode; layout-debug-bounds: root.layout-debug-bounds; profile-add-kind-index: root.profile-add-kind-index; profile-type-menu-open: root.profile-type-menu-open; notice: root.notice; pending-delete-name: root.pending-delete-name; profile-settings-id: root.profile-settings-id;
        profile-settings-kind: root.profile-settings-kind; profile-settings-age-configured: root.profile-settings-age-configured; profile-settings-overrides: root.profile-settings-overrides;
        profile-name <=> root.profile-name; profile-url <=> root.profile-url; profile-age-key <=> root.profile-age-key;
        profile-settings-type-index <=> root.profile-settings-type-index; profile-settings-type-menu-open <=> root.profile-settings-type-menu-open;
        profile-settings-name <=> root.profile-settings-name; profile-settings-url <=> root.profile-settings-url; profile-settings-age-key <=> root.profile-settings-age-key;
        close-profile-add => { root.close-profile-add(); }
        confirm-add => {
            if root.profile-add-kind-index == 0 {
                if root.profile-url == "" { root.notice = @tr("请输入订阅链接"); }
                else { root.notice = @tr("正在验证订阅链接…"); root.add-url-profile(root.profile-name, root.profile-url, root.profile-age-key); }
            } else if root.profile-add-kind-index == 1 {
        root.choose-profile-file(root.profile-name, root.profile-age-key); root.close-profile-add();
            }
        }
        toggle-type-menu => { root.profile-type-menu-open = !root.profile-type-menu-open; } select-kind(k) => { root.profile-add-kind-index = k; root.profile-type-menu-open = false; root.notice = ""; }
        choose-file => { root.choose-profile-file(root.profile-name, root.profile-age-key); root.close-profile-add(); } scan-qr => { root.scan-profile-qr(); root.close-profile-add(); }
        close-profile-action => { root.profile-action-open = false; root.profile-action-id = ""; root.profile-action-name = ""; }
        open-editor => { let id = root.profile-action-id; root.profile-action-open = false; root.profile-action-id = ""; root.profile-action-name = ""; if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.page = "Preview"; root.navigate("Preview"); root.show-profile-preview(id); }
        open-settings => { let id = root.profile-action-id; root.profile-action-open = false; root.profile-action-id = ""; root.profile-action-name = ""; root.open-profile-settings(id); }
        refresh-profile => { let id = root.profile-action-id; root.profile-action-open = false; root.profile-action-id = ""; root.profile-action-name = ""; root.refresh-profile(id); }
        close-profile-share => { root.pending-profile-export-id = ""; root.pending-profile-export-name = ""; }
        export-profile => { let id = root.pending-profile-export-id; root.pending-profile-export-id = ""; root.pending-profile-export-name = ""; root.export-profile(id); }
        close-profile-delete => { root.pending-delete-id = ""; root.pending-delete-name = ""; }
        confirm-delete => { let id = root.pending-delete-id; root.pending-delete-id = ""; root.pending-delete-name = ""; root.confirm-delete-profile(id); }
        cancel-profile-settings => { root.profile-settings-type-menu-open = false; root.cancel-profile-settings(); }
        save-profile-settings => { root.save-profile-settings(root.profile-settings-id, root.profile-settings-name, root.profile-settings-url, root.profile-settings-age-key); }
        clear-profile-age-key => { root.clear-profile-age-key(root.profile-settings-id); }
        toggle-override(id, en) => { root.toggle-profile-override(id, en); } move-override(id, up) => { root.move-profile-override(id, up); }
