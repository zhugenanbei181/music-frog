    in-out property <string> connection-detail-duration: "";
    in-out property <string> connection-detail-upload: "";
    in-out property <string> connection-detail-download: "";
    in-out property <bool> connection-detail-active: false;
    in-out property <string> connection-breaking-id: "";
    in-out property <string> log-search: "";
    in-out property <string> log-level: "all";
    in-out property <string> log-stream-status: "未运行";
    in-out property <string> rule-search: "";
    in-out property <string> rule-pending-index: "";
    in-out property <string> stat-down: "0 B/s";
    in-out property <string> stat-up: "0 B/s";
    in-out property <string> stat-down-value: "0";
    in-out property <string> stat-down-unit: "B";
    in-out property <string> stat-up-compact: "0 B";
    in-out property <string> home-current-node: @tr("未知");
    in-out property <string> home-current-accessible: @tr("未知");
    in-out property <string> home-current-flag-code: "";
    in-out property <int> home-current-flag-index: -1;
    in-out property <string> home-current-delay: "—";
    in-out property <string> home-exit-ip: "—";
    in-out property <string> home-exit-country-code: "";
    in-out property <int> home-exit-flag-index: -1;
    in-out property <string> home-exit-status: "";
    in-out property <[HomeTrafficPoint]> home-traffic-points: [];
    in-out property <bool> home-traffic-has-data: false;
    in-out property <string> traffic-stream-status: @tr("未运行");
    in-out property <string> stat-connections: "0";
    in-out property <string> stat-total-down: "0 B";
    in-out property <string> stat-total-up: "0 B";
    in-out property <string> traffic-today-down: "0 B";
    in-out property <string> traffic-today-up: "0 B";
    in-out property <string> traffic-week-down: "0 B";
    in-out property <string> traffic-week-up: "0 B";
    in-out property <string> traffic-week-average-down: "0 B";
    in-out property <string> traffic-week-average-up: "0 B";
    in-out property <[TrafficBar]> traffic-today-bars: [];
    in-out property <[TrafficBar]> traffic-week-bars: [];
    in-out property <bool> traffic-today-has-data: false;
    in-out property <bool> traffic-week-has-data: false;
    in-out property <string> traffic-range: "today";
    in-out property <string> traffic-selected-detail: "";
    in-out property <bool> clear-traffic-dialog-open: false;
    in-out property <[ObservationRow]> traffic-samples: [];
    in-out property <[ObservationRow]> rules: [];
    in-out property <[ObservationRow]> providers: [];
    in-out property <[ObservationRow]> logs: [];
    in-out property <[ObservationRow]> connections: [];
    in-out property <[ProxyGroup]> proxy-groups: [];
    in-out property <[ObservationRow]> proxy-nodes: [];
    in-out property <bool> proxy-recovery-pending: false;
    in-out property <string> proxy-sort-mode: "name_asc";
    in-out property <string> proxy-testing-group: "";
    in-out property <string> proxy-testing-node: "";
    in-out property <string> selected-group: "";
