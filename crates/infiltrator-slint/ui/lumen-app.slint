    in-out property <string> profile-name: "";
    in-out property <string> profile-url: "";
    in-out property <string> profile-age-key: "";
    in-out property <string> proxy-search: "";
    in-out property <string> override-name: "";
    in-out property <string> override-body: "";
    in-out property <string> override-url: "";
    in-out property <bool> override-importing: false;
    in-out property <string> override-import-error: "";
    in-out property <int> override-import-revision: 0;
    in-out property <string> search-text: "";
    in-out property <string> connection-search: "";
    in-out property <string> connection-sort: "time";
    in-out property <bool> connection-show-closed: false;
    in-out property <string> connection-detail-host: "";
    in-out property <string> connection-detail-id: "";
    in-out property <string> connection-detail-protocol: "";
    in-out property <string> connection-detail-process: "";
    in-out property <string> connection-detail-source: "";
    in-out property <string> connection-detail-destination: "";
