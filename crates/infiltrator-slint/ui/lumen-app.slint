    in-out property <[ProfileCard]> profiles: [];
    in-out property <string> profile-action-id: "";
    in-out property <string> profile-action-name: "";
    in-out property <bool> profile-action-open: false;
    in-out property <string> pending-delete-id: "";
    in-out property <string> pending-delete-name: "";
    in-out property <string> pending-profile-export-id: "";
    in-out property <string> pending-profile-export-name: "";
    in-out property <string> profile-settings-id: "";
    in-out property <string> profile-settings-name: "";
    in-out property <string> profile-settings-url: "";
    in-out property <string> profile-settings-location: "";
    in-out property <string> profile-settings-kind: "";
    in-out property <string> profile-settings-age-key: "";
    in-out property <bool> profile-settings-age-configured: false;
    in-out property <bool> profile-settings-saving: false;
    in-out property <int> profile-settings-type-index: 0;
    in-out property <bool> profile-settings-type-menu-open: false;
    in-out property <[ProfileOverrideChoice]> profile-settings-overrides: [];
    in-out property <string> user-agent: "";
    in-out property <string> user-agent-draft: "";
    in-out property <string> user-agent-error: "";
    in-out property <bool> user-agent-dialog-open: false;
    in-out property <bool> user-agent-saving: false;
    in-out property <int> user-agent-save-revision: 0;
    in-out property <int> user-agent-result-revision: 0;
    in-out property <[OverrideCard]> overrides: [];
    in-out property <string> override-edit-id: "";
    in-out property <string> content-preview: "";
    in-out property <string> content-preview-profile: "";
    in-out property <string> core-version: "";
    in-out property <[LicenseRow]> license-rows: []; in-out property <int> license-rows-revision: 0;
    in-out property <string> license-query: ""; in-out property <string> license-catalog-error: "";
    in-out property <string> license-detail-name: ""; in-out property <string> license-detail-version: "";
    in-out property <string> license-detail-identifier: ""; in-out property <string> license-detail-text: "";
    in-out property <string> license-detail-error: ""; in-out property <int> license-detail-revision: 0;
    in-out property <[WorkbenchItem]> workbench-items: []; in-out property <string> workbench-draft: "";
    in-out property <string> workbench-draft-2: ""; in-out property <string> workbench-draft-id: "";
    in-out property <string> workbench-draft-2-id: ""; in-out property <string> workbench-draft-placeholder: "";
    in-out property <string> workbench-draft-2-placeholder: "";

    callback navigate(string); callback color-scheme-changed(bool);
    callback start-runtime(); callback stop-runtime();
    callback set-route-mode(string); callback set-network-mode(string);
    callback check-core(); callback retry-proxy-restore();
    callback add-override(string, string); callback import-override-url(string);
    callback choose-override-file(); callback save-override(string, string);
    callback delete-override(string); callback export-override(string);
    callback edit-override(string);
    callback apply-override(string);
    callback add-url-profile(string, string, string);
    callback choose-profile-file(string, string);
    callback set-current-profile(string);
    callback move-profile(string, bool);
    callback delete-profile(string);
    callback refresh-profile(string);
    callback open-profile-settings(string);
    callback clear-profile-age-key(string);
    callback show-profile-preview(string);
    callback save-profile-settings(string, string, string, string);
    callback cancel-profile-settings();
    callback toggle-profile-override(string, bool);
    callback move-profile-override(string, bool);
    callback select-proxy-group(string);
    callback select-proxy(string, string);
    callback search-proxy-nodes(string);
    callback set-proxy-sort(string);
    callback test-proxy(string, string);
    callback refresh-home-egress();
    callback close-connection(string);
    callback open-connection(string);
    callback search-connections(string);
    callback set-connection-view(bool);
    callback set-connection-sort(string);
    callback search-logs(string);
    callback set-log-level(string);
    callback search-rules(string);
    callback set-rule-enabled(string, bool);
    callback update-provider(string);
    callback export-logs();
    callback refresh-observations();
    callback save-user-agent(string);
    callback set-refresh-profile-on-start(bool);
    callback set-auto-start(bool);
    callback set-theme-mode(string);
    callback set-invert-theme-foreground(bool);
    callback preview-theme-color(float, float, float);
    callback cancel-theme-color-preview();
    callback set-theme-color(string);
    callback set-application-language(string);
    callback set-page-scale(int);
    callback set-hide-bottom-bar-on-scroll(bool);
    callback set-predictive-back-enabled(bool);
    callback set-hide-background-card(bool);
    callback set-show-traffic-notification(bool);
    callback set-release-ui-when-background(bool);
    callback request-ignore-battery-optimization();
    callback cache-back-preview();
    callback commit-back-preview();
    callback confirm-delete-profile(string);
    callback export-profile(string);
    callback scan-profile-qr();
    callback clear-traffic-history();
    callback search-licenses(string);
    callback open-license(string);
    callback retry-license-catalog();
    callback workbench-action(string, string); callback workbench-draft-edited(string, string);

    changed page => { if root.page != "Proxy" && root.selected-group != "" { root.selected-group = ""; } app-body.scroll-to-top(); root.bottom-bar-visible = true; root.update-color-scheme(); }
    changed selected-group => { root.proxy-active-node-position = 0px * LumenUiScale.factor; root.proxy-current-node-available = false; root.update-color-scheme(); root.select-proxy-group(root.selected-group); }
    changed proxy-nodes => { root.proxy-active-node-position = 0px * LumenUiScale.factor; }
    changed profile-add-open => { root.update-color-scheme(); root.profile-type-menu-open = false; if root.profile-add-open { profile-overlays.show-add(); } else { profile-overlays.close-add(); } }
    changed layout-debug-bounds => { LumenTheme.show-layout-bounds = root.layout-debug-bounds; }
    changed user-agent-dialog-open => { if root.user-agent-dialog-open { settings-overlays.show-user-agent(); } else { settings-overlays.close-user-agent-sheet(); } }
    changed profile-action-open => { if root.profile-action-open { profile-overlays.show-action(); } else { profile-overlays.close-action(); } }
    changed pending-delete-id => { if root.pending-delete-id != "" { profile-overlays.show-delete(); } else { profile-overlays.close-delete(); } }
    changed pending-profile-export-id => { if root.pending-profile-export-id != "" { profile-overlays.show-share(); } else { profile-overlays.close-share(); } }
    changed profile-settings-id => { if root.profile-settings-id != "" { root.profile-settings-type-index = 0; root.profile-settings-type-menu-open = false; profile-overlays.show-settings(); } else { root.profile-settings-type-menu-open = false; profile-overlays.close-settings(); } }
    changed back-request-revision => { root.go-back(); }
    changed application-dark-mode => { root.update-color-scheme(); }
    changed platform-dark-mode => { if root.theme-mode == "system" { root.application-dark-mode = root.platform-dark-mode; } }
    changed theme-mode => {
        LumenTheme.forest-mode = root.theme-mode == "forest"; LumenTheme.amoled-mode = root.theme-mode == "amoled";
        if root.theme-mode == "system" { root.application-dark-mode = root.platform-dark-mode; }
        else if root.theme-mode == "dark" || root.theme-mode == "amoled" { root.application-dark-mode = true; }
        else { root.application-dark-mode = false; }
        root.update-color-scheme();
    }
    changed page-scale-percent => { LumenUiScale.factor = root.page-scale-percent / 100.0; }
    changed theme-color => { LumenTheme.user-accent = root.theme-color; MaterialPalette.schemes = LumenTheme.material-schemes; }
    changed theme-color-code => { if root.theme-color-dialog-open && !root.theme-color-code-edited { root.theme-color-code-draft = root.theme-color-input-code; root.theme-color-draft = root.theme-color-input-code; } }
    changed theme-color-input-code => { if root.theme-color-dialog-open && !root.theme-color-code-edited { root.theme-color-code-draft = root.theme-color-input-code; root.theme-color-draft = root.theme-color-input-code; } }
    changed theme-accent-light-foreground => { LumenTheme.accent-foreground = root.theme-accent-light-foreground ? #FFFFFF : #000000; MaterialPalette.schemes = LumenTheme.material-schemes; }
    changed invert-theme-foreground => { LumenTheme.invert-semantic-foreground = root.invert-theme-foreground; MaterialPalette.schemes = LumenTheme.material-schemes; }
    changed theme-color-dialog-open => { if root.theme-color-dialog-open { settings-overlays.show-theme-color(); } else { settings-overlays.close-theme-color-sheet(); } }
    changed page-scale-dialog-open => { if root.page-scale-dialog-open { settings-overlays.show-page-scale(); } else { settings-overlays.close-page-scale-sheet(); if root.page-scale-committing { root.page-scale-committing = false; } else { LumenUiScale.factor = root.page-scale-percent / 100.0; } } }
    changed page-scale-draft => { LumenUiScale.factor = root.page-scale-draft / 100.0; }
    changed profiles => { if root.profile-add-open && root.profiles.length > root.profile-count-at-open { root.close-profile-add(); } }

    function update-color-scheme() { LumenTheme.dark-mode = root.application-dark-mode; MaterialPalette.schemes = LumenTheme.material-schemes; root.color-scheme-changed(root.application-dark-mode); }
    function locate-current-node() { app-body.locate-current-node(root.proxy-active-node-position, root.proxy-current-node-available); }
    function open-profile-add() { root.profile-name = ""; root.profile-url = ""; root.profile-age-key = ""; root.notice = ""; root.profile-add-kind-index = 0; root.profile-type-menu-open = false; root.profile-count-at-open = root.profiles.length; root.profile-add-open = true; }
    function close-profile-add() { root.profile-add-open = false; root.profile-type-menu-open = false; root.profile-name = ""; root.profile-url = ""; root.profile-age-key = ""; root.notice = ""; }

    function go-back() {
        if app-theme-menu.is-open { app-theme-menu.close(); return; }
        if app-language-menu.is-open { app-language-menu.close(); return; }
        proxy-sort-menu.close();
        if root.theme-color-dialog-open { root.theme-color-dialog-open = false; root.cancel-theme-color-preview(); }
        else if root.page-scale-dialog-open { root.page-scale-dialog-open = false; }
        else if root.user-agent-dialog-open { root.user-agent-dialog-open = false; }
        else if root.profile-settings-type-menu-open { root.profile-settings-type-menu-open = false; }
        else if root.profile-type-menu-open { root.profile-type-menu-open = false; }
        else if root.profile-settings-id != "" { root.cancel-profile-settings(); }
        else if root.profile-action-open { root.profile-action-open = false; root.profile-action-id = ""; root.profile-action-name = ""; }
        else if root.pending-profile-export-id != "" { root.pending-profile-export-id = ""; root.pending-profile-export-name = ""; }
        else if root.pending-delete-id != "" { root.pending-delete-id = ""; root.pending-delete-name = ""; }
        else if root.profile-add-open { root.close-profile-add(); }
        else if root.page == "Proxy" && root.selected-group != "" { root.selected-group = ""; root.proxy-search = ""; }
        else if root.page == "ProfileSettings" || root.page == "Preview" { if root.page == "ProfileSettings" { root.cancel-profile-settings(); } if root.predictive-back-enabled { root.commit-back-preview(); } root.page = "Config"; root.navigate("Config"); }
        else if root.page == "ConnectionDetail" { if root.predictive-back-enabled { root.commit-back-preview(); } root.page = "Connections"; root.navigate("Connections"); }
        else if root.page == "LicenseDetail" { if root.predictive-back-enabled { root.commit-back-preview(); } root.page = "Licenses"; root.navigate("Licenses"); }
        else if root.page == "Licenses" { if root.predictive-back-enabled { root.commit-back-preview(); } root.page = "About"; root.navigate("About"); }
        else if root.page == "Network" || root.page == "AppSettings" || root.page == "Overrides" || root.page == "Providers" || root.page == "Meta" || root.page == "Connections" || root.page == "Logs" || root.page == "Rules" || root.page == "Traffic" { if root.predictive-back-enabled { root.commit-back-preview(); } root.page = root.page-origin; root.navigate(root.page-origin); }
        else if root.page == "Home" || root.page == "Proxy" || root.page == "Config" || root.page == "Settings" { }
        else { if root.predictive-back-enabled { root.commit-back-preview(); } root.page = "Settings"; root.navigate("Settings"); }
    }

    app-body := AppBody {
        x: root.safe-area-insets.left; y: root.safe-area-insets.top; width: max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right); height: max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
