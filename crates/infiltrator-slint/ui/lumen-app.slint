    }

    app-theme-menu := PopupMenu {
        x: max(root.safe-area-insets.left + 12px * LumenUiScale.factor, min(root.width - root.safe-area-insets.right - self.width - 12px * LumenUiScale.factor, root.app-theme-anchor-x - self.width));
        y: max(root.safe-area-insets.top, min(root.app-theme-anchor-y, root.height - root.safe-area-insets.bottom - self.height - 12px * LumenUiScale.factor));
        available_width: root.width; show_layout_bounds: root.layout-debug-bounds;
        items: [{ text: @tr("跟随系统"), enabled: true }, { text: @tr("浅色"), enabled: true }, { text: @tr("深色"), enabled: true }, { text: @tr("护眼森林"), enabled: true }, { text: "AMOLED", enabled: true }];
        current_index: root.theme-mode == "light" ? 1 : root.theme-mode == "dark" ? 2 : root.theme-mode == "forest" ? 3 : root.theme-mode == "amoled" ? 4 : 0;
        activated(index) => { root.set-theme-mode(index == 0 ? "system" : index == 1 ? "light" : index == 2 ? "dark" : index == 3 ? "forest" : "amoled"); self.close(); }
    }

    app-language-menu := PopupMenu {
        x: max(root.safe-area-insets.left + 12px * LumenUiScale.factor, min(root.width - root.safe-area-insets.right - self.width - 12px * LumenUiScale.factor, root.app-language-anchor-x - self.width));
        y: max(root.safe-area-insets.top, min(root.app-language-anchor-y, root.height - root.safe-area-insets.bottom - self.height - 12px * LumenUiScale.factor));
        available_width: root.width; show_layout_bounds: root.layout-debug-bounds;
        items: [{ text: @tr("跟随系统"), enabled: true }, { text: @tr("简体中文"), enabled: true }, { text: "English", enabled: true }];
        current_index: root.application-language == "en" || (root.application-language == "system" && root.system-language == "en") ? 2 : root.application-language == "zh-CN" ? 1 : 0;
        activated(index) => { root.set-application-language(index == 0 ? "system" : index == 1 ? "zh-CN" : "en"); self.close(); }
    }

    settings-overlays := SettingsOverlays {
        width: root.width; height: root.height; app-settings-bottom-inset: root.app-settings-bottom-inset; profile-dialog-content-width: root.profile-dialog-content-width; theme-sheet-height: min(540px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.app-settings-bottom-inset - 40px * LumenUiScale.factor));
        user-agent-sheet-height: min(root.user-agent-error == "" ? 260px * LumenUiScale.factor : 320px * LumenUiScale.factor, max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.app-settings-bottom-inset - 60px * LumenUiScale.factor)); android-platform: root.android-platform; layout-debug-bounds: root.layout-debug-bounds; compact-layout: root.compact-layout; product-version: root.product-version; theme-color-error: root.theme-color-error; theme-color-saving: root.theme-color-saving;
        user-agent-error: root.user-agent-error; user-agent-saving: root.user-agent-saving; network-mode-draft-label: root.network-mode-draft-label; network-mode-dialog-open: root.network-mode-dialog-open;
        theme-hue-draft <=> root.theme-hue-draft; theme-saturation-draft <=> root.theme-saturation-draft;
        theme-value-draft <=> root.theme-value-draft; theme-color-code-draft <=> root.theme-color-code-draft;
        theme-color-code-edited <=> root.theme-color-code-edited; page-scale-draft <=> root.page-scale-draft;
        user-agent-draft <=> root.user-agent-draft;
        close-theme-color => { root.theme-color-dialog-open = false; root.cancel-theme-color-preview(); }
        preview-theme-color(h, s, v) => { root.preview-theme-color(h, s, v); }
        set-theme-color(code) => { root.theme-color-saving = true; root.theme-color-error = ""; root.set-theme-color(code); }
        close-page-scale => { root.page-scale-dialog-open = false; }
        apply-page-scale(draft) => { root.page-scale-committing = true; root.page-scale-percent = draft; root.set-page-scale(draft); root.page-scale-dialog-open = false; }
        close-user-agent => { root.user-agent-dialog-open = false; }
        save-user-agent(draft) => { root.user-agent-saving = true; root.user-agent-error = ""; root.save-user-agent(draft); }
        cancel-network-mode => { root.network-mode-dialog-open = false; root.network-mode-draft = ""; }
        confirm-network-mode => { root.set-network-mode(root.network-mode-draft); root.network-mode-dialog-open = false; root.network-mode-draft = ""; }
    }

    if root.notice != "" && !root.profile-add-open: NoticeBanner {
        notice: root.notice; window-width: root.width; window-height: root.height;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        compact-layout: root.compact-layout; primary-page: root.primary-page; bottom-bar-visible: root.bottom-bar-visible;
        close => { root.notice = ""; }
    }

    if root.page == "AppSettings" && root.app-settings-message != "" && root.notice == "" && !root.user-agent-dialog-open && !root.theme-color-dialog-open && !root.page-scale-dialog-open && !app-language-menu.is-open && !app-theme-menu.is-open: SettingsMessageBanner {
        message: root.app-settings-message; window-width: root.width;
        safe-left: root.safe-area-insets.left; safe-right: root.safe-area-insets.right;
        safe-top: root.safe-area-insets.top; safe-bottom: root.safe-area-insets.bottom;
        close => { root.app-settings-message = ""; }
    }

    if root.layout-debug-bounds: Rectangle {
        x: root.safe-area-insets.left; y: root.safe-area-insets.top;
        width: max(0px * LumenUiScale.factor, root.width - root.safe-area-insets.left - root.safe-area-insets.right);
        height: max(0px * LumenUiScale.factor, root.height - root.safe-area-insets.top - root.safe-area-insets.bottom);
        background: transparent; border-width: 1px * LumenUiScale.factor; border-color: #FF2D55; z: 1000;
    }
    app-settings-message-timeout := Timer {
        interval: 5s; running: root.app-settings-message != "";
        triggered => { root.app-settings-message = ""; }
    }
}
