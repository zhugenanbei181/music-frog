        traffic-week-down: root.traffic-week-down; traffic-week-up: root.traffic-week-up; traffic-week-average-down: root.traffic-week-average-down; traffic-week-average-up: root.traffic-week-average-up; traffic-week-has-data: root.traffic-week-has-data; traffic-week-bars: root.traffic-week-bars;
        window-height: root.height; content-preview: root.content-preview; content-preview-profile: root.content-preview-profile;
