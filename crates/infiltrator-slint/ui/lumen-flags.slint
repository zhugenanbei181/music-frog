import { LumenUiScale } from "lumen-ui-scale.slint";
import { LumenTheme } from "./components/theme.slint";

export global FlagImages {
    // One rectangular vector flag per country, in the catalog order of
    // `flag.<code>` / variant `source`; `flag_assets::index_for_code` maps the
    // owner ISO code onto this list. Every asset is the same full-bleed 4:3
    // plate with square corners: the flag is the artwork, and no container
    // rounds, clips, or letterboxes it.
