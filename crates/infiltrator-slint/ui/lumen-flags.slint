export component FlagIcon inherits Rectangle {
    in property <int> index: -1;
    in property <string> country-code;
    // A flag is a 4:3 rectangle, so the box is named for its width. `diameter`
    // was the vendor's name for a circle this surface never draws again.
    in property <length> size: 28 * LumenUiScale.unit;
    width: root.size;
    height: root.size * 3 / 4;
    background: transparent;
    border-width: 0 * LumenUiScale.unit;
    accessible-role: image;
    accessible-label: country-code;
    if root.index >= 0: Image {
        source: FlagImages.flags[root.index];
        x: 0 * LumenUiScale.unit; y: 0 * LumenUiScale.unit; width: parent.width; height: parent.height; image-fit: contain;
    }
    // The debug outline reads the surface's one layout-bounds switch. It used
    // to be an input that none of the six call sites ever fed, so turning the
    // debug frames on left every other frame visible and the flags invisible -
    // a second, silently-off source for the same fact.
    if LumenTheme.show-layout-bounds: Rectangle {
        width: parent.width; height: parent.height;
        background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
        z: 1000;
    }
}
