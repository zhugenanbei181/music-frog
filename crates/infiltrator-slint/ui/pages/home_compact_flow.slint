import { DesignType, TextRole } from "../components/design-type.slint";
import { IconButton, TonalButton } from "@material";
import { CompactPageHeader, HeaderActionCluster } from "../components/base_widgets.slint";
import { AppPreferenceSwitch } from "../components/preferences.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { NetworkMode, RouteMode, RuntimeStatus } from "../components/domain_enums.slint";
import { CountryChip } from "../components/country_chip.slint";
import { PageTitles } from "../components/page_titles.slint";
import { ProfileCard, ProxyGroup } from "../components/models.slint";
import { LayoutTokens } from "../components/layout-tokens.slint";
import { HomeProfileBadge, StatusBadge, SurfaceCard } from "../components/cards.slint";
import {
    AppCardHeader, HomeHeroActionButton, HomeLatencyChip, HomePolicyGroupGrid,
    HomeMetaChip, HomeRouteModePills, ProfileIdentityRow,
} from "home_widgets.slint";
import { DashboardFacts } from "../components/models.slint";
import { HomeHeroFactRow } from "home_fact_row.slint";

export component HomeCompactFlow inherits VerticalLayout {
    in property <RuntimeStatus> runtime-status;
    in property <string> home-exit-status;
    in property <string> home-exit-country-code;
    in property <int> home-exit-flag-index: -1;
    in property <string> home-exit-ip;
    in property <string> stat-up;
    in property <string> stat-down;
    in property <RouteMode> route-mode;
    // One width basis for the whole quick-info grid. Every card in a row
    // takes one equal share of the row, so sibling cards line up on both
    // edges and the page is one grid instead of three content-sized rows.
    property <length> card-column-width: max(0 * LumenUiScale.unit,
        (self.width - (LumenTheme.overview-card-columns - 1) * LumenTheme.overview-card-gap)
            / LumenTheme.overview-card-columns);
    // The owner's typed takeover mode. The two quick switches read their
    // checked state from this enum instead of comparing a label string that
    // no projection ever filled.
    in property <NetworkMode> network-mode;
    in property <bool> tun-capable: true;
    in property <string> active-profile;
    in property <[ProfileCard]> profiles;
    in property <bool> has-current-profile;
    in property <[ProxyGroup]> proxy-groups;
    in property <DashboardFacts> dashboard-facts;

    callback start-runtime();
    callback stop-runtime();
    callback open-overview-order();
    callback navigate(string);
    callback set-route-mode(RouteMode);
    callback set-network-mode(NetworkMode);
    callback select-group(string);

    width: 100%;
    spacing: LumenTheme.space-mobile-card-gap;
    alignment: start;

    // Mobile Header: page name + the one page-level action.
    CompactPageHeader {
        page: "Home";
        HeaderActionCluster {
            IconButton {
                width: 40 * LumenUiScale.unit; height: 40 * LumenUiScale.unit;
                icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/pencil.svg");
                tooltip: @tr("编辑概览卡片顺序");
                clicked => { root.open-overview-order(); }
            }
        }
    }

    // Hero Outbound Card (FlClash Mobile Style)
    SurfaceCard {
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: LumenTheme.space-3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: LumenTheme.space-2;
                HorizontalLayout {
                    spacing: LumenTheme.space-2;
                    cross-axis-alignment: center;
                    Image {
                        source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/activity.svg");
                        width: LumenTheme.card-header-icon-size;
                        height: LumenTheme.card-header-icon-size;
                        image-fit: contain;
                        colorize: LumenTheme.text-secondary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: @tr("状态");
                        color: LumenTheme.text-primary;
                        font-size: DesignType.labelStrong-size;
                        font-weight: DesignType.labelStrong-weight;
                        vertical-alignment: center;
                    }
                    StatusBadge {
                        label: root.runtime-status == RuntimeStatus.running ? @tr("运行中") : @tr("已停止");
                        active: root.runtime-status == RuntimeStatus.running;
                        badge-width: 76 * LumenUiScale.unit;
                    }
                }
                HorizontalLayout {
                    spacing: LumenTheme.space-2;
                    CountryChip {
                        side: 32 * LumenUiScale.unit;
                        flag-index: root.home-exit-flag-index;
                        country-code: root.home-exit-country-code;
                        code-role: TextRole.caption;
                    }
                    Text {
                        text: root.home-exit-ip;
                        font-family: DesignType.monoTitle-family;
                        color: LumenTheme.text-primary;
                        font-size: DesignType.monoTitle-size;
                        font-weight: DesignType.monoTitle-weight;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: LumenTheme.space-2;
                    HomeMetaChip {
                        label: @tr("机房");
                        chip-height: 20 * LumenUiScale.unit;
                    }
                    HomeMetaChip {
                        value: root.dashboard-facts.quality-tag;
                        chip-height: 20 * LumenUiScale.unit;
                    }
                    // The exit-IP caption is a secondary fact, so it rides
                    // with the other secondary chips instead of the status
                    // row. On the phone the status row plus the mascot
                    // column is wider than the card, and the caption used to
                    // push the mascot past the card's own border.
                    if root.home-exit-status != "": Text {
                        text: root.home-exit-status;
                        color: LumenTheme.text-secondary;
                        font-size: DesignType.micro-size;
                        vertical-alignment: center;
                        max-width: LumenTheme.exit-status-max-width;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
            VerticalLayout {
                    padding-right: 8 * LumenUiScale.unit;
                spacing: 2 * LumenUiScale.unit;
                HomeHeroFactRow {
                    uptime-cell: root.dashboard-facts.hero-fact-uptime;
                    organization-cell: root.dashboard-facts.hero-fact-organization;
                }
                }
            }
            // Mobile Fluid Pause / Play Action Button (>=48dp touch target)
            HomeHeroActionButton {
                // The phone tier's one mascot size. The disc is the whole hit
                // surface and the control rides on the character, so the
                // target is the disc itself and never a separate 56u button.
                disc-size: 96 * LumenUiScale.unit;
                y: (parent.height - self.height) / 2;
                start-runtime => { root.start-runtime(); }
                stop-runtime => { root.stop-runtime(); }
            }
        }
    }

    // Network Speed Card (FlClash Mobile Style)
    SurfaceCard {
        AppCardHeader {
            title: @tr("网络速度");
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/activity.svg");
        }
        HorizontalLayout {
            spacing: LumenTheme.space-3;
            // Upload sub-card
            Rectangle {
                horizontal-stretch: 1;
                border-radius: LumenTheme.radius-inset-card;
                background: LumenTheme.zinc-4;
                VerticalLayout {
                    padding: 8 * LumenUiScale.unit;
                    spacing: 4 * LumenUiScale.unit;
                    Text { text: "↑ " + @tr("上传"); color: LumenTheme.status-info; font-size: DesignType.captionStrong-size; font-weight: DesignType.captionStrong-weight; }
                    Text { text: root.stat-up; font-family: DesignType.numericDense-family; color: LumenTheme.text-primary; font-size: DesignType.numericDense-size; font-weight: DesignType.numericDense-weight; horizontal-stretch: 1; overflow: elide; }
                    Text { text: root.dashboard-facts.traffic-total-up; color: LumenTheme.text-secondary; font-size: DesignType.tag-size; }
                }
            }
            // Download sub-card
            Rectangle {
                horizontal-stretch: 1;
                border-radius: LumenTheme.radius-inset-card;
                background: LumenTheme.zinc-4;
                VerticalLayout {
                    padding: 8 * LumenUiScale.unit;
                    spacing: 4 * LumenUiScale.unit;
                    Text { text: "↓ " + @tr("下载"); color: LumenTheme.accent; font-size: DesignType.captionStrong-size; font-weight: DesignType.captionStrong-weight; }
                    Text { text: root.stat-down; font-family: DesignType.numericDense-family; color: LumenTheme.accent; font-size: DesignType.numericDense-size; font-weight: DesignType.numericDense-weight; horizontal-stretch: 1; overflow: elide; }
                    Text { text: root.dashboard-facts.traffic-total-down; color: LumenTheme.text-secondary; font-size: DesignType.tag-size; }
                }
            }
        }
    }

    // Outbound Mode Capsule (Full-width mobile selector)
    SurfaceCard {
        AppCardHeader {
            title: @tr("出站模式");
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg");
        }
        HomeRouteModePills {
            full-width: true;
            route-mode: root.route-mode;
            select(mode) => { root.set-route-mode(mode); }
        }
    }

    // VPN Quick Switch Card (FlClash Mobile Style)
    SurfaceCard {
        HorizontalLayout {
            spacing: LumenTheme.space-3;
            cross-axis-alignment: center;
            Rectangle {
                width: 38 * LumenUiScale.unit;
                height: 38 * LumenUiScale.unit;
                border-radius: 12 * LumenUiScale.unit;
                background: root.network-mode == NetworkMode.system-proxy || root.network-mode == NetworkMode.tun || root.network-mode == NetworkMode.vpn
                    ? LumenTheme.accent-soft
                    : LumenTheme.zinc-4;
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/shield.svg");
                    width: 20 * LumenUiScale.unit;
                    height: 20 * LumenUiScale.unit;
                    image-fit: contain;
                    colorize: root.network-mode == NetworkMode.system-proxy || root.network-mode == NetworkMode.tun || root.network-mode == NetworkMode.vpn
                        ? LumenTheme.accent
                        : LumenTheme.text-muted;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2 * LumenUiScale.unit;
                Text {
                    text: root.network-mode == NetworkMode.tun ? @tr("VPN (TUN)") : @tr("系统代理");
                    color: LumenTheme.text-primary;
                    font-size: DesignType.bodyStrong-size;
                    font-weight: DesignType.bodyStrong-weight;
                }
                Text {
                    text: root.network-mode == NetworkMode.system-proxy || root.network-mode == NetworkMode.tun || root.network-mode == NetworkMode.vpn ? @tr("已开启") : @tr("已关闭");
                    color: LumenTheme.text-secondary;
                    font-size: DesignType.caption-size;
                }
            }
            AppPreferenceSwitch {
                checked: root.network-mode == NetworkMode.system-proxy || root.network-mode == NetworkMode.tun || root.network-mode == NetworkMode.vpn;
                label: @tr("网络接管");
                toggled(enabled) => {
                    root.set-network-mode(enabled ? (root.tun-capable ? NetworkMode.tun : NetworkMode.system-proxy) : NetworkMode.core-only);
                }
            }
        }
    }

    // Quick Info 2x2 Grid: LAN IP, Profile, Service Health, Memory
    HorizontalLayout {
        width: parent.width;
        spacing: LumenTheme.space-3;

        // LAN IP
        SurfaceCard {
            width: root.card-column-width;
            HorizontalLayout {
                AppCardHeader {
                    title: @tr("内网 IP");
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/network.svg");
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.dashboard-facts.lan-ip;
                font-family: LumenTheme.metric-value-family;
                color: LumenTheme.text-primary;
                font-size: LumenTheme.metric-value-size;
                font-weight: LumenTheme.metric-value-weight;
                height: LumenTheme.fact-value-line-height;
                vertical-alignment: bottom;
                overflow: elide;
            }
            Text { text: root.dashboard-facts.lan-shared ? @tr("局域网共享 已开启") : @tr("局域网共享 已关闭"); color: LumenTheme.text-secondary; font-size: DesignType.caption-size; font-weight: DesignType.caption-weight; }
        }

        // Profile Quick Info
        SurfaceCard {
            width: root.card-column-width;
            HorizontalLayout {
                AppCardHeader {
                    title: @tr("配置");
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg");
                    horizontal-stretch: 1;
                }
            }
            ProfileIdentityRow {
                profile-name: root.active-profile;
                source-label: root.dashboard-facts.profile-source-label;
            }
            Text { text: root.dashboard-facts.profile-groups-count + @tr("策略 · ") + root.dashboard-facts.profile-proxies-count + @tr("节点 · ") + root.dashboard-facts.profile-rules-count + @tr("规则"); color: LumenTheme.text-secondary; font-size: DesignType.caption-size; font-weight: DesignType.caption-weight; overflow: elide; }
        }
    }

    HorizontalLayout {
        width: parent.width;
        spacing: LumenTheme.space-3;

        // Service Health 4-mini
        SurfaceCard {
            width: root.card-column-width;
            HorizontalLayout {
                AppCardHeader {
                    title: @tr("服务状态");
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/activity.svg");
                    trailing: root.dashboard-facts.services-summary;
                    trailing-color: LumenTheme.accent;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: LumenTheme.space-2;
                HomeLatencyChip { label: "G"; value: root.dashboard-facts.latency-google; pulse-ink: root.dashboard-facts.latency-google-color; }
                HomeLatencyChip { label: "GH"; value: root.dashboard-facts.latency-github; pulse-ink: root.dashboard-facts.latency-github-color; }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: LumenTheme.space-2;
                HomeLatencyChip { label: "YT"; value: root.dashboard-facts.latency-youtube; pulse-ink: root.dashboard-facts.latency-youtube-color; }
                HomeLatencyChip { label: "AI"; value: root.dashboard-facts.latency-openai; pulse-ink: root.dashboard-facts.latency-openai-color; }
            }
        }

        // Memory
        SurfaceCard {
            width: root.card-column-width;
            HorizontalLayout {
                AppCardHeader {
                    title: @tr("内存信息");
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/settings.svg");
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.dashboard-facts.memory-total;
                font-family: LumenTheme.metric-value-family;
                color: LumenTheme.text-primary;
                font-size: LumenTheme.metric-value-size;
                font-weight: LumenTheme.metric-value-weight;
                height: LumenTheme.fact-value-line-height;
                vertical-alignment: bottom;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 4 * LumenUiScale.unit;
                border-radius: 2 * LumenUiScale.unit;
                background: LumenTheme.zinc-4;
                Rectangle {
                    width: parent.width * root.dashboard-facts.memory-fraction;
                    height: parent.height;
                    border-radius: 2 * LumenUiScale.unit;
                    background: LumenTheme.accent;
                }
            }
            HorizontalLayout {
                spacing: LumenTheme.space-2;
                Text { text: @tr("CPU"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text { text: root.dashboard-facts.cpu-text; color: LumenTheme.text-primary; font-family: LumenTheme.metric-fact-family; font-size: LumenTheme.metric-fact-size; font-weight: LumenTheme.metric-fact-weight; }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 4 * LumenUiScale.unit;
                border-radius: 2 * LumenUiScale.unit;
                background: LumenTheme.zinc-4;
                Rectangle {
                    width: parent.width * root.dashboard-facts.cpu-fraction;
                    height: parent.height;
                    border-radius: 2 * LumenUiScale.unit;
                    background: LumenTheme.ping-good;
                }
            }
        }
    }

    // Policy Groups Card: the same two-column quick grid the desktop dashboard
    // mounts, so a phone can switch an outbound without leaving the overview.
    SurfaceCard {
        HomePolicyGroupGrid {
            proxy-groups: root.proxy-groups;
            tile-height: 44 * LumenUiScale.unit;
            select-group(name) => { root.select-group(name); }
        }
    }

    // The page action is the same action the compact grid variant shows, so it
    // reads the one touch-target authority instead of spelling its height.
    TonalButton {
        text: @tr("调整卡片顺序");
        height: LumenTheme.min-touch-target;
        horizontal-stretch: 1;
        clicked => { root.open-overview-order(); }
    }
}
