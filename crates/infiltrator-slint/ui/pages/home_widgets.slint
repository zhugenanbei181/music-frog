import { DesignType, TextRole } from "../components/design-type.slint";
import { LayoutTokens } from "../components/layout-tokens.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { ConnectionRow, DashboardFacts, ObservationRow, ProxyGroup } from "../components/models.slint";
import { RouteMode, RuntimeStatus } from "../components/domain_enums.slint";
import { FlagIcon } from "../lumen-flags.slint";
import { ListRule } from "../components/base_widgets.slint";
import { MusicFrogHero } from "../components/mascot.slint";

// The dashboard card's title row: one icon, one title, one trailing affordance.
//
// The reference dashboard names every card with a line icon; this surface used
// to print bare text plus a raw ">" and a clipboard emoji that the font has no
// glyph for. One component keeps the hierarchy identical on every card and on
// both tiers, and the chevron is a real vector icon.
export component AppCardHeader inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <string> glyph: "";
    in property <color> icon-color: LumenTheme.text-secondary;
    in property <string> trailing: "";
    in property <color> trailing-color: LumenTheme.text-secondary;
    in property <bool> chevron: false;
    in property <bool> actionable: false;
    property <length> title-size: LumenTheme.card-header-title-size;
    callback clicked();

    height: LumenTheme.card-header-height;
    background: transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { if root.actionable { root.clicked(); } }

    HorizontalLayout {
        width: parent.width;
        spacing: LumenTheme.space-2;
        padding-right: LumenTheme.card-header-trailing-inset;
        if root.glyph != "": Text {
            text: root.glyph;
            color: root.icon-color;
            font-size: root.title-size;
            font-weight: DesignType.weight(TextRole.caption);
            font-family: DesignType.family(TextRole.caption);
            vertical-alignment: center;
        }
        if root.icon.width > 0: Image {
            source: root.icon;
            width: LumenTheme.card-header-icon-size;
            height: LumenTheme.card-header-icon-size;
            image-fit: contain;
            colorize: root.icon-color;
            vertical-alignment: center;
        }
        title-text := Text {
            text: root.title;
            color: root.actionable && (touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.text-primary : LumenTheme.text-secondary;
            font-size: root.title-size;
            font-weight: DesignType.weight(TextRole.caption);
            font-family: DesignType.family(TextRole.caption);
            vertical-alignment: center;
            overflow: elide;
            // The title claims the slack. It used to have no stretch while a
            // stretch-1 spacer sat beside it, so an eliding Text collapsed to
            // its minimum width and the dense tier showed "服…" for 服务状态.
            horizontal-stretch: 1;
            animate color { duration: 120ms; easing: ease-out; }
        }
        if root.trailing != "": Text {
            text: root.trailing;
            color: root.trailing-color;
            font-size: DesignType.micro-size;
            font-weight: DesignType.micro-weight;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.chevron: Image {
            source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg");
            width: LumenTheme.card-header-chevron-size;
            height: LumenTheme.card-header-chevron-size;
            image-fit: contain;
            colorize: root.actionable && (touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.accent : LumenTheme.text-muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.actionable;
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.actionable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The speed card's waveform band. The path comes from the owner's typed
// waveform projection, so neither layout redraws a synthetic curve of its own.
export component HomeWaveBand inherits Rectangle {
    in property <string> commands;
    in property <color> ink;
    in property <length> band-height: 36 * LumenUiScale.unit;

    height: root.band-height;
    clip: true;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 32;
        commands: root.commands;
        fill: root.ink.with_alpha(38%);
        stroke: root.ink;
        stroke-width: 1.5 * LumenUiScale.unit;
    }
}

// The hero's run/stop control is now the product mascot. The name is kept as
// the one page-facing entry point so desktop, tablet and phone cannot fork a
// second hero; every instance reads the same typed spec and emits the same
// typed intent. See components/mascot.slint.
export component HomeHeroActionButton inherits MusicFrogHero {
}

// The dashboard's shared service-latency chip: a service badge plus its
// measured latency. One theme-owned geometry trims the dot, label and value
// gaps so the owner's full four-digit probe string stays inside the chip.
export component HomeLatencyChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> pulse-ink: LumenTheme.text-muted;
    in property <bool> observed: root.value != "—" && root.value != "";
    horizontal-stretch: 1;
    height: LumenTheme.latency-chip-height;
    border-radius: LumenTheme.latency-chip-radius;
    background: root.observed ? ((touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.surface-raised : LumenTheme.zinc-4) : LumenTheme.zinc-3;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        x: LumenTheme.latency-chip-inset;
        width: max(0 * LumenUiScale.unit, parent.width - 2 * LumenTheme.latency-chip-inset);
        spacing: LumenTheme.latency-chip-gap;
        Rectangle {
            width: LumenTheme.latency-chip-pulse-size;
            height: LumenTheme.latency-chip-pulse-size;
            border-radius: LumenTheme.latency-chip-pulse-size / 2;
            y: (parent.height - self.height) / 2;
            background: root.pulse-ink;
        }
        Text {
            width: LumenTheme.latency-chip-label-width;
            text: root.label;
            font-weight: DesignType.weight(TextRole.micro);
            color: LumenTheme.text-primary;
            font-size: DesignType.size(TextRole.micro);
            font-family: DesignType.family(TextRole.micro);
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.value;
            font-family: DesignType.family(TextRole.monoTag);
            color: root.observed ? LumenTheme.status-info : LumenTheme.text-muted;
            font-size: DesignType.size(TextRole.monoTag);
            font-weight: DesignType.weight(TextRole.monoTag);
            vertical-alignment: center;
            // The number is right-aligned inside the chip: every chip in the
            // grid is the same width, but their labels are not ("G" vs "GH"),
            // so a left-aligned value started at a different column in each
            // chip and the four latencies never formed a column. Right-aligned,
            // the digits share one edge across the whole grid.
            horizontal-alignment: right;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: default;
    }
}

export component HomeMetaChip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> chip-height: 22 * LumenUiScale.unit;
    in property <length> chip-font-size: DesignType.micro-size;

    // The hero's meta chips used to be bare Rectangles in a HorizontalLayout.
    // A Rectangle has no implicit width, so the layout stretched them into two
    // long empty bars that read as skeleton placeholders. A chip now hugs the
    // text it actually carries, the way the reference's pills do.
    horizontal-stretch: 0;
    width: chip-text.preferred-width + 18 * LumenUiScale.unit;
    height: root.chip-height;
    border-radius: 4 * LumenUiScale.unit;
    background: LumenTheme.zinc-4;

    chip-text := Text {
        width: parent.width;
        height: parent.height;
        text: root.value == "" ? root.label : root.label + " " + root.value;
        color: LumenTheme.text-secondary;
        font-size: root.chip-font-size;
        font-weight: DesignType.micro-weight;
        font-family: DesignType.micro-family;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The profile card's identity row, shaped after FlClash's `ProfilesCard`:
// the name owns the slack while the shared owner's localized origin sits at
// the end of the same baseline. One component keeps desktop and phone from
// inventing two placements for the same fact.
export component ProfileIdentityRow inherits HorizontalLayout {
    in property <string> profile-name;
    in property <string> source-label;

    spacing: LumenTheme.space-2;
    height: LumenTheme.fact-value-line-height;
    alignment: center;

    Text {
        text: root.profile-name;
        color: LumenTheme.text-primary;
        font-size: LumenTheme.profile-name-size;
        font-weight: LumenTheme.profile-name-weight;
        horizontal-stretch: 1;
        min-width: 0 * LumenUiScale.unit;
        overflow: elide;
        vertical-alignment: bottom;
    }
    Text {
        text: root.source-label;
        color: LumenTheme.text-secondary;
        font-size: DesignType.caption-size;
        font-weight: DesignType.caption-weight;
        horizontal-stretch: 0;
        min-width: 0 * LumenUiScale.unit;
        max-width: LumenTheme.profile-name-max-width / 2;
        vertical-alignment: bottom;
        overflow: elide;
    }
}

// The dashboard's live connection mini table: the owner's active connection
// rows, the shared counters and no row the owner did not publish.
export component HomeConnectionMiniTable inherits VerticalLayout {
    in property <DashboardFacts> dashboard-facts;
    in property <[ConnectionRow]> connections;
    // The seven columns are one stretch vocabulary, not a page-derived
    // `column-unit`. Slint distributes the same 8/16/3/5/6/6/4 weights in the
    // header and every row, so a parent layout guess can no longer make the
    // column edges drift or overflow the card. The weights themselves are
    // generated from `TextRole::CONNECTION_COLUMN_WEIGHTS` in the contract.
    callback open-connections();
    callback open-dns();

    spacing: LumenTheme.space-2;
    alignment: start;

    // One width owner for the whole table. The caller supplies the width
    // the card has already measured, so the table never reads its own
    // `width` (that would form a layout binding loop). The seven generated
    // fractions are multiplied HERE, once, and the header and every body
    // row read the resulting lengths. `horizontal-stretch` could not do
    // this job: it distributes the slack left over after each child takes
    // its preferred width, so a 2-glyph CJK header and a long mono address
    // in the same column ended up with different column edges (measured
    // 59px drift between the header and row 1).
    in property <length> table-content-width: 600 * LumenUiScale.unit;
    property <length> column-content-width: max(0 * LumenUiScale.unit,
        min(root.table-content-width, LumenTheme.viewport-width) - 20 * LumenUiScale.unit - 6 * LumenTheme.space-2);
    property <length> column-1: root.column-content-width * LayoutTokens.connection-column-1;
    property <length> column-2: root.column-content-width * LayoutTokens.connection-column-2;
    property <length> column-3: root.column-content-width * LayoutTokens.connection-column-3;
    property <length> column-4: root.column-content-width * LayoutTokens.connection-column-4;
    property <length> column-5: root.column-content-width * LayoutTokens.connection-column-5;
    property <length> column-6: root.column-content-width * LayoutTokens.connection-column-6;
    property <length> column-7: root.column-content-width * LayoutTokens.connection-column-7;

    HorizontalLayout {
        spacing: LumenTheme.space-2;
        height: 28 * LumenUiScale.unit;
        // Tab 1: 实时连接 (active pill)
        Rectangle {
            height: 28 * LumenUiScale.unit;
            border-radius: 14 * LumenUiScale.unit;
            background: LumenTheme.selection;
            width: conn-tab-text.preferred-width + 24 * LumenUiScale.unit;
            conn-tab-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.dashboard-facts.connection-count + " " + @tr("实时连接");
                color: LumenTheme.accent-foreground;
                font-size: DesignType.captionStrong-size;
                font-weight: DesignType.captionStrong-weight;
                font-family: DesignType.captionStrong-family;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-connections(); }
            }
        }
        // Tab 2: 最近请求
        Rectangle {
            height: 28 * LumenUiScale.unit;
            border-radius: 14 * LumenUiScale.unit;
            background: (req-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-3 : LumenTheme.zinc-4;
            animate background { duration: 120ms; easing: ease-out; }
            width: req-tab-text.preferred-width + 24 * LumenUiScale.unit;
            req-tab-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.dashboard-facts.request-count + " " + @tr("最近请求");
                color: LumenTheme.text-secondary;
                font-size: DesignType.caption-size;
                font-weight: DesignType.caption-weight;
                font-family: DesignType.caption-family;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            req-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-connections(); }
            }
        }
        // Tab 3: DNS 查询
        Rectangle {
            height: 28 * LumenUiScale.unit;
            border-radius: 14 * LumenUiScale.unit;
            background: (dns-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-3 : LumenTheme.zinc-4;
            animate background { duration: 120ms; easing: ease-out; }
            width: dns-tab-text.preferred-width + 24 * LumenUiScale.unit;
            dns-tab-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.dashboard-facts.dns-query-count + " " + @tr("DNS查询");
                font-family: DesignType.caption-family;
                font-size: DesignType.caption-size;
                font-weight: DesignType.caption-weight;
                color: LumenTheme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            dns-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-dns(); }
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        // Badge: TCP / UDP counts matching FlClash
        Rectangle {
            height: 24 * LumenUiScale.unit;
            border-radius: 6 * LumenUiScale.unit;
            background: LumenTheme.zinc-4;
            y: (parent.height - self.height) / 2;
            width: tcp-count-text.preferred-width + 16 * LumenUiScale.unit;
            tcp-count-text := Text {
                width: parent.width;
                height: parent.height;
                text: "TCP " + root.dashboard-facts.connection-count;
                font-family: DesignType.monoMicro-family;
                font-size: DesignType.monoMicro-size;
                font-weight: DesignType.monoMicro-weight;
                color: LumenTheme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // The reference renders live connections as a real table: source,
    // destination, protocol, outbound, download, upload, duration. Every
    // column has one fixed width, shared by the header and every row, so
    // the column edges cannot drift with the text inside them. The unit is
    // passed in by the caller from the card width rather than bound to this
    // component's own width (which would form a layout binding loop).
    // The duration stays the honest unknown until the owner publishes a
    // time base; the column is kept so the table will not reflow.
    HorizontalLayout {
        padding-left: 10 * LumenUiScale.unit;
        padding-right: 10 * LumenUiScale.unit;
        spacing: LumenTheme.space-2;
        height: 24 * LumenUiScale.unit;
        Text { text: @tr("来源"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-1; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("目标"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-2; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("协议"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-3; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("出口"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-4; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("下载"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-5; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("上传"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-6; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Text { text: @tr("时长"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; width: root.column-7; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
    // One separator dialect: the mini table used to draw its own hairline
    // from `border.with_alpha(15%)`, which is a stroke colour wearing a seam's
    // job - a third separator tier next to `row-divider`. The seam is ListRule.
    ListRule {}
    for connection in root.connections: Rectangle {
        height: 30 * LumenUiScale.unit;
        border-radius: 6 * LumenUiScale.unit;
        background: LumenTheme.zinc-2;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.hairline-glow;
        HorizontalLayout {
            padding-left: 10 * LumenUiScale.unit;
            padding-right: 10 * LumenUiScale.unit;
            spacing: LumenTheme.space-2;
            height: parent.height;
            Text { text: connection.source; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-1; height: parent.height; vertical-alignment: center; overflow: elide; }
            Text { text: connection.destination; color: LumenTheme.text-primary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; font-weight: DesignType.monoMicro-weight; width: root.column-2; height: parent.height; vertical-alignment: center; overflow: elide; }
            Text { text: connection.protocol; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-3; height: parent.height; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            Text { text: connection.outbound; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-4; height: parent.height; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            Text { text: connection.download; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-5; height: parent.height; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
            Text { text: connection.upload; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-6; height: parent.height; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
            Text { text: connection.duration; color: LumenTheme.text-secondary; font-size: DesignType.monoMicro-size; font-family: DesignType.monoMicro-family; width: root.column-7; height: parent.height; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
        }
    }
    if root.connections.length == 0: Text {
        text: @tr("暂无实时连接");
        color: LumenTheme.text-muted;
        font-size: DesignType.micro-size;
        font-weight: DesignType.micro-weight;
        font-family: DesignType.micro-family;
    }
    ListRule {}
}

// One pill of the outbound-mode selector. The selection is the owner's
// routing intent, never a local bit: the pill only reads `selected` and only
// reports a tap.
component HomeRouteModePill inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> pill-width: 58 * LumenUiScale.unit;
    in property <length> pill-height: 30 * LumenUiScale.unit;
    in property <length> font-size: DesignType.caption-size;
    callback clicked();

    width: root.pill-width;
    height: root.pill-height;
    border-radius: root.pill-height / 2;
    background: root.selected
        ? LumenTheme.accent
        : ((touch.has-hover && LumenTheme.hover-allowed) && root.enabled ? LumenTheme.zinc-3 : transparent);
    animate background { duration: 150ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 4 * LumenUiScale.unit;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 14 * LumenUiScale.unit;
            height: 14 * LumenUiScale.unit;
            image-fit: contain;
            colorize: root.selected ? LumenTheme.accent-foreground : LumenTheme.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.selected ? LumenTheme.accent-foreground : LumenTheme.text-secondary;
            font-size: root.font-size;
            font-weight: DesignType.weight(root.selected ? TextRole.captionStrong : TextRole.caption);
            font-family: DesignType.family(root.selected ? TextRole.captionStrong : TextRole.caption);
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// The dashboard's outbound-mode selector. Both the compact flow and the
// desktop grid mount this one component so a tap always submits the shared
// typed route-mode intent; a surface can no longer render the three pills as
// decoration while the other wires them.
export component HomeRouteModePills inherits Rectangle {
    in property <RouteMode> route-mode;
    in property <bool> enabled: true;
    in property <length> pill-width: 58 * LumenUiScale.unit;
    in property <length> pill-height: 30 * LumenUiScale.unit;
    in property <length> font-size: DesignType.caption-size;
    in property <bool> full-width: false;
    callback select(RouteMode);

    property <length> effective-pill-width: root.full-width ? (self.width - 8 * LumenUiScale.unit) / 3 : root.pill-width;
    property <length> effective-pill-height: root.full-width ? 36 * LumenUiScale.unit : root.pill-height;

    horizontal-stretch: root.full-width ? 1 : 0;
    min-width: 3 * root.pill-width + 8 * LumenUiScale.unit;
    preferred-width: root.full-width ? 10000 * LumenUiScale.unit : (3 * root.pill-width + 8 * LumenUiScale.unit);
    max-width: root.full-width ? 10000 * LumenUiScale.unit : (3 * root.pill-width + 8 * LumenUiScale.unit);
    height: root.effective-pill-height + 4 * LumenUiScale.unit;
    border-radius: root.full-width ? 14 * LumenUiScale.unit : (root.pill-height + 4 * LumenUiScale.unit) / 2;
    background: LumenTheme.zinc-4;

    HorizontalLayout {
        x: 2 * LumenUiScale.unit;
        y: 2 * LumenUiScale.unit;
        width: parent.width - 4 * LumenUiScale.unit;
        height: parent.height - 4 * LumenUiScale.unit;
        spacing: 2 * LumenUiScale.unit;
        HomeRouteModePill {
            label: @tr("规则");
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg");
            selected: root.route-mode == RouteMode.rule;
            enabled: root.enabled;
            pill-width: root.effective-pill-width;
            pill-height: root.effective-pill-height;
            font-size: root.font-size;
            clicked => { root.select(RouteMode.rule); }
        }
        HomeRouteModePill {
            label: @tr("全局");
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/globe.svg");
            selected: root.route-mode == RouteMode.global;
            enabled: root.enabled;
            pill-width: root.effective-pill-width;
            pill-height: root.effective-pill-height;
            font-size: root.font-size;
            clicked => { root.select(RouteMode.global); }
        }
        HomeRouteModePill {
            label: @tr("直连");
            icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg");
            selected: root.route-mode == RouteMode.direct;
            enabled: root.enabled;
            pill-width: root.effective-pill-width;
            pill-height: root.effective-pill-height;
            font-size: root.font-size;
            clicked => { root.select(RouteMode.direct); }
        }
    }
}

// One tile of the policy grid: the group's own avatar, its name, and the
// outbound the owner currently selected for it, with that node's flag.
component HomePolicyGroupTile inherits Rectangle {
    in property <ProxyGroup> group;
    in property <length> tile-height: 44 * LumenUiScale.unit;
    callback clicked();

    height: root.tile-height;
    border-radius: 10 * LumenUiScale.unit;
    background: (touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.zinc-3 : LumenTheme.zinc-4;
    animate background { duration: 120ms; easing: ease-out; }
    border-width: 1 * LumenUiScale.unit;
    border-color: LumenTheme.hairline-glow;
    accessible-role: button;
    accessible-label: root.group.name;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        x: LumenTheme.policy-tile-inset;
        width: max(0 * LumenUiScale.unit, parent.width - 2 * LumenTheme.policy-tile-inset);
        spacing: LumenTheme.policy-tile-gap;
        Rectangle {
            width: LumenTheme.policy-tile-avatar-size; height: LumenTheme.policy-tile-avatar-size;
            border-radius: LumenTheme.policy-tile-avatar-size / 2;
            background: LumenTheme.zinc-3;
            y: (parent.height - self.height) / 2;
            Text {
                text: root.group.icon-emoji != "" ? root.group.icon-emoji : root.group.name;
                font-size: DesignType.micro-size;
                font-weight: DesignType.micro-weight;
                color: LumenTheme.text-primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                overflow: elide;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1 * LumenUiScale.unit;
            alignment: center;
            Text {
                text: root.group.name;
                font-size: DesignType.caption-size;
                font-weight: DesignType.caption-weight;
                color: LumenTheme.text-primary;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 4 * LumenUiScale.unit;
                if root.group.current-flag-index >= 0: FlagIcon {
                    index: root.group.current-flag-index;
                    country-code: root.group.current-flag-code;
                    diameter: 12 * LumenUiScale.unit;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.group.current;
                    font-size: DesignType.tag-size;
                    color: LumenTheme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The dashboard's policy group quick grid: the owner's published groups and
// their currently selected outbound, never a hardcoded group list. Two
// columns on every surface, so a long group list reads as a grid instead of
// one squeezed row, and a tile opens that group.
export component HomePolicyGroupGrid inherits VerticalLayout {
    in property <[ProxyGroup]> proxy-groups;
    in property <length> tile-height: 44 * LumenUiScale.unit;
    in property <bool> show-header: true;
    in property <image> header-icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg");
    callback select-group(string);
    callback open-proxies();

    spacing: LumenTheme.space-2;
    alignment: start;

    if root.show-header: HorizontalLayout {
        AppCardHeader {
            title: @tr("策略组");
            icon: root.header-icon;
            trailing: "" + root.proxy-groups.length;
            trailing-color: LumenTheme.accent;
            chevron: true;
            actionable: true;
            horizontal-stretch: 1;
            clicked => { root.open-proxies(); }
        }
    }
    GridLayout {
        spacing: LumenTheme.space-2;
        for group[index] in root.proxy-groups: HomePolicyGroupTile {
            col: Math.mod(index, 2);
            row: index / 2;
            tile-height: root.tile-height;
            group: group;
            clicked => { root.select-group(group.name); }
        }
    }
}
