import { ScrollView } from "std-widgets.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { LicenseRow } from "../components/models.slint";
import { PillButton, SearchField } from "../components/base_widgets.slint";
import { SectionCard } from "../components/cards.slint";

export component PagePreview inherits VerticalLayout {
    in property <length> window-height;
    in property <length> safe-top;
    in property <length> safe-bottom;
    in property <string> content-preview;

    width: 100%;
    spacing: LumenTheme.space-2;

    HorizontalLayout {
        width: parent.width;
        height: 28 * LumenUiScale.unit;
        spacing: LumenTheme.space-2;
        Text {
            text: @tr("有效配置");
            color: LumenTheme.text-primary;
            font-size: 16 * LumenUiScale.unit;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }
        Rectangle {
            width: 48 * LumenUiScale.unit;
            height: 24 * LumenUiScale.unit;
            border-radius: 12 * LumenUiScale.unit;
            background: LumenTheme.surface-muted;
            Text {
                text: @tr("只读");
                width: parent.width;
                height: parent.height;
                color: LumenTheme.text-secondary;
                font-size: 12 * LumenUiScale.unit;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Text {
        text: @tr("敏感字段已遮蔽 · 修改行为请使用覆写配置");
        color: LumenTheme.text-secondary;
        font-size: 12 * LumenUiScale.unit;
        wrap: word-wrap;
    }
    Rectangle {
        width: parent.width;
        height: max(420 * LumenUiScale.unit, root.window-height - root.safe-top - root.safe-bottom - 168 * LumenUiScale.unit);
        border-radius: 8 * LumenUiScale.unit;
        border-width: 1 * LumenUiScale.unit;
        border-color: LumenTheme.border;
        background: LumenTheme.surface;
        ScrollView {
            x: 10 * LumenUiScale.unit;
            y: 8 * LumenUiScale.unit;
            width: parent.width - 20 * LumenUiScale.unit;
            height: parent.height - 16 * LumenUiScale.unit;
            Text {
                text: root.content-preview;
                color: LumenTheme.text-primary;
                font-family: LumenTheme.mono-family;
                font-size: 12 * LumenUiScale.unit;
                wrap: word-wrap;
            }
        }
    }
}

export component PageAbout inherits VerticalLayout {
    in property <bool> android-platform;
    in property <string> product-version;
    in property <string> core-version;

    callback open-licenses();

    width: 100%;
    spacing: LumenTheme.space-4;

    SectionCard {
        heading: "MusicFrog Infiltrator";
        detail: @tr("版本 ") + root.product-version + @tr(" · Mihomo ") + root.core-version;
        Text {
            text: @tr("跨平台 Mihomo 客户端，使用 Rust + Slint。");
            color: LumenTheme.text-secondary;
            font-size: 13 * LumenUiScale.unit;
        }
        Text {
            text: @tr("界面改编自 Lumen；上游 README 声明采用 MIT，导入归档未附独立许可证文本。");
            color: LumenTheme.text-secondary;
            font-size: 13 * LumenUiScale.unit;
            wrap: word-wrap;
        }
        Text {
            text: @tr("代理节点旗帜图形使用 Twemoji，© Twitter, Inc. 和贡献者，CC BY 4.0。");
            color: LumenTheme.text-secondary;
            font-size: 13 * LumenUiScale.unit;
            wrap: word-wrap;
        }
        if root.android-platform: Text {
            text: @tr("Mihomo v1.19.33 是独立 GPL-3.0 核心进程，随本 ABI APK 提供；在依赖许可列表中搜索 Mihomo Core 可查看许可证和源码标签。");
            color: LumenTheme.text-secondary;
            font-size: 13 * LumenUiScale.unit;
            wrap: word-wrap;
        }
        if !root.android-platform: Text {
            text: @tr("Mihomo 核心由用户安装在 PATH 中。第三方依赖许可正文随应用离线提供。");
            color: LumenTheme.text-secondary;
            font-size: 13 * LumenUiScale.unit;
        }
        PillButton {
            label: @tr("查看第三方依赖许可");
            clicked => { root.open-licenses(); }
        }
    }
}

export component PageLicenses inherits VerticalLayout {
    in-out property <string> license-query;
    in property <[LicenseRow]> license-rows;
    in property <string> license-catalog-error;

    callback back-about();
    callback search(string);
    callback retry-catalog();
    callback select-license(LicenseRow);

    width: 100%;
    spacing: LumenTheme.space-4;

    SectionCard {
        heading: @tr("第三方依赖许可证");
        detail: @tr("按依赖名、版本或 SPDX 许可证标识搜索");
        PillButton {
            label: @tr("返回关于");
            clicked => { root.back-about(); }
        }
        SearchField {
            placeholder: @tr("搜索依赖或 SPDX 标识");
            text <=> root.license-query;
            search(query) => { root.search(query); }
        }
        Text {
            text: @tr("匹配 ") + root.license-rows.length + @tr(" 项");
            color: LumenTheme.text-secondary;
            font-size: 12 * LumenUiScale.unit;
        }
        if root.license-catalog-error != "": Rectangle {
            border-radius: LumenTheme.radius-control;
            background: LumenTheme.error.with_alpha(15%);
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.error;
            HorizontalLayout {
                padding: LumenTheme.space-2;
                spacing: LumenTheme.space-2;
                cross-axis-alignment: center;
                Text { text: "⚠"; color: LumenTheme.error; font-size: 14 * LumenUiScale.unit; }
                Text {
                    text: @tr("无法读取内置许可证清单：") + root.license-catalog-error;
                    color: LumenTheme.error;
                    font-size: 12 * LumenUiScale.unit;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                PillButton {
                    label: @tr("重试");
                    clicked => { root.retry-catalog(); }
                }
            }
        }
        if root.license-rows.length == 0 && root.license-catalog-error == "": Rectangle {
            height: 64 * LumenUiScale.unit;
            border-radius: LumenTheme.radius-control;
            background: LumenTheme.surface-muted;
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.border;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.license-query == "" ? @tr("当前许可证清单为空") : (@tr("没有匹配到依赖：") + root.license-query);
                    color: LumenTheme.text-secondary;
                    font-size: 13 * LumenUiScale.unit;
                    horizontal-alignment: center;
                }
            }
        }
        for item in root.license-rows: Rectangle {
            height: 64 * LumenUiScale.unit;
            border-radius: LumenTheme.radius-control;
            background: lic-touch.has-hover ? LumenTheme.surface-raised : LumenTheme.surface;
            border-width: 1 * LumenUiScale.unit;
            border-color: lic-touch.has-hover ? LumenTheme.accent : LumenTheme.border;
            animate background, border-color { duration: 120ms; easing: ease-out; }

            lic-touch := TouchArea {
                clicked => { root.select-license(item); }
            }

            VerticalLayout {
                x: 14 * LumenUiScale.unit;
                y: 8 * LumenUiScale.unit;
                width: parent.width - 28 * LumenUiScale.unit;
                height: parent.height - 16 * LumenUiScale.unit;
                spacing: 3 * LumenUiScale.unit;
                Text {
                    text: item.name + "  " + item.version;
                    color: LumenTheme.text-primary;
                    font-size: 13 * LumenUiScale.unit;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: item.identifier;
                    color: LumenTheme.text-secondary;
                    font-size: 11 * LumenUiScale.unit;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component PageLicenseDetail inherits VerticalLayout {
    in property <string> license-detail-name;
    in property <string> license-detail-version;
    in property <string> license-detail-identifier;
    in property <string> license-detail-error;
    in property <string> license-detail-text;

    callback back-licenses();
    callback retry-read();

    width: 100%;
    spacing: LumenTheme.space-4;

    SectionCard {
        heading: root.license-detail-name + "  " + root.license-detail-version;
        detail: @tr("许可证标识：") + root.license-detail-identifier;
        PillButton {
            label: @tr("返回许可证列表");
            clicked => { root.back-licenses(); }
        }
        if root.license-detail-error != "": Rectangle {
            border-radius: LumenTheme.radius-control;
            background: LumenTheme.error.with_alpha(15%);
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.error;
            HorizontalLayout {
                padding-left: 12 * LumenUiScale.unit;
                padding-right: 12 * LumenUiScale.unit;
                padding-top: 8 * LumenUiScale.unit;
                padding-bottom: 8 * LumenUiScale.unit;
                spacing: 8 * LumenUiScale.unit;
                cross-axis-alignment: center;
                Text { text: "⚠"; color: LumenTheme.error; font-size: 16 * LumenUiScale.unit; }
                Text {
                    text: root.license-detail-error;
                    color: LumenTheme.error;
                    font-size: 13 * LumenUiScale.unit;
                    font-weight: 500;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                PillButton {
                    label: @tr("重试读取");
                    clicked => { root.retry-read(); }
                }
            }
        }
        Text {
            text: @tr("许可证全文可选择并复制；Windows/Linux 可使用 Ctrl+C。");
            color: LumenTheme.text-secondary;
            font-size: 12 * LumenUiScale.unit;
        }
        Rectangle {
            height: 560 * LumenUiScale.unit;
            border-radius: 8 * LumenUiScale.unit;
            background: LumenTheme.surface-muted;
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.border;

            ScrollView {
                HorizontalLayout {
                    padding: 12 * LumenUiScale.unit;
                    Text {
                        text: root.license-detail-text;
                        color: LumenTheme.text-primary;
                        font-family: LumenTheme.mono-family;
                        font-size: 12 * LumenUiScale.unit;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
