import { DesignType } from "../components/design-type.slint";
import { FilledButton, TonalButton } from "@material";
import { HomeDesktopGrid } from "home_desktop_grid.slint";
import { HomeCompactFlow } from "home_compact_flow.slint";
import { AppPreferenceSwitch } from "../components/preferences.slint";
import { FlagIcon } from "../lumen-flags.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { PageTitles } from "../components/page_titles.slint";
import { RouteMode, RuntimeStatus } from "../components/domain_enums.slint";
import { NetworkMode } from "../components/domain_enums.slint";
import {
        ConnectionRow, HomeTrafficPoint, ProfileCard, ProxyGroup, TrafficBar, DashboardFacts
} from "../components/models.slint";
import {
        HomeActionButton, HomeProfileBadge, HomeRoundActionButton, HomeStatusChip,
        StatusBadge, SummaryRow, SurfaceCard
} from "../components/cards.slint";

export component PageHome inherits VerticalLayout {
        in property <bool> compact-layout;
        in property <bool> android-platform;
        in property <bool> predictive-back-enabled;
        in property <bool> application-dark-mode;
        in property <[ProfileCard]> profiles;
        in property <string> active-profile;
        in property <RouteMode> route-mode;
        in property <RuntimeStatus> runtime-status;
        // The owner's typed takeover mode and TUN capability: the home cards read
        // the two quick switches from these, never from a label string.
        in property <NetworkMode> network-mode;
        in property <bool> tun-capable: true;
        in property <bool> has-current-profile;
        in property <string> stat-down;
        in property <string> stat-up;
        in property <string> stat-down-value;
        in property <string> stat-down-unit;
        in property <string> stat-up-compact;
        in property <string> stat-connections;
        in property <string> home-current-node;
        in property <string> home-current-delay;
        in property <string> home-current-flag-code;
        in property <int> home-current-flag-index;
        in property <string> home-current-accessible;
        in property <string> home-exit-country-code;
        in property <int> home-exit-flag-index;
        in property <string> home-exit-ip;
        in property <string> home-exit-status;
        in property <DashboardFacts> dashboard-facts;
        in property <[ConnectionRow]> home-connection-table;
        in property <bool> home-traffic-has-data;
        in property <[HomeTrafficPoint]> home-traffic-points;
        in property <bool> traffic-today-has-data;
        in property <string> traffic-today-down;
        in property <string> traffic-today-up;
        in property <[TrafficBar]> traffic-today-bars;
        in property <[ProxyGroup]> proxy-groups;

        callback start-runtime();
        callback stop-runtime();
        callback open-profile-add();
        callback navigate(string);
        callback cache-back-preview();
        callback refresh-home-egress();
        // Opens the Overview card order sheet. The sheet lists the cards in the
        // order the shared owner published, so the page itself keeps no order.
        callback open-overview-order();
        callback set-route-mode(RouteMode);
        callback set-network-mode(NetworkMode);
        callback select-group(string);
        width: 100%;
        spacing: LumenTheme.space-4;
        alignment: start;
        // The compact tier still gets the reference dashboard's density once
        // the window is wide enough to carry two-column rows. A phone keeps
        // the single-column flow; a true Android surface is always phone.
        property <bool> uses-dashboard-grid: !root.android-platform
            && LumenTheme.viewport-width >= LumenTheme.dashboard-grid-min-width;

        if root.compact-layout && root.uses-dashboard-grid: HorizontalLayout {
            width: parent.width;
            height: 40 * LumenUiScale.unit;
            alignment: space-between;
            Text {
                text: PageTitles.phone-title("Home");
                color: LumenTheme.text-primary;
                font-size: DesignType.display-size;
                font-weight: DesignType.display-weight;
                vertical-alignment: center;
            }
            if root.profiles.length > 0: HomeProfileBadge {
                badge-width: min(220 * LumenUiScale.unit, max(0 * LumenUiScale.unit, parent.width - 140 * LumenUiScale.unit));
                profile-name: root.active-profile;
                route-mode: root.route-mode;
            }
        }

        if root.compact-layout && !root.uses-dashboard-grid: HomeCompactFlow {
        runtime-status: root.runtime-status;
        home-exit-status: root.home-exit-status;
        dashboard-facts: root.dashboard-facts;
        home-exit-country-code: root.home-exit-country-code;
        home-exit-ip: root.home-exit-ip;
        home-exit-flag-index: root.home-exit-flag-index;
        stat-up: root.stat-up;
        stat-down: root.stat-down;
        route-mode: root.route-mode;
        active-profile: root.active-profile;
        profiles: root.profiles;
        has-current-profile: root.has-current-profile;
        proxy-groups: root.proxy-groups;
        start-runtime => { root.start-runtime(); }
        stop-runtime => { root.stop-runtime(); }
        open-overview-order => { root.open-overview-order(); }
        navigate(page) => { root.navigate(page); }
        network-mode: root.network-mode;
        tun-capable: root.tun-capable;
        set-route-mode(mode) => { root.set-route-mode(mode); }
        set-network-mode(mode) => { root.set-network-mode(mode); }
        select-group(group) => { root.select-group(group); }
        }
        // EFFECTS-037 #153: desktop dashboard grid — speed and overview share
        // the first row. Wide compact windows use the same grid so the first
        // screen reaches the mode/switch band instead of stopping after speed.
        if !root.compact-layout || root.uses-dashboard-grid: HomeDesktopGrid {
        runtime-status: root.runtime-status;
        home-exit-status: root.home-exit-status;
        dashboard-facts: root.dashboard-facts;
        home-connection-table: root.home-connection-table;
        home-exit-country-code: root.home-exit-country-code;
        home-exit-ip: root.home-exit-ip;
        home-exit-flag-index: root.home-exit-flag-index;
        stat-up: root.stat-up;
        stat-down: root.stat-down;
        route-mode: root.route-mode;
        active-profile: root.active-profile;
        proxy-groups: root.proxy-groups;
        start-runtime => { root.start-runtime(); }
        stop-runtime => { root.stop-runtime(); }
        navigate(page) => { root.navigate(page); }
        network-mode: root.network-mode;
        tun-capable: root.tun-capable;
        set-route-mode(mode) => { root.set-route-mode(mode); }
        set-network-mode(mode) => { root.set-network-mode(mode); }
        select-group(group) => { root.select-group(group); }
        }

        if root.compact-layout && root.uses-dashboard-grid: TonalButton {
            text: @tr("调整卡片顺序");
            // One page action, one height: the compact grid variant used to be
            // 44u while the phone flow was 48u, and 44u is below the touch
            // minimum this surface publishes. Both now read that authority.
            height: LumenTheme.min-touch-target;
            horizontal-stretch: 1;
            clicked => { root.open-overview-order(); }
        }
}
