import { Button, CheckBox, LineEdit } from "std-widgets.slint";
import { TextField } from "@material";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { ProfileCard, ProfileOverrideChoice } from "../components/models.slint";
import { ProfileCardSurface, SectionCard, SurfaceCard } from "../components/cards.slint";

export component PageConfig inherits VerticalLayout {
    in property <bool> application-dark-mode;
    in property <[ProfileCard]> profiles;

    callback open-profile-add();
    callback set-current-profile(string);
    callback open-profile-action(string, string);
    callback request-export(string, string);
    callback request-delete(string, string);

    width: 100%;
    spacing: LumenTheme.space-4;
    alignment: start;

    Rectangle {
        width: parent.width;
        height: 58px * LumenUiScale.factor;
        border-radius: 29px * LumenUiScale.factor;
        background: LumenTheme.surface;
        HorizontalLayout {
            width: max(0px * LumenUiScale.factor, parent.width - 32px * LumenUiScale.factor);
            x: 16px * LumenUiScale.factor;
            height: parent.height;
            spacing: 10px * LumenUiScale.factor;
            alignment: center;
            Image { source: root.application-dark-mode ? @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/add-dark.svg") : @image-url("../../../infiltrator-shared/assets/ui/lumen/svg/add.svg"); width: 24px * LumenUiScale.factor; height: 24px * LumenUiScale.factor; y: (parent.height - self.height) / 2; image-fit: contain; }
            Text { text: @tr("添加配置"); color: LumenTheme.accent; font-size: 18px * LumenUiScale.factor; height: parent.height; vertical-alignment: center; }
        }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.open-profile-add(); } }
    }
    if root.profiles.length == 0: SurfaceCard {
        Text { text: @tr("暂无配置文件"); color: LumenTheme.text-primary; font-size: 18px * LumenUiScale.factor; font-weight: 600; }
        Text { text: @tr("订阅或导入 YAML 配置后，可以选择当前配置并启动 Mihomo。"); color: LumenTheme.text-secondary; font-size: LumenTheme.body-size; wrap: word-wrap; }
    }
    for profile in root.profiles: ProfileCardSurface {
        profile-name: profile.name;
        profile-kind: profile.kind == "本地 YAML" ? @tr("本地文件") : profile.kind;
        profile-location: profile.kind == "本地 YAML" ? @tr("本地配置文件") : profile.location;
        current: profile.current;
        set-current => { root.set-current-profile(profile.id); }
        clear-current => { root.set-current-profile(""); }
        open-settings => { root.open-profile-action(profile.id, profile.name); }
        share-profile => { root.request-export(profile.id, profile.name); }
        delete-profile => { root.request-delete(profile.id, profile.name); }
    }
}

export component PageProfileSettings inherits VerticalLayout {
    in property <string> profile-settings-id;
    in property <string> profile-settings-kind;
    in property <string> profile-settings-location;
    in-out property <string> profile-settings-name;
    in-out property <string> profile-settings-url;
    in-out property <string> profile-settings-age-key;
    in property <bool> profile-settings-age-configured;
    in property <[ProfileOverrideChoice]> profile-settings-overrides;

    callback cancel();
    callback save();
    callback clear-age-key(string);
    callback toggle-override(string, bool);
    callback move-override(string, bool);

    width: 100%;
    spacing: 16px * LumenUiScale.factor;

    SectionCard {
        heading: @tr("订阅信息");
        detail: root.profile-settings-kind == "remote_subscription" ? @tr("当前地址：") + root.profile-settings-location + @tr("。留空保持已保存地址；新地址会先下载并校验。") : @tr("本地来源：") + root.profile-settings-location + @tr("。来源文件保持只读。");
        Text { text: @tr("配置名称"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; }
        LineEdit { text <=> root.profile-settings-name; placeholder-text: @tr("配置名称"); }
        if root.profile-settings-kind == "remote_subscription": LineEdit { text <=> root.profile-settings-url; input-type: password; placeholder-text: @tr("输入新订阅链接；留空不更改"); }
        if root.profile-settings-kind == "remote_subscription": HorizontalLayout {
            spacing: 8px * LumenUiScale.factor;
            TextField {
                horizontal-stretch: 1;
                label: @tr("Age 私钥（可选）");
                input-type: password;
                text <=> root.profile-settings-age-key;
                supporting-text: root.profile-settings-age-configured ? @tr("当前已配置 Age 私钥；输入新私钥替换。") : @tr("输入新私钥以支持加密订阅；留空保留当前设置。");
            }
            if root.profile-settings-age-configured: Button {
                text: @tr("清除私钥");
                clicked => { root.clear-age-key(root.profile-settings-id); }
            }
        }
        if root.profile-settings-kind != "remote_subscription": Text { text: @tr("本地配置来源以解密后的 YAML 保存，无需继续保留 Age 私钥。"); color: LumenTheme.text-secondary; font-size: 12px * LumenUiScale.factor; wrap: word-wrap; }
    }
    SectionCard {
        heading: @tr("覆写配置");
        detail: @tr("选中项按列表顺序应用。修改暂存到草稿，保存后生效。");
        if root.profile-settings-overrides.length == 0: Text { text: @tr("暂无可绑定的用户 Override"); color: LumenTheme.text-secondary; font-size: 13px * LumenUiScale.factor; }
        for option in root.profile-settings-overrides: HorizontalLayout {
            CheckBox { text: option.name + "  ·  " + option.format; checked: option.selected; toggled => { root.toggle-override(option.id, self.checked); } }
            Button { text: @tr("上移"); enabled: option.selected && option.can-move-up; clicked => { root.move-override(option.id, true); } }
            Button { text: @tr("下移"); enabled: option.selected && option.can-move-down; clicked => { root.move-override(option.id, false); } }
        }
    }
    HorizontalLayout {
        Button { text: @tr("取消"); clicked => { root.cancel(); } }
        Button { text: @tr("保存设置"); clicked => { root.save(); } }
    }
}
