import { DesignType } from "../components/design-type.slint";
import { IconButton } from "@material";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { ObservationRow, ProxyGroup } from "../components/models.slint";
import { CompactPageHeader, HeaderActionCluster, HeaderActionMetrics, LayoutOutline, NavButtonMetrics, SegmentedControl } from "../components/base_widgets.slint";
import { ProxyGroupCard, SurfaceCard } from "../components/cards.slint";
import { RouteMode, RuntimeStatus } from "../components/domain_enums.slint";
import { ProxyGroupPillBar, ProxyNodeCard } from "../components/proxy_picker.slint";
import { ViewportLadder } from "../components/viewport-ladder.slint";

export component PageProxies inherits VerticalLayout {
    in property <bool> compact-layout;
    in property <bool> application-dark-mode;
    in property <bool> layout-debug-bounds;
    in property <RouteMode> route-mode;
    in property <RuntimeStatus> runtime-status;
    in property <string> selected-group;
    in property <[ProxyGroup]> proxy-groups;
    in property <[ObservationRow]> proxy-nodes;
    in-out property <string> proxy-search;
    in property <string> proxy-testing-group;
    in property <string> proxy-testing-node;
    in-out property <length> proxy-active-node-position;
    in-out property <bool> proxy-current-node-available;
    property <bool> show-search: !root.compact-layout;

    // FlClash answers "how many node cards fit" from the page-body width, not
    // from a window tier: `getProxiesColumns(max(width - 32, 0))` uses a 250dp
    // floor and keeps at least two columns (`lib/common/layout.dart`), and the
    // caller hands it the width the grid was given
    // (`lib/views/proxies/tab.dart`). The generated lookup reads those exported
    // constants, and the grid passes its own page-body width to the owner.
    //
    // The form is the surface's one tier fact, `LumenTheme.proxy-grid-form`:
    // the phone tier keeps its single readable column and every tier with a
    // page body asks the width rule. It used to read `LumenTheme.desktop-page`,
    // which answers a different question - whether the tier owns a labelled
    // navigation column - so the laptop range (an icon rail, a 624dp body)
    // was stacked one node per row where the reference draws three columns.
    in property <int> node-columns:
        ViewportLadder.proxy_columns(LumenTheme.proxy-grid-form, self.width);

    callback set-route-mode(RouteMode);
    callback select-group(string);
    callback select-proxy(string, string);
    callback search-proxy-nodes(string);
    callback test-proxy(string, string);
    callback open-sort-menu();

    width: 100%;
    spacing: LumenTheme.space-4;
    alignment: start;

    if root.selected-group != "": VerticalLayout {
        width: parent.width;
        spacing: LumenTheme.space-2;
        // The reference puts the page title on the left and the page actions on
        // the right of one row. The action used to sit alone on its own row
        // above the title, which read as an orphaned icon.
        CompactPageHeader {
            page: "Proxy";
            // The reference groups the two node-level actions into one capsule
            // and lets the sort/locate action keep a circle of its own.
            HeaderActionCluster {
                IconButton {
                    width: HeaderActionMetrics.action-control-size; height: HeaderActionMetrics.action-control-size;
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/search.svg");
                    tooltip: @tr("搜索节点");
                    clicked => { root.show-search = !root.show-search; }
                }
                IconButton {
                    width: HeaderActionMetrics.action-control-size; height: HeaderActionMetrics.action-control-size;
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/zap.svg");
                    tooltip: @tr("全部测速");
                    clicked => { root.test-proxy(root.selected-group, ""); }
                }
            }
            HeaderActionCluster {
                IconButton {
                    width: HeaderActionMetrics.action-control-size; height: HeaderActionMetrics.action-control-size;
                    icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg");
                    tooltip: @tr("定位当前节点与排序");
                    clicked => { root.open-sort-menu(); }
                }
            }
        }
        if root.show-search: search-box := Rectangle {
            width: parent.width; height: HeaderActionMetrics.search-height; border-radius: HeaderActionMetrics.search-height / 2;
            background: LumenTheme.surface-muted;
            border-width: 1 * LumenUiScale.unit;
            border-color: (search-touch.has-hover && LumenTheme.hover-allowed) ? LumenTheme.accent : LumenTheme.border;
            search-touch := TouchArea { width: parent.width; height: parent.height; }
            search-layout := HorizontalLayout {
                x: HeaderActionMetrics.search-inset; width: parent.width - 2 * HeaderActionMetrics.search-inset; height: parent.height; spacing: LumenTheme.space-3;
                cross-axis-alignment: center;
                search-icon := Image {
                    source: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/search.svg");
                    width: NavButtonMetrics.icon-size; height: NavButtonMetrics.icon-size; image-fit: contain;
                    colorize: LumenTheme.text-secondary;
                }
                search-content := Rectangle {
                    horizontal-stretch: 1; height: parent.height; background: transparent;
                    TextInput {
                        width: parent.width; height: parent.height;
                        text <=> root.proxy-search;
                        color: LumenTheme.text-primary;
                        font-size: DesignType.label-size;
                        font-weight: DesignType.label-weight;
                        font-family: DesignType.label-family;
                        vertical-alignment: center;
                        edited => { root.search-proxy-nodes(self.text); }
                    }
                    if root.proxy-search == "": Text {
                        x: 0 * LumenUiScale.unit; width: parent.width; height: parent.height;
                        text: @tr("搜索节点名称或协议"); color: LumenTheme.text-muted; font-size: DesignType.label-size; font-weight: DesignType.label-weight; font-family: DesignType.label-family;
                        vertical-alignment: center;
                    }
                }
            }
            if root.layout-debug-bounds: Rectangle {
                x: search-layout.x + search-icon.x; y: search-layout.y + search-icon.y;
                width: search-icon.width; height: search-icon.height;
                background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-icon;
            }
            if root.layout-debug-bounds: Rectangle {
                x: search-layout.x + search-content.x; y: search-layout.y + search-content.y;
                width: search-content.width; height: search-content.height;
                background: transparent; border-width: 1 * LumenUiScale.unit; border-color: LumenTheme.debug-content;
            }
            if root.layout-debug-bounds: LayoutOutline { outline-color: LumenTheme.debug-frame; }
        }
        if root.runtime-status != RuntimeStatus.running: Text { text: @tr("内核未启动：Ping 测 TCP 连通性，切换节点需启动"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; font-weight: DesignType.micro-weight; font-family: DesignType.micro-family; height: 18 * LumenUiScale.unit; }
    }
    if root.selected-group == "" && !root.compact-layout: SurfaceCard {
        Text { text: @tr("策略模式"); color: LumenTheme.text-primary; font-size: DesignType.subheading-size; font-weight: DesignType.subheading-weight; }
        Text { text: @tr("应用后会从 Mihomo 核心回读实际值"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start;
            SegmentedControl {
                width: 260 * LumenUiScale.unit;
                items: [{ text: @tr("规则") }, { text: @tr("全局") }, { text: @tr("直连") }];
                current-index: root.route-mode == RouteMode.rule ? 0 : root.route-mode == RouteMode.global ? 1 : 2;
                index-changed(index) => {
                    root.set-route-mode(index == 0 ? RouteMode.rule : index == 1 ? RouteMode.global : RouteMode.direct);
                }
            }
        }
    }
    if root.selected-group == "" && !root.compact-layout: Text { text: @tr("代理组"); color: LumenTheme.accent; font-size: DesignType.bodyLarge-size; font-weight: DesignType.bodyLarge-weight; }
    // The group row is persistent and sits under the page title, as the
    // reference draws it: switching egress group is one tap and the node list
    // stays where it is instead of asking the reader to drill back out.
    if root.proxy-groups.length > 0: ProxyGroupPillBar {
        width: parent.width;
        groups: root.proxy-groups;
        selected-group: root.selected-group;
        picked(group) => { root.select-group(group); }
    }
    if root.selected-group == "" && root.proxy-groups.length == 0: SurfaceCard {
        Text { text: root.runtime-status == RuntimeStatus.running ? @tr("正在读取代理组…") : @tr("暂无代理组"); color: LumenTheme.text-primary; font-size: DesignType.subheading-size; font-weight: DesignType.subheading-weight; }
        Text { text: root.runtime-status == RuntimeStatus.running ? @tr("正在读取当前 Mihomo 状态。") : @tr("选择当前配置后，可先查看配置中的代理组和节点。启动 Mihomo 后即可切换。"); color: LumenTheme.text-secondary; font-size: LumenTheme.supporting-size; wrap: word-wrap; }
    }
    if root.selected-group == "": VerticalLayout {
        width: parent.width;
        spacing: LumenTheme.space-4;
        for group in root.proxy-groups: ProxyGroupCard {
            group-name: group.name;
            group-icon-emoji: group.icon-emoji;
            group-kind: group.kind;
            current-node: group.current;
            current-flag-code: group.current-flag-code;
            current-flag-index: group.current-flag-index;
            current-accessible: group.current-accessible;
            compact: root.compact-layout;
            runtime-running: root.runtime-status == RuntimeStatus.running;
            testing: root.proxy-testing-group == group.name;
            has-nodes: group.nodes != "";
            selected: false;
            clicked => { root.select-group(group.name); }
            test-current => { root.test-proxy(group.name, ""); }
        }
    }
    if root.selected-group != "" && root.proxy-nodes.length == 0: SurfaceCard {
        Text { text: root.proxy-search == "" ? @tr("当前组没有可选节点") : @tr("没有匹配的节点"); color: LumenTheme.text-secondary; font-size: LumenTheme.body-size; wrap: word-wrap; }
    }
    if root.selected-group != "": GridLayout {
        width: parent.width;
        // The node grid keeps the reference's own seam: `proxyGridSpacing = 8.0`
        // (`lib/views/proxies/common.dart`), a constant on both axes in every
        // view mode. This grid used to pay 12u on a desktop window - a seam the
        // reference never draws - and the comment above it claimed the
        // opposite.
        spacing: LumenTheme.space-mobile-card-gap;
        for node[index] in root.proxy-nodes: ProxyNodeCard {
            col: Math.mod(index, root.node-columns);
            row: index / root.node-columns;
            node: node;
            testing: root.proxy-testing-node == node.id;
            switching-allowed: root.runtime-status == RuntimeStatus.running;
            changed absolute-position => {
                if node.active {
                    root.proxy-active-node-position = self.absolute-position.y;
                    root.proxy-current-node-available = true;
                }
            }
            picked => { root.select-proxy(root.selected-group, node.id); }
            probed => { root.test-proxy(root.selected-group, node.id); }
        }
    }
}
