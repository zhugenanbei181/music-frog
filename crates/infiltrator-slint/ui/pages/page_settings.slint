import { DesignType } from "../components/design-type.slint";
import { ProductIdentity } from "../components/product-identity.slint";
import { CheckBox } from "std-widgets.slint";
import { LumenUiScale } from "../lumen-ui-scale.slint";
import { LumenTheme } from "../components/theme.slint";
import { OverrideCard } from "../components/models.slint";
import {
    PillButton, RoundedInputField, SegmentedControl, SettingRow
} from "../components/base_widgets.slint";
import { AppPreferenceGroup, AppPreferenceRow } from "../components/preferences.slint";
import { SectionCard, SectionHeading } from "../components/cards.slint";
import { NetworkMode, RouteMode, RuntimeStatus, ThemeMode } from "../components/domain_enums.slint";

export component PageSettings inherits VerticalLayout {
    in property <bool> android-platform;
    in property <bool> predictive-back-enabled;
    in property <bool> layout-debug-tools-enabled;
    in-out property <bool> layout-debug-bounds;
    in property <string> product-version: ProductIdentity.version;

    callback navigate(string);
    callback cache-back-preview();

    // A list-only section card has no heading or detail text, so the standard
    // card padding would add air that its first and last 56u rows do not have.
    // This one row-padding token keeps both ends equal without a second frame.
    private property <length> list-card-vertical-padding: LumenTheme.space-1;

    width: 100%;
    // The group headings own the air above and below themselves, so the list
    // does not add a uniform gap on top of it.
    spacing: 0 * LumenUiScale.unit;
    alignment: start;

    SectionHeading { text: @tr("资源"); }
    SectionCard {
        heading: ""; detail: ""; content-spacing: 0 * LumenUiScale.unit; vertical-padding: root.list-card-vertical-padding; border-width: 0 * LumenUiScale.unit;
        SettingRow { show-divider: true; label: @tr("运行观测"); detail: @tr("连接、规则和流量统计"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/activity.svg"); destination: "Meta"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Meta"); } }
        SettingRow { label: @tr("日志"); detail: @tr("实时运行与内核输出"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg"); destination: "Logs"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Logs"); } }
    }
    SectionHeading { text: @tr("设置"); }
    SectionCard {
        heading: ""; detail: ""; content-spacing: 0 * LumenUiScale.unit; vertical-padding: root.list-card-vertical-padding; border-width: 0 * LumenUiScale.unit;
        SettingRow { show-divider: true; label: @tr("应用"); detail: @tr("主题、语言与启动行为"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/settings.svg"); destination: "AppSettings"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("AppSettings"); } }
        SettingRow { show-divider: true; label: @tr("网络"); detail: @tr("代理模式、核心与平台接管"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/network.svg"); destination: "Network"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Network"); } }
        SettingRow { show-divider: true; label: @tr("覆写"); detail: @tr("YAML 与规则覆写"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg"); destination: "Overrides"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Overrides"); } }
        SettingRow { show-divider: true; label: @tr("进阶配置"); detail: @tr("DNS、编辑器、过滤与聚合"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/code-2.svg"); destination: "Dns"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Dns"); } }
        SettingRow { show-divider: true; label: @tr("诊断与同步"); detail: @tr("生命周期、备份与恢复"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/copy.svg"); destination: "Doctor"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Doctor"); } }
        SettingRow { label: @tr("应用路由"); detail: @tr("按应用分流的策略编辑"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg"); destination: "AppRouting"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("AppRouting"); } }
    }
    SectionHeading { text: @tr("其他"); }
    SectionCard {
        heading: ""; detail: ""; content-spacing: 0 * LumenUiScale.unit; vertical-padding: root.list-card-vertical-padding; border-width: 0 * LumenUiScale.unit;
        SettingRow { show-divider: true; label: @tr("开源许可"); detail: @tr("第三方声明与协议"); icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg"); destination: "Licenses"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Licenses"); } }
        SettingRow { label: @tr("关于"); detail: @tr("版本与许可证"); badge: "v" + root.product-version; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg"); destination: "About"; clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("About"); } }
        if root.layout-debug-tools-enabled: CheckBox {
            text: @tr("显示布局边界（调试）");
            checked: root.layout-debug-bounds;
            toggled => { root.layout-debug-bounds = self.checked; }
        }
        if root.layout-debug-bounds: Text { text: @tr("洋红：外框 · 青色：内容区/输入框 · 蓝色：图标框"); color: LumenTheme.text-secondary; font-size: DesignType.micro-size; wrap: word-wrap; }
    }
}

export component PageMeta inherits VerticalLayout {
    in property <bool> android-platform;
    in property <bool> predictive-back-enabled;

    callback navigate(string);
    callback cache-back-preview();

    private property <length> list-card-vertical-padding: LumenTheme.space-1;

    width: 100%;
    spacing: LumenTheme.space-3;
    alignment: start;

    Text { text: @tr("运行观测"); color: LumenTheme.accent; font-size: DesignType.bodyLarge-size; font-weight: DesignType.bodyLarge-weight; }
    SectionCard {
        heading: ""; detail: ""; content-spacing: 0 * LumenUiScale.unit; vertical-padding: root.list-card-vertical-padding; border-width: 0 * LumenUiScale.unit;
        // One separator dialect: these rows used to hand-draw a full-width rule
        // between every pair, so the same list grew two kinds of seam - the
        // inset hairline the rows own and this edge-to-edge line that read as a
        // stray frame. The row's own seam is the only one.
        SettingRow { show-divider: true; label: @tr("连接"); detail: @tr("查看并管理活动连接"); destination: "Connections"; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/network.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Connections"); } }
        SettingRow { show-divider: true; label: @tr("日志"); detail: @tr("筛选和导出 Mihomo 日志"); destination: "Logs"; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/file-text.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Logs"); } }
        SettingRow { show-divider: true; label: @tr("运行规则"); detail: @tr("查看和临时启停规则"); destination: "Rules"; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/list-checks.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Rules"); } }
        SettingRow { show-divider: true; label: @tr("流量统计"); detail: @tr("查看今日和本周流量"); destination: "Traffic"; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/activity.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Traffic"); } }
        SettingRow { label: @tr("Providers"); detail: @tr("更新代理与规则提供者"); destination: "Providers"; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/server.svg"); clicked => { if root.android-platform && root.predictive-back-enabled { root.cache-back-preview(); } root.navigate("Providers"); } }
    }
}

export component PageNetwork inherits VerticalLayout {
    in property <bool> compact-layout;
    in property <bool> android-platform;
    in property <RouteMode> route-mode;
    in property <RuntimeStatus> runtime-status;
    in property <bool> has-current-profile;
    in property <NetworkMode> network-mode;
    in property <string> network-mode-label;
    in property <string> network-mode-status;
    in property <bool> network-mode-status-warning;
    in property <bool> tun-capable;
    in property <string> tun-capability-detail;
    in property <string> lan-sharing-heading;
    in property <string> lan-sharing-detail;
    in property <string> core-version;
    in property <bool> proxy-recovery-pending;

    callback set-route-mode(RouteMode);
    callback start-runtime();
    callback stop-runtime();
    callback set-network-mode(NetworkMode);
    callback check-core();
    callback retry-proxy-restore();

    width: 100%;
    spacing: LumenTheme.space-4;

    SectionCard {
        heading: @tr("代理模式"); detail: @tr("应用后由 Mihomo 核心回读实际模式。");
        SegmentedControl {
            width: max(0 * LumenUiScale.unit, parent.width - 2 * LumenTheme.space-4);
            height: 48 * LumenUiScale.unit;
            items: [{ text: @tr("规则") }, { text: @tr("全局") }, { text: @tr("直连") }];
            current-index: root.route-mode == RouteMode.rule ? 0 : root.route-mode == RouteMode.global ? 1 : 2;
            index-changed(index) => { root.set-route-mode(index == 0 ? RouteMode.rule : index == 1 ? RouteMode.global : RouteMode.direct); }
        }
    }
    SectionCard {
        heading: @tr("运行模式"); detail: root.compact-layout ? @tr("Android 通过系统 VPN 接管其他应用流量；本产品核心与转发器自身流量直连以避免回环。") : @tr("桌面接管模式与 Mihomo 的 Rule/Global/Direct 代理策略相互独立。");
        if root.compact-layout: HorizontalLayout {
            spacing: LumenTheme.space-2;
            PillButton {
                label: root.runtime-status == RuntimeStatus.running ? @tr("停止 VPN") : @tr("启动 VPN");
                enabled: root.runtime-status == RuntimeStatus.running || root.has-current-profile;
                clicked => { if root.runtime-status == RuntimeStatus.running { root.stop-runtime(); } else { root.start-runtime(); } }
            }
            Text { text: root.network-mode-status; color: root.network-mode-status-warning ? LumenTheme.status-warning : LumenTheme.status-info; font-size: DesignType.mono-size; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
        if !root.compact-layout: HorizontalLayout {
            spacing: LumenTheme.space-2;
            PillButton {
                label: @tr("系统代理");
                selected: root.network-mode == NetworkMode.system-proxy;
                check-prefix: true;
                enabled: root.network-mode != NetworkMode.system-proxy;
                // There were two routes for this one action, and the one taken
                // while the core was running - `open-network-dialog` - was handled
                // by nobody in the tree, so pressing the system-proxy pill with a
                // live core did nothing at all. `set-network-mode` is the live route:
                // the router sends it to the takeover confirmation, which is exactly
                // what a running core needs. One action, one route, both states.
                clicked => { root.set-network-mode(NetworkMode.system-proxy); }
            }
            PillButton {
                label: "TUN";
                selected: root.network-mode == NetworkMode.tun;
                check-prefix: true;
                enabled: root.tun-capable && root.network-mode != NetworkMode.tun;
                clicked => { root.set-network-mode(NetworkMode.tun); }
            }
        }
        if !root.compact-layout: Text { text: @tr("当前选择：") + root.network-mode-label + " · " + root.network-mode-status; color: root.network-mode-status-warning ? LumenTheme.status-warning : LumenTheme.status-info; font-size: DesignType.mono-size; wrap: word-wrap; }
        if !root.compact-layout: Text { text: root.tun-capability-detail; color: root.tun-capable ? LumenTheme.text-muted : LumenTheme.status-warning; font-size: DesignType.caption-size; wrap: word-wrap; }
    }
    SectionCard {
        heading: root.lan-sharing-heading;
        detail: root.lan-sharing-detail;
    }
    SectionCard {
        heading: @tr("Mihomo 核心"); detail: root.android-platform ? (@tr("官方 Android v1.19.33 · 随本产品 APK 提供，独立进程运行；GPL-3.0 许可与源码见关于页。当前：") + root.core-version) : (@tr("从 PATH 运行 Mihomo；当前版本：") + root.core-version);
        HorizontalLayout { Text { text: root.android-platform ? @tr("Android ABI 核心") : @tr("执行命令：mihomo"); color: LumenTheme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; } PillButton { label: @tr("检查版本"); clicked => { root.check-core(); } } }
    }
    SectionCard {
        heading: @tr("运行安全"); detail: @tr("控制 API 绑定 127.0.0.1，随机密钥仅驻留内存；未实现或未确认的系统接管能力不会报告为已生效。");
        PillButton { label: @tr("重试恢复上次系统代理"); enabled: root.proxy-recovery-pending; clicked => { root.retry-proxy-restore(); } }
    }
}

export component PageAppSettings inherits VerticalLayout {
    in property <bool> android-platform;
    in property <int> app-settings-preview-section;
    in property <bool> auto-start;
    in property <bool> refresh-current-profile-on-start;
    in property <ThemeMode> theme-mode;
    in property <bool> invert-theme-foreground;
    in property <string> theme-color-code;
    in property <string> application-language;
    in property <string> system-language;
    in property <int> page-scale-percent;
    in property <bool> predictive-back-enabled;
    in property <bool> predictive-back-supported;
    in property <bool> hide-background-card;
    in property <bool> show-traffic-notification;
    in property <bool> release-ui-when-background;
    in property <bool> ignore-battery-optimizations;
    in property <string> user-agent;

    callback set-auto-start(bool);
    callback set-refresh-profile-on-start(bool);
    callback set-invert-theme-foreground(bool);
    callback set-predictive-back-enabled(bool);
    callback set-hide-background-card(bool);
    callback set-show-traffic-notification(bool);
    callback set-release-ui-when-background(bool);
    callback request-ignore-battery-optimization();
    callback open-theme-menu(length, length);
    callback open-language-menu(length, length);
    callback open-theme-color-dialog();
    callback open-page-scale-dialog();
    callback open-user-agent-dialog();
    callback show-message(string);

    width: 100%;
    spacing: 0 * LumenUiScale.unit;
    alignment: start;
    if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 0: AppPreferenceGroup {
        heading: @tr("行为");
        AppPreferenceRow { label: @tr("自动启动"); toggle: true; checked: root.auto-start; toggled(value) => { root.set-auto-start(value); } }
        AppPreferenceRow { label: @tr("启动更新配置"); toggle: true; checked: root.refresh-current-profile-on-start; toggled(value) => { root.set-refresh-profile-on-start(value); } }
    }
    if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 1: AppPreferenceGroup {
        heading: @tr("主题配色");
        AppPreferenceRow { label: @tr("主题模式"); value: root.theme-mode == ThemeMode.light ? @tr("浅色") : root.theme-mode == ThemeMode.dark ? @tr("深色") : root.theme-mode == ThemeMode.forest ? @tr("护眼森林") : root.theme-mode == ThemeMode.amoled ? @tr("AMOLED") : @tr("跟随系统"); expand: true; clicked => { root.open-theme-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height); } }
        AppPreferenceRow { label: @tr("反转主题前景色"); toggle: true; checked: root.invert-theme-foreground; toggled(value) => { root.set-invert-theme-foreground(value); } }
        AppPreferenceRow { label: @tr("主题配色"); detail: @tr("当前主题色：") + root.theme-color-code; icon: @image-url("../../../infiltrator-shared/assets/ui/iced/svg/target.svg"); clicked => { root.open-theme-color-dialog(); } }
        AppPreferenceRow { label: @tr("应用语言"); value: root.application-language == "en" ? @tr("English") : root.application-language == "zh-CN" ? @tr("简体中文") : (root.system-language == "en" ? @tr("English") : @tr("简体中文")); expand: true; clicked => { root.open-language-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height); } }
        AppPreferenceRow { label: @tr("页面缩放"); value: root.page-scale-percent + "%"; clicked => { root.open-page-scale-dialog(); } }
    }
    if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 2): AppPreferenceGroup {
        heading: @tr("导航");
        AppPreferenceRow { label: @tr("预测返回手势"); toggle: true; checked: root.predictive-back-enabled; capability-enabled: root.predictive-back-supported; unavailable: root.predictive-back-supported ? "" : @tr("Android 14及以上支持系统手势进度"); clicked => { root.show-message(@tr("Android 14及以上支持系统手势进度")); } toggled(value) => { root.set-predictive-back-enabled(value); } }
    }
    if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 3): AppPreferenceGroup {
        heading: @tr("隐私");
        AppPreferenceRow { label: @tr("隐藏后台卡片"); toggle: true; checked: root.hide-background-card; toggled(value) => { root.set-hide-background-card(value); } }
    }
    if root.android-platform && (root.app-settings-preview-section < 0 || root.app-settings-preview-section == 4): AppPreferenceGroup {
        heading: @tr("服务");
        AppPreferenceRow { label: @tr("显示流量通知"); toggle: true; checked: root.show-traffic-notification; toggled(value) => { root.set-show-traffic-notification(value); } }
        AppPreferenceRow { label: @tr("后台隐藏时释放界面"); toggle: true; checked: root.release-ui-when-background; toggled(value) => { root.set-release-ui-when-background(value); } }
        AppPreferenceRow { label: @tr("电池优化无限制"); state-description: root.ignore-battery-optimizations ? @tr("系统已加入不优化名单") : @tr("系统正在优化本产品"); icon: root.ignore-battery-optimizations ? @image-url("../../../infiltrator-shared/assets/ui/iced/svg/square.svg") : @image-url("../../../infiltrator-shared/assets/ui/iced/svg/chevron-right.svg"); checked: root.ignore-battery-optimizations; clicked => { root.request-ignore-battery-optimization(); } }
    }
    if root.app-settings-preview-section < 0 || root.app-settings-preview-section == 5: AppPreferenceGroup {
        heading: @tr("网络");
        AppPreferenceRow { label: @tr("自定义 User-Agent"); detail: root.user-agent == "" ? @tr("未设置，使用默认值") : root.user-agent; clicked => { root.open-user-agent-dialog(); } }
    }
}

export component PageOverrides inherits VerticalLayout {
    in property <[OverrideCard]> overrides;
    in-out property <string> override-name;
    in-out property <string> override-url;
    in-out property <string> override-body;
    in property <bool> override-importing;
    in property <string> override-import-error;
    in-out property <string> override-edit-id;

    callback import-override-url(string);
    callback add-override(string, string);
    callback save-override(string, string);
    callback choose-override-file();
    callback edit-override(string);
    callback apply-override(string);
    callback export-override(string);
    callback delete-override(string);

    width: 100%;
    spacing: LumenTheme.space-4;

    SectionCard {
        heading: @tr("新建 YAML Override"); detail: @tr("仅用户 Override 可编辑；JavaScript 尚未通过安全沙箱验证，因此不执行。");
        RoundedInputField { label: @tr("配置名称"); text <=> root.override-name; }
        HorizontalLayout {
            spacing: LumenTheme.space-2;
            cross-axis-alignment: center;
            RoundedInputField { label: @tr("HTTP/HTTPS YAML 链接"); text <=> root.override-url; password: true; horizontal-stretch: 1; }
            PillButton { label: root.override-importing ? @tr("正在导入…") : @tr("从链接导入"); enabled: !root.override-importing && root.override-url != ""; clicked => { root.import-override-url(root.override-url); } }
        }
        if root.override-import-error != "": Text { text: root.override-import-error; color: LumenTheme.error; font-size: DesignType.caption-size; wrap: word-wrap; }
        if root.override-importing: Text { text: @tr("正在导入并校验 YAML Override…"); color: LumenTheme.text-secondary; font-size: DesignType.caption-size; }
        Rectangle {
            height: 150 * LumenUiScale.unit;
            border-radius: LumenTheme.radius-control;
            background: LumenTheme.surface-muted;
            border-width: 1 * LumenUiScale.unit;
            border-color: LumenTheme.border;

            TextInput {
                x: 14 * LumenUiScale.unit;
                y: 10 * LumenUiScale.unit;
                width: parent.width - 28 * LumenUiScale.unit;
                height: parent.height - 20 * LumenUiScale.unit;
                text <=> root.override-body;
                color: LumenTheme.text-primary;
                font-family: DesignType.mono-family;
                font-size: DesignType.mono-size;
                single-line: false;
                wrap: word-wrap;
            }

            if root.override-body == "": Text {
                x: 14 * LumenUiScale.unit;
                y: 10 * LumenUiScale.unit;
                text: @tr("填写 YAML 覆写内容");
                color: LumenTheme.text-muted;
                font-size: DesignType.mono-size;
            }
        }
        HorizontalLayout {
            spacing: LumenTheme.space-2;
            PillButton {
                label: root.override-edit-id == "" ? @tr("创建覆写") : @tr("保存覆写");
                selected: true;
                clicked => {
                    if root.override-edit-id == "" { root.add-override(root.override-name, root.override-body); }
                    else { root.save-override(root.override-edit-id, root.override-body); }
                }
            }
            if root.override-edit-id != "": PillButton {
                label: @tr("取消编辑");
                clicked => { root.override-edit-id = ""; root.override-name = ""; root.override-body = ""; }
            }
        }
        PillButton { label: @tr("从 YAML/YML 文件导入"); enabled: !root.override-importing; clicked => { root.choose-override-file(); } }
    }
    for item in root.overrides: SectionCard {
        heading: item.name + "   ·   " + item.kind; detail: item.format + @tr("  ·  绑定到 ") + item.bound-count + @tr(" 个配置");
        HorizontalLayout {
            spacing: LumenTheme.space-2;
            PillButton { label: @tr("编辑"); clicked => { root.edit-override(item.id); } }
            PillButton { label: @tr("应用到当前配置"); selected: true; clicked => { root.apply-override(item.id); } }
            PillButton { label: @tr("导出"); clicked => { root.export-override(item.id); } }
            PillButton { label: @tr("删除"); clicked => { root.delete-override(item.id); } }
        }
    }
}
