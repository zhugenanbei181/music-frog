[Desktop Entry]
Name=@desktop.slint.display_name@
Comment=@desktop.slint.linux_comment@
Exec=@desktop.slint.binary_name@ %U
Icon=@desktop.slint.linux_package_id@
Terminal=false
Type=Application
Categories=Network;Utility;
MimeType=x-scheme-handler/@desktop.slint.url_scheme@;
Keywords=proxy;vpn;mihomo;singbox;network;
StartupWMClass=@desktop.slint.binary_name@
